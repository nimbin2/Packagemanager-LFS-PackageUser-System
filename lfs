# Inside the chroot, `lfs` is the wrong tool for most things.
#
# The build is driven from OUTSIDE: `lfs` mounts the partition, creates the
# layout, builds the cross toolchain and generates the in-chroot scripts.  From
# inside, none of that applies -- $LFS does not even exist as a path -- so
# `lfs build-system next` reads the empty state and cheerfully reports "2 of 12
# done", sending you back to the beginning of a finished build.
#
# Inside, lfs-helper is the tool.
_INSIDE_ONLY_ELSEWHERE = {
    "next", "session", "layout", "add-user", "get-sources", "crosschain",
    "chroot", "gen-chroot-scripts", "install-tools", "fix-ownership",
    "version-check", "show",
}

_INSIDE_EQUIVALENT = {
    "next":        "lfs-helper next",
    "show":        "lfs-helper list",
    "fix-ownership": "lfs-helper fix-ownership --run",
    "manifests":   "lfs-helper manifests",
}


def _root_differs_from_pid1():
    """Is this process's / a different directory from PID 1's?

    THE KERNEL KNOWS.  That is what a chroot IS -- a root that is not the
    real one -- and /proc/1/root resolves to the real one, so comparing the
    two answers the question outright instead of inferring it from files
    that happen to be there.  Returns None when it cannot be asked: no
    /proc mounted, or not privileged enough to read PID 1's root.
    """
    if os.geteuid() != 0:
        return None                # /proc/1/root is root's to read
    try:
        a, b = os.stat("/"), os.stat("/proc/1/root")
    except OSError:
        return None                # no /proc, or a kernel that will not say
    return (a.st_dev, a.st_ino) != (b.st_dev, b.st_ino)


def inside_chroot():
    """Are we running inside the LFS chroot?

    The chroot SAYS SO: `lfs build-system chroot enter` sets LFS_IN_CHROOT in
    the environment it starts.  Failing that, the kernel is asked
    (_root_differs_from_pid1).

    It used to be inferred from "/usr/src/lfs-pkgusr exists", and that is true
    of any system these tools have built -- so a finished host running its own
    lfs refused every command with "you are inside the LFS chroot".  An
    inference that is true of the destination cannot identify the journey.

    The guard on that inference was "...and /mnt/lfs/usr/src does not exist",
    which fails at the one moment it matters: a FRESH build, where the
    partition is mounted and still empty, on a host these tools built.  That
    is the report this fix comes from.  The old test survives only as a last
    resort -- no LFS_IN_CHROOT, no readable /proc/1 -- and then against the
    CONFIGURED mount point, not a hardcoded one.
    """
    if os.environ.get("LFS_IN_CHROOT"):
        return True
    differs = _root_differs_from_pid1()
    if differs is not None:
        return differs
    if os.environ.get("LFS"):
        return False                      # there is a build target: we are outside
    mount = load_config().get("lfs_mount") or "/mnt/lfs"
    return (os.path.isdir(os.path.join("/", PKGUSR_DIR))
            and not os.path.isdir(mount))


def _refuse_inside_chroot(cmd, sub=None):
    name = sub or cmd
    sys.stderr.write(
        "You are inside the LFS chroot, where `lfs %s` does not apply.\n"
        "\n"
        "  The build is driven from OUTSIDE the chroot: `lfs` mounts the\n"
        "  partition, builds the toolchain and writes the scripts.  From in\n"
        "  here there is no $LFS to work on, so this command would report\n"
        "  nonsense about a build that is actually finished.\n"
        "\n" % (("build-system " + sub) if sub else cmd))
    eq = _INSIDE_EQUIVALENT.get(name)
    if eq:
        sys.stderr.write("  In here, use:  %s\n" % eq)
    else:
        sys.stderr.write("  In here, lfs-helper drives the build:\n"
                         "      lfs-helper next      # what to do next\n"
                         "      lfs-helper status    # where things stand\n"
                         "      lfs-helper list      # every step\n")
    sys.stderr.write("\n  To run this, leave the chroot first (type 'exit').\n")
    # WHICH lfs SAID SO, AND WHY.
    #
    # A host was refused by this message for days.  1.14.1 fixed the
    # detection, but the binary being run was 1.11.26 -- `make install` had
    # been going somewhere else, and nothing on screen said which copy was
    # talking or what convinced it.  A refusal has to identify itself, or a
    # stale install looks like a bug in the current one.
    how = "LFS_IN_CHROOT is set" if os.environ.get("LFS_IN_CHROOT") \
        else ("this process's / is not PID 1's"
              if _root_differs_from_pid1() else "no $LFS, and no mounted tree")
    sys.stderr.write("\n  (said by %s %s, build %s -- because %s)\n"
                     % (os.path.abspath(sys.argv[0]), LFS_VERSION,
                        _build_id(), how))
    sys.exit(2)


