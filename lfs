def cmd_config_target(args):
    """Show or change the config the BUILT system will get.

    Laid out like `packagemanager config --show`: value, then where it comes
    from.  The user asked for the config commands to look and behave the same
    across the tools, and this is the first of them to follow that shape.
    """
    path = _target_config_path()
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    # INTERACTIVE, LIKE THE OTHERS.
    #
    # `packagemanager config` asks for what is missing and `packagemanager env
    # --ask` walks the build variables; this took only a key and a value -- so
    # the config a person most needs to set deliberately, the NEW SYSTEM'S,
    # was the one with no guided way to set it.
    if getattr(args, "ask", False):
        print()
        print("# === Config the BUILT system will get ===")
        print("  file: %s" % path)
        print("  Enter keeps the current value; '-' clears it (means 'none').")
        print()
        for key, what in _TARGET_KEYS:
            cur = cfg.get(key)
            shown = ("(none)" if cur == "" else
                     cur if cur is not None else "this host's value")
            try:
                ans = input("  %s\n    %-16s [%s]: " % (what, key, shown)).strip()
            except EOFError:
                print()
                break
            if ans == "":
                continue
            cfg[key] = "" if ans == "-" else ans
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2, sort_keys=True)
            f.write("\n")
        print()
        print("  saved %s" % path)
        print("  it reaches the build system on the next `lfs run`.")
        return
    if args.key and args.value is not None:
        cfg[args.key] = args.value
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2, sort_keys=True)
            f.write("\n")
        print("  %s = %r  ->  %s" % (args.key, args.value, path))
        print("  it reaches the build system on the next `lfs run`.")
        return
    print()
    print("# === Config the BUILT system will get ===")
    print("  file: %s%s" % (path, "" if os.path.isfile(path)
                            else "   (not created yet)"))
    print()
    if not cfg:
        print("  nothing set -- the build system will use this host's values")
        print("  for the shared keys (prefixes, layout, books).")
        print()
        print("  set one with, for example:")
        print("    lfs config --target pkgusr_prefix p")
        print("    lfs config --target pkgusr_subdir packages")
        return
    for k in sorted(cfg):
        print("  %-22s = %r" % (k, cfg[k]))
    print()
    print("  these override this host's values when the tree is built;")
    print("  a config the tree already has wins over both.")


