# =========================================================================== #
# command: files_with_broken_id                                   [IMPLEMENTED]
# =========================================================================== #
#
# DIAGNOSTIC (finds, does not change anything): lists files whose owning uid or
# gid no longer maps to a name -- i.e. orphaned files left behind when a user or
# group was deleted while its files still existed (e.g. a --purge without
# removing the files first, or an old manual userdel).  Writes the paths to a
# file so you can review and decide what to do (reassign, remove, or ignore).

def cmd_reclaim(args):
    """Give a package back the files something else took from it.

    The ownership rule -- the installer owns what it installs -- is right for
    packages that legitimately overlap, and wrong when one package installs a
    BUNDLED COPY of another (1.14.116).  By the time that is noticed, the
    victim's files belong to the wrong account: /usr/bin/dvbv5-scan owned by
    p_libdisplay-info, listed in p_v4l-utils's manifest.  Only root can put
    them back, and only the manifest knows which they are.
    """
    if os.geteuid() != 0:
        printError("reclaim changes ownership; run it as root.")
        return 1
    if getattr(args, "all", False):
        # ONE ACCIDENT, EVERY PACKAGE.  A tree-wide chown -- lfs-kernel's
        # headers step gave p_linux-headers all of /usr/include -- is not a
        # per-package problem, and naming the victims one at a time means
        # finding them first.
        args.packages = sorted(_pkg_dirs())
        printInfo("checking %d installed package(s) against their manifests"
                  % len(args.packages))
    elif not args.packages:
        printError("name a package, or --all")
        return 2

    rc = 0
    for name in args.packages:
        acct = pkgusr_name(name)
        manifest = os.path.join(pkgusr_home(acct), "pkg.lst")
        try:
            paths = [l.strip() for l in open(manifest) if l.strip()]
        except OSError as e:
            # under --all a package with no manifest is not an error, it is
            # a package that has not recorded one -- saying so 90 times
            # buries the packages that DID lose files
            if getattr(args, "all", False):
                continue
            printError("%s: cannot read %s (%s)" % (acct, manifest, e))
            rc = 1
            continue
        wrong = []
        for path in paths:
            try:
                st = os.lstat(path)
            except OSError:
                continue
            try:
                owner = pwd.getpwuid(st.st_uid).pw_name
            except (KeyError, AttributeError):
                owner = str(st.st_uid)
            if owner != acct:
                wrong.append((path, owner))
        if not wrong:
            printSuccess("%s: every recorded file is already its own (%d checked)"
                         % (acct, len(paths)))
            continue
        printWarning("%s: %d recorded file(s) belong to someone else"
                     % (acct, len(wrong)))
        for path, owner in wrong[:20]:
            printInfo("    %-52s now %s" % (path, owner))
        if len(wrong) > 20:
            printInfo("    ... and %d more" % (len(wrong) - 20))
        if not args.run:
            printInfo("  Dry run -- re-run with --run to give them back.")
            continue
        back = 0
        for path, _owner in wrong:
            try:
                os.lchown(path, pwd.getpwnam(acct).pw_uid,
                          grp.getgrnam(acct).gr_gid)
                back += 1
            except (OSError, KeyError) as e:
                printError("    could not return %s (%s)" % (path, e))
                rc = 1
        printSuccess("%s: %d file(s) returned" % (acct, back))
    return rc


def _setid_table():
    """setid.conf as {path: (mode, owner, group, package)}.

    The 5th column (package) is the one this command is here for: it is the
    only written-down statement of WHICH package installs a setuid file, and
    a setuid file held by any other package is damage, not history.
    """
    out = {}
    for d in (os.environ.get("PM_STACK_DIR") or "/etc/pkgusr/stacks",
              os.path.join(os.path.dirname(os.path.abspath(__file__)), "stacks")):
        conf = os.path.join(d, "setid.conf")
        if not os.path.isfile(conf):
            continue
        try:
            with open(conf, errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    col = [c.strip() for c in line.split("|")]
                    if len(col) < 2 or not col[0].startswith("/"):
                        continue
                    col += [""] * (5 - len(col))
                    out[col[0]] = (col[1], col[2] or "root", col[3] or "-", col[4])
        except OSError:
            continue
        break
    return out


def cmd_disown(args):
    """Take back the files a package cannot have installed.

    `reclaim` is the other direction: it pushes ownership TOWARDS pkg.lst,
    which is right when a package lost files and wrong when the record is
    what went bad.  This one distrusts the record, and it exists because the
    record did go bad -- three times, the same way:

        -rwx--x--x 1 p_webkitgtk p_webkitgtk /usr/bin/su
        lrwxrwxrwx 1 p_webkitgtk p_webkitgtk /usr/sbin/iptables -> xtables-nft-multi

    Neither is webkitgtk's.  They were swept into its manifest because
    attribution is by TIME WINDOW and a webkitgtk build runs for hours, and
    the lease then acted on that manifest -- clearing su's setuid bit on the
    way, because `chown` does that and says nothing.  1.14.310 shuts both
    doors; this repairs machines that already went through them.

    Two rules, and nothing is guessed from either:

      * setid.conf names the package that installs each setuid file.  Anyone
        else holding it gives it back to root, with the mode from the table.
      * a symlink is installed by whoever installed its target.  A link whose
        target belongs to another package goes back to that package.

    Whatever is handed back is struck from the package's pkg.lst as well:
    an ownership fix that leaves the record claiming the file is a fix that
    undoes itself on the next `--clean`, which would DELETE these paths.
    """
    if args.run and os.geteuid() != 0:
        printError("disown changes ownership; run it as root.")
        return 1

    setid = _setid_table()
    if not setid:
        printWarning("no setid.conf found -- only the symlink rule can run")

    if getattr(args, "all", False):
        names = sorted(_pkg_dirs())
    elif args.packages:
        names = args.packages
    else:
        printError("name a package, or --all")
        return 2

    accounts = set()
    for root in pkgusr_roots():
        try:
            accounts.update(os.listdir(root))
        except OSError:
            pass

    def owner_of(path, follow=False):
        try:
            st = os.stat(path) if follow else os.lstat(path)
            return pwd.getpwuid(st.st_uid).pw_name
        except (KeyError, OSError):
            return None

    rc, total = 0, 0
    for name in names:
        acct = pkgusr_name(name)
        pkg = re.sub(r"^" + re.escape(pkgusr_prefix()), "", acct)
        lst = os.path.join(pkgusr_home(acct), "pkg.lst")
        try:
            paths = [l.strip() for l in open(lst, errors="replace") if l.strip()]
        except OSError as e:
            if getattr(args, "all", False):
                continue
            printError("%s: cannot read %s (%s)" % (acct, lst, e))
            rc = 1
            continue

        wrong = []          # (path, reason, give-to, mode-or-None)
        for path in paths:
            if owner_of(path) != acct:
                continue
            pol = setid.get(path)
            if pol and pol[3] != pkg:
                who = pol[3] or "no package"
                wrong.append((path, "setid.conf says %s installs it" % who,
                              "root", pol[0]))
                continue
            if os.path.islink(path):
                tgt = os.path.realpath(path)
                to = owner_of(tgt, follow=True)
                if to and to != acct and to != "root" and to in accounts:
                    wrong.append((path, "points at %s's %s" % (to, tgt), to, None))

        if not wrong:
            if not getattr(args, "all", False):
                printSuccess("%s: nothing it could not have installed (%d checked)"
                             % (acct, len(paths)))
            continue

        total += len(wrong)
        printWarning("%s: %d recorded path(s) belong somewhere else" % (acct, len(wrong)))
        for path, why, to, _m in wrong:
            printInfo("    %-46s -> %-12s %s" % (path, to, why))
        if not args.run:
            printInfo("  Dry run -- re-run with --run to hand them back.")
            continue

        done = []
        for path, _why, to, mode in wrong:
            try:
                if to == "root":
                    os.lchown(path, 0, 0)
                    # THE MODE COMES BACK TOO.  The chown that took the file
                    # cleared its setuid bit; handing it to root without the
                    # bit leaves `su` exactly as broken as it was.
                    if mode and not os.path.islink(path):
                        os.chmod(path, int(mode, 8))
                else:
                    os.lchown(path, pwd.getpwnam(to).pw_uid, grp.getgrnam(to).gr_gid)
                done.append(path)
            except (OSError, KeyError) as e:
                printError("    could not hand back %s (%s)" % (path, e))
                rc = 1

        # ...AND OUT OF THE RECORD, or `update <pkg> --clean` deletes them.
        if done:
            keep = [p for p in paths if p not in set(done)]
            try:
                with open(lst + ".new", "w") as f:
                    f.write("\n".join(keep) + ("\n" if keep else ""))
                os.replace(lst + ".new", lst)
            except OSError as e:
                printError("    %s: could not rewrite pkg.lst (%s)" % (acct, e))
                rc = 1
            # lfs-helper's build manifests: $LFS_PKGUSR_DIR/manifests/<pkg>.files,
            # which defaults to /usr/src/lfs-pkgusr.  It is the list the LEASE
            # reads, so leaving the path in it re-arms the whole thing.
            _state = (os.environ.get("LFS_PKGUSR_DIR")
                      or os.path.join(os.path.dirname(BASE_DIR.rstrip("/")) or "/usr/src",
                                      "lfs-pkgusr"))
            for man in dict.fromkeys(
                    [os.path.join(_state, "manifests", pkg + ".files"),
                     os.path.join("/usr/src/lfs-pkgusr/manifests", pkg + ".files")]):
                if not os.path.isfile(man):
                    continue
                try:
                    lines = [l.rstrip("\n") for l in open(man, errors="replace")]
                    left = [l for l in lines if l.strip() not in set(done)]
                    if len(left) != len(lines):
                        with open(man + ".new", "w") as f:
                            f.write("\n".join(left) + ("\n" if left else ""))
                        os.replace(man + ".new", man)
                        printInfo("    %s: %d line(s) removed" % (man, len(lines) - len(left)))
                except OSError as e:
                    printError("    %s (%s)" % (man, e))
                    rc = 1
            printSuccess("%s: %d path(s) handed back" % (acct, len(done)))

    if total == 0:
        printSuccess("nothing to hand back")
    elif not args.run:
        printInfo("")
        printInfo("  After --run, put the setuid bits back and check them:")
        printInfo("      lfs-helper setid --run")
    return rc


def cmd_which_package(args):
    """Which package installed this path.

    The README has promised this command for as long as it has existed and
    packagemanager never had it:

        packagemanager: error: argument <command>: invalid choice: 'which-package'

    `lfs-helper which-package` does exist, but it reads the BUILD manifests --
    the chapter 5-9 steps -- so for anything installed afterwards it answers

        Nothing recorded means it was installed before file tracking existed,
        or outside these tools entirely.

    which is wrong twice over: these tools installed it, and they did record
    it, in the package user's own pkg.lst.  Two file registries, one question,
    and each tool could only see its own.
    """
    rc = 0
    for target in args.paths:
        path = os.path.abspath(os.path.expanduser(target))
        printHeader(path)

        owner = None
        try:
            owner = pwd.getpwuid(os.stat(path).st_uid).pw_name
        except (KeyError, OSError):
            pass

        # The manifests: which package RECORDS having installed it.
        hits = []
        for root in pkgusr_roots():
            try:
                names = sorted(os.listdir(root))
            except OSError:
                continue
            for n in names:
                lst = os.path.join(root, n, "pkg.lst")
                if not os.path.isfile(lst):
                    continue
                try:
                    with open(lst, errors="replace") as f:
                        for line in f:
                            if line.strip() == path:
                                hits.append(n)
                                break
                except OSError:
                    continue
        if hits:
            for n in hits:
                printSuccess(f"  recorded by: {n}   ({os.path.join(pkgusr_home(n), 'pkg.lst')})")
        else:
            printWarning("  no pkg.lst records this path")
            rc = 1

        # ...and who owns it now, which is the other half of the answer and
        # can disagree with the manifest.
        if owner:
            printInfo(f"  owned on disk by: {owner}")
            if hits and owner not in hits:
                printWarning(f"  the owner is not among the packages that "
                             f"recorded it -- one of the two is wrong")
        else:
            printWarning("  not on disk, or its owner does not resolve")

        if not hits:
            printInfo("  The build steps have their own manifests; for anything")
            printInfo("  installed during chapters 5-9 ask:")
            printInfo(f"      lfs-helper which-package {path}")
    return rc


def cmd_files_with_broken_id(args):
    out_file = args.outfile or "/tmp/invalid_files.txt"
    printInfo("Scanning for orphaned files (uid/gid with no matching name); "
              "this runs 'find /' and may take a while. Nothing is changed.")
    cmd = ["find", "/",
           "(", "-path", "/proc", "-o", "-path", "/sys", "-o", "-path", "/dev",
           "-o", "-path", "/run", "-o", "-path", "/mnt", ")", "-prune", "-o",
