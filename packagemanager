def _book_in_use(tool):
    """Which book each tool would use -- the thing you actually want to know
    when a package cannot be found."""
    if tool == "blfs":
        rc, out, _e = run_blfs(["books"])
        if rc != 0:
            return "(blfs not available)"
        for ln in out.splitlines():
            if "[" in ln and "]" in ln:
                return ln.split("[", 1)[1].split("]", 1)[0]
        return "(none cached -- blfs fetch, or blfs import <file>)"
    # Read the config directly.  Parsing `lfs config` needed a mounted LFS
    # tree, which does not exist inside the chroot -- so the book the system
    # was built from showed as "(unknown)" on the very system it built.
    cfg = _shared_lfs_config()
    ver = cfg.get("build_book") or cfg.get("default")
    if not ver:
        return "(no book configured)"
    for cand in (os.environ.get("LFS_STORE"), "/usr/share/lfs"):
        if not cand:
            continue
        p = os.path.join(cand, "books", f"LFS-BOOK-{ver}-NOCHUNKS.html")
        if os.path.isfile(p):
            return os.path.basename(p)
    return f"{ver}  (not cached here)"


def _accounts_with_prefix(prefix):
    """Package-user accounts currently using this prefix.

    Used to refuse a prefix change that would orphan a built tree: the
    accounts are not renamed by changing the setting.
    """
    if pwd is None:
        return []
    pfx = (prefix.rstrip("_") + "_") if prefix else ""
    out = []
    for entry in pwd.getpwall():
        if not pfx or entry.pw_name.startswith(pfx):
            if entry.pw_dir.startswith(BASE_DIR.rstrip("/") + "/"):
                out.append(entry.pw_name)
    return out


def _config_sources():
    """Every prefix and directory, with the reason it has that value.

    The user could not find where these live -- fairly: prefixes come from
    /usr/share/lfs/config.json (authoritative), then
    /etc/pkgusr/packagemanager.conf, then the environment, then a default;
    and the DIRECTORIES were environment-only, documented nowhere.
    """
    shared = _shared_lfs_config() or {}
    conf = {}
    try:
        import configparser
        cp = configparser.ConfigParser()
        with open(CONFIG_PATH) as f:
            cp.read_string("[c]\n" + f.read())
        conf = dict(cp["c"])
    except Exception:
        conf = {}

    def src(key, env, value):
        if os.environ.get(env):
            return "the environment ($%s)" % env
        if key in shared:
            return "the lfs config (%s)" % _lfs_config_path()
        if key in conf:
            return "packagemanager.conf"
        return "the built-in default"

    rows = [
        ("package-user prefix", pkgusr_prefix(),
         src("pkgusr_prefix", "LFS_PKGUSR_PREFIX", None)),
        ("config-user prefix", cfguser_prefix(),
         src("cfguser_prefix", "LFS_CFGUSR_PREFIX", None)),
        ("collector prefix", collector_prefix(),
         src("collector_prefix", "LFS_COLLECTOR_PREFIX", None)),
        ("shared-user prefix", user_prefix(),
         src("user_prefix", "LFS_USER_PREFIX", None)),
        ("base directory", BASE_DIR,
         "the environment ($PKGUSR_BASE)" if os.environ.get("PKGUSR_BASE")
         else "the built-in default"),
        ("package homes", os.path.join(BASE_DIR, PKGUSR_SUBDIR) if PKGUSR_SUBDIR
         else BASE_DIR,
         src("pkgusr_subdir", "PKGUSR_SUBDIR", None)),
        ("config-user homes", os.path.join(BASE_DIR, CFGUSR_SUBDIR) if CFGUSR_SUBDIR
         else BASE_DIR,
         src("cfguser_subdir", "CFGUSR_SUBDIR", None)),
    ]
    return rows


def _lfs_config_path():
    """The lfs config actually in use -- not the default path.

    The report named /usr/share/lfs/config.json whatever it had read, which
    is wrong wherever LFS_STORE points somewhere else.
    """
    for cand in (os.environ.get("LFS_STORE"), "/usr/share/lfs",
                 os.path.expanduser("~/.local/share/lfs")):
        if cand and os.path.isfile(os.path.join(cand, "config.json")):
            return os.path.join(cand, "config.json")
    return "/usr/share/lfs/config.json"


