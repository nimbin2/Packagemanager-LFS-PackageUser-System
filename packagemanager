_USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


class colors:
    normal = "\033[0m" if _USE_COLOR else ""
    red = "\033[31m" if _USE_COLOR else ""
    green = "\033[32m" if _USE_COLOR else ""
    yellow = "\033[33m" if _USE_COLOR else ""
    blue = "\033[34m" if _USE_COLOR else ""
    cyan = "\033[36m" if _USE_COLOR else ""
    dim = "\033[2m" if _USE_COLOR else ""


HEADER_WIDTH = 60


def printHeader(msg):
    inner = f"### {msg} "
    tail = "#" * max(HEADER_WIDTH - len(inner), 3)
    print(f"\n{colors.blue}{inner}{tail}{colors.normal}")


def printLine():
    line = f"{colors.blue}{'-' * HEADER_WIDTH}{colors.normal}"
    print(line)
    return line


def printSuccess(msg): print(f"{colors.green}{msg}{colors.normal}")
def printInfo(msg):    print(f"{colors.blue}{msg}{colors.normal}")
# Warnings go to STDERR, like lfs-helper's warn().  A note printed to stdout
# lands inside whatever a caller is capturing -- the config-conflict note was
# read back as part of `print(pm.BASE_DIR)` by anything scripting this module,
# and the value it polluted was correct.
def printWarning(msg): print(f"{colors.yellow}{msg}{colors.normal}", file=sys.stderr)
def printError(msg):   print(f"{colors.red}{msg}{colors.normal}")


def ask_yes_no(question):
    while True:
        resp = input(f"{question} [y|n]: ").strip().lower()
        if resp == "y":
            return True
        if resp == "n":
            return False
        print("Please enter 'y' for yes or 'n' for no.")


# --------------------------------------------------------------------------- #
# shared helpers
# --------------------------------------------------------------------------- #

# BASE_DIR is /usr/src, which holds more than package users -- lfs-pkgusr,
# a stray root/, whatever else lives there.  Listing every directory reported
# them as packages ("root  broken  has a home dir but no user").  An account
# either exists in the user database or carries the skeleton every package
# user is created with.
_ACCOUNT_MARKERS = ("build.conf", ".project", "install_last", "pkg.lst",
                    ".bash_profile")


def _looks_like_an_account(path, name):
    # the prefix IS the evidence: p_gcc is a package user by construction
    for pfx in (pkgusr_prefix(), user_prefix(), cfguser_prefix()):
        if pfx and name.startswith(pfx):
            return True
    # NOT "a user of this name exists" -- /usr/src/root passed that test
    # because root exists, and came out of verify as a broken package.  A
    # system user is not evidence that a DIRECTORY is a package home.
    return any(os.path.lexists(os.path.join(path, m)) for m in _ACCOUNT_MARKERS)


def list_all_users():
    """Every package-user, i.e. every directory directly under BASE_DIR."""
    # Directory names ARE user names, so they carry the prefix.  Hand back
    # package names: everything user-facing speaks in package names, and
    # pkgusr_name() puts the prefix back wherever it is needed.
    #
    # A root that does not exist is normal -- a system with no config-step
    # packages has no cfg/ directory.  ALL of them missing is not, and must
    # still be reported: swallowing it turns "nothing is installed here" into
    # a silent empty list, which reads as "no packages".
    out, found = [], False
    for root in pkgusr_roots():
        try:
            names = os.listdir(root)
        except OSError:
            continue
        found = True
        # A COLLECTOR GROUP IS NOT A PACKAGE.
        #
        # `nimgnu_perl-modules`, `nimgnu_python-modules` and friends are
        # GROUPS that own shared install directories.  They were listed as
        # package-users and reported "broken -- has a user but no home dir",
        # so a verify of a healthy system ended with four scary lines about
        # things that are working exactly as designed.  A false alarm in a
        # health check is worse than no check: it is what teaches people to
        # skip the output.
        # BOTH SPELLINGS.  lfs-helper fell back to "nimgnu" while this tool
        # and `lfs` fell back to "sysgroup" (fixed in 1.14.35), so a system
        # whose config never set the key has groups under the OTHER name.
        # Recognise them however they were created; the config still decides
        # what NEW ones are called.
        _cps = {collector_prefix(), "sysgroup_", "nimgnu_"}
        # ONE UNDERSCORE.  collector_prefix() already ends in "_", so this
        # tested startswith("sysgroup__") and never matched anything -- the
        # filter above has never worked, and every collector group was still
        # listed as a "broken" package.
        # ...and check the name BOTH ways.  A directory may be `p_nimgnu_x`
        # (the package prefix stacked on a group name) or plain `nimgnu_x`;
        # the raw name misses the first, the unprefixed one misses nothing.
        for d in names:
            if not os.path.isdir(os.path.join(root, d)):
                continue
            bare = unprefix_pkgusr(d)
            if any(c and (d.startswith(c) or bare.startswith(c)) for c in _cps):
                continue
            if not _looks_like_an_account(os.path.join(root, d), d):
                continue
            out.append(bare)
    if not found:
        printError(f"{BASE_DIR} does not exist (looked in "
                   f"{', '.join(pkgusr_roots())}).")
        return []
    return sorted(set(out))


# --------------------------------------------------------------------------- #
# bridge to the `blfs` tool (offline book parser / script generator)
#
# packagemanager no longer parses the book itself -- it shells out to `blfs`,
# which is fast (cached) and knows the real 13.0 structure.  Location/book can
# be steered with env vars so the same code works in production and in tests:
#   BLFS_BIN        e.g. "blfs" or "python3 /path/blfs"   (default: auto-detect)
#   BLFS_BOOK_FILE  passed through as `--book-file <path>` (offline/testing)
#   BLFS_BOOK       passed through as `--book <selector>`
# --------------------------------------------------------------------------- #

def find_blfs():
    override = os.environ.get("BLFS_BIN")
    if override:
        return override.split()
    here = os.path.dirname(os.path.abspath(__file__))
    local = os.path.join(here, "blfs")
    if os.path.isfile(local):
        # os.access(X_OK) answers "yes" for root even without any execute bit,
        # so check the mode bits themselves -- exactly the situation in a
        # fresh copy of the tools, and the exec then dies with EACCES.
        ex = bool(os.stat(local).st_mode & 0o111)
        return [local] if ex else [sys.executable or "python3", local]
    return ["blfs"]                                   # rely on $PATH


def _blfs_book_flags():
    if os.environ.get("BLFS_BOOK_FILE"):
        return ["--book-file", os.environ["BLFS_BOOK_FILE"]]
    if os.environ.get("BLFS_BOOK"):
        return ["--book", os.environ["BLFS_BOOK"]]
    return []


# what each blfs subcommand is actually doing, for the status line
_BLFS_ACTIVITY = {
    "order":    "working out the build order for %s",
    "debug":    "looking up %s in the book",
    "deps":     "reading %s's dependencies",
    "script":   "writing the install script for %s",
    "versions": "reading versions from the book",
    "search":   "searching the book for %s",
}


# distinct blfs notes already shown this invocation (see run_blfs)
_FORWARDED_NOTES = set()


def run_blfs(args):
    """Run blfs; return (returncode, stdout, stderr).  rc 127 => blfs missing.

    Each call is a subprocess, and the first one for a given book INDEXES it,
    which takes many seconds.  Announce what is happening: an install that sits
    silent for half a minute before its first output looks frozen."""
    cmd = find_blfs() + _blfs_book_flags() + list(args)
    verb = args[0] if args else ""
    if verb in _BLFS_ACTIVITY:
        arg = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        try:
            set_status(_BLFS_ACTIVITY[verb] % arg if "%s" in _BLFS_ACTIVITY[verb]
                       else _BLFS_ACTIVITY[verb])
        except Exception:
            pass
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
        # blfs says important things on stderr -- "note: no book matched
        # '13.0-systemd'; using the cached ..." is a decision being
        # overridden, and capturing it silently is how a wrong book got used
        # without a word.  Forward each DISTINCT note once: a plan touching
        # ninety packages makes ninety blfs calls, and the same note ninety
        # times is noise wearing a warning's colour.
        _notes = [ln for ln in (r.stderr or "").splitlines()
                  if ln.startswith("note:") and ln not in _FORWARDED_NOTES]
        if _notes:
            try:
                clear_status()
            except Exception:
                pass
            for ln in _notes:
                _FORWARDED_NOTES.add(ln)
                printWarning(ln)
        return r.returncode, r.stdout, r.stderr
    except FileNotFoundError:
        return 127, "", "blfs executable not found"
    finally:
        # the status line this call set is ITS to clear: left standing, the
        # caller's next print lands on the same line
        # ("reading versions from the bookChecking 97 package(s)...")
        if verb in _BLFS_ACTIVITY:
            try:
                clear_status()
            except Exception:
                pass


_VERSION_MAP = None          # anchor -> name_version, the whole book, once


def book_version(anchor):
    """Current name-version of a package in the book, or None if unavailable.

    ONE PROCESS FOR THE WHOLE BOOK, not one per question.  This ran `blfs
    debug <anchor>` every time it was called -- a subprocess that opens and
    reads the book cache to answer one lookup.  A stack preview asks it once
    per entry (56 for sway) and the planner asks it for every package it
    considers, so a command whose real work is a dictionary lookup spent
    minutes launching processes:

        looking up pipewire in the book        <- one process
        looking up ... in the book             <- another

    `book_versions_all` was already here, used only by `update`.  The map is
    loaded on first use and answers everything after that; a name the map does
    not have (an alias, a URL, a fragment) still falls back to the old call.
    """
    global _VERSION_MAP
    if _VERSION_MAP is None:
        try:
            _VERSION_MAP = book_versions_all() or {}
        except Exception:
            _VERSION_MAP = {}
    hit = _VERSION_MAP.get(anchor)
    if hit:
        return hit
    if _VERSION_MAP:
        low = anchor.lower()
        for a, nv in _VERSION_MAP.items():
            if a.lower() == low:
                return nv
    rc, out, _ = run_blfs(["debug", anchor])
    if rc != 0:
        return None
    m = re.search(r"^title\s*:\s*(.+)$", out, re.M)
    nv = m.group(1).strip() if m else None
    if nv and _VERSION_MAP is not None:
        _VERSION_MAP[anchor] = nv          # ask once, even for an alias
    return nv


def book_rdeps(target, no_recommended=False, optional=False):
    """anchors of packages that recursively depend on `target`, via blfs rdeps."""
    argv = ["rdeps", target, "--anchors"]
    if no_recommended:
        argv.append("--no-recommended")
    if optional:
        argv.append("--optional")
    rc, out, _ = run_blfs(argv)
    result = {}
    if rc == 0:
        for line in out.splitlines():
            if "\t" in line:
                a, nv = line.split("\t", 1)
                if a.strip():
                    result[a.strip()] = nv.strip()
    return result


def book_versions_all():
    """Map anchor -> name_version for the whole book, in ONE blfs call (so update
    doesn't spawn a process per package)."""
    rc, out, _ = run_blfs(["versions"])
    versions = {}
    if rc == 0:
        for line in out.splitlines():
            if "\t" in line:
                a, nv = line.split("\t", 1)
                a, nv = a.strip(), nv.strip()
                if a and nv and " " not in a:
                    versions[a] = nv
    return versions


def cmd_blfs(args):
    """Pass through to the blfs book tool: books, set-default, search, etc.
    e.g.  packagemanager blfs books --discover   /   packagemanager blfs set-default svn"""
    passthrough = args.args
    if passthrough and passthrough[0] == "--":
        passthrough = passthrough[1:]
    cmd = find_blfs() + _blfs_book_flags() + passthrough
    try:
        sys.exit(subprocess.run(cmd).returncode)
    except FileNotFoundError:
        printError("blfs not found (set BLFS_BIN or put blfs on PATH).")
        sys.exit(127)


def find_pm_install():
    """The install front door.  packagemanager_install is retired (item 6,
    step 7); the front-matter and the loop both live in lfs-helper now, behind
    `lfs-helper pm-install <account> <script>`.  Overridable with
    PM_INSTALL_BIN so tests can substitute a stub."""
    override = os.environ.get("PM_INSTALL_BIN")
    if override:
        return override.split()
    here = os.path.dirname(os.path.abspath(__file__))
    local = os.path.join(here, "lfs-helper")
    if os.path.isfile(local):
        base = [local] if os.access(local, os.X_OK) else ["bash", local]
        return base + ["pm-install"]
    return ["lfs-helper", "pm-install"]


# =========================================================================== #
# command: info                                                   [IMPLEMENTED]
# =========================================================================== #
#
# Mirrors the original `info`: a table of package-users with the columns
# name / uid / gid / home / pkg_list.  A value is shown in red when it is
# missing, and uid/gid are shown in yellow when they differ.  A user is
# "broken" when any column is missing (e.g. a /usr/src dir with no matching
# system user, or a user that has never been installed so has no pkg.lst);
# broken users are repeated in their own section.
#
# Column selection: -name -uid -gid -home -pkg-list pick specific columns;
# with none given, all columns are shown.  `info all` == every package-user.

# =========================================================================== #
# command: info                                                   [IMPLEMENTED]
# =========================================================================== #
#
# A table of package-users.  Beyond the system-user facts (name/uid/gid) we also
# read /usr/src/<name>/install_last -- the install script copied into the user's
# home at install time -- to show the installed version, and (with -l/--long)
# the link, md5, info text, and required/recommended/optional deps + groups.
#
# State (refined):
#   installed      user + home dir + non-empty pkg.lst
#   not installed  user + home dir, but no pkg.lst yet
#   broken         an inconsistency: a /usr/src dir with no matching system
#                  user, or a named user with no /usr/src home
# uid != gid is shown yellow as a warning but is not by itself "broken".
#
# Column selection: -name -uid -gid -home -pkg-list -version -state pick an
# explicit set; with none given the default overview is
# name/uid/gid/version/state.  `info all` == every package-user.

# fields we read out of an install_last script
_LAST_SCALARS = ("name", "name_version", "url", "link", "pkg", "md5_sum", "info",
                 "installed_program", "installed_directory", "validate_cmd")
_LAST_ARRAYS = ("required", "recommended", "optional",
                "install_groups", "additional_links",
                "installed_programs", "installed_libraries",
                "installed_directories", "installed_content")


def _parse_bash_vars(text, scalars=(), arrays=()):
    """Pull simple  key="value"  and single-line  key=(a b c)  assignments out
    of a generated install script.  Good enough for our own install_last files
    (all header vars are single lines at the top)."""
    # GREEDY, AND THE LINE HAS A COMMENT ON IT.
    #
    # The stack's generated scripts document their own metadata:
    #     installed_programs=()      # e.g. ('gst-launch-1.0' 'gst-inspect-1.0')
    #     installed_program="sway"   # e.g. "ffmpeg"  (checked on PATH)
    # `\((.*)\)` ran from the first "(" to the LAST ")" -- into the comment --
    # and `"(.*)"` likewise from the first quote to the last.  Every git and
    # tar package in `verify` therefore reported
    #     missing: program ), program #, program e.g., program ('gst-launch-1.0
    # for twenty packages, in every run, all session.  Non-greedy, and a
    # trailing comment is allowed and ignored.
    out = {}
    for key in scalars:
        m = re.search(rf'^{key}="(.*?)"[ \t]*(#.*)?$', text, re.M)
        if m:
            out[key] = m.group(1)
    for key in arrays:
        m = re.search(rf'^{key}=\((.*?)\)[ \t]*(#.*)?$', text, re.M)
        if m:
            items = re.findall(r"'[^']*'|\"[^\"]*\"|\S+", m.group(1))
            out[key] = [it.strip("'\"") for it in items]
    return out


def _same_version(a, b):
    """Do these two name_version strings describe the same release?

    The books capitalize differently -- BLFS anchors are lowercase
    ('which-2.23'), the LFS book titles its packages ('Which-2.23') -- and
    the VERSION file records the LFS spelling.  Comparing exactly would
    invent an update for every package both books carry, which is precisely
    the risk of reading VERSION at all."""
    if not a or not b:
        return False
    return a.strip().lower() == b.strip().lower()


def read_install_last(home):
    """Parsed vars from /usr/src/<name>/install_last (or install_<name>).

    Falls back to the VERSION file when there is no install script record.
    Both build paths write down what they installed -- packagemanager into
    install_last, lfs-helper into VERSION -- and reading only the first meant
    every package the LFS build produced came back with no version at all:
    "97 checked, 0 judged" on a system where `lfs update` compares all 97
    happily.  Same fact, two files; this reads whichever exists.

    (The real fix is one build loop -- open item 6 -- but a tool must not be
    blind to the other loop's records in the meantime.)"""
    if not home:
        return {}
    # install_last first: it is the record of the script AS IT LAST RAN, the
    # only file that states what is actually installed.
    path = os.path.join(home, "install_last")
    if os.path.isfile(path):
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            return {}
        return _parse_bash_vars(text, _LAST_SCALARS, _LAST_ARRAYS)
    # Then lfs-helper's record.  It must come BEFORE the install script: that
    # script is regenerated whenever the book moves on, so its name_version is
    # what the BOOK has, and reading it would compare the book with itself and
    # call everything current forever.  (`lfs update` avoids the same trap.)
    vpath = os.path.join(home, "VERSION")
    if os.path.isfile(vpath):
        try:
            for line in open(vpath, encoding="utf-8", errors="replace"):
                line = line.strip()
                if line and not line.startswith("#"):
                    return {"name_version": line, "_source": "VERSION"}
        except OSError:
            pass
    # Last resort, and only for a home with no record of its own.
    path = os.path.join(home, "install_" + os.path.basename(home))
    if os.path.isfile(path):
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            return {}
        return _parse_bash_vars(text, _LAST_SCALARS, _LAST_ARRAYS)
    return {}


def _is_account_furniture(path):
    """Paths that exist because the ACCOUNT exists, not because anything was
    installed: useradd's mail spool, and the home directory itself."""
    return path.startswith("/var/mail/") or path.startswith("/var/spool/mail/")


class User:
    __slots__ = ("search", "name", "uid", "gid", "home", "pkg_list", "meta")

    def __init__(self, search):
        self.search = search
        self.name = self.uid = self.gid = None
        self.home = self.pkg_list = None
        self.meta = {}

    @property
    def has_user(self):
        return self.uid is not None

    @property
    def state(self):
        """How we decide a package is INSTALLED (same rule everywhere):
        there must be a package-user AND its /usr/src/<name> home, AND evidence
        that an install actually completed -- either an 'install_last' recording
        a version, or a 'pkg.lst' manifest listing at least one path that still
        exists on disk.  User+home but no such evidence => 'not installed' (the
        user was created but nothing is installed yet).  Only one of user/home
        => 'broken'."""
        if not self.home and not self.has_user:
            return "not installed"
        if self.home and self.has_user:
            # install_last says a version was installed -- but if the manifest
            # beside it is mostly gone, the files are not there and the claim
            # is stale.  The manifest wins when there is one.
            if self.pkg_list:
                if self._manifest_has_real_paths():
                    return "installed"
                return "not installed"
            if self._declares_content_that_is_missing():
                # the script says where it installs, and it is not there
                return "not installed"
            if self.meta.get("name_version"):
                return "installed"
            return "not installed"
        return "broken"

    def _declares_content_that_is_missing(self):
        """The book says what this package installs -- is any of it there?

        A SECOND OPINION, for when there is no manifest to consult.  Every
        generated script carries the page's own Installed-programs /
        -libraries / -directories, e.g. for Pathspec

            installed_directories='/usr/lib/python3.14/site-packages/pathspec ...'

        so "installed" can be checked against the system instead of inferred
        from the existence of an install_last record.  Only decides NOT
        installed when the script names paths and none of them exist; a
        package whose page names nothing is left to the older rule.
        """
        paths = []
        for key in ("installed_directories", "installed_directory",
                    "installed_libraries", "installed_library"):
            for p in (self.meta.get(key) or "").split():
                if p.startswith("/"):
                    paths.append(p)
        if not paths:
            return False
        return not any(os.path.exists(p) for p in paths)

    def _manifest_has_real_paths(self):  # noqa: D401 (see _is_account_furniture)
        """Does this manifest still DESCRIBE the system?

        One surviving path used to be enough, and that is how a record kept
        lying for three sessions: binutils claimed 330 paths with 190 gone,
        140 survivors said "installed", the planner skipped it, and packages
        that needed it failed somewhere else entirely (xmllint, glib,
        -lfreetype).  `lfs-helper verify` had the right rule all along -- a
        record with most of its files missing is not describing an installed
        package -- but only the manual sweep applied it.  The planner uses the
        same rule now, so an ordinary `packagemanager install` / `stack --run`
        rebuilds such a package instead of skipping it.

        Counted over the WHOLE manifest (capped at 5000 paths, which no
        package reaches by much).  Sampling the first N is wrong: pkg.lst is
        path-sorted, so a package whose /usr/bin survived and whose
        /usr/share died would look healthy from the top."""
        if not self.pkg_list:
            return False
        seen = alive = 0
        try:
            with open(self.pkg_list, encoding="utf-8", errors="replace") as f:
                for line in f:
                    p = line.strip()
                    if not p.startswith("/"):
                        continue
                    # NOT AN INSTALLED FILE, WHOEVER WROTE THE RECORD.
                    # useradd's mail spool is owned by the package user, so
                    # older manifests contain it -- and for a package that
                    # installed nothing it is the ONLY line, so the record
                    # counted 1 of 1 alive and said "installed".  Excluding it
                    # from the scan (1.14.16) only fixed records written after;
                    # every pkg.lst already on disk still claimed it, which is
                    # why pathspec was skipped again on the next run.
                    if _is_account_furniture(p):
                        continue
                    seen += 1
                    if os.path.lexists(p):
                        alive += 1
                    if seen >= 5000:
                        break
        except OSError:
            return False
        if not seen:
            return False
        return alive * 2 > seen          # more than half still there

    @property
    def broken(self):
        return self.state == "broken"

    @property
    def uid_gid_mismatch(self):
        return self.has_user and self.uid != self.gid

    @property
    def version(self):
        return self.meta.get("name_version")


def gather_user(name):
    """Populate a User from the system user db, the on-disk package dir, and
    its install_last script.

    The lookup goes through pkgusr_name(): callers speak in PACKAGE names
    ('glibc') and list_all_users hands them back unprefixed, while the account
    is 'p_glibc'.  Looking the raw name up got a KeyError, so has_user stayed
    false, so state came out 'broken' -- and every package the LFS build made
    landed in the "cannot judge" bucket of `packagemanager update` with its
    home, VERSION and manifest sitting right there.  pkgusr_name is
    idempotent, so this is safe for a name that already carries the prefix."""
    u = User(name)
    if pwd is not None:
        try:
            pw = pwd.getpwnam(pkgusr_name(name))
            u.name, u.uid, u.gid = pw.pw_name, str(pw.pw_uid), str(pw.pw_gid)
        except KeyError:
            pass
    home = pkgusr_home(name)
    if os.path.isdir(home):
        u.home = home
    pkg_lst = os.path.join(home, "pkg.lst")
    if os.path.isfile(pkg_lst) and os.path.getsize(pkg_lst) > 0:
        u.pkg_list = pkg_lst
    u.meta = read_install_last(u.home)
    return u


def count_pkg_files(pkg_list):
    if not pkg_list:
        return None
    try:
        with open(pkg_list, encoding="utf-8", errors="replace") as f:
            return sum(1 for _ in f)
    except OSError:
        return None


_STATE_COLOR = {"installed": colors.green,
                "unvalidated": colors.cyan,
                "not installed": colors.yellow,
                "broken": colors.red}


def print_user_details(u):
    m = u.meta
    expected = book_version(u.name or u.search)
    state, why = assess(u, expected)
    head = f"{u.name or u.search}"
    if u.version:
        head += f"  ({u.version})"
    print(f"\n{colors.cyan}{head}{colors.normal}  "
          f"[{_STATE_COLOR.get(state, '')}{state}{colors.normal}]")
    print(f"  {colors.dim}why{colors.normal:<9}: {why}")
    rows = [
        ("uid/gid", f"{u.uid}/{u.gid}" if u.has_user else None),
        ("home", u.home),
        ("link", m.get("link")),
        ("md5", m.get("md5_sum")),
        ("info", m.get("info")),
        ("required", ", ".join(m.get("required", [])) or None),
        ("recommended", ", ".join(m.get("recommended", [])) or None),
        ("optional", ", ".join(m.get("optional", [])) or None),
        ("groups", ", ".join(m.get("install_groups", [])) or None),
        ("files", count_pkg_files(u.pkg_list)),
    ]
    for label, value in rows:
        if value is None or value == "":
            continue
        if label == "info":
            lines = [ln.strip() for ln in str(value).replace("\\n", "\n").split("\n")
                     if ln.strip()]
            if not lines:
                continue
            print(f"  {label:<12}: {lines[0]}")
            for extra in lines[1:]:
                print(f"  {'':<12}  {extra}")
        else:
            print(f"  {label:<12}: {value}")


def print_user_short(users, versions=None):
    versions = versions or {}
    width = max((len(u.name or u.search) for u in users), default=4)
    for u in users:
        name = (u.name or u.search)
        anchor = u.meta.get("name") or name
        st, _ = assess(u, versions.get(anchor), run_cmd=False)
        color = _STATE_COLOR.get(st, "")
        print(f"{name.ljust(width)}  {color}{st:<12}{colors.normal} "
              f"{u.version or ''}".rstrip())


def book_info(anchor):
    """Parse `blfs debug <anchor>` into a dict (works for any book package,
    installed or not)."""
    rc, out, _ = run_blfs(["debug", anchor])
    if rc != 0 or "resolve" in out and "not an installable" in out:
        # still return whatever fields parsed (title may be absent)
        pass
    info = {}
    for line in (out or "").splitlines():
        m = re.match(r"^([\w /]+?)\s*:\s*(.*)$", line)
        if m:
            info[m.group(1).strip()] = m.group(2).strip()
    return info or None


def print_book_info(anchor):
    """Show the book's view of a package (version, link, deps, description) --
    useful when the package isn't installed yet."""
    bi = book_info(anchor)
    if not bi or not bi.get("title"):
        return
    print(f"  {colors.dim}(from the BLFS book){colors.normal}")
    for label, key in (("book version", "title"), ("link", "link"),
                       ("md5", "md5"), ("required", "required"),
                       ("recommended", "recommended"), ("optional", "optional")):
        val = bi.get(key)
        if val and val not in ("[]", ""):
            print(f"  {label:<12}: {val}")


def _script_name_version(path):
    try:
        with open(path) as f:
            for line in f:
                # EITHER QUOTE.  Since 1.12.18 the generator emits book strings
                # SINGLE-quoted (a dollar sign in prose is not a variable), and this
                # matched only double quotes -- so _script_name_version returned None,
                # the local script never matched, and every edit a user made in
                # install_<name>-<version> was quietly ignored for the generated one.
                m = re.match(r"""\s*name_version=["']([^"']+)["']""", line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return None


def _pending_edit_conflict(home, iv, bv):
    """Would updating iv -> bv silently orphan local edits?

    `install_last` is the read-only record of the script AS IT LAST RAN;
    the canonical `install_<iv>` beside it is where edits live.  If they
    differ, the user has changes that never ran -- and the update will
    generate a fresh script for `bv` that carries none of them.  The make-ca
    systemctl edit was exactly this, and --regenerate discarding it is what
    the handoff warned about.

    Self-clearing: once a local `install_<bv>` exists in the home (the user
    merged their edits into the new version's script -- resolve_script will
    prefer it), the conflict is resolved and this answers False.  Missing
    files answer False too: with no record there is nothing to judge."""
    if not iv or not bv or iv == bv or iv == "(reinstall)":
        return False
    if os.path.isfile(os.path.join(home, f"install_{bv}")):
        return False
    canon = os.path.join(home, f"install_{iv}")
    last = os.path.join(home, "install_last")
    if not (os.path.isfile(canon) and os.path.isfile(last)):
        return False
    try:
        return open(canon, errors="replace").read() \
            != open(last, errors="replace").read()
    except OSError:
        return False


def _warn_if_wrong_file_edited(user, chosen):
    """Point out an edit made to the wrong file.

    A package user's home holds two files with nearly identical names:
        install_<name>-<version>   the source -- edit THIS one
        install_<name>             the engine's runtime copy, overwritten each run
    Editing the second is an easy mistake, and the symptom is silent: the
    install runs the unedited script and fails in exactly the same way as
    before, so it looks as though the edit was thrown away."""
    runtime = os.path.join(pkgusr_home(user), f"install_{user}")
    if not os.path.isfile(runtime):
        return
    try:
        if os.path.samefile(runtime, chosen):
            return
        if os.path.getmtime(runtime) <= os.path.getmtime(chosen):
            return                      # not edited more recently: nothing odd
    except OSError:
        return
    printWarning(f"  note: {runtime} was changed more recently than the script "
                 f"in use.")
    printWarning(f"        That file is a runtime copy and is overwritten every "
                 f"run -- edits to it are lost.")
    printWarning(f"        Edit this instead:  {chosen}")



_GENVER_RE = re.compile(r"^### generated by blfs (\S+)", re.M)

def _blfs_gen_version():
    """The generator's own version string, asked once."""
    if not hasattr(_blfs_gen_version, "_v"):
        rc, out, _ = run_blfs(["--version"])
        m = re.search(r"blfs (\S+)", out or "")
        _blfs_gen_version._v = m.group(1) if (rc == 0 and m) else None
    return _blfs_gen_version._v


def _script_is_user_edited(path):
    """Did somebody change this script after it was generated?

    The generator stamps every script and never writes it again, so an mtime
    newer than the stamp line's own file creation is the only signal there
    is.  We use a marker instead: a script the user has edited gets a
    ".edited" sibling the first time it is regenerated, and we treat the
    presence of a `# EDITED` line, or of that sibling, as "hands off".
    """
    if os.path.exists(path + ".edited"):
        return True
    try:
        with open(path) as f:
            head = f.read(4000)
    except OSError:
        return False
    return "# EDITED" in head or "# do not regenerate" in head.lower()


def _script_gen_version(path):
    try:
        head = open(path).read(400)
    except OSError:
        return None
    m = _GENVER_RE.search(head)
    return m.group(1) if m else None


def _prewarm_scripts(plan, script_dir, force_regen=False):
    """Generate every script the plan needs, in ONE blfs call.

    resolve_script generates per package, and a plan of 151 packages therefore
    ran 151 subprocesses that each loaded and indexed the whole book.  With a
    warm cache that is a fifth of a second each; on a fresh system, where the
    first call INDEXES the book, it is the difference between a wait and a
    hang -- and it looked like a hang, because the only output was one
    "-- regenerating" line per package with minutes of silence between them.

    Nothing else changes: this writes the same files into the same directory,
    and resolve_script then finds them cached.  A local script in a package
    user's home still wins; those are not touched here.
    """
    wanted = []
    for anchor, nv, _reason in plan:
        local = os.path.join(pkgusr_home(pkgusr_name(anchor)), f"install_{nv}")
        if os.path.isfile(local) and not force_regen:
            continue                                  # the user's own copy wins
        cached = os.path.join(script_dir, f"install_{nv}")
        if not force_regen and os.path.isfile(cached) \
                and _script_name_version(cached) == nv:
            _cv, _gv = _script_gen_version(cached), _blfs_gen_version()
            if not (_cv and _gv and _cv != _gv):
                continue                              # current, keep it
        wanted.append(anchor)
    if len(wanted) < 2:
        return                                        # nothing to gain
    printInfo("  generating %d install script(s) from the book "
              "(one pass) ..." % len(wanted))
    os.makedirs(script_dir, exist_ok=True)
    rc, out, err = run_blfs(["script"] + wanted + ["-o", script_dir])
    made = len(re.findall(r"^Created ", out, re.M))
    if rc != 0 and made == 0:
        # not fatal: resolve_script will generate them one at a time, as before
        printWarning("  could not generate them in one pass (%s); "
                     "falling back to one at a time"
                     % (err or out).strip().splitlines()[-1:] or "no output")
        return
    printInfo("  %d written" % made)


def _stop_if_prereqs_missing(args):
    """A plan that cannot finish should not start.

    Warning and building anyway is how a missing cmake got found twenty-two
    packages deep, after the warning had already scrolled off.  The check is
    exact -- these are the scripts' own guards and their own command words --
    so stopping is safe, and --ignore-prereqs is there for the case where it
    is wrong.
    """
    if not (_MISSING_TOOLS or _MISSING_ENV):
        return
    if not getattr(args, "run", False):
        return                       # a dry run is allowed to show the plan
    if getattr(args, "ignore_prereqs", False):
        printWarning("  --ignore-prereqs: starting anyway; the packages above"
                     " will fail where they need what is missing.")
        return
    printError("Not starting: this plan is missing what %d of its packages"
               " need." % len({p for v in list(_MISSING_TOOLS.values())
                               + list(_MISSING_ENV.values()) for p in v}))
    # SAY WHEN THE PACKAGE IS THERE AND ONLY THE TOOL IS NOT FOUND.
    for _t in sorted(_MISSING_TOOLS):
        _prov = _provider_of(_t)
        if _prov and gather_user(_prov).state == "installed":
            printInfo("  NOTE: %s is installed, so `%s` exists but is not on"
                      " PATH here." % (_prov, _t))
            printInfo("        BLFS puts it outside /usr (e.g. /opt/%s/bin)"
                      " and adds it in" % _prov)
            printInfo("        /etc/profile.d -- which a login shell reads and"
                      " this one did not.")
            printInfo("        Check:  bash -lc 'command -v %s'" % _t)
    printInfo("  Fix the lines above, then run the same command again --"
              " finished packages are skipped.")
    printInfo("  To start regardless:  --ignore-prereqs")
    sys.exit(1)


def _report_ignored_required(steps):
    """A package in the plan whose REQUIRED dependency is being ignored.

    webkitgtk requires Ruby; the stack's avoid list contains ruby; so the plan
    left out a hard requirement of a package the user asked for, and cmake
    said "Ruby 2.5 or higher is required" after an hour of building.  Skipping
    an avoided branch is right (1.14.24) -- doing it without a word, when the
    thing skipped is REQUIRED by something being built, is not.
    """
    if not _IGNORED_REQUIRED:
        return
    _in = {a.lower() for a, _n, _r, _p in steps}
    pairs = [(w, d) for w, d in _IGNORED_REQUIRED if w.lower() in _in]
    if not pairs:
        return
    print()
    printWarning("%d package(s) in this plan REQUIRE something the ignore list"
                 " excludes:" % len(pairs))
    for w, d in pairs:
        printWarning("  %-20s requires %s, which is ignored" % (w, d))
    printWarning("  They will fail where they need it.  Either drop it from the")
    printWarning("  ignore list (in the stack file, or --ignore), or install it:")
    printWarning("    packagemanager install %s --run --recursive"
                 % " ".join(sorted({d for _w, d in pairs})))
    print()


def _report_cycles(steps):
    """Name the packages a dependency cycle forces out of order.

    vala recommends graphviz; graphviz -> gegl -> babl -> librsvg -> vala
    closes the loop, so one recommended edge has to give and vala is built
    first -- without graphviz, and (for vala) with configure stopping on
    "Package 'libgvc' not found".  There is no order that satisfies a cycle;
    what there is, is a rebuild afterwards, and the person can only ask for it
    if they are told.
    """
    if not _CYCLE_PAIRS:
        return
    # Only the direction that ACTUALLY happened.  The breaker drops both
    # edges of a two-package cycle, so freetype2/harfbuzz was reported in both
    # directions and one of the two lines was always false.  The final order
    # decides which one is true.
    _pos = {a.lower(): i for i, (a, _n, _r, _p) in enumerate(steps)}
    _pairs = [(a, d) for a, d in _CYCLE_PAIRS
              if a.lower() in _pos and d.lower() in _pos
              and _pos[a.lower()] < _pos[d.lower()]]
    if not _pairs:
        return
    print()
    printWarning("%d package(s) are built before something they recommend"
                 " (a dependency cycle):" % len(_pairs))
    for a, d in _pairs:
        printWarning("  %-16s is built before %s" % (a, d))
    printWarning("  That is unavoidable -- the recommendation runs both ways."
                 "  They build")
    printWarning("  without the optional feature; rebuild afterwards if you"
                 " want it:")
    printWarning("    packagemanager install %s --run --reinstall"
                 % " ".join(sorted({a for a, _d in _pairs})))
    print()


def _report_missing_env():
    """One block naming every variable the plan's scripts will refuse without.

    Reported per package this was one to three lines each: in a 151-package
    plan the same XORG_PREFIX notice appeared dozens of times, scrolled past,
    and the run stopped on it seventeen packages in.
    """
    if not _MISSING_ENV:
        return
    print()
    printWarning("This plan cannot finish: %d build variable(s) are not set."
                 % len(_MISSING_ENV))
    for name in sorted(_MISSING_ENV):
        users = _MISSING_ENV[name]
        printWarning("  %-14s needed by %d package(s), first: %s"
                     % (name, len(users), users[0]))
    printWarning("  Set them once -- they apply to every build:")
    for name in sorted(_MISSING_ENV):
        printWarning("    packagemanager env --set %s=%s"
                     % (name, _ENV_SUGGESTIONS.get(name, "...")))
    printWarning("  (exporting them in your shell does not reach a package"
                 " user; %s does)" % BUILD_ENV_FILE)
    print()


def _report_missing_tools():
    """One block, under the plan, naming every build-system driver the plan's
    own commands call and this system does not have."""
    _report_missing_env()
    if not _MISSING_TOOLS:
        return
    print()
    printWarning("This plan cannot finish: %d build tool(s) are missing."
                 % len(_MISSING_TOOLS))
    for tool in sorted(_MISSING_TOOLS):
        users = _MISSING_TOOLS[tool]
        printWarning("  %-8s needed by %d package(s), first: %s"
                     % (tool, len(users), users[0]))
    _provs = sorted({p for p in (_provider_of(t) for t in _MISSING_TOOLS) if p})
    if _provs:
        printWarning("  Install them first, with their own dependencies:")
        printWarning("    packagemanager install %s --run --recursive"
                     % " ".join(_provs))
    _noprov = sorted(t for t in _MISSING_TOOLS if not _provider_of(t))
    if _noprov:
        printWarning("  No BLFS page provides %s -- these come from LFS;"
                     % ", ".join(_noprov))
        printWarning("  check they were built and are on PATH.")
    print()


def resolve_script(user, name_version, script_dir, assume_yes=False,
                   force_regen=False):
    """Path to the install script to use for `user`.

    By default, if the package user's home has the canonical, edited script
    'install_<name_version>', that LOCAL one is used (so your edits are kept) and
    we say so.  'install_last' (a read-only record) and 'install_<user>' (the
    engine's runtime copy) are never treated as sources.  --regenerate forces a
    fresh build from the book."""
    local = os.path.join(pkgusr_home(user), f"install_{name_version}")
    # A STALE SCRIPT IS REFRESHED, NOT JUST REPORTED.
    #
    # Telling the user to pass --regenerate has cost several rounds each on
    # brotli, rust, xcb-utilities and ffmpeg: the fix existed, the warning
    # printed, and the build still ran the old script -- because spotting one
    # warning in a 200-package plan and acting on it per package is not a
    # reasonable thing to ask.  A script older than the generator and NOT
    # edited by the user is simply regenerated below.
    _stale_unedited = False
    if os.path.isfile(local):
        _lgv, _cgv = _script_gen_version(local), _blfs_gen_version()
        _stale_unedited = bool(_lgv and _cgv and _lgv != _cgv
                               and not _script_is_user_edited(local))
        if _stale_unedited:
            printWarning(f"  {os.path.basename(local)}: generated by blfs "
                         f"{_lgv}, this is {_cgv} -- regenerating")
    if (not force_regen and not _stale_unedited and os.path.isfile(local)
            and _script_name_version(local) == name_version):
        printInfo(f"  using LOCAL script (your edits, not the book): {local}")
        _warn_if_wrong_file_edited(user, local)
        try:
            body = open(local).read()
        except OSError:
            body = ""
        # a real build script has the phased functions or actual build commands;
        # warn if it looks like a stub so a "reinstall that does nothing" is obvious
        if ("unpack_pkg" not in body and "build_pkg" not in body
                and not re.search(r"\b(make|ninja|meson|cmake|configure)\b", body)):
            printWarning(f"  ^ this script has no build commands -- it may be a "
                         f"stub. If a reinstall does nothing, rebuild it from the "
                         f"book with --regenerate.")
        else:
            printInfo(f"  -- pass --regenerate to rebuild {name_version} from the book")
        # A SCRIPT FROM AN OLDER GENERATOR CARRIES THE OLD BUGS.
        #
        # brotli failed twice on the same `pip3 install --find-links dist`
        # after the generator had been fixed: the local script was written by
        # the previous blfs, resolve_script prefers it, and the only notice
        # was a one-line hint that is easy to miss in a 200-package run.
        # Say it loudly, and offer the command that fixes it.
        # A STALE SCRIPT IS REFRESHED, NOT JUST REPORTED.
        #
        # Telling the user to pass --regenerate has now cost several rounds
        # each on brotli, rust, xcb-utilities and ffmpeg: the fix existed,
        # the message was printed, and the build still ran the old script --
        # because noticing one warning in a 200-package plan and acting on it
        # per package is not a reasonable thing to ask.
        #
        # A script older than the generator is regenerated automatically.
        # Nothing is lost: if the file differs from what the generator
        # produces, the old one is kept as .edited (1.13.4) and named here.
        _lg, _cg = _script_gen_version(local), _blfs_gen_version()
        if _lg and _cg and _lg != _cg:
            printWarning(f"  ^ generated by blfs {_lg}; the generator is now "
                         f"{_cg}, and this file has YOUR EDITS -- keeping it")
            printWarning(f"    to take the newer generator instead (your copy "
                         f"is saved as install_{name_version}.edited):")
            printWarning(f"      packagemanager install {user} --run --regenerate")
        # THE OPTIONS APPLY TO A LOCAL SCRIPT TOO.
        #
        # They were merged only when a script was GENERATED, so a package
        # whose script already sat in its home -- every package that has
        # failed once -- was reused untouched, and libassuan kept building
        # its TeX manual with the fix sitting in package-fixes.conf.  The
        # merge is idempotent, so applying it on every resolve is safe.
        apply_machine_opts(user, local)
        # THE CHECKS BELONG TO EVERY PATH OUT OF HERE.
        #
        # They were on the generate path (1.14.9 added the cache path), and a
        # script already sitting in the package user's home returned before
        # either -- which is EVERY package that has been attempted once.  So a
        # plan whose libaom needed a missing cmake said nothing, built
        # twenty-two other packages, and then stopped exactly where the check
        # would have pointed.
        _check_script_prereqs(user, local)
        return local

    # reuse a script a PRIOR DRY-RUN already generated into script_dir, so a
    # follow-up --run doesn't regenerate all of them (version-keyed = safe).
    cached = os.path.join(script_dir, f"install_{name_version}")
    if (not force_regen and os.path.isfile(cached)
            and _script_name_version(cached) == name_version):
        # "version-keyed = safe" was only half true: it caught a moved BOOK,
        # not a moved GENERATOR.  A pre-fix cached docbook-xsl script ran the
        # optional doc block a newer blfs comments out.  A cache from an
        # older generator is regenerated.
        _cv, _gv = _script_gen_version(cached), _blfs_gen_version()
        if _cv and _gv and _cv != _gv:
            printInfo(f"  cached script is from blfs {_cv}, this is {_gv} "
                      f"-- regenerating")
        else:
            _check_script_prereqs(user, cached)
            return cached

    rc, out, err = run_blfs(["script", user, "-o", script_dir])
    m = re.search(r"^Created (.+)$", out, re.M)
    if rc != 0 or not m:
        printError(f"{name_version}: blfs script failed -- {(err or out).strip()}")
        return None
    path = m.group(1).strip()
    # the machine's options, merged the moment the script is born
    apply_machine_opts(user, path)
    _check_script_prereqs(user, path)
    return path



# --------------------------------------------------------------------------- #
# machine option overrides
# --------------------------------------------------------------------------- #
# The BOOK decides how a package is built; the MACHINE decides its options.
# Mesa's gallium drivers belong to the GPU in the case, not to the stack file
# or the book -- so /etc/pkgusr/stacks/machine.conf carries them:
#
#     [mesa]
#     gallium-drivers = radeonsi
#     vulkan-drivers  = amd
#
# Every key of an [anchor] section is merged into the generated script's
# `meson setup` line as -Dkey=value -- an existing -Dkey is replaced, a new
# one is appended right after `meson setup`.  Only meson for now (cmake
# pending); only freshly generated scripts are touched, and the change makes
# the script a LOCAL edit, which resolve_script then deliberately keeps.

MACHINE_CONF = "/etc/pkgusr/stacks/machine.conf"

# Two files, and the difference matters.
#
#   package-fixes.conf -- workarounds the TOOLS ship (cairo's ctime_r,
#                         libassuan's TeX manual).  Refreshed with the other
#                         stack files, so a fix reaches an existing system.
#   machine.conf       -- the MACHINE'S own choices (mesa's drivers).  Never
#                         overwritten, and it wins where both mention a key.
#
# They were one file, which meant a workaround shipped in machine.conf could
# never arrive anywhere: the sync refuses to overwrite it, correctly, because
# it is the user's.  libassuan kept failing on a fix that was in the release
# and not on the system.
PACKAGE_FIXES = "/etc/pkgusr/stacks/package-fixes.conf"


def _read_conf_section(path, anchor):
    if not os.path.isfile(path):
        return {}
    import configparser
    # strict=False: A REPEATED SECTION IS NOT A BROKEN FILE.
    #
    # Appending the same block twice -- exactly what `cat >> machine.conf`
    # does when a recipe is followed twice -- made configparser raise, and
    # this discarded the ENTIRE file.  So [webrtc-audio-processing] did
    # nothing, and so did [mesa]: the driver selection quietly reverted to
    # "build everything" because of a duplicate heading further down.  One
    # typo disabling every option in the file is not a proportionate answer.
    # Later keys win, which is what someone appending a correction expects.
    cp = configparser.ConfigParser(strict=False)
    # CMAKE VARIABLES ARE CASE-SENSITIVE.
    #
    # configparser lower-cases keys by default, so
    #     [webkitgtk]
    #     ENABLE_JOURNALD_LOG = OFF
    # reached cmake as -Denable_journald_log=OFF -- a different variable,
    # which cmake accepted and ignored, and webkitgtk went on building
    # against systemd/sd-journal.h on a system that has no systemd.  meson's
    # options are lower-case anyway, which is why this went unnoticed for as
    # long as the file only held [mesa].
    cp.optionxform = str
    try:
        cp.read(path)
    except configparser.Error as e:
        printWarning(f"{os.path.basename(path)} is broken ({e})")
        printWarning("  NO options from that file were applied -- not for this"
                     " package and not for any other.")
        printWarning(f"  Fix it and re-run:  {path}")
        return {}
    for sect in cp.sections():
        if sect.lower() == anchor.lower():
            return dict(cp[sect])
    return {}


def _machine_opts_for(anchor):
    opts = _read_conf_section(
        os.environ.get("PM_PACKAGE_FIXES", PACKAGE_FIXES), anchor)
    opts.update(_read_conf_section(
        os.environ.get("PM_MACHINE_CONF", MACHINE_CONF), anchor))
    return opts


_ENV_GUARD_RE = re.compile(r'needs ([A-Z][A-Z0-9_]{2,}) to be set')

def _warn_unset_env(anchor, script_path):
    """Say it BEFORE the build, not in the log afterwards.

    The generated script refuses if a variable the book expects is unset --
    but it refuses after unpacking, patching and configuring, with the
    failure buried in a log.  The script is generated here, so the question
    can be asked here: which variables does it need, and are they set?

    Applies to every package, not just TeX Live: whatever the book expects
    the user to export, this finds it the moment the script exists."""
    try:
        body = open(script_path, encoding="utf-8", errors="replace").read()
    except OSError:
        return
    # SET WHERE THE BUILD LOOKS, NOT WHERE WE HAPPEN TO BE.
    #
    # This asked os.environ only, so after `packagemanager env --set
    # XORG_CONFIG=...` -- which writes /etc/pkgusr/build.env and IS what the
    # build reads -- every Xorg package in the plan was still announced as
    # missing it.  And the advice it gave, `export`, is the one thing that
    # does NOT work: builds run as the package user through `su -`, which
    # drops the caller's environment.  A warning that is wrong and then
    # recommends the wrong cure teaches people to ignore warnings.
    _build_env = _read_build_env()
    missing = [n for n in dict.fromkeys(_ENV_GUARD_RE.findall(body))
               if not (_build_env.get(n) or os.environ.get(n))]
    if not missing:
        return
    # once per VARIABLE, like the build tools -- the rest goes in the summary
    fresh = [n for n in missing if n not in _MISSING_ENV]
    for n in missing:
        _MISSING_ENV.setdefault(n, []).append(anchor)
    if not fresh:
        return
    printWarning("%s needs %s set before it can build:"
                 % (anchor, ", ".join(fresh)))
    for n in fresh:
        _sugg = _ENV_SUGGESTIONS.get(n)
        printWarning("    packagemanager env --set %s=%s" % (n, _sugg or "...")
                     + ("" if _sugg else "    (the book's page for %s says what)"
                        % anchor))
    printWarning("  that writes %s, which every build reads;" % BUILD_ENV_FILE)
    printWarning("  exporting it in your shell does not reach a package user.")
    printWarning("  the build will stop at that check rather than configure with"
                 " an empty value")


# A build-system driver the script CALLS but the page never lists.  libheif's
# BLFS page has no Required section at all: CMake reaches it only through
# x265, so on a system where x265 was already installed nothing pulled cmake
# into the plan, and the build died 33 lines in with
#     install_libheif: line 33: cmake: command not found
# after three other packages had been built.  The dependency list is the
# book's opinion; the COMMANDS are the fact, and they are right here.
_MISSING_TOOLS = {}          # tool -> [packages in this plan that call it]
_MISSING_ENV = {}            # variable -> [packages in this plan that need it]
_CYCLE_PAIRS = []            # (dependant, dependency) the cycle forced out of order
_IGNORED_REQUIRED = []       # (wanted package, its REQUIRED dep that is ignored)

# tool -> the BLFS ANCHOR that provides it.  These are checked against the
# book at use time (_provider_in_book), because a suggestion naming a package
# the book does not have is the 1.14.10 mistake again: `cargo` was reported
# with "packagemanager install rustc --run --recursive", and the book's anchor
# is `rust`, so the command would have answered "not in the book".
# Meson, Ninja, gperf and libtool are LFS packages, not BLFS ones -- they have
# no anchor here, and are reported without a command rather than a wrong one.
_BUILD_TOOLS = {
    "cmake": "cmake", "scons": "scons", "qmake6": "qt6",
    "cargo": "rust", "rustc": "rust",
    "ant": "apache-ant", "b2": "boost", "bjam": "boost",
    "itstool": "itstool", "xsltproc": "libxslt", "doxygen": "doxygen",
    "valac": "vala", "node": "nodejs", "npm": "nodejs", "rake": "ruby",
    "yasm": "yasm", "nasm": "nasm",
    # a stack entry of kind=git clones with it; nothing in the book's command
    # text mentions it, so only the tool map can catch it before the build
    "git": "git",
    # no BLFS anchor: LFS builds these, or the book has no page
    "meson": "", "ninja": "", "gperf": "", "libtoolize": "",
    "autoreconf": "", "go": "", "mvn": "", "gradle": "", "qmake": "",
}


_TOOL_SEEN = {}


def _tool_available(tool):
    """Is the tool there FOR THE BUILD -- not just for us?

    `shutil.which` reads OUR PATH.  A build runs through `su -`, a LOGIN
    shell, which reads /etc/profile and /etc/profile.d -- and that is exactly
    where BLFS puts the packages it installs outside /usr:

        /opt/rustc/bin      (rustc.sh)      -> cargo, rustc
        /opt/qt6/bin        (qt6.sh)        -> qmake6

    So Rust was installed, cargo was on the build's PATH, and this reported
    it missing and refused to start.  Worse, the plan could not repair it:
    rust WAS installed, so adding it changed nothing and the same stop came
    back on the second pass -- the loop the user saw.

    Asked the way the build will ask.
    """
    if tool in _TOOL_SEEN:
        return _TOOL_SEEN[tool]
    found = bool(shutil.which(tool))
    if not found:
        try:
            found = subprocess.run(["bash", "-lc", "command -v " + shlex.quote(tool)],
                                   capture_output=True, timeout=20).returncode == 0
        except (OSError, subprocess.SubprocessError):
            found = False
    if not found:
        found = any(os.access(os.path.join(d, tool), os.X_OK)
                    for d in glob.glob("/opt/*/bin"))
    _TOOL_SEEN[tool] = found
    return found


def _build_tools_used(script_path):
    """The build-system drivers a script's own commands call."""
    try:
        body = open(script_path, encoding="utf-8", errors="replace").read()
    except OSError:
        return []
    used = []
    for line in body.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        word = line.split()[0]
        while word in ("env", "sudo", "nice", "time") and len(line.split()) > 1:
            line = line.split(None, 1)[1]
            word = line.split()[0]
        if "/" in word or word not in _BUILD_TOOLS or word in used:
            continue
        used.append(word)
    return used


def _order_by_build_tools(steps):
    """Build a package AFTER the tool its commands call.

    The dependency graph is the book's, and the book does not say that libaom
    builds with cmake -- libaom's page lists no Required at all.  So a plan
    could contain BOTH, correctly, and still schedule libaom at position 89
    and CMake at 151, and stop at 89 with `cmake: command not found`.  The
    resolver was right; it was ordering on the wrong facts.

    The CONSUMER moves down to just after its provider, never the provider up:
    moving a package later keeps every dependency it already has in front of
    it, while moving one earlier could jump it over its own.
    """
    if not steps:
        return steps, []
    moved = []
    for _round in range(len(steps)):          # bounded: each pass fixes >= 1
        index = {}
        for i, (anchor, nv, _r, _p) in enumerate(steps):
            index[anchor.lower()] = i
            index[nv.lower()] = i
            index[nv.rsplit("-", 1)[0].lower()] = i
        for i, (anchor, nv, reason, path) in enumerate(steps):
            for tool in _build_tools_used(path):
                if _tool_available(tool):
                    continue                  # already on the system
                j = index.get((_BUILD_TOOLS.get(tool) or "").lower())
                if j is None or j <= i:
                    continue                  # absent, or already earlier
                steps.insert(j + 1, steps.pop(i))
                moved.append((nv, steps[j][1], tool))
                break
            else:
                continue
            break
        else:
            break
    return steps, moved


def _provider_of(tool):
    """The BLFS package that provides a tool, if the book actually has one."""
    name = _BUILD_TOOLS.get(tool) or ""
    if not name:
        return ""
    try:
        return name if book_version(name) else ""
    except Exception:
        return ""


def _install_cmd_for(tool):
    prov = _provider_of(tool)
    if prov:
        return "packagemanager install %s --run --recursive" % prov
    return ""


def _warn_missing_build_tools(anchor, script_path):
    """Name the tool the build will die on, before the build starts."""
    try:
        body = open(script_path, encoding="utf-8", errors="replace").read()
    except OSError:
        return []
    missing = []
    # A CLONE IS NOT A COMMAND IN THE SCRIPT.
    #
    # `is_git="1"` tells the runner to clone $link, so `git` never appears in
    # the command text and the scan could not see it.  elogind's entry died on
    # `git: command not found` after the account had been created and the
    # phase started.
    if re.search(r'^is_git=[\'"]?1', body, re.M) and not _tool_available("git"):
        missing.append("git")
    for line in body.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # the command word: skip env prefixes and anything path-qualified
        # (./configure is the package's own, not something to install)
        word = line.split()[0]
        while word in ("env", "sudo", "nice", "time") and len(line.split()) > 1:
            line = line.split(None, 1)[1]
            word = line.split()[0]
        if "/" in word or word not in _BUILD_TOOLS:
            continue
        if _tool_available(word) or word in missing:
            continue
        missing.append(word)
    if not missing:
        return []
    # ONCE PER TOOL, not once per package: a 151-package plan would otherwise
    # print the same three lines about cmake thirty-seven times, and a warning
    # repeated thirty-seven times is scrollback, not a warning.  The rest are
    # collected for the summary below the plan.
    for w in missing:
        first = w not in _MISSING_TOOLS
        _MISSING_TOOLS.setdefault(w, []).append(anchor)
        if not first:
            continue
        printWarning("%s builds with `%s`, which is not installed:" % (anchor, w))
        # --recursive, ALWAYS.  A tool from the book has its own tree, and
        # `packagemanager install cmake --run` builds cmake alone, which then
        # fails at "CMAKE_USE_SYSTEM_CURL is ON but a curl is not found" --
        # cURL is one of its four recommended deps.  A suggested command that
        # does not work is worse than no suggestion, which is also why a tool
        # with no BLFS page gets no command at all.
        _cmd = _install_cmd_for(w)
        printWarning("    " + (_cmd if _cmd else
                     "(no BLFS page provides `%s` -- it comes from LFS; "
                     "check it is built and on PATH)" % w))
        printWarning("  (the book's page does not list it as a dependency, so"
                     " the plan cannot know -- its own commands do)")
    return missing


def _check_script_prereqs(anchor, script_path):
    """Everything knowable from a script before it runs.

    Called for a script whether it was just generated or came from the cache:
    the checks belong to USING a script, not to writing one, and pre-generating
    a whole plan in one pass (1.14.8) would otherwise have skipped them.
    """
    _warn_unset_env(anchor, script_path)
    _warn_missing_build_tools(anchor, script_path)


def _insert_on_command(body, cmd, arg):
    """Add an argument to the first REAL invocation of `cmd`, skipping
    comments -- a book NOTE that mentions the command by name is prose."""
    out, done = [], False
    for line in body.split("\n"):
        if (not done and not line.lstrip().startswith("#")
                and re.search(r"(?:^|\s|&&|;)%s\b" % re.escape(cmd), line)):
            line = re.sub(r"(%s)\b" % re.escape(cmd), r"\1 " + arg, line, count=1)
            done = True
        out.append(line)
    return "\n".join(out)


def apply_machine_opts(anchor, script_path):
    """Merge machine.conf's [anchor] options into the script's meson line."""
    opts = _machine_opts_for(anchor)
    if not opts or not script_path or not os.path.isfile(script_path):
        return
    try:
        body = open(script_path).read()
    except OSError:
        return
    # AUTOTOOLS TOO.  This only knew `meson setup`, so a package built with
    # ./configure had no way to take a machine option -- and libassuan needs
    # one: its `make` builds a PDF manual that wants TeX, which this system
    # deliberately does not have.  configure_args is appended to the
    # ./configure line; every other key stays a meson -Dkey=value.
    # `needs` is for the DEPENDENCY GRAPH, not the build command.  blfs reads
    # it from the same file (1.13.69) to add an edge the book omits; this
    # function turns every remaining key into -Dkey=value, so it passed
    # `-Dneeds=glslang` to meson and mesa died with
    #     ERROR: Unknown option: "needs".
    # One file, two readers: each must ignore what belongs to the other.
    opts.pop("needs", None)
    # ...and REMOVE it if an earlier version already wrote it into the script.
    # 1.13.69 stopped adding -Dneeds=, but every script generated while the
    # bug existed still carries it, and merging is idempotent so nothing took
    # it out again.  A key that is not a build option has no business on a
    # meson line, whoever put it there.
    if "-Dneeds=" in body:
        body = re.sub(r"\s*-Dneeds=\S+", "", body)
        with open(script_path, "w") as f:
            f.write(body)
        printInfo("  removed a stale -Dneeds= from %s (it is a dependency "
                  "key, not a build option)" % os.path.basename(script_path))
    # WRAP MODE, PER PACKAGE.
    #
    # blfs adds --wrap-mode=nofallback to every `meson setup` so a package
    # cannot silently build and install a bundled copy of a dependency (cairo
    # once installed its own freetype that way, and the planner then thought
    # freetype2 was done).  For a package whose subproject is NOT a BLFS
    # package at all, that flag is fatal instead of protective:
    #     gegl: ERROR: Dependency 'libnsgif' is required but not found.
    #           Use of fallback dependencies is disabled.
    # libnsgif and poly2tri-c have no book page; the fallback is the only way
    # to get them.  So the flag stays the default and becomes overridable:
    #     [gegl]
    #     wrap_mode = default
    # NINJA DOES NOT READ MAKEFLAGS.
    #
    # WebKitGTK's page: "some source files require more than 4 GiB of RAM to
    # be built ... you should pass -j<N> to ninja (N = RAM / 4 GiB) to avoid
    # the job being killed by the kernel OOM killer".  MAKEFLAGS cannot do
    # that -- ninja ignores it and defaults to nproc+2 -- so there was no way
    # to follow the book's advice short of editing the script by hand, and
    # the failure it prevents arrives hours in, as a killed compiler.
    _jobs = opts.pop("jobs", None)
    if _jobs:
        _nb = re.sub(r"(?m)^(\s*ninja\b(?![^\n]*\s-j))",
                     r"\1 -j" + str(_jobs).lstrip("-j"), body)
        if _nb != body:
            body = _nb
            with open(script_path, "w") as f:
                f.write(body)
            printInfo("  machine.conf [%s]: ninja -j%s" % (anchor, _jobs))
    _wrap = opts.pop("wrap_mode", None)
    if _wrap:
        if "meson setup" not in body:
            printWarning("  machine.conf has [%s] wrap_mode but the script has"
                         " no `meson setup` line -- not applied" % anchor)
        else:
            new_body = re.sub(r"--wrap-mode=\S+", "--wrap-mode=" + _wrap, body)
            if new_body == body:            # none there yet: add one
                new_body = re.sub(r"(\bmeson\s+setup\b)",
                                  r"\1 --wrap-mode=" + _wrap, body, count=1)
            if new_body != body:
                body = new_body
                with open(script_path, "w") as f:
                    f.write(body)
                printInfo("  machine.conf [%s]: wrap-mode %s" % (anchor, _wrap))
    _conf_args = opts.pop("configure_args", None)
    if _conf_args:
        if "./configure" not in body:
            printWarning("  machine.conf has [%s] configure_args but the script"
                         " has no ./configure line -- not applied" % anchor)
        else:
            if _conf_args in body:
                pass                      # already applied; merging is idempotent
            else:
                # AN --enable-X MUST BEAT THE BOOK'S --disable-X.
                #
                # configure_args was PREPENDED, and autoconf takes the last
                # occurrence: `[iptables] configure_args = --enable-nftables`
                # produced
                #     ./configure --enable-nftables --prefix=/usr \
                #                 --disable-nftables ...
                # so the book's flag won and the option silently did nothing.
                # Drop the opposite form of each flag we are adding first.
                # ...line by line, so a continuation that held nothing but
                # the removed flag goes with it.  Deleting just the token left
                #     ./configure --enable-nftables --prefix=/usr      \ \
                # -- a backslash-escaped space, which is an argument.
                for _flag in _conf_args.split():
                    _m = re.match(r"^--(enable|disable|with|without)-(.+)$", _flag)
                    if not _m:
                        continue
                    _opp = {"enable": "disable", "disable": "enable",
                            "with": "without", "without": "with"}[_m.group(1)]
                    _pat = re.compile(r"--%s-%s\b[^\s\\]*"
                                      % (_opp, re.escape(_m.group(2))))
                    _out = []
                    for _line in body.split("\n"):
                        if not _pat.search(_line):
                            _out.append(_line)
                            continue
                        _stripped = _pat.sub("", _line)
                        if _stripped.strip() in ("", "\\"):
                            continue          # the line was only that flag
                        _out.append(_stripped)
                    body = "\n".join(_out)
                body = re.sub(r"(\./configure\b)", r"\1 " + _conf_args, body, count=1)
            if _conf_args not in open(script_path).read():
                with open(script_path, "w") as f:
                    f.write(body)
                printInfo("  machine.conf [%s]: configure %s" % (anchor, _conf_args))
        if not opts:
            return
    # CMAKE TAKES -D OPTIONS TOO.
    #
    # This only knew `meson setup`, so for a cmake package it printed
    #     machine.conf has [webkitgtk] but the script has no `meson setup`
    #     line -- options NOT applied
    # and the person had nowhere to put -D ENABLE_SPELLCHECK=OFF.  Both build
    # systems take -Dkey=value; only the command word differs.  (autotools is
    # already handled above, by configure_args.)
    _anchor_cmd = "meson setup" if "meson setup" in body else (
        "cmake" if re.search(r"^\s*cmake\b", body, re.M) else "")
    if not _anchor_cmd:
        printWarning(f"  machine.conf has [{anchor}] but the script has no "
                     f"`meson setup` or `cmake` line -- options NOT applied")
        printWarning("  (an autotools package takes configure_args instead)")
        return
    new = body
    applied = []
    for k, v in opts.items():
        # `-D key=value` WITH A SPACE is how the book writes them.
        #
        # This matched only "-Dkey=", so the book's own `-D gallium-drivers=auto`
        # was left in place and OUR value was merely prepended -- and meson
        # takes the LAST occurrence.  mesa built for every driver instead of
        # radeonsi and then failed on a dependency it should never have wanted:
        #     ERROR: Dependency "libdrm_intel" not found
        # A VALUE WITH A SPACE IS ONE VALUE.
        #
        # The fix for the commonest GCC-15 breakage is
        #     [webrtc-audio-processing]
        #     cpp_args = -include cstdint
        # and this pasted it in unquoted, so the shell split it and meson saw
        # `-Dcpp_args=-include` plus a stray `cstdint`.  Every option here that
        # takes a flag LIST -- c_args, cpp_args, c_link_args -- has this shape;
        # the single-word examples in the help text hid it.
        _v = v if not re.search(r"\s", v) else "'%s'" % v.replace("'", "'\\''")
        pat = re.compile(r"-D\s*%s\s*=(?:'[^']*'|\S+)" % re.escape(k))
        if pat.search(new):
            new = pat.sub("-D%s=%s" % (k, _v), new)
        else:
            # ...and put it on the COMMAND, not in the first line that happens
            # to contain the word.  WebKitGTK's page opens with a NOTE
            # mentioning "the cmake command", so every option landed inside
            # that comment and none of them reached the build.
            new = _insert_on_command(new, _anchor_cmd, "-D%s=%s" % (k, _v))
        applied.append("%s=%s" % (k, v))
    if new != body:
        with open(script_path, "w") as f:
            f.write(new)
        printInfo("  machine.conf [%s]: %s" % (anchor, ", ".join(applied)))


def _which_program(prog):
    """Does an executable `prog` exist (PATH or the usual bindirs)?"""
    if not prog:
        return None
    if "/" in prog:
        return prog if os.access(prog, os.X_OK) else None
    for d in os.environ.get("PATH", "").split(":") + [
            "/usr/bin", "/usr/sbin", "/bin", "/sbin", "/usr/local/bin"]:
        p = os.path.join(d, prog)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def _find_library(lib):
    """Does a shared library `lib` exist in the usual lib dirs?"""
    if not lib:
        return None
    if "/" in lib:
        return lib if os.path.exists(lib) else None
    for d in ("/usr/lib", "/usr/lib64", "/lib", "/lib64", "/usr/local/lib",
              "/usr/libexec"):
        p = os.path.join(d, lib)
        if os.path.exists(p):
            return p
    return None


_STACK_TARGETS = None      # name -> (prog, have) from every stack file, once
_STACK_TARGET_SOURCE = {}  # name -> the stack file the declaration came from


def _stack_declared_targets():
    """What every git/tar entry in every stack file says proves it installed.

    A stack entry's `prog=` and `have=` are its own statement of what to
    check.  Until 1.14.87 they were not carried into the generated script, and
    install_last -- the record of the script AS IT RAN -- keeps whatever it
    was given at the time.  Reading the stack files directly means verify
    checks the right thing for an entry built under any version, without
    rewriting a record.  Read once per run; a dozen small files.
    """
    global _STACK_TARGETS
    if _STACK_TARGETS is not None:
        return _STACK_TARGETS
    out = {}
    dirs = [os.environ.get("PM_STACK_DIR") or "/etc/pkgusr/stacks",
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "stacks")]
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for f in names:
            if not f.endswith(".stack"):
                continue
            try:
                rows = _parse_stack_file(os.path.join(d, f))
            except (OSError, ValueError):
                continue
            for r in rows:
                if r.get("kind") not in ("git", "tar"):
                    continue
                o = r["opts"]
                if not (o.get("prog") or o.get("have")):
                    continue
                # ALL declarations, not the first: the user's stack in
                # /etc/pkgusr/stacks is never overwritten (1.14.58), so a
                # corrected prog=/have= shipped in a newer stack sits in a
                # .new file beside it -- and the first-found rule meant the
                # stale one always won, and the user was asked to hand-merge
                # a metadata fix.  Read every copy; prefer the one whose
                # proof is actually on disk.
                out.setdefault(r["target"], []).append(
                    (o.get("prog", ""), o.get("have", ""), os.path.join(d, f)))
        # the .new files a protected install leaves beside the user's copies
        # carry the shipped fixes; they count as declarations too
        for f in names:
            if not f.endswith(".stack.new"):
                continue
            try:
                rows = _parse_stack_file(os.path.join(d, f))
            except (OSError, ValueError):
                continue
            for r in rows:
                if r.get("kind") not in ("git", "tar"):
                    continue
                o = r["opts"]
                if o.get("prog") or o.get("have"):
                    out.setdefault(r["target"], []).append(
                        (o.get("prog", ""), o.get("have", ""), os.path.join(d, f)))
    chosen = {}
    for name, alts in out.items():
        pick = None
        for prog, have, src in alts:
            ok = True
            if prog and not shutil.which(prog):
                ok = False
            if have and not os.path.exists(have):
                ok = False
            if ok:
                pick = (prog, have, src)
                break
        if pick is None:
            pick = alts[0]            # nothing satisfied: report the first
        chosen[name] = (pick[0], pick[1])
        _STACK_TARGET_SOURCE[name] = pick[2]
    _STACK_TARGETS = chosen
    return chosen


def install_targets(meta):
    """Collect concrete things the install script says it installs:
    programs, libraries, directories (from installed_program(s)/-libraries/
    -director(y|ies))."""
    progs, libs, dirs = [], [], []
    if meta.get("installed_program"):
        progs.append(meta["installed_program"])
    progs += meta.get("installed_programs", [])
    libs += meta.get("installed_libraries", [])
    if meta.get("installed_directory"):
        dirs.append(meta["installed_directory"])
    dirs += meta.get("installed_directories", [])
    # A STACK ENTRY'S OWN DECLARATION WINS OVER A STALE RECORD.
    #
    # If the stack says what proves this package installed, use that: it is
    # current, it is the entry's own word, and it is what a rebuilt script
    # would carry anyway.  A self-named program left in an old record
    # (installed_program="libsrtp") is dropped in favour of it.
    name = (meta.get("name") or "").strip()
    decl = _stack_declared_targets().get(name) if name else None
    if decl:
        prog, have = decl
        progs = [p for p in progs if p != name] + ([prog] if prog else [])
        if have and have not in dirs:
            dirs.append(have)
    return ([p for p in progs if p], [l for l in libs if l],
            [d for d in dirs if d])


def run_validate_cmd(user, cmd):
    """Run a package's validate_cmd AS the user; return its stdout (version), or
    None on failure."""
    if not cmd:
        return None
    run = ["su", "-", user, "-c", cmd] if _can_su(user) else ["bash", "-c", cmd]
    try:
        r = subprocess.run(run, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return (r.stdout or r.stderr).strip() if r.returncode == 0 else None


def _version_number(name_version):
    m = re.search(r"[0-9][0-9.]*[0-9]|[0-9]", name_version or "")
    return m.group(0) if m else None


def assess(u, expected=None, run_cmd=True):
    """Layered install assessment.  Returns (status, reason):
      installed    -- evidence + validated (files exist / version confirmed)
      unvalidated  -- evidence it's installed, but we could NOT confirm it
      not installed / broken
    `expected` is the book name_version, used for version checks.  With
    run_cmd=False the (possibly slow) validate command is skipped -- used for
    bulk/short views."""
    if not u.home and not u.has_user:
        return "not installed", "no package-user and no home"
    if not (u.home and u.has_user):
        # NAME THE DIRECTORY.  "root  broken  has a home dir but no user" sent
        # someone looking for /usr/src/root, which is not where it was; the
        # path is right here and is the whole of what they need to act.
        return "broken", (("no account for the directory %s" % u.home)
                          if u.home else "has a user but no home dir")
    m = u.meta
    if not (m.get("name_version") or u._manifest_has_real_paths()):
        return "not installed", "user + home exist, but nothing installed yet"

    # 1) strongest signal: a validate command that prints the installed version.
    #    A per-package 'validate' file in the home persists across versions and
    #    wins over any validate_cmd inside the (regenerated) install script.
    vfile = os.path.join(u.home or pkgusr_home(u.name or u.search),
                         "validate")
    vcmd = None
    if os.path.isfile(vfile):
        vcmd = f"bash {shlex.quote(vfile)}"
    elif m.get("validate_cmd"):
        vcmd = m["validate_cmd"]
    if vcmd and run_cmd:
        out = run_validate_cmd(u.name or u.search, vcmd)
        if out is None:
            return "unvalidated", "validate command failed to run"
        want = _version_number(expected or m.get("name_version"))
        if want and want in out:
            return "installed", f"validate -> {out.splitlines()[0][:60]} (matches {want})"
        return "unvalidated", (f"validate -> {out.splitlines()[0][:60]} "
                               f"(expected {want})")

    # 2) check the concrete targets the script says it installs
    progs, libs, dirs = install_targets(m)
    missing = []
    for p in progs:
        if not _which_program(p):
            missing.append(f"program {p}")
    for l in libs:
        if not _find_library(l):
            missing.append(f"lib {l}")
    dir_version_ok = None
    for d in dirs:
        # exists, not isdir: a stack entry's `have=` is whatever proves the
        # package landed -- often a .pc file or a header, not a directory --
        # and it is recorded here (1.14.87).  A path that is there is proof
        # either way; a book's installed_directories are directories anyway.
        if not os.path.exists(d):
            missing.append(f"dir {d}")
        elif expected:                                   # versioned dir check
            want = _version_number(expected)
            if want and re.search(r"\d", os.path.basename(d)):
                dir_version_ok = (want in d)
    if progs or libs or dirs:
        # A TARGET THAT WAS NEVER A REAL TARGET.
        #
        # Until 1.14.87 a stack entry's script got installed_program=<its own
        # name>, so libsrtp, tllist and dejavu-fonts were checked for binaries
        # that do not exist.  Their install_last files still say that -- it is
        # the record of the script AS IT RAN, and rewriting it would be a lie
        # about history -- so verify would report "missing: program libsrtp"
        # for a package that is perfectly installed.  When the ONLY thing
        # missing is a program named exactly like the package, and the
        # manifest's files are on disk, the script named no real check.
        _pkgname = (m.get("name") or "").strip()
        if (missing and len(missing) == 1 and _pkgname
                and missing[0] == f"program {_pkgname}"):
            return "unvalidated", ("its script names no verifiable target"
                                   " (rebuilt scripts declare one)")
        if missing:
            # SAY WHERE THE EXPECTATION CAME FROM.  "missing: dir
            # /usr/include/wlr" sent the user to look for a directory; the
            # useful fact was that /etc/pkgusr/stacks/sway.stack still said
            # have=/usr/include/wlr while sway.stack.new beside it -- the
            # shipped fix -- said the .pc file.  The user's copy is never
            # overwritten (1.14.58), so the place to fix it must be named.
            _src = _STACK_TARGET_SOURCE.get(_pkgname)
            _where = (" (declared by %s)" % _src) if _src else ""
            return "unvalidated", "missing: " + ", ".join(missing[:4]) + (
                " ..." if len(missing) > 4 else "") + _where
        if dir_version_ok is False:
            return "unvalidated", "installed dir version differs from the book"
        return "installed", "all installed_* targets present" + (
            " (dir version matches)" if dir_version_ok else "")

    # 3) NOTHING TO CHECK IS NOT THE SAME AS A FAILED CHECK.
    #
    # Most pages name no installed_programs/libraries/directories, so this
    # answered "unvalidated" for 226 of 242 packages on a healthy system --
    # and "unvalidated" reads like a problem.  A health check whose normal
    # output is two hundred warnings is one nobody reads, and the twelve lines
    # that DID matter were buried in it.
    #
    # The manifest has already been checked at this point: its paths exist
    # (that is what got us here).  So the honest answer is installed, with the
    # limit stated -- and anything genuinely wrong still comes out above as
    # "not installed", "broken" or a missing target.
    if m.get("name_version"):
        return "installed", (f"{m['name_version']}, recorded files present "
                             f"(the page names no targets to verify against)")
    return "installed", ("recorded files present "
                         "(the page names no targets to verify against)")


def _install_evidence(u, expected=None):
    return assess(u, expected)[1]


def cmd_verify(args):
    """Re-check install state for all (or named) package-users, showing WHY each
    is/ isn't considered installed.  --fix regenerates pkg.lst for users that own
    files but lack a manifest (which can flip them to 'installed')."""
    names = args.packages if args.packages else list_all_users()

    # edit a package's persistent validate command in $EDITOR
    if getattr(args, "set_validate_command", False):
        if not args.packages:
            printError("verify --set-validate-command needs a package name.")
            return
        for name in args.packages:
            home = pkgusr_home(name)
            if not os.path.isdir(home):
                printError(f"{name}: no /usr/src/{name} -- add-user it first.")
                continue
            vfile = os.path.join(home, "validate")
            if not os.path.isfile(vfile):
                with open(vfile, "w") as f:
                    f.write(
                        "#!/bin/bash\n"
                        f"# Print the INSTALLED version of {name}.\n"
                        "# packagemanager marks the package 'installed' if this\n"
                        "# output contains the book's version number.\n"
                        "# Example:\n"
                        "#   ffmpeg -version | grep -oP '(?<=version ).*(?= Copyright)'\n\n")
                os.chmod(vfile, 0o755)
                if pwd is not None:
                    try:
                        pw = pwd.getpwnam(name)
                        os.chown(vfile, pw.pw_uid, pw.pw_gid)
                    except KeyError:
                        pass
            printInfo(f"opening {vfile} in {editor()} ...")
            subprocess.run([editor(), vfile])
            out = run_validate_cmd(name, f"bash {shlex.quote(vfile)}")
            printInfo(f"  test run -> {out if out else '(no output / failed)'}")
        return

    versions = book_versions_all()
    printHeader("Verify install state")
    print()
    print(f"  {colors.dim}installed = evidence + validated (installed_* files "
          f"exist / validate_cmd matches);\n"
          f"  unvalidated = looks installed but couldn't confirm; "
          f"not installed = nothing built{colors.normal}\n")
    counts, _states = {}, {}
    for name in sorted(set(names)):
        u = gather_user(name)
        anchor = u.meta.get("name") or name
        st, why = assess(u, versions.get(anchor))
        counts[st] = counts.get(st, 0) + 1
        _states[name] = st
        color = _STATE_COLOR.get(st, "")
        print(f"  {name:<24} {color}{st:<12}{colors.normal} {why}")
        # A PIP MODULE INSTALLED BEFORE 1.14.37 HAS NO RECORD AT ALL.
        #
        # `packagemanager pip` wrote neither pkg.lst nor install_last, so the
        # bootstrap set reads "nothing installed yet" while being in daily use.
        # If the module IMPORTS, the account is real and only its paperwork is
        # missing -- say so, and offer the one command that fixes it.
        if st == "not installed" and u.has_user and u.home \
                and not u.meta.get("name_version") and _python_module_here(name):
            st, why = "unvalidated", (
                "installed as a Python module, but with no record -- run:"
                " packagemanager pip record %s" % name)
            counts["not installed"] -= 1
            counts[st] = counts.get(st, 0) + 1
            _states[name] = st
            color = _STATE_COLOR.get(st, "")
            print(f"  {name:<24} {color}{st:<12}{colors.normal} {why}")
            continue
        if args.fix and st == "not installed" and u.has_user and u.home \
                and not u.meta.get("name_version"):
            printInfo(f"    fixing: regenerating pkg.lst for {name}...")
            write_pkg_list(name, background=False)
    print("\n  " + "   ".join(f"{k}: {v}" for k, v in sorted(counts.items())))
    #
    # `unvalidated` is the normal state for most of a system -- it means only
    # that the page named no file to check, not that anything is wrong -- and
    # on a real tree it is 226 of 242 lines.  The dozen that need action
    # scroll past inside it.  Repeat them at the end, where the eye lands,
    # with the command that fixes them.
    # ONE PASS, NOT TWO.  This re-assessed every package to find the ones to
    # repeat -- a second validate command per package on a 242-package tree.
    # The states were already computed in the loop above.
    _act = [n for n, st in _states.items() if st in ("not installed", "broken")]
    if _act:
        print()
        printWarning("%d package(s) need attention (everything else is fine "
                     "-- 'unvalidated' just means" % len(_act))
        printWarning("the book named no file to check):")
        for n in _act:
            u = gather_user(n)
            st, why = assess(u, versions.get(u.meta.get("name") or n))
            printWarning("  %-24s %-14s %s" % (n, st, why))
        # ONLY WHAT THIS COMMAND CAN ACTUALLY BUILD.
        #
        # The list was pasted straight into an install command that could not
        # work: collector groups and a stray `root` are not packages at all,
        # and pkgusr / linux-headers are LFS steps with no BLFS page.  The one
        # bad name then killed the whole run (fixed in 1.14.36), but even
        # without that, offering a command that cannot succeed is worse than
        # offering none.
        _vers = book_versions_all() or {}
        _book = [n for n in _act if _vers.get(n) or _vers.get(n.lower())]
        _other = [n for n in _act if n not in _book]
        if _book:
            printInfo("  Rebuild the BLFS ones:")
            printInfo("    packagemanager install %s --run --recursive"
                      % " ".join(_book))
        if _other:
            printInfo("  Not BLFS packages, and not rebuilt by that command:")
            printInfo("    " + ", ".join(_other))
            printInfo("    LFS steps (linux-headers, pkgusr, ...) belong to the"
                      " chroot build:  lfs-helper build <name> --force")
            # NOT `packagemanager remove root`.  For a directory with no
            # account the fix is to delete the DIRECTORY, and suggesting a
            # remove command against a name like `root` is an invitation to
            # an accident.
            printInfo("    Anything else is a directory or account with no"
                      " package behind it -- the line")
            printInfo("    above names it; a leftover directory can simply be"
                      " removed.")
    else:
        printSuccess("  nothing needs attention.")


