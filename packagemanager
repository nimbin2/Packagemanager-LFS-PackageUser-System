def _adopt_existing_settings():
    """What can be answered without asking anybody.

    Three sources, in order of authority:

      1. the lfs config -- the interview's own answers, which is what the
         system was actually built with;
      2. the environment `lfs` exports into the chroot;
      3. the system itself -- the collector groups and accounts that are
         already there.

    Returns {key: (value, where it came from)} for everything that is known.
    """
    found = {}
    shared = _shared_lfs_config()
    for key in _SHARED_WITH_LFS + ("user_prefix",):
        val = shared.get(key)
        if val:
            found[key] = (str(val).rstrip("_"), "the lfs config")

    for key, env in (("collector_prefix", "LFS_COLLECTOR_PREFIX"),
                     ("pkgusr_prefix", "LFS_PKGUSR_PREFIX"),
                     ("cfguser_prefix", "LFS_CFGUSR_PREFIX"),
                     ("main_user", "LFS_MAIN_USER")):
        if key in found:
            continue
        val = os.environ.get(env)
        if val:
            found[key] = (val.rstrip("_"), "the chroot environment ($%s)" % env)

    # THE SYSTEM ITSELF.  Collector groups live at gid 90000+, and every one of
    # them carries the prefix -- so on a built system the answer is written in
    # /etc/group whether or not any config survived.
    if "collector_prefix" not in found:
        pfx = _prefix_from_groups()
        if pfx:
            found["collector_prefix"] = (pfx, "the collector groups on this system")
    if "pkgusr_prefix" not in found:
        pfx = _prefix_from_accounts(("p", "pkg"))
        if pfx:
            found["pkgusr_prefix"] = (pfx, "the package users on this system")
    if "main_user" not in found:
        mu = _guess_main_user()
        if mu:
            found["main_user"] = (mu, "the login account on this system")
    return found


def _prefix_from_groups():
    """The prefix the collector groups already carry, if they agree on one."""
    if grp is None:
        return ""
    seen = {}
    try:
        groups = grp.getgrall()
    except Exception:
        return ""
    for g in groups:
        if not (90000 <= g.gr_gid < 99000) or "_" not in g.gr_name:
            continue
        seen[g.gr_name.split("_", 1)[0]] = seen.get(g.gr_name.split("_", 1)[0], 0) + 1
    if not seen:
        return ""
    # One prefix, or the commonest: a tree that changed prefix mid-life has
    # both, and the one on most groups is the one in use.
    return max(seen.items(), key=lambda kv: kv[1])[0]


def _prefix_from_accounts(candidates):
    """Which of these prefixes the package users actually wear."""
    if pwd is None:
        return ""
    counts = {}
    try:
        users = pwd.getpwall()
    except Exception:
        return ""
    for u in users:
        if not (10000 <= u.pw_uid < 65000) or "_" not in u.pw_name:
            continue
        pfx = u.pw_name.split("_", 1)[0]
        if pfx in candidates:
            counts[pfx] = counts.get(pfx, 0) + 1
    if not counts:
        return ""
    return max(counts.items(), key=lambda kv: kv[1])[0]


def first_run_setup():
    """Write packagemanager's config, asking only for what nothing knows.

    This asked for all three settings every time the config file was absent --
    on a system built by these tools, where `lfs build-system session` had
    already collected every one of them, written them into config.json, and
    copied that into the chroot.  Being asked for a value the machine is
    holding teaches you that the answer does not matter, which is the opposite
    of true: a collector prefix that disagrees with the built system gives you
    two parallel sets of groups over the same directories, with no error.
    """
    cfg = load_config()
    known = _adopt_existing_settings()

    for key, (val, _src) in known.items():
        cfg[key] = val

    missing = [k for k in ("collector_prefix", "user_prefix")
               if not cfg.get(k)]

    if not missing:
        printHeader("Settings")
        print()
        printInfo("Taken from what this system was built with -- nothing to answer:")
        for key in ("collector_prefix", "pkgusr_prefix", "cfguser_prefix",
                    "user_prefix", "main_user"):
            if not cfg.get(key):
                continue
            src = known.get(key, (None, "the default"))[1]
            print("    %-18s %-12s (%s)" % (key, cfg[key], src))
        if save_config(cfg):
            printSuccess("Saved %s -- change any of it with: packagemanager config"
                         % CONFIG_PATH)
        else:
            printWarning("Could not save config; using these values for this run only.")
        print()
        return

    printHeader("First-run setup")
    print()
    printInfo("packagemanager needs a few settings (saved so you're only asked once):")
    print("  - collector groups own shared install directories, so several")
    print("    package-users can install into the same place;")
    print("  - shared users run apps under a separate account;")
    print("  - the main user is your own human login account.")
    print("  (Existing users: enter your current values, e.g. 'nimgnu', 'u'.)")
    print()
    guess = cfg.get("main_user") or _guess_main_user() or "none"
    try:
        cp = input(f"  Collector-group prefix [{cfg['collector_prefix']}]: ").strip()
        up = input(f"  Application-user prefix [{cfg['user_prefix']}]: ").strip()
        mu = input(f"  Main (human) user name [{guess}]: ").strip()
    except EOFError:
        cp = up = mu = ""
    cfg["collector_prefix"] = (cp or cfg["collector_prefix"]).rstrip("_")
    cfg["user_prefix"] = (up or cfg["user_prefix"]).rstrip("_")
    mu = mu or guess
    if mu and mu.lower() != "none":
        cfg["main_user"] = mu
    if save_config(cfg):
        printSuccess(f"Saved {CONFIG_PATH} (change later with: packagemanager config).")
    else:
        printWarning("Could not save config; using these values for this run only.")
    print()


def _guess_main_user():
    su = os.environ.get("SUDO_USER")
    if su and su != "root":
        return su
    if pwd is not None:
        for p in sorted(pwd.getpwall(), key=lambda x: x.pw_uid):
            if 1000 <= p.pw_uid < 9999:
                return p.pw_name
    return ""


def _blfs_store_lines():
    rc, out, _ = run_blfs(["books"])
    store = default = None
    for line in (out or "").splitlines():
        if line.startswith("Store:"):
            store = line.split(":", 1)[1].strip()
        elif line.startswith("Default:"):
            default = line.split(":", 1)[1].strip()
    return store, default


def cmd_script(args):
    """Run one phase of a package's install script AS the package user, e.g.
    'packagemanager script nano install' to re-run only the install step after
    fixing permissions (no recompile)."""
    # THE ACCOUNT, NOT THE ANCHOR.  This took args.package verbatim, so
    #     packagemanager script install rust
    # ran `su - rust -c 'bash ~/install_rust install'` -- an account that
    # does not exist, and a script named after the anchor rather than the
    # package user.  Everything else in the tool goes through pkgusr_name.
    # TWO NAMES, AND THEY ARE NOT INTERCHANGEABLE.
    #   anchor  -- what the BOOK calls it (rust); blfs generates from this
    #   name    -- the ACCOUNT (p_rust); su and the script path use this
    # It used the anchor for both (su - rust: no such account), and the first
    # fix used the account for both (blfs script failed for p_rust).
    anchor = args.package
    name = pkgusr_name(anchor)
    phase = args.phase

    # fetch: get the script, run NOTHING.  It lands where edits live -- the
    # package user's home when there is one, /tmp's script dir otherwise --
    # which is exactly the file resolve_script prefers, so "fetch, edit,
    # install" and the 1.11.31 conflict flow ("merge into install_<version>")
    # are the same motion.
    if phase == "fetch":
        bv = book_version(name)
        if not bv:
            printError(f"{name} is not in the BLFS book.")
            printInfo(f"  LFS-book packages have their script fetched by:  "
                      f"lfs script fetch {name}")
            sys.exit(1)
        home = pkgusr_home(name)
        target = os.path.join(home, f"install_{bv}")
        if os.path.isfile(target) and not args.regenerate:
            printSuccess(f"already there: {target}")
            printInfo("  edit that file -- install and update use it.  "
                      "Rebuild it from the book with --regenerate.")
            return
        outdir = home if os.path.isdir(home) \
            else os.path.join(TMP_DIR, "install_files")
        os.makedirs(outdir, exist_ok=True)
        path = resolve_script(name, bv, outdir, assume_yes=True,
                              force_regen=args.regenerate)
        if not path:
            sys.exit(1)
        if os.path.isdir(home) and os.path.dirname(
                os.path.abspath(path)) != os.path.abspath(home):
            shutil.copy(path, target)
            path = target
        # the canonical script belongs to the package user, like every other
        # file in its home; a not-yet-created account simply keeps root's copy
        try:
            import pwd
            pw = pwd.getpwnam(pkgusr_name(name))
            os.chown(path, pw.pw_uid, pw.pw_gid)
        except (KeyError, OSError):
            pass
        printSuccess(f"script: {path}")
        printInfo(f"  edit it, then:  packagemanager install {name} --run")
        return

    home = pkgusr_home(name)
    if not _user_exists(name):
        printError(f"{name}: no such package user.")
        return
    # THE CANONICAL FILE, NOT A COPY OF IT.
    #
    # This used install_<user> -- the redundant runtime copy 1.14.16 removed
    # everywhere else -- so a failure reported "ran: install_p_glib2" while
    # telling the person to edit install_GLib-2.86.4, and an edit to the file
    # they were pointed at did not affect the file that ran.
    home_script = (_versioned_script_in(home)
                   or os.path.join(home, f"install_{name}"))

    # (re)generate if asked, missing, or the on-disk script predates the current
    # phased format (old scripts can't find the build dir for install).
    needs_regen = args.regenerate or not os.path.isfile(home_script)
    if not needs_regen:
        try:
            with open(home_script) as f:
                head = f.read(6000)
            if not _script_is_current(head):          # old/un-stamped format
                needs_regen = True
                printInfo("(install script is an older format -- regenerating)")
        except OSError:
            needs_regen = True
    if needs_regen:
        printInfo(f"Generating install script for {name}...")
        script_dir = os.path.join(TMP_DIR, "install_files")
        os.makedirs(script_dir, exist_ok=True)
        rc, out, err = run_blfs(["script", anchor, "-o", script_dir])
        m = re.search(r"^Created (.+)$", out, re.M)
        if rc != 0 or not m:
            printError(f"blfs script failed for {name} -- {(err or out).strip()}")
            return
        gen = m.group(1).strip()
        # NEVER DESTROY AN EDIT IN SILENCE.
        #
        # This overwrites the script in the package's home whenever the tools
        # move on -- and a user who had fixed something in it (a dead download
        # URL, say) loses the fix with no message.  Keep a copy and say so.
        try:
            _dest = os.path.join(home, os.path.basename(gen))
            if (os.path.isfile(_dest)
                    and open(_dest).read() != open(gen).read()):
                home_script = _dest
                bak = home_script + ".edited"
                shutil.copy(home_script, bak)
                printWarning("  your version of %s differed -- saved as %s"
                             % (os.path.basename(home_script),
                                os.path.basename(bak)))
                # Say what actually happens.  This claimed the versioned file
                # "is never regenerated" while regenerating it, which is how a
                # person loses an edit twice: once to the overwrite, once to
                # the sentence that said it could not happen.
                printInfo("    (this file IS the one you edit; it was rewritten"
                          " because you asked for")
                printInfo("     --regenerate or its format was too old."
                          "  Your copy is the .edited file.)")
        except OSError:
            pass
        # a regenerated script keeps the book's own name for the file
        home_script = os.path.join(home, os.path.basename(gen))
        try:
            shutil.copy(gen, home_script)
            os.chmod(home_script, 0o755)
            # `pwd` is imported inside a try in ANOTHER branch, so this
            # referenced a name that may never have been bound:
            #   UnboundLocalError: cannot access local variable 'pwd'
            # Import it here, where it is used, and treat a missing account
            # as "leave it owned by root" rather than an error.
            try:
                import pwd as _pw_mod
                _pw = _pw_mod.getpwnam(name)
                os.chown(home_script, _pw.pw_uid, _pw.pw_gid)
            except (ImportError, KeyError, OSError):
                pass
        except OSError as e:
            printError(f"could not place script in {home}: {e}")
            return

    printHeader(f"{name}: {phase}")
    # THE BUILD ENVIRONMENT HAS TO REACH THE BUILD.
    #
    # `packagemanager env --set XORG_CONFIG=...` writes /etc/pkgusr/build.env,
    # and lfs-helper's run_phase_as pastes it in front of the command it runs.
    # This path built its own `su` and passed nothing, so the same package
    # failed here with
    #     this package needs XORG_CONFIG to be set
    # right after the person had set it and been shown it in the table.
    # `su -` starts a login shell and drops the caller's environment, so the
    # variables have to travel INSIDE the command, not in subprocess's env.
    _bootenv = dict(_read_build_env())
    if getattr(args, "test", False):
        _bootenv["PM_TEST"] = _bootenv["PKGUSR_TESTS"] = "1"
    _pairs = "".join("%s=%s " % (k, shlex.quote(v))
                     for k, v in sorted(_bootenv.items()))
    # THE SAME DOOR AS EVERY OTHER BUILD.
    #
    # This ran the script itself, and so had none of what lfs-helper's
    # cmd_build wraps around one: the compiler wrappers, the file tracking,
    # the failure box -- and above all the GRANT-AND-RETRY.  A glib2 install
    # that stopped on
    #     PermissionError: [Errno 13] '/usr/share/gettext/its'
    # was repaired automatically when the same script ran through lfs-helper,
    # and repeated the identical traceback forever when it ran through here.
    # `packagemanager script install X` is the command the failure box itself
    # tells people to use, so it must be the same door.
    _helper = shutil.which("lfs-helper")
    if _helper and _can_su(name) and phase != "fetch":
        cmd = [_helper, "build", name, "--script", home_script,
               "--phase", phase, "--force"]
        printInfo("  $ " + " ".join(cmd[1:]))
    else:
        _run = f"bash {shlex.quote(f'install_{name}')} {shlex.quote(phase)}"
        inner = f"cd ~ && {('env ' + _pairs) if _pairs else ''}{_run}"
        cmd = (["su", "-", name, "-c", inner] if _can_su(name)
               else ["sh", "-c", inner])
        printInfo(f"  $ su - {name} -c 'bash ~/install_{name} {phase}'")
        if _bootenv:
            printInfo("    with: " + " ".join(sorted(_bootenv)) + "   (from %s)"
                      % BUILD_ENV_FILE)
    _records = phase in ("install", "all", "update")
    env = {**os.environ}
    old_paths = (_pkglist_paths(name)
                 if getattr(args, "clean", False) and phase in ("all", "install", "update")
                 else None)
    t0 = time.time()
    result = subprocess.run(cmd, env=env)
    if result.returncode != 0:
        # NAME THE FILES.  This printed the exit code and a log directory and
        # left the person to work out which of the three copies of the script
        # had just run, where it built, and what to do next -- while the same
        # failure through lfs-helper prints all of it.  A failure report that
        # does not say where is barely a report.
        printError(f"phase '{phase}' failed for {name} (exit {result.returncode}).")
        printInfo(f"  ran    : {home_script}")
        _edit = _versioned_script_in(home)
        if _edit:
            printInfo(f"  edit   : {_edit}")
            printInfo("           (that one is yours and is never regenerated;"
                      " the file above is a copy of it)")
        _src = _unpacked_source_dir(home)
        if _src:
            printInfo(f"  source : {_src}")
        printInfo(f"  logs   : {_pkg_log_dir(name)}")
        printInfo(f"  retry  : packagemanager script {phase} "
                  f"{getattr(args, 'package', name)}")
        if phase in ("install", "configure", "test"):
            # "No rule to make target 'install'" means the source is there and
            # unconfigured -- the build phase never finished, and running one
            # later phase cannot make up for it.
            printInfo("  If the build phase never finished here, no later"
                      " phase can work.")
            printInfo(f"           packagemanager script build "
                      f"{getattr(args, 'package', name)}")
        sys.exit(result.returncode)
    if old_paths is not None:
        _clean_after_install(name, old_paths, t0)
    # A PHASE THAT INSTALLED MUST BE RECORDED.
    #
    # This runs the script directly, and only pm-install writes the manifest
    # -- so after `packagemanager script install rust` succeeded, the planner
    # still called Rustc "new" and the next stack run started building it
    # again from scratch.  An install nobody recorded did not happen, as far
    # as every other command is concerned.
    if _records:
        try:
            _rr = subprocess.run(["lfs-helper", "record-install", name],
                                 capture_output=True, text=True)
            for _l in (_rr.stdout or "").splitlines():
                if _l.strip():
                    printInfo("  " + _l.strip())
            if _rr.returncode != 0:
                printWarning("  could not record the install -- the planner will"
                             " treat %s as not installed" % name)
        except (OSError, subprocess.SubprocessError) as e:
            printWarning(f"  could not record the install ({e})")
    printSuccess(f"{name}: {phase} done.  logs: {_pkg_log_dir(name)}")


