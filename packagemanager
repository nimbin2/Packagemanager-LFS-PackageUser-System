          "present" if st["ca"] else "no bundle generated yet"))
    print()
    print("  site-packages : %s" % (st["site"] or "NOT FOUND -- is Python installed?"))
    print("  sources       : %s" % srcdir)
    if st["unverified"]:
        print()
        printWarning("  Certificate checking is OFF in /etc/wgetrc so that")
        printWarning("  make-ca can be fetched at all.  It is turned back on")
        printWarning("  automatically once stage 5 is done.")

    if not st["site"]:
        printError("\nNo system site-packages directory: nothing can be installed.")
        sys.exit(1)

    # Stages 1 and 2 need no network -- only the files get-sources already put
    # on disk.  Stages 3-5 need a working download, which is exactly what 1 and
    # 2 buy you, so they run straight after in the same command.
    if not todo_wget and not todo_wheels:
        print()
        printSuccess("Stages 1 and 2 are done -- `blfs` and `packagemanager` can read a book.")
        if not args.run:
            _bootstrap_next_steps(st)
            printInfo("\nDry run -- to do these, re-run with --run.")
            return
        failed = _bootstrap_finish(st, yes)
        _bootstrap_report(failed)
        return

    if not args.run:
        print()
        _bootstrap_next_steps(st)
        printInfo("\nDry run -- to apply all of this, re-run with --run.")
        return

    # The wheels are already on disk and pip must not reach for an index: this
    # system has no CA certificates yet, so anything that tries is a hang, not
    # an error.
    missing = [fn for _d, _v, fn, _u, _h in todo_wheels
               if not os.path.isfile(os.path.join(srcdir, fn))]
    if missing:
        printError("\nThese wheels are not in %s:" % srcdir)
        for fn in missing:
            print("    %s" % fn)
        printWarning("They had to be downloaded before the reboot:")
        printWarning("    lfs build-system get-sources --run   (on the host)")
        sys.exit(1)

    failed = []

    # MODULES FIRST, THEN THE DOWNLOAD TOOL.
    #
    # Installing wget means looking it up in the BLFS book, and reading the
    # book needs requests and beautifulsoup4.  With the tool installed first,
    # the very first run on a fresh system could not parse the book it was
    # holding and said the package did not exist:
    #
    #     $ install wget --run
    #     wget: not in the BLFS book.
    #     searching the book for wget  Nothing similar found either.
    #
    # ...and it only ever succeeded on a SECOND run, once stage 2 had put the
    # parsers in place -- which looked like flakiness rather than an order.
    # The wheels need neither the book nor a network, so they come first and
    # nothing is lost.
    if todo_wheels:
        printHeader("1. book-parsing modules")
        grp = collector_prefix() + _pip_owner_of_python()
        # IN ORDER, with --no-deps: pip cannot reach an index to resolve
        # anything, so the order in _SETUP_WHEELS is the dependency order and
        # each module must already have what it imports.
        for dist, ver, fn, url, _have in todo_wheels:
            if not pip_install_module(dist, st["site"], grp,
                                      find_links=srcdir, no_deps=True,
                                      target=os.path.join(srcdir, fn)):
                failed.append(dist)

    if todo_wget:
        printHeader("2. a download tool")
        if failed:
            printWarning("The book parsers did not install, so the book cannot")
            printWarning("be read and the download tool cannot be looked up.")
            printWarning("Fix those first; this stage would fail for that reason")
            printWarning("rather than for one of its own.")
        elif not _setup_install_wget(yes):
            failed.append("wget")
        else:
            # A system with no certificates cannot verify anything it fetches.
            # This is the same call the tool makes on every invocation; doing it
            # here means the very next download works.
            ensure_wget_workaround()

    print()
    if failed:
        # Stop here: everything after this point needs what just failed.
        _bootstrap_report(failed)
    printSuccess("Stages 1 and 2 done.")
    failed = _bootstrap_finish(_bootstrap_state(), yes)
    _bootstrap_report(failed)


def _bootstrap_report(failed):
    print()
    if failed:
        printError("bootstrap stopped with %d failure(s): %s"
                   % (len(failed), ", ".join(failed)))
        printInfo("Fix them and run it again -- it skips what is already done.")
        sys.exit(1)
    st = _bootstrap_state()
    if st["book"] and st["make_ca"] and st["ca"]:
        printSuccess("Bootstrap complete -- all five stages done.")
        # THE STARTUP HELPERS BELONG TO THE BOOTSTRAP.  BLFS packages drop
        # /etc/profile.d snippets that call pathprepend, which LFS does not
        # provide -- rust's snippet failed on every package-user login.
        # lfs-helper writes them; this is the command people run on a fresh
        # system, so it asks for them here.
        try:
            _pr = subprocess.run(["lfs-helper", "install-profile"],
                                 capture_output=True, text=True)
            for _l in (_pr.stdout or "").splitlines():
                if _l.strip():
                    printInfo("  " + _l.strip())
        except (OSError, subprocess.SubprocessError):
            printWarning("  could not run `lfs-helper install-profile`; BLFS"
                         " profile.d snippets may fail with"
                         " 'pathprepend: command not found'")
        printInfo("Try it:  blfs order <pkg>   /   packagemanager install <pkg>")
    else:
        printSuccess("Nothing left that this command can do.")


def _bootstrap_finish(st, yes):
    """Do stages 3, 4 and 5 -- the ones that need a working download.

    These used to be PRINTED, on the reasoning that each has to be seen to work
    before the next is worth trying.  That was a poor trade: `bootstrap --run`
    is a person saying "get this system ready", and answering with three
    commands to type is refusing the request while looking like an answer.
    Each stage still reports what it did, and a failure still stops the ones
    that depend on it -- which is the part that actually mattered.
    """
    failed = []

    # 3. the book.  Only reachable now: fetching it needs the download tool
    # that stage 2 just installed.
    if not st["book"]:
        printHeader("3. the BLFS book")
        blfs = _find_blfs_cmd()
        if not blfs:
            printError("  blfs is not installed, so the book cannot be fetched.")
            failed.append("the BLFS book")
        else:
            printInfo("  $ blfs fetch")
            try:
                rc = subprocess.run(blfs + ["fetch"]).returncode
            except (OSError, subprocess.SubprocessError) as e:
                printError("  could not run blfs: %s" % e)
                rc = 1
            if rc != 0 or not _blfs_book_available():
                printError("  no book was fetched -- this needs a network.")
                printInfo("  Or copy one in:  blfs import /path/to/BLFS-BOOK-...html")
                failed.append("the BLFS book")

    # 4. make-ca, through the ordinary install path so BLFS resolves what it
    # needs.  Without a book there is nothing to look it up in, so this is
    # skipped rather than attempted and blamed on itself.
    if not st["make_ca"]:
        printHeader("4. make-ca")
        if "the BLFS book" in failed:
            printWarning("  Skipped: there is no book to look make-ca up in.")
            failed.append("make-ca")
        else:
            printInfo("  This fetches over an UNVERIFIED connection -- that is")
            printInfo("  what the /etc/wgetrc marker is for, and the last time")
            printInfo("  it happens.")
            if not _install_via_self("make-ca", yes, recursive=True):
                failed.append("make-ca")

    # 5. the bundle.  `make-ca -g` alone reports "No update required!" and
    # writes nothing, because its copy of certdata.txt looks current right
    # after installing -- so the install looks fine while the system still has
    # no certificates.
    # THE TRIGGER MUST MATCH WHAT COUNTS AS DONE.
    #
    # This ran only when there was NO bundle at all, while 1.11.19 made the
    # finishing condition "a bundle AND no empty store".  So on a tree with the
    # GnuTLS bundle written and /etc/ssl/certs empty, stage 5 was skipped
    # entirely and then the check below reported the empty store as a failure
    # -- correctly, and without ever having tried to fix it.  Reported twice,
    # attempted never.
    if not _have_ca_bundle() or _empty_cert_stores():
        printHeader("5. the certificate bundle")
        if "make-ca" in failed:
            printWarning("  Skipped: make-ca is not installed.")
            failed.append("certificates")
        else:
            if not _run_make_ca():
                failed.append("certificates")

    # Turn verification back on only when there is something that can actually
    # verify.  make-ca writes several stores and EXITS 0 having failed some of
    # them, so "a bundle exists" is not the same as "verification works".
    if _have_ca_bundle():
        empty = _empty_cert_stores()
        if empty:
            printWarning("")
            printWarning("  Some certificate stores were NOT written, even after")
            printWarning("  granting and generating again:")
            for d, why in empty:
                printWarning("    %-28s %s" % (d, why))
            printWarning("  A tool that reads one of those still cannot verify")
            printWarning("  anything.  OpenSSL reads /etc/ssl/certs by default,")
            printWarning("  so this matters to wget itself.")
            printWarning("  Grant it by hand and generate once more:")
            printWarning("      lfs-helper grant-dir %s %s --run"
                         % (_OPENSSL_CERT_DIR, pkgusr_name("make-ca")))
            printWarning("      /usr/sbin/make-ca -g --force")
            if "certificates" not in failed:
                failed.append("certificates")
        else:
            restore_wget_verification()
    return failed


# OpenSSL's default CApath, and the file make-ca writes beside it.  These are
# what `wget` itself consults, so an empty one means verification fails even
# though _have_ca_bundle found a GnuTLS bundle elsewhere and said yes.
_OPENSSL_CERT_DIR = "/etc/ssl/certs"


def _empty_cert_stores():
    """Stores that exist but hold nothing, with why -- best guess."""
    out = []
    d = _OPENSSL_CERT_DIR
    if os.path.isdir(d):
        try:
            n = len([f for f in os.listdir(d)
                     if f.endswith((".pem", ".crt", ".0"))])
        except OSError:
            n = 0
        if n == 0:
            why = "empty"
            try:
                owner = pwd.getpwuid(os.stat(d).st_uid).pw_name
                if owner != "root":
                    why = "empty -- owned by %s" % owner
            except (KeyError, OSError):
                pass
            out.append((d, why))
    return out


def _run_make_ca(retry=True):
    """Generate the certificate stores, granting access if that is what stops it.

    make-ca writes into several directories owned by other packages --
    /etc/ssl/certs belongs to p_openssl -- and it EXITS 0 having failed some of
    them:

        p11-kit: couldn't create file: /etc/ssl/certs/...pem: Unknown error 13
        Failed!!!
        ...
        Extracting GNUTLS server auth certificates to: ...Done!

    A zero exit and one bundle written is what made bootstrap report success
    with an empty OpenSSL trust store.  So: read the output, grant what the
    errors name, and run it again.
    """
    mk = shutil.which("make-ca") or "/usr/sbin/make-ca"
    printInfo("  $ %s -g --force" % mk)
    try:
        r = subprocess.run([mk, "-g", "--force"], capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError) as e:
        printError("  could not run make-ca: %s" % e)
        return False
    out = (r.stdout or "") + (r.returncode and (r.stderr or "") or (r.stderr or ""))
    sys.stdout.write(r.stdout or "")
    sys.stderr.write(r.stderr or "")

    if r.returncode == 0 and not _empty_cert_stores():
        return _have_ca_bundle()

    if not retry:
        if not _have_ca_bundle():
            printError("  no certificate bundle was generated.")
        return False

    # Which directories did it fail on?  Written to a file so the one parser
    # both this and an install failure go through can read it.
    tmp = os.path.join(TMP_DIR, "make-ca.log")
    try:
        os.makedirs(TMP_DIR, exist_ok=True)
        with open(tmp, "w") as f:
            f.write(out)
    except OSError:
        return False
    account = pkgusr_name("make-ca")
    if not _user_exists(account):
        return _have_ca_bundle()
    granted = auto_grant_from_log(account, tmp)
    if not granted:
        printWarning("  make-ca could not write every store, and nothing in its")
        printWarning("  output names a directory to grant.  Check by hand:")
        printWarning("      ls -ald %s" % _OPENSSL_CERT_DIR)
        return False
    printInfo("  granted; generating again ...")
    return _run_make_ca(retry=False)


def _find_blfs_cmd():
    if shutil.which("blfs"):
        return ["blfs"]
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "blfs")
    if os.path.isfile(here):
        return [sys.executable, here]
    return None


def _bootstrap_next_steps(st):
    """What is left, and the command for it -- for a DRY RUN.

    `--run` does these (see _bootstrap_finish); this is what to expect.
    """
    if st["book"] and st["make_ca"] and st["ca"]:
        print()
        printSuccess("Bootstrap complete -- nothing is left to do.")
        printInfo("Try it:  blfs order <pkg>   /   packagemanager install <pkg>")
        return
    print()
    printHeader("what --run would do next")
    n = 3
    if not st["book"]:
        print()
        print("  %d. The BLFS book.  Without it every lookup fails as" % n)
        print("     'not found in book', whatever you ask for.")
        print("         blfs books --discover")
        print("         blfs fetch <version>")
        print("     Or copy a book you already have into /usr/share/blfs/books/.")
    n += 1
    if not st["make_ca"]:
        print()
        print("  %d. make-ca.  Until this is installed every download is" % n)
        print("     unverified -- which is why /etc/wgetrc has verification")
        print("     turned off: make-ca itself has to be fetched somehow.")
        print("         packagemanager install make-ca --run")
    n += 1
    if not st["ca"]:
        print()
        print("  %d. The certificate bundle.  `make-ca -g` generates nothing" % n)
        print("     when it thinks its copy of certdata.txt is current, which")
        print("     it is right after installing -- so force it once:")
        print("         /usr/sbin/make-ca -g --force")
        print("     The tools re-enable certificate checking on their own once")
        print("     a bundle exists.")
    print()
    pass


def cmd_user_create(args):
    if _resolve_shared_level(args) is None:
        return 2
    u = _user_prefixed(args.name)
    if _user_exists(u):
        printInfo(f"{u}: already exists.")
    else:
        printHeader(f"Create shared user {u}")
        print()
        cmd = find_add_package_user() + [u, u, str(APP_UID_MIN), str(APP_UID_MAX),
                                         u, str(APP_UID_MIN), str(APP_UID_MAX)]
        printInfo(f"Creating shared user: {' '.join(cmd)}")
        if not _run(cmd):
            return
        printSuccess(f"{u} created.")
        report_created_user(u, kind="application user")
    if args.groups:
        _add_groups(u, [g for g in re.split(r"[,\s]+", args.groups) if g])

    # AN APPLICATION USER IS NOT A PACKAGE USER, AND ITS HOME IS NOT IN
    # /usr/src.
    #
    # `add_package_user` is what creates the account -- it handles the uid
    # range and the matching group -- and it puts the home where PACKAGE
    # homes go:
    #     /usr/src/u_claude, /usr/src/u_browser-mini, ...
    # A package user's home is a build tree.  An application user's home is
    # a home: it holds a browser profile, a .config, a Downloads directory.
    # It belongs in /home, which is also where the shared-directory links
    # and the XDG skeleton expect it.
    _relocate_app_home(u)

    # An account on its own is not usable: you cannot become it, its home is
    # world-readable, and nothing launches the program.  Do the rest.
    _setup_application_user(u, args)


def _relocate_app_home(u):
    """Move an application user's home from the package tree to /home.

    Only from the package-user base, only when the target does not already
    exist, and with `usermod -m` so the contents come along.  Anything else
    is left exactly as it is: a home someone has already set up elsewhere
    is not this function's business.
    """
    cur = _home_of(u) or ""
    root = appuser_home()
    want = os.path.join(root, u)
    if not cur or os.path.realpath(cur) == os.path.realpath(want):
        return
    # Moved from where these tools put it before, and nowhere else: the
    # package tree, or /home/<user> (the old hard-coded place).  A home
    # someone chose elsewhere is not this function's business.
    base = os.path.realpath(BASE_DIR)
    rc = os.path.realpath(cur)
    if not (rc.startswith(base + os.sep)
            or rc == os.path.realpath(os.path.join("/home", u))):
        printInfo("  %s's home is %s -- left alone (not a place these tools"
                  " put it)" % (u, cur))
        return
    if os.path.exists(want):
        printWarning("  %s already exists -- not moving %s's home there"
                     % (want, u))
        printInfo("    check it, then:  usermod -d %s -m %s" % (want, u))
        return
    if not os.path.isdir(root):
        _run(["install", "-d", "-o", "root", "-g", "root", "-m", "0755", root])
    printInfo("  %s's home is %s -- application users live in %s"
              % (u, cur, root))
    if _run(["usermod", "-d", want, "-m", u]):
        _run(["chmod", "0750", want])
        printSuccess("  moved to %s (0750)" % want)
        _repoint_shared_link(u, cur, want)
    else:
        printWarning("  could not move it (is %s logged in or running"
                     " something?); by hand:" % u)
        printInfo("    usermod -d %s -m %s && chmod 0750 %s" % (want, u, want))


def _repoint_shared_link(u, old_home, new_home):
    """~/Shared/<Name> of the main user pointed into the old home."""
    hub = shared_hub()
    if not hub or not os.path.isdir(hub):
        return
    for n in os.listdir(hub):
        p = os.path.join(hub, n)
        if not os.path.islink(p):
            continue
        t = os.readlink(p)
        if t.startswith(old_home.rstrip("/") + "/"):
            nt = new_home.rstrip("/") + t[len(old_home.rstrip("/")):]
            os.unlink(p)
            os.symlink(nt, p)
            printInfo("    %s -> %s" % (p, nt))


def _xdg_runtime_dir_of(user):
    """The main user's XDG runtime directory, however this system names it."""
    try:
        import pwd
        uid = pwd.getpwnam(user).pw_uid
    except (KeyError, ImportError):
        return None
    for cand in (os.environ.get("XDG_RUNTIME_DIR") if user == os.environ.get("USER") else None,
                 "/run/user/%d" % uid,
                 "/tmp/xdg-%s" % user,
                 "/tmp/xdg-%d" % uid):
        if cand and os.path.isdir(cand):
            return cand
    return None


def xdg_runtime_group():
    """The one group that opens the main user's session to shared accounts."""
    return collector_prefix() + "xdg-runtime"


def _join_xdg_runtime_group(main, u):
    """Put an application user -- and the main user -- in the session group.

    A "shared user" is one that may reach the main user's XDG runtime
    directory: the display socket (and pipewire's) live there, so without it
    a graphical program starts and then cannot draw anything.

    THE GROUP IS NAMED, NOT READ OFF THE DIRECTORY.  This used to take
    whatever group /tmp/xdg-<main> carried -- which is the main user's own
    private group -- refuse, and say "set up a runtime group first", which
    nothing did.  <prefix>_xdg-runtime is created here (collector range), the
    main user joins it (a user may only chgrp to a group it is in) and so does
    every shared account.  The directory is recreated at every boot, so its
    group is applied by the session itself: /usr/bin/xdg-runtime-share and
    /etc/profile.d/xdg-runtime-share.sh, written by `cfg app-users`.
    """
    g = xdg_runtime_group()
    if not _create_collector_group(g):
        printWarning(f"  could not create the session group {g} -- {u} will "
                     f"not reach the session")
        return
    for who in (main, u):
        _run(["usermod", "-a", "-G", g, who])
    printInfo(f"  {main} and {u} are in '{g}' (the session group)")
    rt = _xdg_runtime_dir_of(main)
    if not rt:
        printInfo(f"    no runtime directory for {main} right now -- the session "
                  f"applies the group when it starts")
        return
    try:
        import grp
        cur = grp.getgrgid(os.stat(rt).st_gid).gr_name
    except (KeyError, ImportError, OSError):
        cur = ""
    if cur != g:
        # root may do it now; the session does it on every later login
        _run(["chgrp", g, rt])
        _run(["chmod", "0750", rt])
        printInfo(f"    {rt}: group {g}, 0750 (was {cur or '?'})")


XDG_SKEL = "/etc/pkgusr/skel-u_xdg/.bash_profile"


def _link_xdg_profile(main, u):
    """Point a shared user's .bash_profile at the XDG skeleton.

    Being in the session group is necessary but not sufficient: the account
    also has to KNOW where the session is.  XDG_RUNTIME_DIR, WAYLAND_DISPLAY
    and the package-user PATH come from this one file, so a shared user
    without it can reach the socket and still not find it.

    It is a symlink, not a copy: change the file once and every shared account
    picks it up."""
    if not os.path.isfile(XDG_SKEL):
        printWarning(f"  {XDG_SKEL} is missing -- {u} will not find the session")
        printInfo("    It ships with these tools; reinstall them, or write it "
                  "by hand.")
        return

    # The skeleton is installed with a placeholder, because the runtime
    # directory belongs to whoever is logged in.  Fill it in once.
    try:
        text = open(XDG_SKEL).read()
    except OSError as e:
        printWarning(f"  could not read {XDG_SKEL}: {e}")
        return
    if "@XDG_RUNTIME_DIR@" in text:
        rt = _xdg_runtime_dir_of(main)
        if not rt:
            printWarning(f"  {XDG_SKEL} still has a placeholder and no runtime "
                         f"directory was found for {main}")
            printInfo(f"    Set it by hand:  XDG_RUNTIME_DIR in {XDG_SKEL}")
            return
        try:
            with open(XDG_SKEL, "w") as f:
                f.write(text.replace("@XDG_RUNTIME_DIR@", rt))
            printInfo(f"  {XDG_SKEL}: XDG_RUNTIME_DIR set to {rt}")
        except OSError as e:
            printWarning(f"  could not write {XDG_SKEL}: {e}")
            return

    # the ACCOUNT's home, not a package home: this linked
    # /usr/src/u_claude/.bash_profile
    home = _app_home(u)
    target = os.path.join(home, ".bash_profile")
    if os.path.islink(target) and os.path.realpath(target) == \
            os.path.realpath(XDG_SKEL):
        printInfo(f"  {target} already points at the XDG profile")
        return
    try:
        if os.path.exists(target) or os.path.islink(target):
            os.replace(target, target + ".pkgusr")
            printInfo(f"    kept the old one as {target}.pkgusr")
        os.symlink(XDG_SKEL, target)
        _run(["chown", "-h", f"{u}:{u}", target])
        printInfo(f"  {target} -> {XDG_SKEL}")
    except OSError as e:
        printWarning(f"  could not link {target}: {e}")


def _setup_application_user(u, args):
    """Make an application user actually usable from your own account.

    Creating the account is the easy part.  What makes it useful:
      * your account may `su - <user>` without a password (via PAM)
      * the home is 0700, so no other account can read it
      * your account joins the user's group, for the shared directory
      * an optional shared directory both accounts can write
      * an optional launcher in ~/bin so the program runs as that user
    """
    home = _app_home(u)
    main = main_user()
    if not main:
        printWarning("\nNo main user is set, so this account cannot be reached "
                     "from your own.")
        printWarning("Set it, then run this again:")
        printWarning("    packagemanager config --main-user <your-login>")
        return

    # 1. the home is private -- 0700, NOT 0750 (1.14.315)
    #
    # 0750 let the account's GROUP in, and your login is in that group (for
    # the shared directory).  So "a browser cannot read your documents" held,
    # and the reverse did not: you could read its profile and cookies, and
    # so could anything running as you.  The shared directory lives in the
    # hub now, so nothing needs to pass through the home.
    if os.path.isdir(home):
        _run(["chmod", "0700", home])
        printInfo(f"  home {home} is 0700 (private to {u})")

    # 2. your account joins the user's group -- this is what makes a shared
    #    directory work, and what lets PAM identify you as entitled
    _run(["usermod", "-a", "-G", u, main])
    printInfo(f"  {main} joined group '{u}'")

    # 3. su without a password, if this system uses the hint's PAM file
    _allow_su_via_pam(u, main)

    # 4. the session: a shared user is one that may reach the main user's
    #    XDG runtime directory (the display, the session bus, the audio
    #    socket).  The group is whatever that directory carries -- reading it
    #    rather than assuming a name, since the prefix is configurable.
    if getattr(args, "shared", False):
        _join_xdg_runtime_group(main, u)
        _link_xdg_profile(main, u)

    # 5. a shared directory, when asked for
    #
    # THE DIRECTORY LIVES IN THE HUB, THE LINK LIVES IN THE HOME (1.14.315).
    # It was the other way round: the data in <account home>/Shared and a
    # link to it in the hub -- so reaching it meant passing through the
    # account's home, and the home had to be group-readable (0750) for
    # that.  Your login is in the account's group, so it could read the
    # browser profile, the cookies, everything.  Now the data is
    # /home/Shared/<Name> (2770 u_<name>:u_<name>), the home is 0700, and
    # the account's own ~/Shared is a link into the hub -- which keeps
    # `--download-dir ~/Shared` in app-users.conf meaning the same thing.
    if getattr(args, "share_dir", False):
        _hub = _ensure_shared_hub(main)
        share = os.path.join(_hub, args.name[:1].upper() + args.name[1:])
        if os.path.islink(share):
            printWarning(f"  {share} is a link (to {os.readlink(share)}) -- the "
                         f"layout before 1.14.315; left alone")
            printInfo("    move the data in, as the 1.14.315 notes say, then "
                      "run this again")
        else:
            _run(["mkdir", "-p", share])
            _run(["chown", f"{u}:{u}", share])
            _run(["chmod", "2770", share])   # setgid: new files keep the group
            printInfo(f"  shared directory: {share}  (2770 {u}:{u})")
            # ...and the account's ~/Shared points at it
            _in_home = os.path.join(home, "Shared")
            if os.path.islink(_in_home):
                if os.path.realpath(_in_home) != os.path.realpath(share):
                    printWarning(f"  {_in_home} points at "
                                 f"{os.readlink(_in_home)} -- left alone")
            elif os.path.isdir(_in_home):
                if not os.listdir(_in_home):
                    os.rmdir(_in_home)
                    _run(["ln", "-s", share, _in_home])
                    _run(["chown", "-h", f"{u}:{u}", _in_home])
                else:
                    # DATA IS NEVER MOVED BY THIS.  It was asked for as a
                    # hand step; the command is printed, not run.
                    printWarning(f"  {_in_home} still holds files -- not "
                                 f"moved (that is yours to do)")
                    printInfo(f"    mv {_in_home}/* {_in_home}/.[!.]* {share}/ "
                              f"&& rmdir {_in_home} && ln -s {share} {_in_home}")
            elif not os.path.lexists(_in_home):
                _run(["ln", "-s", share, _in_home])
                _run(["chown", "-h", f"{u}:{u}", _in_home])

    # 6. a launcher and a menu entry, when the program is really there
    app = getattr(args, "app", None) or getattr(args, "name", None) \
        or u[len(user_prefix()):]
    import shutil as _sh
    # AN APP CAN BE A COMMAND LINE.  `--app "/bin/browser-mini
    # https://claude.ai/new"` is the whole point of a per-account browser,
    # and `which` on that string finds nothing -- so the launcher and the
    # menu entry were silently skipped for exactly the accounts that needed
    # them most.  Look up the FIRST word; run the whole line.
    _app_argv = app.split()
    _app_cmd = _app_argv[0] if _app_argv else app
    _app_base = os.path.basename(_app_cmd)
    want_launcher = getattr(args, "launcher", False)
    want_desktop = getattr(args, "desktop", False)
    if want_launcher or want_desktop:
        # Their original checked `which $app` first and skipped both when it
        # was missing -- a launcher for a program that is not installed is
        # just a broken command in your PATH.
        if not (_sh.which(_app_cmd) or os.path.isfile(_app_cmd)):
            printWarning(f"  no '{_app_cmd}' on PATH -- no launcher or menu "
                         f"entry")
            printInfo(f"    (install it first, then: packagemanager user "
                      f"setup {args.name} --launcher --desktop)")
        else:
            # the launcher is NAMED after the account, not after the command:
            # two accounts can run the same browser with different arguments,
            # and ~/bin/browser-mini cannot be both.
            if want_launcher:
                _write_launcher(main, u, app, name=args.name)
            if want_desktop:
                _write_desktop_entry(main, u, app, name=args.name)


def _home_of(user):
    try:
        import pwd
        return pwd.getpwnam(user).pw_dir
    except (KeyError, ImportError):
        return None


def _allow_su_via_pam(u, main):
    """Let <main> su to <u> without a password, if the PAM file is present.

    The hint ships /etc/pam.d/su_u_user with a case statement listing which
    accounts each user may become.  It is not part of stock LFS, so this is a
    no-op when the file does not exist -- `su` then simply asks for a
    password, which still works."""
    pam = "/etc/pam.d/su_u_user"
    if not os.path.isfile(pam):
        printInfo(f"  ({pam} not present -- `su - {u}` will ask for a password)")
        return
    try:
        text = open(pam).read()
    except OSError as e:
        printWarning(f"  could not read {pam}: {e}")
        return
    if re.search(r"^\s*%s\)" % re.escape(u), text, re.M):
        printInfo(f"  {pam} already allows it")
        return
    marker = 'case "$PAM_USER" in'
    if marker not in text:
        printWarning(f"  {pam} has no '{marker}' block -- not editing it")
        return
    lines = text.splitlines(True)
    out = []
    for line in lines:
        out.append(line)
        if marker in line:
            out.append('  %s) USERS="%s %s"; ;;\n' % (u, u, main))
    try:
        with open(pam, "w") as f:
            f.writelines(out)
        # IT IS A SCRIPT pam EXECUTES.  Rewriting it must not drop the exec
        # bit, and a file written 644 makes `su` ask for a password with
        # nothing in the logs to say why.
        _m = os.stat(pam).st_mode & 0o777
        if not _m & 0o111:
            os.chmod(pam, 0o755)
            printInfo(f"  {pam} was not executable ({_m:o}) -- set to 755, "
                      f"pam_exec.so runs it")
        printInfo(f"  {main} may now `su - {u}` without a password")
        # ...AND pam ONLY READS IT IF /etc/pam.d/su SAYS SO.
        _su = "/etc/pam.d/su"
        _line = "auth      sufficient  pam_exec.so quiet %s" % pam
        try:
            _has = os.path.isfile(_su) and "su_u_user" in open(_su).read()
        except OSError:
            _has = False
        if not _has:
            printWarning(f"  {_su} does not call it, so su will still ask for"
                         f" a password.")
            printInfo("    add, above the other auth lines:")
            printInfo("      %s" % _line)
            printInfo("    `packagemanager stack services --only app-users "
                      "--run` does it for you.")
    except OSError as e:
        printWarning(f"  could not write {pam}: {e}")


def _resolve_shared_level(args):
    """--shared-slim / --shared-full on top of the original --shared.

    `--shared` joins the group on the XDG runtime directory -- the display,
    the session bus and audio sockets live there, so without it a graphical
    program cannot draw.  Audio and video are SEPARATE groups, and were only
    reachable by spelling them out in --groups.
    
    An account that runs one browser window does not need a microphone.  So
    the level is named: slim is the desktop alone, full adds audio and video.
    """
    slim = getattr(args, "shared_slim", False)
    full = getattr(args, "shared_full", False)
    if slim and full:
        printError("--shared-slim and --shared-full are opposites; pick one")
        return None
    if slim or full:
        args.shared = True
    if full:
        have = [g for g in (getattr(args, "groups", "") or "").split(",") if g]
        for g in ("audio", "video"):
            if g not in have:
                have.append(g)
        args.groups = ",".join(have)
        printInfo("  --shared-full: desktop + groups %s" % ", ".join(have))
    elif slim:
        printInfo("  --shared-slim: desktop only (no audio, no video)")
    return args


def cmd_user_setup(args):
    """Apply the application-user setup to an account that already exists.

    Everything `user create` does after making the account, so a user made
    earlier -- or made by hand -- can be brought up to the same state.  Each
    step is idempotent, so running it again is safe and only fills in what is
    missing."""
    if _resolve_shared_level(args) is None:
        return 2
    u = _user_prefixed(args.name)
    if not _user_exists(u):
        printError(f"{u}: no such user.")
        printInfo(f"  Create it first:  packagemanager user create {args.name}")
        sys.exit(1)
    printHeader(f"Set up {u}")
    print()
    # an account made before its home had a place is brought there too
    _relocate_app_home(u)
    if args.groups:
        _add_groups(u, [g for g in re.split(r"[,\s]+", args.groups) if g])
    _setup_application_user(u, args)


# BROWSERS THAT TAKE --app-id.  A window's app id is what sway matches rules
# and the taskbar groups on; without one every account's browser is the same
# "browser-mini" window.  A line that does not give one gets its launcher name.
_APP_ID_PROGRAMS = ("browser-mini", "browser-big")

# WHAT YOU TYPE, AND WHAT HAPPENS WHEN YOU TYPE NOTHING.
#
#   {}                 the word is the arguments / a search term
#   {https://site/}    ...and this page when there are no arguments
#
# The braces are the placeholder; anything INSIDE them is the fallback.  It
# cannot be spelled `{|url}`: `|` is app-users.conf's field separator.
_TEMPLATE_RE = re.compile(r"\{[^{}]*\}")


def _is_template(word):
    """Does this word carry a {} placeholder (with or without a fallback)?"""
    return bool(_TEMPLATE_RE.search(word))


def _launcher_words(u, app, who):
    """The command line as words, with ~/ made the ACCOUNT's home, and an
    --app-id added for a browser that has none."""
    import shlex as _shlex
    try:
        words = _shlex.split(app)
    except ValueError:
        words = app.split()
    home = _app_home(u) or ""
    words = [(home + w[1:]) if (w.startswith("~/") and home) else w for w in words]
    if words and os.path.basename(words[0]) in _APP_ID_PROGRAMS \
            and "--app-id" not in words:
        words[1:1] = ["--app-id", who]
    return words


def _recolor_svg(path, color):
    """Paint a one-colour SVG in `color`.

    A brand icon is a single path with one fill (or none at all, inheriting
    black).  simpleicons.org used to do this server-side -- /openai/38BDF8 --
    but only for the icons it still carries, and it dropped `openai` and
    `grok`.  Doing it here works on any monochrome SVG, wherever it came
    from.  `fill="none"` is left alone: that is a hole, not a colour.  A
    multi-colour logo comes out flat, which is why this only happens when a
    colour is asked for.
    """
    try:
        t = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return False
    if "<svg" not in t:
        return False
    new = re.sub(r'fill="(?!none\b)[^"]*"', 'fill="%s"' % color, t)
    new = re.sub(r'fill:\s*(?!none\b)[^;"\']+', 'fill:%s' % color, new)
    if not re.search(r'<svg\b[^>]*\bfill=', new):
        new = re.sub(r'<svg\b', '<svg fill="%s"' % color, new, count=1)
    if new == t:
        return False
    try:
        open(path, "w").write(new)
    except OSError:
        return False
    return True


def _fetch_icon(main, who, icon):
    """The menu icon, fetched once into ~/.local/share/icons/lfs-apps.

    icon: an http(s) URL -> that file; a word -> the simpleicons.org slug of
    that name; empty -> the launcher name as the slug; "-" -> no icon.  A
    trailing #RRGGBB paints a monochrome SVG that colour after it is
    fetched.  A failed download is not an error: the entry falls back to the
    program's own icon name.
    """
    if icon == "-":
        return None
    home = _home_of(main)
    if not home:
        return None
    spec = icon or ""
    # #RRGGBB AT THE END IS A COLOUR, NOT PART OF THE URL.  No URL these
    # icons come from uses a fragment, and a colour has to be expressible for
    # a plain slug too (`openai#38BDF8`), not just for a URL.
    color = ""
    m = re.search(r"#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$", spec)
    if m:
        color = "#" + m.group(1)
        spec = spec[:m.start()]
    url = spec if re.match(r"^https?://", spec) else \
        "https://cdn.simpleicons.org/%s" % ((spec or who).lower())
    ext = os.path.splitext(url.split("?")[0])[1].lower()
    ext = ext if ext in (".svg", ".png", ".xpm") else ".svg"
    d = os.path.join(home, ".local", "share", "icons", "lfs-apps")
    path = os.path.join(d, who + ext)
    stamp = path + ".from"
    # the stamp records the WHOLE spec, so changing only the colour refetches
    want = url + color
    if os.path.isfile(path) and os.path.getsize(path) > 0:
        try:
            if open(stamp).read().strip() == want:
                return path
        except OSError:
            pass
    os.makedirs(d, exist_ok=True)
    tmp = path + ".part"
    r = subprocess.run(["curl", "-fsSL", "--max-time", "20", url, "-o", tmp],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if r.returncode != 0 or not os.path.isfile(tmp) or os.path.getsize(tmp) == 0:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        printWarning(f"  no icon for {who} from {url} -- the menu uses the program's")
        if "cdn.simpleicons.org" in url:
            printInfo("    (simpleicons.org has dropped several brands, `openai` "
                      "and `grok` among them -- give the icon column a URL)")
        return None
    os.replace(tmp, path)
    if color and ext == ".svg":
        printInfo(f"  icon {who}: painted {color}" if _recolor_svg(path, color)
                  else f"  icon {who}: {color} changed nothing (not a one-colour SVG)")
    open(stamp, "w").write(want + "\n")
    for f in (d, path, stamp):
        _run(["chown", f"{main}:{main}", f])
    printInfo(f"  icon: {path}  ({url})")
    return path


def _write_desktop_entry(main, u, app, name=None, icon=""):
    """A menu entry that runs the launcher -- named after the LAUNCHER, so
    one account can have several (google and duckduckgo run as u_browser)."""
    home = _home_of(main)
    if not home:
        return
    who = os.path.basename(name or app.split()[0])
    appdir = os.path.join(home, ".local", "share", "applications")
    os.makedirs(appdir, exist_ok=True)
    path = os.path.join(appdir, f"{who}.desktop")
    launcher = os.path.join(home, "bin", who)
    words = _launcher_words(u, app, who)
    prog = os.path.basename(words[0]) if words else who
    icon_path = _fetch_icon(main, who, icon)
    takes_args = any(_is_template(w) for w in words)
    # A MENU NEEDS A CATEGORY.  An entry with none is "Other" at best and
    # missing at worst, depending on the menu -- and these are the entries a
    # person actually clicks.  Taken from the program, since that is what is
    # known here.
    if prog in _APP_ID_PROGRAMS:
        cats = "Network;WebBrowser;"
    elif prog in ("mpv", "vlc", "ffplay"):
        cats = "AudioVideo;Video;Player;"
    else:
        cats = "Utility;"
    text = ("[Desktop Entry]\n"
            f"Name={who.capitalize()}\n"
            f"Comment=Runs as the application user {u}\n"
            f"Exec={launcher}{' %U' if takes_args else ''}\n"
            "Terminal=false\n"
            "Type=Application\n"
            f"Categories={cats}\n"
            f"Icon={icon_path or prog}\n"
            f"StartupWMClass={who if prog in _APP_ID_PROGRAMS else prog.capitalize()}\n")
    if os.path.exists(path):
        try:
            cur = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            cur = ""
        if cur == text:
            return
        if "Comment=Runs as the application user " not in cur:
            printInfo(f"  {path} was not written by these tools -- left alone")
            return
        printInfo(f"  menu entry {path} was stale -- rewritten")
    with open(path, "w") as f:
        f.write(text)
    os.chmod(path, 0o644)
    _run(["chown", f"{main}:{main}", path])
    printInfo(f"  menu entry: {path}")


_LAUNCHER_TEMPLATE = r'''#!/bin/bash
# Runs @APP@ as the application user @USER@.
# written by packagemanager user launcher -- rewritten when stale
T=(@ARR@)
enc() {   # URL-encode, byte by byte; a space becomes +
    local LC_ALL=C s="$*" o="" c i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) o+="$c" ;;
            " ") o+="+" ;;
            *) printf -v c "%%%02X" "'$c"; o+="$c" ;;
        esac
    done
    printf "%s" "$o"
}
cmd=()
for w in "${T[@]}"; do
    if [ "$w" = "{}" ]; then
        cmd+=("$@")                       # the arguments, one by one
    elif [[ "$w" == *"{"*"}"* ]]; then
        pre="${w%%\{*}"; rest="${w#*\{}"  # ...{ inner }...
        inner="${rest%%\}*}"; post="${rest#*\}}"
        if [ $# -gt 0 ]; then
            cmd+=("$pre$(enc "$*")$post") # what you typed, URL-encoded
        elif [ -n "$inner" ]; then
            cmd+=("$inner")               # nothing typed: the default page
        else
            p="$pre"; case "$p" in *\?*) p="${p%\?*}" ;; esac
            cmd+=("$p")                   # nothing typed, no default: cut at ?
        fi
    else
        cmd+=("$w")
    fi
done
# A MENU ENTRY HAS NO TERMINAL, AND su WANTS ONE.
#
# From a terminal this is the whole story: su authenticates through
# /etc/pam.d/su_u_user and execs the program.  Started from a .desktop entry,
# a hotkey or a launcher menu there is no tty at all -- su fails, its message
# goes to a stderr nobody is reading, and the entry looks like it "does
# nothing".  script(1) gives it a pty and nothing else; the typescript goes
# to /dev/null and -e returns the program's own exit status.
if [ -t 0 ] && [ -t 1 ]; then
    exec su - @QUSER@ -c 'exec "$0" "$@"' -- "${cmd[@]}"
fi
script -qec "$(printf '%q ' su - @QUSER@ -c 'exec "$0" "$@"' -- "${cmd[@]}")" /dev/null
rc=$?
# ...and say so where it can be seen, since there is no terminal to print to
if [ "$rc" != 0 ] && command -v notify-send >/dev/null 2>&1; then
    notify-send "@WHO@" "did not start (exit $rc) -- run @WHO@ in a terminal to see why"
fi
exit $rc
'''


def _write_launcher(main, u, app, name=None):
    """A wrapper in ~/bin, named after the LAUNCHER, that runs the command
    line as the application account.

    {} IN THE COMMAND LINE IS WHAT YOU TYPE.
      a word that IS {}       -> the arguments, one by one ("browser-mini {}")
      {} inside a word        -> the arguments as a URL-encoded search term
                                 ("https://www.youtube.com/results?search_query={}")
                                 and with no arguments the word is cut before
                                 its ? (or before {}): the site's front page
      {https://site/} in one  -> the same, but with nothing typed the word
                                 becomes exactly what is inside the braces.
                                 Cutting at the ? gives /search/ -- a search
                                 page for a search nobody made.  This gives
                                 the page you actually want to land on, and
                                 it is per line: reddit's is the front page
                                 today and may be your own profile tomorrow.
      no {} at all            -> arguments are NOT passed: `claude foo` must
                                 not hand browser-mini a second address

    THE ARGUMENTS GO THROUGH AS ARGUMENTS.  The old writer built
    su -c "app $(printf %q-each "$@")", which with no arguments produced one
    EMPTY argument ("a second address:").  Here the final list is built in
    the launcher and handed to su after --: bash gets $0 and "$@" exactly.
    """
    home = _home_of(main)
    if not home:
        return
    bindir = os.path.join(home, "bin")
    os.makedirs(bindir, exist_ok=True)
    who = os.path.basename(name or app.split()[0])
    path = os.path.join(bindir, who)
    import shlex as _shlex
    words = _launcher_words(u, app, who)
    arr = " ".join(_shlex.quote(w) for w in words)
    # A PLAIN TEMPLATE, NOT %-FORMATTING.  This body is bash full of `%02X`
    # and `${w%%...}`, and every one of them had to be written `%%%%` here.
    # One miscount and the launcher is subtly wrong, which is how the empty
    # second address survived so long.  Three named slots, .replace(), done.
    text = _LAUNCHER_TEMPLATE.replace("@APP@", app).replace("@USER@", u) \
                             .replace("@QUSER@", _shlex.quote(u)) \
                             .replace("@WHO@", who) \
                             .replace("@ARR@", arr)
    if os.path.exists(path):
        try:
            cur = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            cur = ""
        # OURS AND STALE IS REWRITTEN; ANYTHING ELSE IS YOURS.
        if cur == text:
            printInfo(f"  launcher {path} is current")
            return
        if not re.search(r"^# Runs .* as the application user \S+\.$", cur, re.M):
            # SAY WHAT TO DO ABOUT IT.  A launcher from an older version of
            # these tools is not recognised either, so "left alone" quietly
            # kept the OLD behaviour -- no default page, no --app-id -- on
            # exactly the launchers the conf had just changed.
            printInfo(f"  {path} exists and was not written by these tools -- left alone")
            printInfo(f"    to take the generated one:  rm {path}  and run this again")
            return
        _was = re.search(r"su - (\S+)", cur)
        printInfo(f"  launcher {path} was stale (ran as "
                  f"{_was.group(1) if _was else '?'}) -- rewritten")
    with open(path, "w") as f:
        f.write(text)
    os.chmod(path, 0o755)
    _run(["chown", f"{main}:{main}", path])
    printInfo(f"  launcher: {path}")


def cmd_user_launcher(args):
    """One launcher (and menu entry) for an EXISTING application account.

    Separate from `user setup` because an account can have several: the
    `browser` account runs browser-mini, browser-big, google and duckduckgo.
    """
    u = _user_prefixed(args.account)
    if not _user_exists(u):
        printError(f"{u}: no such account -- `user create {args.account}` first")
        return 1
    main = main_user()
    if not main:
        printError("no main user set (packagemanager config --main-user <login>)")
        return 1
    who = args.name
    import shutil as _sh
    words = _launcher_words(u, args.app, who)
    if not words or not (_sh.which(words[0]) or os.path.isfile(words[0])):
        printWarning(f"  {who}: no '{words[0] if words else args.app}' on PATH "
                     f"-- no launcher or menu entry")
        return 0
    _write_launcher(main, u, args.app, name=who)
    if not args.no_desktop:
        _write_desktop_entry(main, u, args.app, name=who, icon=args.icon or "")
    return 0


def _ours_for(path, marker):
    try:
        return marker in open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return False


def cmd_user_remove_launcher(args):
    """Remove a launcher, its menu entry and icon -- only files these tools
    wrote (a hand-made ~/bin/<name> is never touched)."""
    main = main_user()
    home = _home_of(main) if main else None
    if not home:
        printError("no main user set")
        return 1
    who = os.path.basename(args.name)
    files = []
    lp = os.path.join(home, "bin", who)
    if os.path.isfile(lp) and _ours_for(lp, "as the application user"):
        files.append(lp)
    dp = os.path.join(home, ".local", "share", "applications", who + ".desktop")
    if os.path.isfile(dp) and _ours_for(dp, "Comment=Runs as the application user "):
        files.append(dp)
    idir = os.path.join(home, ".local", "share", "icons", "lfs-apps")
    if os.path.isdir(idir):
        files += [os.path.join(idir, f) for f in os.listdir(idir)
                  if f.startswith(who + ".")]
    if not files:
        printInfo(f"  {who}: no launcher, menu entry or icon of these tools")
        return 0
    for f in files:
        printInfo(("  remove " if args.run else "  would remove ") + f)
    if args.run:
        for f in files:
            os.unlink(f)
    else:
        printInfo("  dry run -- add --run")
    printInfo(f"  and take its line out of /etc/pkgusr/stacks/app-users.conf, "
              f"or the next `cfg app-users` writes it again")
    return 0


def cmd_user_allow(args):
    user = args.user
    up = user_prefix()
    if not user.startswith(up):
        printWarning(f"'{user}' has no '{up}' prefix -- shared users are "
                     f"usually named '{up}{user}'.")
        if not _user_exists(user) and _user_exists(up + user):
            printInfo(f"Using '{up}{user}' instead.")
            user = up + user
    if not _user_exists(user):
        printError(f"{user}: no such user.")
        return
    _add_groups(user, args.groups)


def cmd_user_disallow(args):
    for g in args.groups:
        if _in_group(args.user, g):
            if _run(["gpasswd", "-d", args.user, g]):
                printSuccess(f"Removed {args.user} from {g}.")
        else:
            printInfo(f"{args.user} is not in {g}.")


# WHAT AN ACCOUNT'S HOME HOLDS WHEN IT HAS NEVER RUN ANYTHING.
# `user create` puts a .bash_profile symlink there (and keeps whatever was
# there as .bash_profile.pkgusr), plus an empty Shared if the line asked for
# one.  Nothing else is ours.
_HOME_SCAFFOLD = {".bash_profile", ".bash_profile.pkgusr", ".bashrc",
                  ".bash_logout", ".bash_history", ".profile", ".dircolors",
                  "pkg.lst"}


def _home_is_untouched(home):
    """Is there anything in this home worth keeping?

    The archive exists because a home holds a browser profile: logins,
    cookies, history, downloads -- months of state that `userdel -r` would
    take with it and nothing could give back.  A home that was created and
    never used holds none of that, and a tarball of it is 200 bytes of
    nothing in /root, one per account, fourteen more on the next purge.
    """
    try:
        entries = os.listdir(home)
    except OSError:
        return False
    for n in entries:
        if n in _HOME_SCAFFOLD:
            continue
        p = os.path.join(home, n)
        if n == "Shared" and os.path.isdir(p) and not os.path.islink(p) \
                and not os.listdir(p):
            continue
        return False
    return True


def _shared_hub(main_home=""):
    """Where the per-account links live -- the system hub, not a home
    (1.14.312; the argument is kept for the callers and ignored)."""
    return shared_hub()


def _ensure_shared_hub(main):
    """Create the hub, and make the main user's ~/Shared a link to it.

    MOVING, NOT COPYING, AND ONLY OUR LINKS.  A ~/Shared that is already a
    directory has the links earlier releases made in it; each one moves to
    the hub (same name, same target).  Anything else in it -- a file, a
    directory, a link of your own that clashes with one in the hub -- is
    yours, so the directory stays, and says so.  Only an EMPTY ~/Shared is
    replaced by the link.
    """
    hub = shared_hub()
    if not os.path.isdir(hub):
        _run(["mkdir", "-p", hub])
    # root owns it, your login's group may add a link by hand (0775): the
    # hub is a system path that YOU curate, and nobody else may
    grp_name = main if (main and _group_exists(main)) else "root"
    _run(["chown", f"root:{grp_name}", hub])
    _run(["chmod", "0775" if grp_name != "root" else "0755", hub])
    mh = _home_of(main) if main else None
    if not mh:
        return hub
    home_link = os.path.join(mh, "Shared")
    if os.path.islink(home_link):
        if os.path.realpath(home_link) != os.path.realpath(hub):
            printWarning(f"  {home_link} points at {os.readlink(home_link)}, "
                         f"not the hub {hub} -- left alone")
        return hub
    if os.path.isdir(home_link):
        moved, kept = 0, []
        for n in sorted(os.listdir(home_link)):
            p = os.path.join(home_link, n)
            dest = os.path.join(hub, n)
            if not os.path.islink(p):
                kept.append(n)
                continue
            t = os.readlink(p)
            if os.path.lexists(dest):
                if os.path.islink(dest) and os.readlink(dest) == t:
                    os.unlink(p)            # already moved on an earlier run
                    continue
                kept.append(n)
                continue
            os.symlink(t, dest)
            os.lchown(dest, 0, 0)
            os.unlink(p)
            moved += 1
        if moved:
            printInfo(f"  moved {moved} link(s) from {home_link} to {hub}")
        if kept:
            printWarning(f"  {home_link} still holds {', '.join(kept[:5])}"
                         f"{' ...' if len(kept) > 5 else ''} -- yours, so it "
                         f"stays a directory")
            printInfo(f"    the shared links are in {hub}; move those by hand, "
                      f"then run this again")
            return hub
        try:
            os.rmdir(home_link)
        except OSError:
            return hub
    os.symlink(hub, home_link)
    try:
        _pw = pwd.getpwnam(main)
        os.lchown(home_link, _pw.pw_uid, _pw.pw_gid)
    except (KeyError, OSError):
        pass
    printInfo(f"  {home_link} -> {hub}")
    return hub


def _remove_empty_hub(mh):
    """The hub goes when nothing is left in it -- and ~/Shared, the link to
    it, goes with it, or it dangles."""
    hub = shared_hub()
    if not (hub and os.path.isdir(hub) and not os.listdir(hub)):
        return
    try:
        os.rmdir(hub)
        printInfo(f"  removed {hub} (empty)")
    except OSError:
        return
    hl = os.path.join(mh, "Shared") if mh else ""
    if hl and os.path.islink(hl) and not os.path.exists(hl):
        try:
            os.unlink(hl)
            printInfo(f"  removed {hl} (it pointed at the hub)")
        except OSError:
            pass


def _stale_shared_links(main_home, home=""):
    """Links in ~/Shared that point into `home`, plus every link there that
    leads nowhere at all.  A dangling link is what keeps a SHARED_* variable
    alive after the account behind it is gone."""
    hub = _shared_hub(main_home)
    out = []
    if not hub or not os.path.isdir(hub):
        return out
    for f in sorted(os.listdir(hub)):
        fp = os.path.join(hub, f)
        if not os.path.islink(fp):
            continue
        if not os.path.exists(fp):              # dangling: nothing to keep
            out.append(fp)
        elif home and os.readlink(fp).startswith(home.rstrip("/") + "/"):
            out.append(fp)
    return out


def _shared_vars_note(paths):
    """Say what an open shell still thinks, and how to correct it.

    /etc/profile.d/shared-dirs.sh runs at LOGIN.  Removing the link removes
    tomorrow's variable; the shell you are typing in keeps today's until you
    log in again -- so `cd $SHARED_BROWSER_MINI` still completes and still
    fails, which reads like the removal did not work."""
    names = [os.path.basename(p).upper().replace("-", "_") for p in paths]
    if not names:
        return
    printInfo("  shells that are already open still export "
              + ", ".join("SHARED_" + n for n in names))
    printInfo("    they are read at login: log in again, or right now:")
    printInfo("      unset " + " ".join("SHARED_" + n for n in names))


def cmd_user_delete(args):
    """Remove an application account SAFELY.

    Only an application account: the user prefix, and a home under the
    application-user root or the package tree.  Refused while it runs
    anything.  Without --no-archive its home is packed first into
    /root/<account>-home-<date>.tar.gz (0600).  Then: its launchers, menu
    entries and icons (the ones these tools wrote that run as it), the
    ~/Shared/<Name> link, its line in /etc/pam.d/su_u_user, the account, its
    group, and the home (kept with --keep-home).
    """
    u = _user_prefixed(args.name)
    if not u.startswith(user_prefix()):
        printError(f"{u}: not an application account ({user_prefix()}...) -- refused")
        return 1
    exists = _user_exists(u)
    home = (pwd.getpwnam(u).pw_dir if (exists and pwd) else "") or _app_home(u)
    roots = [os.path.realpath(appuser_home()), os.path.realpath(BASE_DIR)]
    if home and not any(os.path.realpath(home).startswith(r.rstrip("/") + "/") for r in roots):
        printError(f"{u}: home {home} is not under {' or '.join(roots)} -- refused")
        return 1
    main = main_user()
    mh = _home_of(main) if main else None
    # what goes
    launchers = []
    if mh:
        for d, marker in ((os.path.join(mh, "bin"), f"as the application user {u}."),
                          (os.path.join(mh, ".local", "share", "applications"),
                           f"Comment=Runs as the application user {u}\n")):
            if os.path.isdir(d):
                for f in sorted(os.listdir(d)):
                    fp = os.path.join(d, f)
                    if os.path.isfile(fp) and _ours_for(fp, marker):
                        launchers.append(fp)
    icons = []
    if mh:
        idir = os.path.join(mh, ".local", "share", "icons", "lfs-apps")
        names = {os.path.splitext(os.path.basename(f))[0] for f in launchers}
        if os.path.isdir(idir):
            icons = [os.path.join(idir, f) for f in sorted(os.listdir(idir))
                     if f.split(".")[0] in names]
    # THE LINK, AND ANY LINK THAT NO LONGER LEADS ANYWHERE.
    #
    # A link was only removed when it pointed inside THIS home, so a home
    # moved after the link was made (usermod -d, or the move to
    # /home/shared_user) left ~/Shared/<Name> behind, dangling.  Nothing
    # then removed it -- and /etc/profile.d/shared-dirs.sh enumerates that
    # directory, which is why $SHARED_BROWSER_MINI outlived the account.
    links = _stale_shared_links(mh, home)
    printHeader(f"Remove application account {u}")
    print(f"  account : {u}" + ("" if exists else "  (already gone)"))
    if home:
        print(f"  home    : {home}" + ("  (kept: --keep-home)" if args.keep_home else ""))
        if os.path.isdir(home) and not args.no_archive:
            if _home_is_untouched(home):
                print("  archive : none -- nothing in this home but the files "
                      "these tools put there")
            else:
                print(f"  archive : /root/{u}-home-<date>.tar.gz first (0600)")
    for f in launchers + icons + links:
        print(f"  remove  : {f}")
    print("  pam     : its line in /etc/pam.d/su_u_user")
    if exists:
        busy = subprocess.run(["pgrep", "-u", u], stdout=subprocess.DEVNULL).returncode == 0
        if busy:
            printError(f"  {u} is running something -- close it (pkill -u {u}) and try again")
            return 1
    if not args.run:
        printInfo("\n  dry run -- nothing removed.  Remove:  "
                  f"packagemanager user delete {args.name} --run")
        printInfo("  and take its lines out of /etc/pkgusr/stacks/app-users.conf, "
                  "or the next `cfg app-users` creates it again")
        return 0
    if not args.yes and not ask_yes_no(f"\nReally remove {u}?"):
        printWarning("Aborted.")
        return 1
    if home and os.path.isdir(home) and not args.no_archive \
            and not _home_is_untouched(home):
        arch = f"/root/{u}-home-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz"
        old_umask = os.umask(0o077)
        ok_arch = _run(["tar", "-C", os.path.dirname(home), "-czf", arch,
                        os.path.basename(home)])
        os.umask(old_umask)
        if not ok_arch:
            printError(f"  could not archive {home} -- nothing removed")
            return 1
        _run(["chmod", "600", arch])
        printInfo(f"  archived {home} -> {arch}")
    for f in launchers + icons + links:
        try:
            os.unlink(f)
            printInfo(f"  removed {f}")
        except OSError as e:
            printWarning(f"  {f}: {e}")
    pam = "/etc/pam.d/su_u_user"
    if os.path.isfile(pam):
        try:
            txt = open(pam).read()
            new = re.sub(r"^\s*%s\)[^\n]*\n" % re.escape(u), "", txt, flags=re.M)
            if new != txt:
                open(pam, "w").write(new)
                printInfo(f"  removed {u} from {pam}")
        except OSError as e:
            printWarning(f"  {pam}: {e}")
    if exists:
        _run(["userdel", u])
    if _group_exists(u):
        _run(["groupdel", u])
    if home and os.path.isdir(home) and not args.keep_home:
        try:
            shutil.rmtree(home)
            printInfo(f"  removed {home}")
        except OSError as e:
            printError(f"  rmtree {home}: {e}")
    # ITS SHARED DIRECTORY IS NOT IN ITS HOME ANY MORE (1.14.315), so the
    # archive above does not carry it.  Empty: removed.  With files: kept,
    # and said -- those are files you put there, not the account's.
    _bare = u[len(user_prefix()):]
    _sd = os.path.join(shared_hub(), _bare[:1].upper() + _bare[1:])
    if os.path.isdir(_sd) and not os.path.islink(_sd):
        if not os.listdir(_sd):
            try:
                os.rmdir(_sd)
                printInfo(f"  removed {_sd} (empty)")
            except OSError:
                pass
        else:
            printWarning(f"  kept {_sd} -- it has files in it; look, then:"
                         f"  rm -r {_sd}")
    # the hub is ours only while it holds our links: an empty hub is
    # left-over furniture, one with something else in it is yours.
    _remove_empty_hub(mh)
    printSuccess(f"{u} removed.")
    _shared_vars_note(links)
    printInfo("  take its lines out of /etc/pkgusr/stacks/app-users.conf, "
              "or the next `cfg app-users` creates it again")
    return 0


# =========================================================================== #
# command: user purge -- undo the whole app-users setup            [IMPLEMENTED]
# =========================================================================== #
#
# `user delete` removes ONE account.  What it cannot remove is everything the
# accounts share, because the next account still needs it: the session group,
# the two profile fragments, /usr/bin/xdg-runtime-share, the pam file and the
# line in /etc/pam.d/su that calls it.  Left behind, those are what makes a
# "deleted" setup still visible -- a group you are in, variables in every new
# shell, an auth line pointing at a file that is gone.
#
# NOTHING HERE TOUCHES A FILE THESE TOOLS DID NOT WRITE.  Each file is read
# first and only removed if it carries the marker `cfg app-users` writes.
# The home archives in /root are never removed: they are the undo of the undo.

APP_USERS_MARKER = "# written by stacks/app-users.sh -- safe to delete, regenerated"
APP_USERS_CONF = "/etc/pkgusr/stacks/app-users.conf"


def _conf_accounts(path):
    """The account names in app-users.conf: column 1, both file formats."""
    out = []
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return out
    for raw in lines:
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        a = s.split("|")[0].strip()
        if a in ("", "name", "user", "account") or re.search(r"[^a-z0-9_-]", a):
            continue
        if a not in out:
            out.append(a)
    return out


def _ours(path, marker):
    """A file that exists and says these tools wrote it."""
    if not os.path.isfile(path):
        return False
    try:
        return marker in open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return False


def cmd_user_purge(args):
    """Undo the application-account setup: the accounts, then what they share.

    Dry run unless --run.  Homes are archived to /root first, exactly as
    `user delete` does, and those archives stay.
    """
    conf = args.conf or APP_USERS_CONF
    main = main_user()
    mh = _home_of(main) if main else ""
    accounts = _conf_accounts(conf)
    if args.accounts:
        accounts = [a for a in re.split(r"[,\s]+", args.accounts) if a]
    # ACCOUNTS THE FILE NO LONGER MENTIONS ARE STILL OURS TO REMOVE.  That is
    # exactly the browser-mini/browser-big case: the line was rewritten, the
    # account stayed.  Found in passwd, not by listing a directory, so an
    # account whose home is already gone is found too.
    strays = []
    if pwd:
        root = os.path.realpath(appuser_home())
        for e in pwd.getpwall():
            if not e.pw_name.startswith(user_prefix()):
                continue
            a = e.pw_name[len(user_prefix()):]
            if a in accounts or a in strays:
                continue
            if os.path.realpath(e.pw_dir or "").startswith(root.rstrip("/") + "/"):
                strays.append(a)
    strays.sort()
    todo = [a for a in accounts + strays if _user_exists(_user_prefixed(a))]

    printHeader("Undo the application-account setup")
    print()
    print("  accounts : " + (", ".join(user_prefix() + a for a in todo) or "none left"))
    shared = []
    for p in ("/etc/profile.d/shared-dirs.sh", "/etc/profile.d/xdg-runtime-share.sh",
              "/usr/bin/xdg-runtime-share"):
        if _ours(p, APP_USERS_MARKER):
            shared.append(p)
        elif os.path.exists(p):
            printWarning(f"  {p} is not ours -- left alone")
    pam_file = "/etc/pam.d/su_u_user"
    pam_su = "/etc/pam.d/su"
    # an ACTIVE auth line, not a comment that happens to name the file
    pam_line = bool(os.path.isfile(pam_su) and re.search(
        r"^\s*auth\s+sufficient\s+pam_exec\.so.*su_u_user",
        open(pam_su, encoding="utf-8", errors="replace").read(), re.M))
    for p in shared:
        print(f"  remove   : {p}")
    if os.path.isfile(pam_file):
        print(f"  remove   : {pam_file}")
    if pam_line:
        print(f"  edit     : {pam_su} (drop the pam_exec line; backup kept)")
    g = xdg_runtime_group()
    if _group_exists(g):
        print(f"  group    : {g} (removed; {main or 'you'} leaves it)")
    print("  kept     : /root/" + user_prefix() + "*-home-*.tar.gz (the archives)")
    print(f"  kept     : {conf} -- delete the lines you no longer want, or the")
    print("             next `cfg app-users` builds all of this again")

    if not args.run:
        printInfo("\n  dry run -- nothing removed.  Undo it:  "
                  "packagemanager user purge --run")
        return 0
    if not args.yes and not ask_yes_no("\nReally undo all of it?"):
        printWarning("Aborted.")
        return 1

    # 1. the accounts, through the command that already knows how
    import argparse as _ap
    gone = 0
    for a in todo:
        rc = cmd_user_delete(_ap.Namespace(
            name=a, run=True, yes=True,
            keep_home=args.keep_home, no_archive=args.no_archive))
        if rc:
            printWarning(f"  {a}: not removed -- stopping before the shared parts")
            printInfo("    (close what it is running, then run this again)")
            return 1
        gone += 1

    # 2. anything left in ~/Shared that leads nowhere, then the hub itself
    dead = _stale_shared_links(mh)
    for p in dead:
        try:
            os.unlink(p)
            printInfo(f"  removed {p}")
        except OSError as e:
            printWarning(f"  {p}: {e}")
    _remove_empty_hub(mh)
    idir = os.path.join(mh, ".local", "share", "icons", "lfs-apps") if mh else ""
    if idir and os.path.isdir(idir) and not os.listdir(idir):
        try:
            os.rmdir(idir)
            printInfo(f"  removed {idir} (empty)")
        except OSError:
            pass

    # 3. the files every account shared
    for p in shared:
        try:
            os.unlink(p)
            printInfo(f"  removed {p}")
        except OSError as e:
            printWarning(f"  {p}: {e}")
    if os.path.isfile(pam_file):
        try:
            os.unlink(pam_file)
            printInfo(f"  removed {pam_file}")
        except OSError as e:
            printWarning(f"  {pam_file}: {e}")
    # THE LINE IN /etc/pam.d/su GOES LAST AND WITH A BACKUP.  It is the one
    # edit here that can cost you `su` if it goes wrong.
    if pam_line:
        bak = f"{pam_su}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        try:
            txt = open(pam_su).read()
            new = "\n".join(l for l in txt.splitlines()
                            if not re.match(r"^\s*auth\s+sufficient\s+pam_exec\.so.*su_u_user",
                                            l)) + "\n"
            if new != txt:
                shutil.copy2(pam_su, bak)
                open(pam_su, "w").write(new)
                printInfo(f"  {pam_su}: pam_exec line removed (backup {bak})")
        except OSError as e:
            printWarning(f"  {pam_su}: {e}")

    # 3b. the directory the accounts lived in, if it is now empty
    root = appuser_home()
    if os.path.isdir(root) and not os.listdir(root):
        try:
            os.rmdir(root)
            printInfo(f"  removed {root} (empty)")
        except OSError:
            pass

    # 4. the session group -- last, when nothing is in it any more
    if _group_exists(g):
        _run(["groupdel", g])
        printInfo(f"  removed group {g}")

    printSuccess(f"undone: {gone} account(s) and everything they shared.")
    _shared_vars_note(dead)
    printInfo("  your session still has the old group until you log in again")
    # THE ARCHIVES ARE THE ONE THING THIS DOES NOT REMOVE, so say what they
    # are and how to be rid of them.  They only exist for a home that had
    # something in it -- a browser profile, its logins and its downloads.
    import glob as _glob
    arch = sorted(_glob.glob(f"/root/{user_prefix()}*-home-*.tar.gz"))
    if arch:
        printInfo(f"  {len(arch)} home archive(s) kept in /root -- browser profiles, "
                  f"nothing else can give them back")
        printInfo(f"    look:    tar tzf {arch[-1]} | head")
        printInfo(f"    or drop: rm /root/{user_prefix()}*-home-*.tar.gz")
    if mh and os.path.isfile(os.path.join(mh, ".config", "sway", "config")):
        printInfo("  and `exec xdg-runtime-share` is still in your sway config "
                  "-- yours to remove")
    return 0


# =========================================================================== #
# command: service -- the SysV services, without remembering the layout
# =========================================================================== #
#
# A SysV service is two things in two places: /etc/rc.d/init.d/<name>, which
# starts it, and the S/K symlinks in /etc/rc.d/rc<N>.d, which decide whether
# boot does.  Everything here is `ls`, `ln -s` and `rm` on those -- no daemon,
# no database, nothing this tool has to keep in step with the system.
#
# START IS NOT ENABLE.  systemd taught everyone that they are different, and
# SysV has always had them separate; `service sshd start` runs the script now
# whatever the links say, and `enable` only touches the links.

SVC_STATE_DIR = "/var/lib/pkgusr/services"
SVC_ACTIONS = ("start", "stop", "restart", "reload", "force-reload", "status",
               "enable", "disable", "list")


def _svc_dirs():
    """(init.d, the directory holding rc<N>.d) -- LFS's layout, then the
    plain one, because only one of them exists on a given machine."""
    for initd, rcroot in (("/etc/rc.d/init.d", "/etc/rc.d"), ("/etc/init.d", "/etc")):
        if os.path.isdir(initd):
            return initd, rcroot
    return None, None


# NOT EVERY FILE IN init.d IS A SERVICE.  `functions` is a library the others
# source, `rc` is what init runs, `template` is a skeleton to copy.  Listing
# them invites starting them.
_SVC_NOT_SERVICES = {"functions", "rc", "rcS", "template", "README", "Makefile"}


def _svc_all(initd):
    out = []
    try:
        names = sorted(os.listdir(initd))
    except OSError:
        return out
    for n in names:
        if n in _SVC_NOT_SERVICES or n.endswith((".bak", "~", ".orig", ".new")):
            continue
        p = os.path.join(initd, n)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            out.append(n)
    return out


def _svc_links(rcroot, name):
    """Every rc<N>.d link for this service: [(level, 'S'|'K', num, path)]."""
    out = []
    try:
        entries = sorted(os.listdir(rcroot))
    except OSError:
        return out
    for d in entries:
        m = re.match(r"^rc([0-6S])\.d$", d)
        if not m:
            continue
        full = os.path.join(rcroot, d)
        try:
            for f in sorted(os.listdir(full)):
                lm = re.match(r"^([SK])(\d{2})" + re.escape(name) + r"$", f)
                if lm:
                    out.append((m.group(1), lm.group(1), lm.group(2),
                                os.path.join(full, f)))
        except OSError:
            continue
    return out


def _svc_default_runlevel():
    try:
        for line in open("/etc/inittab"):
            m = re.match(r"^\s*id:([0-6]):initdefault:", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return "3"


def _svc_header_levels(initd, name):
    """Default-Start / Default-Stop from the script's INIT INFO block.

    The book's scripts carry it, so the runlevels a service belongs in are
    written down on the machine -- no need to invent them here."""
    start, stop = "", ""
    try:
        for line in open(os.path.join(initd, name), errors="replace"):
            m = re.match(r"^#\s*Default-Start:\s*(.*)$", line)
            if m:
                start = "".join(re.findall(r"[0-6S]", m.group(1)))
            m = re.match(r"^#\s*Default-Stop:\s*(.*)$", line)
            if m:
                stop = "".join(re.findall(r"[0-6S]", m.group(1)))
            if line.startswith("### END INIT INFO"):
                break
    except OSError:
        pass
    return start, stop


def _svc_enabled_levels(rcroot, name):
    return sorted({lv for lv, kind, _n, _p in _svc_links(rcroot, name) if kind == "S"})


def _svc_running(initd, name, quick=True):
    """'yes' / 'no' / '?' -- asked of the script itself.

    The LSB convention is 0 for running and 1-4 for not, which every script
    from the book follows through statusproc.  A script with no `status` says
    so by failing differently, and '?' is an honest answer."""
    p = os.path.join(initd, name)
    try:
        r = subprocess.run([p, "status"], stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, timeout=10 if quick else 60)
    except (OSError, subprocess.SubprocessError):
        return "?", ""
    out = (r.stdout or b"").decode("utf-8", "replace").strip()
    if r.returncode == 0:
        return "yes", out
    if r.returncode in (1, 2, 3, 4):
        return "no", out
    return "?", out


def _svc_state_file(name):
    return os.path.join(SVC_STATE_DIR, name + ".links")


def cmd_service(args):
    initd, rcroot = _svc_dirs()
    if not initd:
        printError("no /etc/rc.d/init.d (nor /etc/init.d) -- no SysV services here")
        return 1
    # `service sshd start` and `service start sshd` both read naturally;
    # whichever word is an action is the action.
    name, action = args.name, args.action
    if name in SVC_ACTIONS and (action is None or action not in SVC_ACTIONS):
        name, action = action, name
    if not name and not action:
        action = "list"
    if name and not action:
        action = "status"
    if action not in SVC_ACTIONS:
        printError("%s: not one of %s" % (action, ", ".join(SVC_ACTIONS)))
        return 2

    if action == "list":
        return _svc_cmd_list(initd, rcroot, args)

    if not name:
        printError("which service?  packagemanager service list")
        return 2
    script = os.path.join(initd, name)
    if not os.path.isfile(script):
        printError("%s: no such service" % name)
        near = [s for s in _svc_all(initd) if name in s]
        if near:
            printInfo("  did you mean: %s" % ", ".join(near))
        printInfo("  what there is:  packagemanager service list")
        return 1

    if action in ("start", "stop", "restart", "reload", "force-reload", "status"):
        # STARTING IS NOT ENABLING, and it does not ask the links for
        # permission: this is the whole point of being able to run sshd for an
        # afternoon without it coming back at the next boot.
        if action == "start" and not _svc_enabled_levels(rcroot, name):
            printInfo("  %s is not enabled at boot -- starting it anyway" % name)
        if not os.access(script, os.X_OK):
            printWarning("  %s is not executable -- fixing that first" % script)
            _run(["chmod", "755", script])
        return subprocess.run([script, action]).returncode

    # ---- enable / disable: the links, and only the links -------------------
    links = _svc_links(rcroot, name)
    if action == "disable":
        gone = [p for _lv, kind, _n, p in links if kind == "S"]
        if not gone:
            printInfo("%s is already not started at boot" % name)
            return 0
        # REMEMBER EXACTLY WHAT WAS THERE.  The priority number is the only
        # thing that cannot be worked out again -- it lives in the
        # blfs-bootscripts Makefile, which may be long gone by then.
        try:
            os.makedirs(SVC_STATE_DIR, exist_ok=True)
            with open(_svc_state_file(name), "w") as f:
                f.write("\n".join(gone) + "\n")
        except OSError as e:
            printWarning("  could not record the links (%s) -- enable will "
                         "rebuild them from the script's header" % e)
        for p in gone:
            try:
                os.unlink(p)
                printInfo("  removed %s" % p)
            except OSError as e:
                printWarning("  %s: %s" % (p, e))
        printSuccess("%s: disabled (it is not stopped -- `service %s stop` does that)"
                     % (name, name))
        return 0

    # enable
    if _svc_enabled_levels(rcroot, name):
        printInfo("%s is already started at boot (runlevels %s)"
                  % (name, ",".join(_svc_enabled_levels(rcroot, name))))
        return 0
    # 1. the exact links we removed, if we removed them
    restored = []
    try:
        saved = [l.strip() for l in open(_svc_state_file(name)) if l.strip()]
    except OSError:
        saved = []
    for p in saved:
        d = os.path.dirname(p)
        if not os.path.isdir(d):
            continue
        try:
            os.symlink("../init.d/" + name, p)
            restored.append(p)
        except OSError as e:
            printWarning("  %s: %s" % (p, e))
    if restored:
        for p in restored:
            printInfo("  %s -> ../init.d/%s" % (p, name))
        try:
            os.unlink(_svc_state_file(name))
        except OSError:
            pass
        printSuccess("%s: enabled (restored as it was)" % name)
        return 0
    # 2. otherwise build them: the number from a link that survived, the
    #    runlevels from the script's own header.
    num = args.priority or next((n for _lv, _k, n, _p in links), None) or "50"
    start, stop = _svc_header_levels(initd, name)
    if args.levels:
        start = "".join(re.findall(r"[0-6S]", args.levels))
    start = start or "2345"
    stop = stop or "016"
    made = []
    for lv in start:
        d = os.path.join(rcroot, "rc%s.d" % lv)
        if not os.path.isdir(d):
            continue
        p = os.path.join(d, "S%s%s" % (num, name))
        if not os.path.lexists(p):
            try:
                os.symlink("../init.d/" + name, p)
                made.append(p)
            except OSError as e:
                printWarning("  %s: %s" % (p, e))
    for lv in stop:
        d = os.path.join(rcroot, "rc%s.d" % lv)
        if not os.path.isdir(d):
            continue
        p = os.path.join(d, "K%s%s" % (num, name))
        if not os.path.lexists(p):
            try:
                os.symlink("../init.d/" + name, p)
                made.append(p)
            except OSError as e:
                printWarning("  %s: %s" % (p, e))
    if not made:
        printWarning("%s: nothing to link (no rc<N>.d directories?)" % name)
        return 1
    for p in made:
        printInfo("  %s -> ../init.d/%s" % (p, name))
    printSuccess("%s: enabled at runlevels %s (priority %s)" % (name, start, num))
    printInfo("  it is not started yet:  packagemanager service %s start" % name)
    return 0


def _svc_cmd_list(initd, rcroot, args):
    names = _svc_all(initd)
    if not names:
        printInfo("no services in %s" % initd)
        return 0
    default_lv = _svc_default_runlevel()
    printHeader("services  (init scripts in %s, boot links in %s/rc<N>.d)"
                % (initd, rcroot))
    print("  default runlevel: %s\n" % default_lv)
    print("  %-22s %-10s %-9s %s" % ("service", "at boot", "running", "runlevels"))
    print("  " + "-" * 60)
    for n in names:
        lv = _svc_enabled_levels(rcroot, n)
        boot = "yes" if default_lv in lv else ("other" if lv else "no")
        run = "-"
        if not args.quick:
            run, _out = _svc_running(initd, n)
        print("  %-22s %-10s %-9s %s" % (n, boot, run, ",".join(lv) or "-"))
    print()
    printInfo("  packagemanager service <name> start|stop|restart|status")
    printInfo("  packagemanager service <name> enable|disable      (boot only)")
    if args.quick:
        printInfo("  (--quick: 'running' not asked; drop it to ask each script)")
    # THE SERVICES THAT ARE NOT INIT SCRIPTS.  /lib/services/* are what `ifup`
    # hands an interface to; they never appear in rc<N>.d and cannot be
    # started, and not saying so is how "dhcpcd is installed but nothing runs
    # it" happens.
    for sd in ("/lib/services", "/usr/lib/services"):
        if os.path.isdir(sd):
            have = sorted(os.listdir(sd))
            if have:
                print()
                printInfo("  network services in %s (run by ifup, never on their "
                          "own): %s" % (sd, ", ".join(have)))
                printInfo("    an interface uses one by naming it: SERVICE=\"<name>\""
                          " in /etc/sysconfig/ifconfig.<iface>")
            break
    return 0


