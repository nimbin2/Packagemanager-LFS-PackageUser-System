# command: reload-pkg-list                                        [IMPLEMENTED]
# =========================================================================== #
#
# Regenerate /usr/src/<name>/pkg.lst from `list_package <name>`.  By default the
# work runs as a DETACHED (disowned) background task -- new session, no
# controlling terminal -- so it survives this process exiting and can't be
# interrupted with Ctrl-C.  Use --foreground to wait for it.
# LIST_PACKAGE_BIN overrides the `list_package` command (for testing).

def find_list_package():
    return os.environ.get("LIST_PACKAGE_BIN", "list_package").split()


def _can_su(user):
    """We can su to the user only if we're root and the user exists."""
    if os.geteuid() != 0 or pwd is None:
        return False
    try:
        pwd.getpwnam(user)
        return True
    except KeyError:
        return False


def _python_module_here(name):
    """Is a module of this name importable by the system python?"""
    mod = name.replace("-", "_")
    try:
        return subprocess.run(
            ["python3", "-c",
             "import importlib.metadata as m,sys;m.version(sys.argv[1])", mod],
            capture_output=True, timeout=20).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# WHAT A MANIFEST SCAN MUST NOT WALK.
#
# `reload-pkg-list p_linux` took minutes, and the time went nowhere near the
# installed files: the scan walked /usr/src/pkgusr -- every package user's
# unpacked source tree, the kernel's own quarter-million files among them --
# plus /proc, /sys, the snapshots and the caches.  None of it can contain an
# INSTALLED file by definition: a package's home is excluded from its own
# manifest, and no package installs into another's source tree.
_SCAN_SKIP = ["/proc", "/sys", "/dev", "/run", "/tmp", "/var/tmp",
              "/var/cache", "/mnt", "/media", "/lost+found",
              "/.snapshots", "/snapshots", "/sources", "/build"]


def _scan_prune_args():
    """find(1) arguments that skip those directories (and stay on one fs)."""
    skips = list(_SCAN_SKIP) + [d.rstrip("/") for d in pkgusr_roots()]
    out = ["-xdev", "("]
    for i, d in enumerate(skips):
        if i:
            out.append("-o")
        out += ["-path", d]
    out += [")", "-prune", "-o"]
    return out


def write_pkg_list(user, background=True, as_root=False):
    """Regenerate /usr/src/<user>/pkg.lst.  Runs list_package AS the package
    user (su -) when possible, so it only scans directories that user owns --
    much faster than scanning the whole filesystem as root."""
    # THE ACCOUNT NAME, NOT THE PACKAGE NAME.
    #
    # `packagemanager reload-pkg-list mpv` passed "mpv" straight through.
    # pkgusr_home() accepts either, so the home resolved; _can_su("mpv") did
    # not, because the account is p_mpv -- so it took the root branch and ran
    # `list_package mpv`, which found no such user, produced nothing, and left
    # an empty root-owned pkg.lst.new behind.  And it printed "regeneration
    # started".
    user = pkgusr_name(user)
    home = pkgusr_home(user)
    if not os.path.isdir(home):
        printError(f"{user}: no package home at {home}")
        return False
    lp = " ".join(shlex.quote(x) for x in find_list_package())
    quser = shlex.quote(user)

    # THE HOME IS NOT INSTALLED FILES.
    #
    # list_package lists everything the account owns, and that includes its
    # own home -- sources, build trees, the install script.  For the kernel
    # that is the whole tree:
    #     # recorded 266621 file(s) for p_linux
    # A manifest is what the package put ON THE SYSTEM, which is what
    # `verify` checks and what `remove` deletes; 266k source files in it
    # make both meaningless.  The build's own tracking has always excluded
    # the home (it compares snapshots of the tree outside it); this is the
    # same rule for the rescan.  awk, not grep, because a filter that
    # removes every line must still exit 0.
    # ...AND NOT THROUGH A SYMLINK INTO IT.
    #
    # Excluding the home was not enough: modules_install leaves
    # /lib/modules/<ver>/build as a SYMLINK to the source tree, the scan
    # follows it, and the same quarter-million files come back recorded as
    # /lib/modules/<ver>/build/... -- outside the home, so the home filter
    # never saw them.  The symlink itself belongs in the manifest; what is
    # on the far side of it does not.
    #
    # The prefix match (index()==1) was too strict: it assumed every line is
    # an absolute path starting exactly at the home, and the manifest stayed
    # at 268k entries with the filter in place.  Matching the home ANYWHERE
    # in the line cannot be fooled by a leading ./ or a relative listing,
    # and no installed file has a package home in its path.
    _filter = ("awk -v h=%s -v m=/var/mail/ -v s=/var/spool/mail/ "
               "'index($0,h) { next } "
               " index($0,m)==1 { next } "
               " index($0,s)==1 { next } "
               " /\\/lib\\/modules\\/[^/]+\\/build\\// { next } "
               " /\\/lib\\/modules\\/[^/]+\\/source\\// { next } "
               " { print }'"
               % shlex.quote(home.rstrip("/") + "/"))
    # THE SCAN ITSELF, PRUNED.  `list_package` is the hint's script and walks
    # everything; this is the same question asked of the same filesystem
    # without the directories that cannot hold an installed file.  It is run
    # AS the package user, which also skips every directory that account
    # cannot read -- and that is the difference between minutes and seconds
    # on a machine with 90 source trees.  --root scans as root instead: it
    # reaches directories the account cannot enter (0700 dirs owned by
    # somebody else), and takes the long way round.
    _find = " ".join(shlex.quote(x) for x in
                     ["find", "/"] + _scan_prune_args()
                     + ["-user", user, "-print"])
    _scan = f"{_find} 2>/dev/null | LC_ALL=C sort -u"
    if _can_su(user) and not as_root:
        # su - starts in the user's home, so pkg.lst.new/pkg.lst are ~/...
        inner = (f"{_scan} | {_filter} > pkg.lst.new"
                 f" && mv pkg.lst.new pkg.lst")
        cmd = ["su", "-", user, "-c", inner]
    else:
        tmp = shlex.quote(os.path.join(home, "pkg.lst.new"))
        dst = shlex.quote(os.path.join(home, "pkg.lst"))
        cmd = ["sh", "-c", f"{_scan} | {_filter} > {tmp}"
                           f" && mv {tmp} {dst}"
                           f" && chown {quser} {dst} 2>/dev/null; true"]

    if background:                                    # detached / disowned
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    return subprocess.run(cmd).returncode == 0


def cmd_reload_pkg_list(args):
    # SAY WHAT HAPPENED, NOT THAT IT STARTED.
    #
    # A disowned task that dies in its first second reported "regeneration
    # started" and left the user watching an empty pkg.lst.new and an empty
    # process table.  This command is asked for by a person, so it runs in the
    # foreground by default and reports the RESULT; --background is there for
    # anyone who wants the old behaviour.
    rc = 0
    for user in args.packages:
        acct = pkgusr_name(user)
        if getattr(args, "background", False):
            if write_pkg_list(user, background=True):
                printInfo(f"{acct}: pkg.lst regeneration started"
                          f" (disowned background task).")
            continue
        _as_root = getattr(args, "root", False)
        printInfo(f"{acct}: scanning for files it owns "
                  + ("as root (every directory) ..." if _as_root
                     else f"as {acct} ..."))
        _t0 = time.time()
        if not write_pkg_list(user, background=False, as_root=_as_root):
            printError(f"{acct}: could not regenerate pkg.lst")
            rc = 1
            continue
        manifest = os.path.join(pkgusr_home(acct), "pkg.lst")
        try:
            with open(manifest) as f:
                n = sum(1 for line in f if line.strip())
        except OSError:
            n = 0
        if n:
            printSuccess(f"{acct}: {n} file(s) recorded in {manifest}"
                         f"  ({time.time() - _t0:.0f}s)")
            if not _as_root:
                # SAY WHAT THE FAST SCAN CANNOT SEE.  A file this package
                # owns inside a directory it may not read is not in this
                # list, and nothing else would ever say so.
                printInfo(f"  scanned as {acct}: directories it cannot enter"
                          f" were skipped, and so were")
                printInfo(f"  {', '.join(_SCAN_SKIP[:6])} ... and the package"
                          f" source roots.")
                printInfo(f"  If something is missing:  packagemanager"
                          f" reload-pkg-list {user} --root")
        else:
            printWarning(f"{acct}: no files found -- it owns nothing on disk.")
            printInfo("  Either it was never installed, or its files ended up"
                      " owned by someone else.")
    return rc


