# =========================================================================== #
# command: check                                                  [IMPLEMENTED]
# =========================================================================== #
#
# Report the install state of one or more packages and, when possible, compare
# the installed version (from install_last) against the current book version
# (via `blfs debug`).  The package's book anchor is taken from install_last's
# recorded name when present, else the package-user name.
#
# Result per package (also reflected in the exit code):
#   installed (up to date)      user+home+pkg.lst, installed == book
#   update: X -> Y              installed, but book has a different version
#   installed                   installed, book version unknown/unchecked
#   not installed               user+home exist, no pkg.lst yet
#   broken                      user/dir inconsistency
# Exit code: 0 if every requested package is installed & up to date, else 1.

def check_one(name, use_book=True):
    """Return (User, book_ver, status) for one package."""
    u = gather_user(name)
    anchor = u.meta.get("name") or name
    book_ver = book_version(anchor) if use_book else None
    if u.state == "broken":
        status = "broken"
    elif u.state == "not installed":
        status = "not installed"
    elif book_ver and u.version and book_ver != u.version:
        status = f"update: {u.version} -> {book_ver}"
    elif book_ver and u.version and book_ver == u.version:
        status = "installed (up to date)"
    else:
        status = "installed"
    return u, book_ver, status


def _status_color(status):
    if status.startswith("update:"):
        return colors.cyan
    if status.startswith("installed"):
        return colors.green
    if status == "not installed":
        return colors.yellow
    return colors.red                                 # broken


def cmd_check(args):
    all_ok = True
    for name in args.packages:
        u, book_ver, status = check_one(name, use_book=not args.no_book)
        if not status.startswith("installed"):     # update:/not installed/broken
            all_ok = False
        color = _status_color(status)
        tail = ""
        if u.version and status in ("installed", "broken", "not installed"):
            tail = f"   [{u.version}]"
        print(f"{name:<20} {color}{status}{colors.normal}{tail}")
    sys.exit(0 if all_ok else 1)
# =========================================================================== #
# command: search                                                 [IMPLEMENTED]
# =========================================================================== #
#
# `blfs search` hits, each annotated with the book version (the title), the
# local install state, and the installed version when present.

_SEARCH_RE = re.compile(r"^\s*\[(package|module)\s*\]\s+(\S+)\s+(.+?)\s*$")


def install_tag(anchor, book_version_str):
    """Colored 'installed/update/not installed/broken' tag for an anchor whose
    current book version is book_version_str."""
    u = gather_user(anchor)
    if u.state == "broken":
        return colors.red + "broken" + colors.normal
    if u.state != "installed":
        return colors.yellow + "not installed" + colors.normal
    if u.version and book_version_str and u.version != book_version_str:
        # "the book has moved on", not "this will be updated": nothing in a
        # stack run changes an installed package.
        return (colors.cyan + f"installed {u.version} (book is newer)"
                + colors.normal)
    return colors.green + f"installed {u.version or ''}".rstrip() + colors.normal


def cmd_search(args):
    rc, out, err = run_blfs(["search"] + args.packages)
    if rc == 127:
        printError("blfs not found (set BLFS_BIN or put blfs on PATH).")
        sys.exit(1)
    hits = 0
    for line in out.splitlines():
        m = _SEARCH_RE.match(line)
        if not m:
            continue                                  # blfs summary / no-match
        hits += 1
        kind, anchor, book_ver = m.group(1), m.group(2), m.group(3)
        print(f"  [{kind:<7}] {anchor:<26} {book_ver:<24} "
              f"{install_tag(anchor, book_ver)}")
    if hits == 0:
        msg = (out or err).strip()
        print(msg if msg else
              f"No package matching {', '.join(args.packages)!r}.")


# =========================================================================== #
# command: dependencies                                           [IMPLEMENTED]
# =========================================================================== #
#
# Recursive dependency order, each line annotated with local install state and,
# for dependency packages, HOW it was pulled in: the kind (required/recommended/
# optional) and the parent package that required it.  --tree shows blfs's tree
# verbatim; --no-recommended / --optional pass through.

def blfs_order_anchors(name, no_recommended=False, optional=False, ignore=None):
    """Return (order, missing): order is [(anchor, name_version, kind, parent)],
    missing is [(name, kind, parent)], via blfs order --anchors.

    `ignore` is passed to the WALK, not applied to the result: a package that
    is not built should not drag its own dependencies in behind it.
    """
    argv = ["order", name, "--anchors"]
    if no_recommended:
        argv.append("--no-recommended")
    if optional:
        argv.append("--optional")
    if ignore:
        argv += ["--ignore", ",".join(sorted(ignore))]
    rc, out, err = run_blfs(argv)
    if rc == 127:
        printError("blfs not found (set BLFS_BIN or put blfs on PATH).")
        sys.exit(1)
    if rc != 0:
        # ONE BAD NAME MUST NOT KILL THE WHOLE COMMAND.
        #
        # `blfs order` exits 1 for a name the book does not have, and this
        # turned that into sys.exit(1) for the entire run.  So
        #     packagemanager install <12 names> --run --recursive
        # died on the first name that is not a BLFS package -- and since the
        # exit came before any plan was printed, the person saw the book note
        # and nothing else.  Report it and hand back an empty order; the
        # caller records it in `not_found` and carries on with the rest.
        printError((err or out).strip() or f"blfs order {name} failed")
        return [], []
    order, missing = [], []
    for line in out.splitlines():
        if "\t" not in line:                          # skip any stray output
            continue
        cols = line.split("\t")
        cols += [""] * (4 - len(cols))
        left, nv, kind, parent = cols[:4]
        left = left.strip()
        if left == "#ignored-required":
            _IGNORED_REQUIRED.append((nv.strip(), kind.strip()))
        elif left == "#cycle":
            # a dependant the walker had to build BEFORE something it
            # recommends, because the cycle admits no order satisfying both
            _CYCLE_PAIRS.append((nv.strip(), kind.strip()))
        elif left == "#missing":
            missing.append((nv.strip(), kind, parent))
        elif left and " " not in left and nv.strip():
            order.append((left, nv.strip(), kind, parent))
    return order, missing


def cmd_dependencies(args):
    name = args.packages[0]
    if args.tree:
        argv = ["deps", name, "--tree"]
        if args.no_recommended:
            argv.append("--no-recommended")
        if args.optional:
            argv.append("--optional")
        rc, out, err = run_blfs(argv)
        print(out if rc == 0 else (err or out).strip())
        return

    order, missing = blfs_order_anchors(name, args.no_recommended, args.optional)
    # anchor -> name_version, to show the parent by its versioned name
    nv_of = {a: nv for a, nv, _, _ in order}
    printHeader(f"Install order for {name} ({len(order)} packages)")
    print()
    need = 0
    for anchor, nv, kind, parent in order:
        u = gather_user(anchor)
        if u.state == "installed" and (not u.version or u.version == nv):
            state = colors.green + "installed" + colors.normal
        elif u.state == "installed":
            state = colors.cyan + f"update ({u.version})" + colors.normal
            need += 1
        else:
            state = colors.yellow + "needs install" + colors.normal
            need += 1
        origin = ""
        if kind and parent:
            origin = f"   ({kind} by {nv_of.get(parent, parent)})"
        print(f"  {nv:<30} {state}{origin}")
    if missing:
        print()
        printWarning("Out-of-book / missing (handle manually):")
        for m, kind, parent in sorted(set(missing)):
            extra = f"  ({kind} by {nv_of.get(parent, parent)})" if kind and parent else ""
            print(f"  {m}{extra}")
    print(f"\n{len(order)} in order, {need} to build"
          + (f", {len(set(m for m, _, _ in missing))} missing" if missing else ""))
# =========================================================================== #
# command: install                                                [IMPLEMENTED]
# =========================================================================== #
#
# Resolve the recursive install order (via blfs), work out which packages
# actually need building (state != installed, or --reinstall), generate an
# install script for each with `blfs script`, and either print the plan
# (default, safe) or run lfs-helper pm-install for each in order (--run).
#
#   -f/--force            just the named package(s), skip dependency resolution
#   -r/--reinstall        rebuild even packages that are already up to date
#   -e/--ignore-recommended   required deps only
#      --optional         also pull in optional deps
#   -i/--ignore a,b,c     skip these anchors
#      --run              actually execute (default is a dry run / plan)
#      --yes              don't ask for confirmation before --run
#   -o/--outdir DIR       where to write the generated scripts

def _blfs_book_available():
    """Is there a BLFS book on disk to look packages up in?

    Asking `blfs books` is no good: it also lists every version available on
    the site, so the output is never empty and the answer was always yes."""
    if os.environ.get("BLFS_BOOK_FILE"):
        return os.path.isfile(os.environ["BLFS_BOOK_FILE"])
    for cand in (os.environ.get("BLFS_STORE"), "/usr/share/blfs",
                 os.path.expanduser("~/.cache/blfs")):
        if not cand:
            continue
        d = os.path.join(cand, "books")
        try:
            if any(f.endswith((".html", ".html.gz")) for f in os.listdir(d)):
                return True
        except OSError:
            continue
    return False


def _download_tool_available():
    return bool(shutil.which("wget") or shutil.which("curl"))


def _explain_no_blfs_book(target):
    """No book, and say so in terms of what can actually be done from here.

    "run `blfs fetch`" is sound advice on a system that can reach the network.
    On a fresh chroot it is the circle itself: fetching needs the download
    tool, the download tool is looked up in the book, and the book is what is
    missing.  Telling someone to close a circle by going round it once more is
    worse than saying nothing.

    The host resolves wget's URL FROM THE BOOK too (`blfs sources wget`, via
    lfs's bootstrap_sources), so a host with no cached book staged no wget
    tarball either -- both halves are missing together, and both are fixed in
    the same trip.  Say which of them is actually absent rather than making
    the person find out one at a time.
    """
    srcdir = setup_sources_dir()
    have_tool = _download_tool_available()
    try:
        have_tarball = any(f.startswith("wget-") and ".tar" in f
                           for f in os.listdir(srcdir))
    except OSError:
        have_tarball = False

    printError(f"{target}: there is no BLFS book on this system to look "
               f"it up in.")
    printInfo("")
    if have_tool:
        printInfo("  Fetch one:")
        printInfo("      blfs fetch")
        printInfo("  or import a copy:")
        printInfo("      blfs import /path/to/BLFS-BOOK-...-nochunks.html")
        printInfo("")
        return

    printInfo("  There is no download tool on this system either, so")
    printInfo("  `blfs fetch` cannot work from in here -- that circle is what")
    printInfo("  bootstrap exists to break, and it is broken from the HOST.")
    printInfo("")
    printInfo("  The host stages both halves into the tree's own sources")
    printInfo(f"  directory, which it sees as $LFS{srcdir}:")
    printInfo("")
    printInfo("    # on the host, which still has a network")
    printInfo("    blfs fetch                     # or: blfs import <book.html>")
    if not have_tarball:
        printInfo("    blfs sources wget              # the URL to download")
        printInfo(f"    wget -P $LFS{srcdir} <that URL>")
    printInfo(f"    cp <book.html> $LFS{srcdir}/")
    printInfo("")
    printInfo("    # back in here")
    printInfo(f"    blfs import {srcdir}/<book.html>")
    printInfo("    packagemanager bootstrap --run")
    printInfo("")
    printInfo("  Already on this system: "
              + ("the wget tarball is in %s" % srcdir if have_tarball
                 else "no wget tarball in %s either" % srcdir))
    printInfo("  (`lfs build-system install-tools` copies a book the host has")
    printInfo("   cached; it said so at the time if there was none.)")
    printInfo("")


def _explain_not_in_book(target):
    """Say why a package could not be found, and what to do about it.

    "not found in book" is unhelpful when the real problem is that there IS no
    book -- a fresh chroot has the LFS book but not the BLFS one, and every
    lookup fails the same way."""
    if not _blfs_book_available():
        _explain_no_blfs_book(target)
        return
    printError(f"{target}: not in the BLFS book.")
    rc, out, _e = run_blfs(["search", target])
    hits = [ln for ln in out.splitlines() if ln.strip().startswith("[")][:5]
    if hits:
        printInfo("  Did you mean:")
        for h in hits:
            printInfo("    " + h.strip())
    else:
        printInfo(f"  Nothing similar found either.  Try: blfs search {target}")


def _install_finished(u):
    """Positive evidence that an install FINISHED -- not that one started.

    THIS IS WHY THE STACK NEEDED HAND-HOLDING.  `install_last` is copied
    into the package home BEFORE the build runs (lfs-helper: "RECORD WHAT
    IS INSTALLED BEFORE OVERWRITING THE RECORD"), so a build that dies at
    configure leaves one behind.  For a package whose page declares no
    programs or libraries to check -- cairomm is one -- `state` then has
    nothing else to go on and answers "installed".

    cairomm-1.0 failed at configure with 0 files tracked, was recorded
    installed by that rule, and every later plan SKIPPED it as a dependency
    that was already there.  pangomm found out the hard way:
        Run-time dependency cairomm-1.0 found: NO
    and the person had to name it by hand to get the chain moving.

    A manifest with real paths, or the marker the runner writes after a
    SUCCESSFUL install, is evidence.  A script that was copied in before
    the build is not.
    """
    if getattr(u, "pkg_list", None):
        return True
    home = getattr(u, "home", "") or ""
    return bool(home) and os.path.isfile(os.path.join(home, ".pkgusr-installed"))


def build_install_plan(args):
    """Return (plan, missing, why).  plan = [(anchor, name_version, reason)] in
    install order (deps first); reason in {new, update, reinstall}.  why maps
    anchor -> (kind, parent) so we can show 'required by <parent>'."""
    ignore = {x for x in (args.ignore or "").split(",") if x}
    # THE AVOID LIST IS A PROPERTY OF THE MACHINE, NOT OF A STACK RUN.
    #
    # `install linux-pam --run --recursive` planned **Systemd-261.2** on a
    # SysV system.  avoid.stack says `avoid systemd` and has since 1.14.224 --
    # but only `stack` ever read it, so a bare install walked the book's
    # graph with no exclusions at all and offered to install the one thing
    # this machine must never have.
    #
    # A package named ON THE COMMAND LINE is still built: asking for it
    # explicitly is an instruction, and refusing that would be second-
    # guessing.  It is dependencies that are filtered.
    _named = {a for a in (args.packages or [])}
    _avoided = _machine_avoids() - _named
    if _avoided:
        ignore |= _avoided
        # SAY IT, because an avoided REQUIRED dependency changes the build.
        # linux-pam's page (in the systemd book) lists systemd as required;
        # skipping it is the right call on a SysV machine and the reader
        # still needs to know it happened.
        printInfo("  %d package(s) this machine never builds are excluded "
                  "from the plan" % len(_avoided))
        printInfo("    (avoid.stack; a package you name yourself is still "
                  "built).  If the plan")
        printInfo("    then looks short, one of them was a dependency: "
                  "packagemanager deps <pkg>")
        printInfo("    the list: packagemanager stack avoid --avoided")
    plan, seen, missing_all, why = [], set(), [], {}
    # WHAT IS ALREADY DONE, counted as we go.
    #
    # A re-run recomputes the whole tree and prints only what is LEFT, so a
    # plan that has shrunk 181 -> 151 -> 135 across three runs reads as three
    # identical fresh starts.  The progress was real and invisible.
    build_install_plan.already = set()
    build_install_plan.behind = []          # installed deps the book has moved past
    build_install_plan.unproven = []       # "installed", with nothing to show for it
    _not_found = []
    # Reading the book can take many seconds the first time (it is indexed
    # once per version).  Without a word on screen that looks like a hang, so
    # say what is happening as it happens.
    set_status("reading the book ...")

    def consider(anchor, nv, kind="", parent=""):
        if anchor not in why:
            why[anchor] = (kind, parent)
        if anchor in seen or anchor in ignore:
            return
        seen.add(anchor)
        # A DEPENDENCY OUTSIDE A STACK BOOK READS ITS OWN BOOK.  The order
        # came from the svn book, so it carries svn's versions for
        # everything; a dependency the stack does not own is judged -- and
        # built, if missing -- against the book it always reads.
        if _PLAN_BOOK and _book_override(anchor) != _PLAN_BOOK:
            nv = default_book_version(anchor) or nv
        u = gather_user(anchor)
        _done = u.state == "installed" and _install_finished(u)
        if u.state == "installed" and not _done:
            # recorded, but nothing says the install ever finished
            build_install_plan.unproven.append(anchor)
        up_to_date = (_done and (not u.version or u.version == nv))
        if up_to_date:
            build_install_plan.already.add(anchor)
        # AN INSTALLED DEPENDENCY IS NOT A THING TO UPGRADE.
        #
        # `install gparted --recursive` planned 53 packages: gparted, its
        # real missing dependencies -- and UPDATES of bubblewrap, alsa-lib,
        # gtk3, gtk4, librsvg, glycin and thirty others that are installed
        # and working, purely because the book has moved on since they were
        # built.  Asking for one program is not asking to rebuild the
        # desktop, and each of those rebuilds is a chance to break a
        # machine that was fine.
        #
        # So: a DEPENDENCY that is installed is left alone, whatever version
        # it is.  A package NAMED on the command line still goes through
        # (that is an instruction), --update-deps restores the old
        # behaviour, and `update --stack <name>` is the deliberate way to
        # move a whole chain forward.
        elif (_done and anchor not in _named
              and not getattr(args, "update_deps", False)):
            build_install_plan.already.add(anchor)
            build_install_plan.behind.append((anchor, u.version or "?", nv))
            return
        if args.reinstall:
            plan.append((anchor, nv, "reinstall" if up_to_date else
                         ("update" if u.state == "installed" else "new")))
        elif not up_to_date:
            plan.append((anchor, nv,
                         "update" if u.state == "installed" else "new"))

    global _PLAN_BOOK
    for target in args.packages:
        set_status(f"working out what {target} needs ...")
        _PLAN_BOOK = None
        _tb = _book_override(target)
        _PLAN_BOOK = _tb if _tb and os.path.isfile(_tb) else None
        if not getattr(args, "recursive", False):
            # DEFAULT: just this package, no dependency walk
            nv = book_version(target)
            if nv is None:
                clear_status()
                _explain_not_in_book(target)
                _not_found.append(target)
                continue
            consider(target, nv, "requested", "")
        else:
            # THE PRUNE BELONGS TO THE WALK, AND NOW IT IS THERE (1.14.24).
            #
            # 1.12.82 pruned HERE, on the finished list, and was reverted for
            # a good reason: `blfs order` reports ONE parent per package, so
            # graphite2 -- recorded under an ignored parent but genuinely
            # needed by harfbuzz -- was dropped, and the build failed with
            #     Dependency 'graphite2' is required but not found
            # The note then read "pruning needs every edge, which this output
            # does not carry".  Right, so it moved to where the edges are:
            # walk_deps does not descend into an ignored package, and anything
            # another package needs is still reached through that package.
            #
            # Until then --ignore dropped only the named package and kept
            # everything it alone wanted: harfbuzz with libreoffice ignored
            # planned 230 packages, of which PostgreSQL, unixODBC, CLucene,
            # Redland, OpenJDK, apache-ant and Cups were nobody else's.  It
            # comes to 46 now, with icu, libxml2, fontconfig, curl and
            # graphite2 all still present.  sway.stack's 80-name avoid list
            # was the workaround.
            order, missing = blfs_order_anchors(
                target, args.ignore_recommended, args.optional, ignore=ignore)
            # A NAME THE BOOK DOES NOT HAVE, IN THE RECURSIVE PATH.
            #
            # The non-recursive branch explains and records it; this one got
            # an empty order back and moved on WITHOUT A WORD.  So
            #     packagemanager install <12 names> --run --recursive
            # printed the book note and nothing else, and the person could not
            # tell whether it had worked, refused, or crashed.  Silence is the
            # one answer a command must never give.
            if not order:
                clear_status()
                _explain_not_in_book(target)
                _not_found.append(target)
                continue
            missing_all.extend(m for m, _, _ in missing)
            for anchor, nv, kind, parent in order:
                consider(anchor, nv,
                         "requested" if not parent else (kind or "required"),
                         parent or target)
            if getattr(args, "dependents", False):    # also rebuild reverse deps
                for danchor, dnv in book_rdeps(
                        target, args.ignore_recommended, args.optional).items():
                    consider(danchor, dnv, "dependent-of", target)
    return plan, missing_all, why, _not_found


def _select_plan_rows(rows, render):
    """Interactive subset picker.  Everything is selected by default; type a
    selection to narrow it.  Syntax:
        (empty) / all           keep everything
        none                    keep nothing
        1,3,5-8                 keep only these
        all,!4,!7               everything except 4 and 7
        !4,!7                   (no positives) => everything except 4 and 7
    """
    print("\nPlan -- all selected by default. Enter to keep all, or edit the set")
    print("(e.g. '1,3,5-8'  |  'all,!4,!7'  |  '!4,!7'  |  'none'):")
    for i, row in enumerate(rows, 1):
        print(f"  [{i:>3}] {render(row)}")

    def expand(tok):
        out = set()
        tok = tok.strip().lstrip("!")
        if "-" in tok:
            try:
                lo, hi = tok.split("-", 1)
                out.update(range(int(lo), int(hi) + 1))
            except ValueError:
                pass
        elif tok.isdigit():
            out.add(int(tok))
        return out

    try:
        ans = input("select> ").strip().lower()
    except EOFError:
        ans = ""
    if ans in ("", "all", "a"):
        return rows
    if ans in ("none", "n", "q"):
        return []

    parts = [p for p in re.split(r"[,\s]+", ans) if p]
    positives = [p for p in parts if not p.startswith("!")]
    negatives = [p for p in parts if p.startswith("!")]
    numeric_pos = [p for p in positives if p not in ("all", "a")]
    # start from "all" if no numeric positives were given (or 'all' was typed)
    if not numeric_pos or "all" in positives or "a" in positives:
        keep = set(range(1, len(rows) + 1))
    else:
        keep = set()
    for p in numeric_pos:
        keep |= expand(p)
    for n in negatives:
        keep -= expand(n)
    return [r for i, r in enumerate(rows, 1) if i in keep]


def find_local_script(name):
    """Look for a local install script for `name` (e.g. one made with
    `template`) in INSTALL_SCRIPTS_DIR or the current directory."""
    for d in (INSTALL_SCRIPTS_DIR, "."):
        try:
            for fn in sorted(os.listdir(d)):
                if fn == f"install_{name}" or fn.startswith(f"install_{name}-"):
                    return os.path.abspath(os.path.join(d, fn))
        except OSError:
            continue
    return None


def install_local(name, path, run, yes, verb="install", test=False, clean=False):
    """Build/install a single package from a local install script (custom or
    git-based).  Used by both install --local and update --local."""
    if not path or not os.path.isfile(path):
        printError(f"{name}: no local install script found "
                   f"(make one with: packagemanager template {name}).")
        sys.exit(1)
    printHeader(f"Local {verb}: {name}")
    print(f"\n  script : {path}")
    if not run:
        printInfo("\nDry run -- to proceed, re-run with --run, or execute:\n"
                  f"  lfs-helper pm-install {name} {path}")
        return
    _acct = pkgusr_name(name)
    if not _user_exists(_acct) and (yes or ask_yes_no(
            f"\nPackage-user {_acct} doesn't exist -- create it first?")):
        _run(find_add_package_user() + [_acct, _acct, "10000", "20000",
                                        _acct, "10000", "20000"])
    if not yes and not ask_yes_no(f"Build and {verb} {name} now?"):
        printWarning("Aborted.")
        return
    printHeader(f"{verb.capitalize()}ing {name} (local)")
    env = {**os.environ, "PM_YES": "1" if yes else "0",
           "PM_MODE": "update" if verb == "update" else "all"}
    if test:
        env["PM_TEST"] = env["PKGUSR_TESTS"] = "1"
    old_paths = _pkglist_paths(name) if clean else None
    t0 = time.time()
    if clean:
        env = {**env, "PM_NO_REFRESH": "1"}
    result = run_pm_install(name, path, env)
    if result.returncode != 0:
        printError(f"{verb} failed for {name} (exit {result.returncode}).")
        printInfo(f"  logs: {_pkg_log_dir(name)}")
        sys.exit(result.returncode)
    if clean:
        _clean_after_install(name, old_paths, t0)
    printSuccess(f"Done -- {name} {verb}ed.  logs: {_pkg_log_dir(name)}")


def _stack_git_entry(name):
    """The git/tar entry for `name` in an installed stack, or None."""
    d = STACK_DIR if "STACK_DIR" in globals() else "/etc/pkgusr/stacks"
    for f in sorted(glob.glob(os.path.join(d, "*.stack"))):
        try:
            for r in _parse_stack_file(f):
                if r["kind"] in ("git", "tar") and r["target"] == name:
                    return r
        except (ValueError, OSError):
            continue
    return None


def _install_git_packages(args):
    """Build the git packages among args.packages from their own scripts.

    NO BOOK.  `install --reinstall imv` asked the book about imv three
    times (an index lookup, `blfs debug`, `blfs search`), took a minute to
    say "not in the BLFS book", and built nothing -- imv is a git entry of
    apps.stack, and its script is in its home.  A git package is recognised
    from that script (or from a stack's git/tar entry, the first time),
    before anything asks the book.  --clean and --test go through as they
    do for `update`.  Returns the names it handled."""
    done = []
    for name in list(args.packages or []):
        script = _canonical_script_path(name)
        if not script:
            p = os.path.join(pkgusr_home(name), "install_%s" % name)
            script = p if os.path.isfile(p) else None
        is_git = bool(script) and _is_git_package(name)
        entry = None if is_git else _stack_git_entry(name)
        if not is_git and not entry:
            continue
        done.append(name)
        if entry and not script:
            script, _ = _stack_git_script(
                entry, os.path.join(TMP_DIR, "stack_files"))
        u = gather_user(name)
        if u.state == "installed" and not args.reinstall:
            printSuccess("%s: installed (a %s package).  Rebuild it: "
                         "--reinstall [--clean];  new commits: update %s"
                         % (name, entry["kind"] if entry else "git", name))
            continue
        printInfo("%s: %s package -- building from %s (no book lookup)"
                  % (name, entry["kind"] if entry else "git", script))
        if script != (_canonical_script_path(name) or "") and entry:
            apply_machine_opts(name, script)
        install_local(name, script, args.run, args.yes, "install",
                      test=getattr(args, "test", False),
                      clean=getattr(args, "clean", False))
    return done


def cmd_install(args, _replanned=False):
    # ---- git packages: their own script, never the book ----
    if not args.local and args.packages:
        _git_done = _install_git_packages(args)
        if _git_done:
            args.packages = [p for p in args.packages if p not in _git_done]
            if not args.packages:
                return
    # ---- local package: install a custom script directly, no BLFS ----
    if args.local or (len(args.packages) == 1
                      and book_version(args.packages[0]) is None
                      and find_local_script(args.packages[0])):
        name = args.packages[0]
        path = os.path.abspath(args.local) if args.local else find_local_script(name)
        install_local(name, path, args.run, args.yes, "install",
                      test=getattr(args, "test", False),
                      clean=getattr(args, "clean", False))
        return

    plan, missing, why, not_found = build_install_plan(args)
    if missing:
        printWarning("Out-of-book / missing (install these manually): "
                     + ", ".join(sorted(set(missing))))
    if not plan:
        if not_found:
            # NOT success: the package could not be looked up at all.  Saying
            # "everything is installed and up to date" here told the user the
            # opposite of the truth.
            printError("Could not install: " + ", ".join(not_found))
            sys.exit(1)
        printSuccess("Nothing to do -- everything is installed and up to date.")
        return

    def why_str(anchor):
        kp = why.get(anchor)
        if not kp:
            return ""
        kind, parent = kp
        if kind == "requested":
            return "requested"
        if kind == "dependent-of":
            return f"depends on {parent}"
        return f"{kind} by {parent}"

    _unproven = getattr(build_install_plan, "unproven", []) or []
    if _unproven:
        printWarning("  %d package(s) are recorded as installed but have no"
                     " finished-install record:" % len(_unproven))
        printWarning("    " + ", ".join(sorted(set(_unproven))[:8])
                     + (" ..." if len(set(_unproven)) > 8 else ""))
        printInfo("    Their install_last was written before a build that did"
                  " not finish, so they")
        printInfo("    are in this plan rather than skipped -- which is what"
                  " lets the stack run")
        printInfo("    through without naming them by hand.")
    _behind = getattr(build_install_plan, "behind", []) or []
    if _behind:
        printInfo("  %d installed dependency(ies) are older than the book and"
                  " are NOT touched:" % len(_behind))
        printInfo("    " + ", ".join("%s (%s -> %s)" % (a, iv, bv)
                                     for a, iv, bv in _behind[:6])
                  + (" ..." if len(_behind) > 6 else ""))
        printInfo("    that is deliberate: one program is not a reason to"
                  " rebuild what works.")
        printInfo("    move them forward on purpose:  packagemanager update"
                  " <name> --run")
        printInfo("    or build this plan against them: add --update-deps")
    if getattr(args, "select", False):
        plan = _select_plan_rows(
            plan, lambda r: f"{r[1]:<30} {r[2]:<10} {why_str(r[0])}")
        if not plan:
            printWarning("Nothing selected.")
            return

    script_dir = args.outdir or os.path.join(TMP_DIR, "install_files")
    os.makedirs(script_dir, exist_ok=True)

    # A ONE-PACKAGE PLAN WITH MISSING DEPENDENCIES IS A TRAP.
    #
    # `packagemanager install ffmpeg --run` (no --recursive) plans exactly
    # one package and says "1 to build" -- then the build dies on
    #     ERROR: libass >= 0.11.0 not found using pkg-config
    # because libass was never installed and was never going to be.  The
    # plan knows; it just did not say.
    if not getattr(args, "recursive", False) and len(plan) == 1:
        # A SWALLOWED EXCEPTION HERE IS SILENCE WHERE THE WARNING SHOULD BE.
        #
        # `except (SystemExit, Exception): _missing = []` made a failed
        # dependency lookup indistinguishable from "no missing
        # dependencies", and the trap this whole block exists to catch went
        # uncaught -- numpy planned alone and died on
        #     BackendUnavailable: Cannot import 'mesonpy'
        # with meson_python (a book page, and numpy's Required) never built.
        _missing, _why_not = [], ""
        try:
            # the SAME ignore set the plan was built with (build_install_plan
            # has its own local; this referenced a name that does not exist
            # here, so every non-recursive install printed "NameError: name
            # 'ignore' is not defined" instead of its missing dependencies)
            _ignore = {x for x in (getattr(args, "ignore", "") or "").split(",") if x}
            _deps, _ = blfs_order_anchors(plan[0][0], ignore=_ignore)
            _missing = [nv for a, nv, _k, parent in _deps
                        if parent and gather_user(a).state != "installed"]
        except SystemExit as e:
            _why_not = "the book lookup exited (%s)" % e
        except Exception as e:
            _why_not = "%s: %s" % (type(e).__name__, e)
        if _why_not:
            printWarning("  could not work out what %s depends on -- %s"
                         % (plan[0][1], _why_not))
            printWarning("  so this plan builds ONLY %s, and a missing"
                         " dependency will not be" % plan[0][1])
            printWarning("  reported until the build fails on it.  Safer:"
                         "  --recursive")
        if _missing:
            printWarning("  %d dependenc%s of %s %s NOT installed:"
                         % (len(_missing), "y" if len(_missing) == 1 else "ies",
                            plan[0][1], "is" if len(_missing) == 1 else "are"))
            printWarning("    " + ", ".join(_missing[:8])
                         + (" ..." if len(_missing) > 8 else ""))
            printWarning("  this plan builds ONLY %s and will fail on them."
                         % plan[0][1])
            printWarning("  to build them too:  packagemanager install %s "
                         "--run --recursive" % plan[0][0])
    _done = len(getattr(build_install_plan, "already", ()))
    printHeader(f"Install plan ({len(plan)} to build)")
    if _done:
        printSuccess("  %d of the %d packages in this tree are already"
                     " installed -- they are skipped."
                     % (_done, _done + len(plan)))
    print()
    _prewarm_scripts(plan, script_dir,
                     force_regen=getattr(args, "regenerate", False))
    steps = []                                       # (anchor, nv, reason, path)
    for anchor, nv, reason in plan:
        path = resolve_script(anchor, nv, script_dir,
                              assume_yes=args.yes,
                              force_regen=getattr(args, "regenerate", False))
        if not path:
            sys.exit(1)
        steps.append((anchor, nv, reason, path))

    # A TOOL THE PLAN DOES NOT HAVE AT ALL: add it and plan again.
    #
    # 1.14.12 orders a package after the tool it calls when both are in the
    # plan.  When the provider is absent entirely the run just stopped:
    #     cargo    needed by 3 package(s), first: rust-bindgen
    # and rust-bindgen's page does not list Rust, so no amount of reordering
    # would have helped.  The provider is a book package like any other, so
    # add it to what was asked for and rebuild the plan -- once, so a tool
    # whose own provider is missing cannot loop.
    _add = sorted({_provider_of(t) for t in _MISSING_TOOLS if _provider_of(t)}
                  - {a.lower() for a, _n, _r, _p in steps})
    # A provider that is ALREADY INSTALLED cannot be added -- the plan would
    # come back identical and stop again, which is what happened with rust:
    # installed in /opt/rustc, invisible to our PATH, so "add it" produced no
    # change and the same refusal appeared twice.
    _add = [a for a in _add if gather_user(a).state != "installed"]
    if _add and getattr(args, "recursive", False) and not _replanned:
        printInfo("  adding to the plan: %s -- %s call %s, which the book's"
                  " pages do not list"
                  % (", ".join(_add),
                     "their commands" if len(_add) > 1 else "its commands",
                     ", ".join("`%s`" % t for t in sorted(_MISSING_TOOLS))))
        args.packages = list(args.packages) + _add
        _MISSING_TOOLS.clear()
        _MISSING_ENV.clear()
        return cmd_install(args, _replanned=True)

    # ORDER BEFORE PRINTING.  The list is a promise about what happens next,
    # so it has to be the order that will actually run -- printing as each
    # script resolved and reordering afterwards showed libaom above CMake and
    # then built it below.
    steps, _moved = _order_by_build_tools(steps)
    _in_plan = {a.lower() for a, _n, _r, _p in steps}
    for anchor, nv, reason, _path in steps:
        color = {"new": colors.yellow, "update": colors.cyan,
                 "reinstall": colors.blue}.get(reason, "")
        w = why_str(anchor)
        print(f"  {nv:<30} {color}{reason:<10}{colors.normal} "
              f"{colors.dim}{w}{colors.normal}")
    for nv, after, tool in _moved:
        printInfo("  ordering: %s moved after %s (its commands call `%s`,"
                  " which the book's page does not list)" % (nv, after, tool))
    # a tool the plan itself builds is no longer missing -- it is just later
    for _t in list(_MISSING_TOOLS):
        if (_BUILD_TOOLS.get(_t) or "").lower() in _in_plan:
            _MISSING_TOOLS.pop(_t, None)
    _report_missing_tools()
    _report_ignored_required(steps)
    _report_cycles(steps)
    _stop_if_prereqs_missing(args)

    if not args.run:
        print()
        printInfo("Dry run -- to install, re-run with --run, or execute:")
        for anchor, nv, reason, path in steps:
            print(f"  lfs-helper pm-install {anchor} {path}")
        return

    print()
    if not args.yes and not ask_yes_no(f"Build and install {len(steps)} "
                                       f"package(s) now?"):
        printWarning("Aborted.")
        return

    pm = find_pm_install()
    env = {**os.environ, "PM_MODE": "all", "PM_YES": "1" if args.yes else "0"}
    if getattr(args, "test", False):
        env["PM_TEST"] = env["PKGUSR_TESTS"] = "1"
    if getattr(args, "reinstall", False):
        env["PM_REINSTALL"] = "1"
    total = len(steps)
    errors = 0
    run_log = start_run_log("install", ",".join(args.packages))
    for i, (anchor, nv, reason, path) in enumerate(steps, 1):
        set_status(f"[{i}/{total}] installing {nv}"
                   + (f"  ({errors} error(s))" if errors else ""))
        printHeader(f"({i}/{total}) Installing {nv}  ({reason})")
        cleaning = getattr(args, "clean", False)
        old_paths = _pkglist_paths(anchor) if cleaning else None
        t0 = time.time()
        penv = {**env, "PM_NO_REFRESH": "1"} if cleaning else env
        result = run_pm_install(anchor, path, penv)
        add_run_entry(run_log, anchor, "install", result.returncode == 0,
                      result.returncode, _pkg_log_dir(anchor))
        if result.returncode != 0:
            errors += 1
            clear_status()
            printError(f"install failed for {nv} (exit {result.returncode}); "
                       f"stopping ({i - 1}/{total} done).")
            printInfo(f"  logs: {_pkg_log_dir(anchor)}   "
                      f"(see all: packagemanager errors)")
            printInfo(f"  Then re-run ONLY the install step (no recompile):\n"
                      f"    packagemanager script install {anchor}")
            # THE FILE TO EDIT IS THE LAST THING SAID.
            #
            # It is what you do next, and it was buried three messages up.  A
            # path you have to scroll back for is a path you retype wrong.
            #
            # And it must be the copy in the package user's HOME, not the one
            # under /tmp/packagemanager/install_files.  That is where a script
            # freshly generated from the book lands; the engine copies it into
            # the home, and the next run regenerates the /tmp one -- so an edit
            # there is silently discarded, which is the exact failure this
            # message exists to prevent.
            _canon = os.path.join(pkgusr_home(anchor),
                                  os.path.basename(path))
            _edit = _canon if os.path.isfile(_canon) else path
            _runtime = os.path.join(pkgusr_home(anchor),
                                    "install_" + pkgusr_name(anchor))
            print()
            printInfo("  To change what it does, edit:")
            printError(f"    {_edit}")
            # Since 1.14.16 the canonical script is the one that runs, so
            # this only fires for a leftover copy from an older version.
            if os.path.isfile(_runtime) and _runtime != _edit:
                printInfo(f"    ({os.path.basename(_runtime)} is a leftover copy"
                          f" from an older version;\n"
                          f"     it is no longer used and can be deleted)")
            if _edit != path:
                printInfo(f"    (not {path} --\n"
                          f"     that one is regenerated from the book each run)")
            sys.exit(result.returncode)
        if getattr(args, "clean", False):
            _clean_after_install(anchor, old_paths, t0)
        _maybe_remove_old_sources(anchor, nv, getattr(args, "keep_sources", False))
    clear_status()
    printSuccess(f"Done -- {total} package(s) installed.")
    # THE PATTERN HAS TO BE A REAL PATH.
    #
    # This built the hint by hand -- os.path.join(BASE_DIR, ...) -- and got it
    # wrong twice over: it printed "/usr/src/p_<pkg>/log", missing the pkgusr/
    # component that every package home actually has.  Someone following it
    # found nothing, twice: the directory does not exist, and until 1.14.71
    # the logs were not there either.  _pkg_log_dir is the function that knows.
    printInfo(f"  results: packagemanager errors     logs: "
              f"{_pkg_log_dir('<name>')}")


# =========================================================================== #
# command: update                                                 [IMPLEMENTED]
# =========================================================================== #
#
# Update installed packages whose book version differs from what's installed.
# With no arguments it checks EVERY installed package-user; with package names it
# checks those packages plus their (recursive) dependencies.  Required and
# recommended deps are followed by default (-e to skip recommended, --optional to
# add optional).  Dry-run by default; --run rebuilds each outdated package via
# the engine.

_PROTECTED_PREFIXES = ("/etc/", "/var/", "/boot/", "/home/", "/root/", "/srv/",
                       "/opt/etc/")


def _pkglist_paths(user):
    pl = os.path.join(pkgusr_home(user), "pkg.lst")
    return {p for p in pkglist_entries(pl) if p.startswith("/")}


def _orphan_sweep(user, old_paths, since, remove=True):
    """Remove files that were in the package's OLD manifest but were NOT rewritten
    by the new version (mtime older than the install start `since`).  Only old-
    manifest files are considered; config paths + the source tree are kept.  Does
    NOT regenerate the manifest (caller does, after any reapply).  Returns the
    number of files removed."""
    if old_paths is None:
        return 0
    protected = _PROTECTED_PREFIXES + (BASE_DIR.rstrip("/") + "/",)
    # NEVER ANOTHER PACKAGE'S FILE.  An old manifest can list a path that
    # has since moved to someone else: switching Mesa to glvnd hands
    # libGL.so.1 to libglvnd, which installs it BEFORE the Mesa rebuild --
    # so it is old, in Mesa's old list, and not rewritten by Mesa.  mtime
    # alone would delete the GL library.  A package cleans only what it
    # still owns.
    try:
        own_uid = pwd.getpwnam(user).pw_uid if pwd else None
    except KeyError:
        own_uid = None
    victims = []
    for p in sorted(old_paths):
        if any(p == pre.rstrip("/") or p.startswith(pre) for pre in protected):
            continue
        if not os.path.lexists(p):
            continue
        try:
            st = os.lstat(p)
            if own_uid is not None and st.st_uid != own_uid:
                continue
            if st.st_mtime < since:
                victims.append(p)
        except OSError:
            continue
    # A LIBRARY SOMETHING IS STILL LINKED TO IS NOT AN ORPHAN.
    #
    # webkitgtk rebuilt from the GTK4 port to the GTK3 one leaves
    # libwebkitgtk-6.0.so.4 in the old manifest, unrewritten and owned by this
    # package -- every test above says "orphan", and deleting it breaks every
    # program built against it, with no warning and no way back but a rebuild.
    # So each library about to go is asked the only question that matters:
    # does anything else still record its soname?  Files of this package do
    # not count -- they go with it.
    kept = []
    if victims:
        libs = [p for p in victims if re.search(r"\.so(\.\d+)*$", p)
                and os.path.isfile(p) and not os.path.islink(p)]
        victim_set = set(victims)
        for p in libs:
            s = _soname_of(p)
            if not s:
                continue
            users = [(f, o) for f, o in _needed_by(s, skip_uid=own_uid)
                     if f not in victim_set]
            if users:
                pkgs = sorted({o for _f, o in users})
                printWarning("  --clean: KEEPING %s -- %d file(s) in %s still "
                             "link against %s"
                             % (p, len(users), ", ".join(pkgs[:4]), s))
                kept.append((p, s, pkgs))
        if kept:
            keep_paths = {p for p, _s, _pk in kept}
            # the symlinks that point at a kept library stay with it, or the
            # soname it is found by disappears and nothing loads anyway
            for p in list(victims):
                if os.path.islink(p):
                    t = os.path.realpath(p)
                    if t in keep_paths:
                        keep_paths.add(p)
            victims = [p for p in victims if p not in keep_paths]
            printInfo("    rebuild those packages, then clean again:")
            for _p, _s, pkgs in kept:
                printInfo("      packagemanager update %s --reinstall --run"
                          % " ".join(p[2:] if p.startswith("p_") else p
                                     for p in pkgs[:4]))
                break
            printInfo("    or see the whole picture:  packagemanager used-by %s"
                      % kept[0][1])
    if not remove:
        # the caller decides (_clean_after_install parks them first)
        return victims
    if victims:
        printInfo(f"  --clean: removing {len(victims)} old-version file(s) the "
                  f"upgrade no longer installs (configs / source kept)")
        remove_paths_as_user(user, victims)
    elif not kept:
        printInfo("  --clean: no leftover files from the old version.")
    return len(victims)


def _reapply_install(user):
    """Re-run ONLY the install phase (no recompile), as the user, to put back
    the current-version files the mtime test mistook for old ones.

    Returns True only when the phase ran and exited 0.

    IT HAD NOT RUN SINCE 1.14.16 (fixed 1.14.311).  It called
    `bash ~/install_<account>` -- the runtime copy 1.14.16 removed everywhere
    else -- with stdout and stderr thrown away and the exit status ignored.
    So every --clean deleted the files the mtime test misjudged, the "restore"
    failed on `No such file or directory` where nobody could see it, and the
    run ended green.  webkitgtk lost /usr/include/webkitgtk-6.0/jsc/*.h that
    way: CMake's install skips a file whose content is unchanged ("--
    Up-to-date:"), so the headers kept their old mtime and read as orphans.

    Now: the same script and the same door as `packagemanager script
    install` (lfs-helper build), its output kept in a log, and its result
    returned so the caller can undo the clean when it fails.
    """
    home = pkgusr_home(user)
    script = (_versioned_script_in(home)
              or os.path.join(home, f"install_{user}"))
    if not os.path.isfile(script):
        printError(f"  --clean: no install script in {home} -- cannot reapply")
        return False
    helper = shutil.which("lfs-helper")
    if helper and _can_su(user):
        cmd = [helper, "build", user, "--script", script,
               "--phase", "install", "--force"]
    else:
        inner = f"cd ~ && bash {shlex.quote(script)} install"
        cmd = (["su", "-", user, "-c", inner] if _can_su(user)
               else ["sh", "-c", inner])
    log = os.path.join(_plans_dir(),
                       re.sub(r"[^A-Za-z0-9_.-]+", "_", user) + ".clean-reapply.log")
    printInfo("  --clean: reapplying the install step to restore current files...")
    printInfo("    $ " + " ".join(cmd[1:] if cmd[0] == helper else cmd))
    try:
        with open(log, "w") as lf:
            rc = subprocess.run(cmd, stdout=lf, stderr=subprocess.STDOUT).returncode
    except OSError as e:
        printError(f"  --clean: could not run the install step ({e})")
        return False
    if rc != 0:
        printError(f"  --clean: the install step FAILED (exit {rc}) -- log: {log}")
        try:
            for line in open(log, errors="replace").read().splitlines()[-12:]:
                printInfo("    | " + line)
        except OSError:
            pass
        return False
    return True


_PARK_SUFFIX = ".pkgusr-clean"


def _park_ledger(user):
    return os.path.join(_plans_dir(),
                        re.sub(r"[^A-Za-z0-9_.-]+", "_", user) + ".parked")


def _unpark_all(user):
    """Put every parked file back, from the ledger.  Returns how many."""
    ledger = _park_ledger(user)
    n = 0
    try:
        lines = open(ledger).read().splitlines()
    except OSError:
        return 0
    for p in lines:
        if not p:
            continue
        q = p + _PARK_SUFFIX
        if not os.path.lexists(q):
            continue
        if os.path.lexists(p):
            # the install put the current version there: that one stays
            try:
                os.unlink(q)
            except OSError:
                pass
            continue
        try:
            os.rename(q, p)
            n += 1
        except OSError as e:
            printError(f"    could not put back {p} ({e}) -- it is at {q}")
    try:
        os.unlink(ledger)
    except OSError:
        pass
    return n


# =========================================================================== #
# git packages: what they follow, and whether it moved            [IMPLEMENTED]
# =========================================================================== #
#
# A book package has a version, and `update` compares it with the book's.  A
# git package has a REF, and a ref answers a different question depending on
# what it is:
#   a branch  -- a moving target.  "Is it behind?" is asked of the remote, and
#                the answer changes without anyone doing anything.
#   a tag     -- a point in time.  It is never behind; the question is whether
#                a NEWER tag exists, and moving to it is a decision.
#   a commit  -- the same, without even a name to compare.
# Telling them apart is the whole of this.

_GIT_ENV = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/true",
                GIT_SSH_COMMAND="ssh -oBatchMode=yes")


def _script_var(text, var):
    """A shell assignment out of an install script: link="..." / git_ref=..."""
    m = re.search(r'^\s*%s\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([^\s#]*))'
                  % re.escape(var), text or "", re.M)
    if not m:
        return ""
    return (m.group(1) or m.group(2) or m.group(3) or "").strip()


def _git_clone_dir(name, link=""):
    """Where this package's checkout is.  lfs-phases builds in $HOME/src, so
    that is where to look -- and the remote is what confirms it, because a
    home can hold more than one tree."""
    home = pkgusr_home(name)
    for base in (os.path.join(home, "src"), home):
        if not os.path.isdir(base):
            continue
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            continue
        cands = [os.path.join(base, d) for d in entries
                 if os.path.isdir(os.path.join(base, d, ".git"))]
        if link:
            for c in cands:
                r = subprocess.run(["git", "-C", c, "remote", "get-url", "origin"],
                                   capture_output=True, text=True, env=_GIT_ENV)
                if r.returncode == 0 and r.stdout.strip().rstrip("/") == link.rstrip("/"):
                    return c
        if len(cands) == 1:
            return cands[0]
    return ""


def _git(clone, *args, timeout=60):
    try:
        r = subprocess.run(["git", "-C", clone] + list(args), capture_output=True,
                           text=True, env=_GIT_ENV, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def _ls_remote(link, pattern=None, timeout=90):
    """[(sha, refname)] from the remote, without cloning anything."""
    cmd = ["git", "ls-remote"]
    if pattern == "tags":
        cmd += ["--tags", "--refs"]
    cmd.append(link)
    if pattern and pattern != "tags":
        cmd.append(pattern)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, env=_GIT_ENV,
                           timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []
    out = []
    for ln in r.stdout.splitlines():
        parts = ln.split(None, 1)
        if len(parts) == 2:
            out.append((parts[0].strip(), parts[1].strip()))
    return out


def _vsort_key(tag):
    """Sort 1.9.0 before 1.10.0, which a plain string sort does not."""
    return [int(x) if x.isdigit() else x
            for x in re.split(r"(\d+)", tag.lstrip("vV"))]


def _git_pkg_state(name, remote=True):
    """Everything worth saying about one git package.

    Returns a dict, or None when this is not a git package.  `remote=False`
    asks the disk only -- no network, for the bulk view."""
    script = (_canonical_script_path(name)
              or os.path.join(pkgusr_home(name), "install_%s" % name))
    if not script or not os.path.isfile(script):
        return None
    try:
        text = open(script, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    if not (re.search(r'is_git="?1"?', text) or re.search(r"\bgit\s+clone\b", text)):
        return None
    link = _script_var(text, "link")
    ref = _script_var(text, "git_ref")
    clone = _git_clone_dir(name, link)
    st = {"name": name, "script": script, "link": link, "ref": ref,
          "clone": clone, "kind": "?", "local": "", "remote": "",
          "newer_tags": [], "behind": None, "note": ""}
    if clone:
        st["local"] = _git(clone, "rev-parse", "HEAD")
    if not link:
        st["note"] = "the script names no repository (link=)"
        return st
    if not remote:
        return st
    # WHAT KIND OF REF IS IT?  The remote knows; guessing from the string
    # ("master" is a branch, "2.18.0" is a tag) is how a tag named `main`
    # or a branch named `1.x` goes wrong.
    heads = {r.rsplit("/", 1)[-1]: s for s, r in _ls_remote(link, "refs/heads/*")}
    tags = [r.rsplit("/", 1)[-1] for _s, r in _ls_remote(link, "tags")]
    st["tags"] = tags
    if ref and ref in heads:
        st["kind"] = "branch"
        st["remote"] = heads[ref]
    elif ref and ref in tags:
        st["kind"] = "tag"
        newer = [t for t in tags if _vsort_key(t) > _vsort_key(ref)]
        st["newer_tags"] = sorted(newer, key=_vsort_key)
    elif not ref:
        st["kind"] = "default branch"
        for d in ("main", "master"):
            if d in heads:
                st["remote"] = heads[d]
                st["ref"] = d
                break
    elif ref:
        st["kind"] = "commit or missing ref"
        st["note"] = "the remote has no branch or tag called %s" % ref
    # how far behind, when the clone already has the objects
    if st["kind"].endswith("branch") and st["local"] and st["remote"] \
            and st["local"] != st["remote"] and clone:
        n = _git(clone, "rev-list", "--count", "%s..%s" % (st["local"], st["remote"]))
        st["behind"] = int(n) if n.isdigit() else None
    return st


def _git_pkg_line(st):
    n = st["name"]
    ref = st["ref"] or "(default)"
    if st["note"] and not st["remote"] and not st["newer_tags"]:
        return "  %-20s %-14s %s" % (n, ref, st["note"])
    if st["kind"].endswith("branch"):
        if not st["remote"]:
            return "  %-20s %-14s branch -- the remote could not be reached" % (n, ref)
        if st["local"][:12] == st["remote"][:12]:
            return "  %-20s %-14s branch, up to date (%s)" % (n, ref, st["local"][:8])
        behind = ("%d commit(s) behind" % st["behind"]) if st["behind"] \
            else "moved"
        return "  %-20s %-14s branch, %s: %s -> %s" % (
            n, ref, behind, (st["local"] or "?")[:8], st["remote"][:8])
    if st["kind"] == "tag":
        if not st["newer_tags"]:
            return "  %-20s %-14s tag, nothing newer released" % (n, ref)
        nt = st["newer_tags"]
        return "  %-20s %-14s tag -- %d newer: %s" % (
            n, ref, len(nt), ", ".join(nt[-4:]))
    return "  %-20s %-14s %s %s" % (n, ref, st["kind"], st["note"])


def cmd_git_status(args):
    """What every git package follows, and whether it has moved."""
    names = args.packages or list_all_users()
    states = []
    for n in sorted(set(names)):
        st = _git_pkg_state(n, remote=not getattr(args, "local_only", False))
        if st:
            states.append(st)
    if not states:
        printInfo("no git-based packages here"
                  if not args.packages else
                  "none of those are git-based packages")
        return 0
    printHeader("git packages")
    print()
    print("  %-20s %-14s %s" % ("package", "ref", "state"))
    print("  " + "-" * 62)
    moved, taggy = [], []
    for st in states:
        print(_git_pkg_line(st))
        if st["kind"].endswith("branch") and st["remote"] \
                and st["local"][:12] != st["remote"][:12]:
            moved.append(st["name"])
        if st["newer_tags"]:
            taggy.append(st)
    print()
    if moved:
        printInfo("  follow the branch (fetch, rebuild, install):")
        printInfo("    packagemanager update %s --run" % " ".join(moved))
    for st in taggy:
        printInfo("  %s is pinned to %s; to move it:" % (st["name"], st["ref"]))
        printInfo("    packagemanager git-ref %s %s"
                  % (st["name"], st["newer_tags"][-1]))
    if not moved and not taggy:
        printInfo("  nothing to do: every git package is where its ref says")
    return 0


def cmd_git_ref(args):
    """Show what a git package could follow, or move it to another ref."""
    name = args.package
    st = _git_pkg_state(name)
    if st is None:
        printError("%s is not a git-based package" % name)
        return 1
    if not st["link"]:
        printError("%s: its script names no repository" % name)
        return 1
    if not args.ref:
        tags = sorted(st.get("tags") or [], key=_vsort_key)
        heads = [r.rsplit("/", 1)[-1] for _s, r in _ls_remote(st["link"], "refs/heads/*")]
        printHeader("%s -- %s" % (name, st["link"]))
        print()
        print("  now: %s (%s)" % (st["ref"] or "(default)", st["kind"]))
        print()
        print("  branches: " + (", ".join(heads[:8]) or "(none)"))
        print("  tags, newest last:")
        for t in tags[-12:]:
            print("      %s%s" % (t, "   <- current" if t == st["ref"] else ""))
        if not tags:
            print("      (none -- this repository is not tagged)")
        print()
        printInfo("  pick one:  packagemanager git-ref %s <ref>" % name)
        return 0
    want = args.ref
    known = set(st.get("tags") or []) | {
        r.rsplit("/", 1)[-1] for _s, r in _ls_remote(st["link"], "refs/heads/*")}
    if want not in known and not re.fullmatch(r"[0-9a-f]{7,40}", want):
        printError("%s: the remote has no tag or branch called %s" % (name, want))
        printInfo("  what it has:  packagemanager git-ref %s" % name)
        return 1
    # THE SCRIPT IS ONE OF TWO PLACES THE REF LIVES.  A stack entry writes it
    # into the generated script, so editing only the script is undone by the
    # next stack run -- say so, and name the file.
    try:
        text = open(st["script"], encoding="utf-8", errors="replace").read()
    except OSError as e:
        printError("%s: %s" % (st["script"], e))
        return 1
    new, n = re.subn(r'^(\s*git_ref\s*=\s*).*$', r'\1"%s"' % want, text,
                     count=1, flags=re.M)
    if not n:
        printError("%s has no git_ref= line to change" % st["script"])
        return 1
    if not getattr(args, "run", False):
        printInfo("  would set git_ref=\"%s\" in %s (was \"%s\")"
                  % (want, st["script"], st["ref"]))
        printInfo("  dry run -- add --run")
        return 0
    bak = st["script"] + ".bak-" + time.strftime("%Y%m%d-%H%M%S")
    try:
        shutil.copy2(st["script"], bak)
        open(st["script"], "w").write(new)
    except OSError as e:
        printError("could not write %s: %s" % (st["script"], e))
        return 1
    printSuccess("%s: git_ref is now %s (was %s; backup %s)"
                 % (name, want, st["ref"] or "(default)", os.path.basename(bak)))
    src = _STACK_TARGET_SOURCE.get(name)
    if src:
        printWarning("  %s also carries this ref: a stack run regenerates the"
                     " script and puts the old one back." % src)
        printInfo("    change the entry there too:   ref=%s" % want)
    printInfo("  then build it:  packagemanager update %s --run" % name)
    return 0


# =========================================================================== #
# who still links against this?                                   [IMPLEMENTED]
# =========================================================================== #
#
# A package-user system records who INSTALLED every file.  It records nothing
# about who USES one -- and a library is used by things that were built
# against it long ago.  webkitgtk rebuilt from the GTK4 port to the GTK3 one
# leaves libwebkitgtk-6.0.so.4 behind with nothing to rebuild it, and
# `--clean` is then one keystroke from deleting a library other programs are
# still linked to.  ldd answers it for ONE file; this answers it for a
# library.

_ELF_SCAN_DIRS = ("/usr/bin", "/usr/sbin", "/usr/lib", "/usr/libexec",
                  "/bin", "/sbin", "/lib", "/opt")
_ELF_CONFIRM_MAX = 600      # readelf calls; a grep hit is cheap, this is not


def _soname_of(path):
    """The SONAME an ELF library announces -- libwebkitgtk-6.0.so.4, not the
    file name libwebkitgtk-6.0.so.4.13.8.  That is the name other binaries
    record, so it is the name to search for."""
    if not os.path.isfile(path):
        return None
    try:
        r = subprocess.run(["readelf", "-d", path], capture_output=True,
                           text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        r = None
    if r and r.returncode == 0:
        m = re.search(r"\(SONAME\)\s+Library soname: \[([^\]]+)\]", r.stdout)
        if m:
            return m.group(1)
    b = os.path.basename(path)
    m = re.match(r"^(lib.+?\.so(?:\.\d+)?)(?:\.|$)", b)
    return m.group(1) if m else None


def _needed_by(soname, skip_uid=None, dirs=None):
    """Every ELF that records this soname in DT_NEEDED: [(path, owner)].

    grep first -- a soname is a literal string in .dynstr, and grep over
    /usr/lib is seconds -- then readelf only on the hits, because a string can
    also appear in a script, a .la file or another library's rpath.
    """
    # RESOLVED HERE, NOT IN THE SIGNATURE.  A default argument is bound at
    # import, so `dirs=_ELF_SCAN_DIRS` could never be overridden -- including
    # by a test, which is how this function first appeared to find nothing.
    live = [d for d in (dirs or _ELF_SCAN_DIRS) if os.path.isdir(d)]
    if not live:
        return []
    try:
        r = subprocess.run(["grep", "-rlZ", "--binary-files=binary", "-F",
                            "--", soname] + live,
                           capture_output=True, timeout=600)
    except (OSError, subprocess.SubprocessError):
        return []
    _all = [c.decode("utf-8", "replace") for c in r.stdout.split(b"\0") if c]
    cands = _all[:_ELF_CONFIRM_MAX]
    if len(_all) > _ELF_CONFIRM_MAX:
        # A TRUNCATED ANSWER MUST NOT READ AS A COMPLETE ONE.
        printWarning("  %s: %d candidates, only the first %d were confirmed"
                     % (soname, len(_all), _ELF_CONFIRM_MAX))
    out = []
    for p in cands:
        if os.path.islink(p) or not os.path.isfile(p):
            continue
        if os.path.basename(p).startswith(soname.split(".so")[0] + ".so"):
            continue                       # the library itself, or its siblings
        try:
            st = os.lstat(p)
            if skip_uid is not None and st.st_uid == skip_uid:
                continue                   # its own package may rebuild freely
            d = subprocess.run(["readelf", "-d", p], capture_output=True,
                               text=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            continue
        if d.returncode != 0:
            continue
        if re.search(r"\(NEEDED\).*\[%s\]" % re.escape(soname), d.stdout):
            owner = "?"
            try:
                owner = pwd.getpwuid(st.st_uid).pw_name if pwd else "?"
            except KeyError:
                owner = str(st.st_uid)
            out.append((p, owner))
    return out


def cmd_used_by(args):
    """What still links against this library, or this package's libraries."""
    target = args.name
    sonames = []
    if re.search(r"\.so(\.|$)", target):
        sonames = [target if os.sep not in target
                   else (_soname_of(target) or os.path.basename(target))]
    else:
        # a package: every shared library in its manifest
        libs = [p for p in _pkglist_paths(target) or []
                if re.search(r"/lib[^/]*\.so(\.\d+)*$", p)
                and os.path.isfile(p) and not os.path.islink(p)]
        for p in sorted(libs):
            s = _soname_of(p)
            if s and s not in sonames:
                sonames.append(s)
        if not sonames:
            printInfo("%s installs no shared library (or has no manifest)" % target)
            return 0
    printHeader("What links against %s" % ", ".join(sonames))
    print()
    total = 0
    for s in sonames:
        users = _needed_by(s)
        by_pkg = {}
        for p, owner in users:
            by_pkg.setdefault(owner, []).append(p)
        if not users:
            print("  %-34s nothing links against it" % s)
            continue
        total += len(users)
        print("  %s -- %d file(s), %d package(s):" % (s, len(users), len(by_pkg)))
        for owner in sorted(by_pkg):
            ex = ", ".join(os.path.basename(x) for x in sorted(by_pkg[owner])[:3])
            more = "" if len(by_pkg[owner]) <= 3 else " ..."
            print("      %-22s %s%s" % (owner, ex, more))
    print()
    if total:
        printInfo("  removing a library these were built against breaks them"
                  " until they are rebuilt:")
        printInfo("    packagemanager update <package> --reinstall --run")
    else:
        printInfo("  nothing needs these; they are safe to remove")
    return 0


def _clean_after_install(user, old_paths, since):
    """Full --clean sequence run AFTER a successful install: remove old-version
    orphans, reapply install (to undo any over-removal), then regenerate the
    manifest so it reflects the final state.

    PARK, REINSTALL, THEN JUDGE (1.14.311).  "Older than the install" is
    not "no longer installed": CMake skips a file whose content has not
    changed, meson and `install -p` keep timestamps, so a current file can
    look old.  This used to delete first and trust a reapply to repair the
    damage -- a reapply that had not run since 1.14.16, so the damage stayed
    (webkitgtk's jsc/*.h, and every build against webkitgtk-6.0 broke).

    Now nothing is deleted on the mtime test's word alone.  The candidates
    are renamed aside (same directory, so it is one rename each and nothing
    is copied), the install phase runs, and only then:
      * a path the install put back IS current -- the parked copy goes;
      * a path it did not put back is a real orphan -- that one goes;
      * if the install step FAILS, every parked file is put back, and the
        clean is reported as not done.  Nothing is half-cleaned.
    """
    # an earlier clean interrupted between park and judge: finish undoing it
    if os.path.exists(_park_ledger(user)):
        n = _unpark_all(user)
        printWarning(f"  --clean: an interrupted clean had parked files -- "
                     f"{n} put back first")

    victims = _orphan_sweep(user, old_paths, since, remove=False)
    if not victims:
        printInfo("  --clean: no leftover files from the old version.")
        printInfo("  --clean: regenerating the file manifest...")
        write_pkg_list(user, background=False)
        return 0

    files = [p for p in victims if os.path.islink(p) or not os.path.isdir(p)]
    dirs = [p for p in victims if p not in set(files)]
    parked = []
    with open(_park_ledger(user), "w") as led:
        for p in files:
            try:
                os.rename(p, p + _PARK_SUFFIX)
                parked.append(p)
                led.write(p + "\n")
                led.flush()
            except OSError as e:
                printWarning(f"    could not set {p} aside ({e}) -- left in place")
    printInfo(f"  --clean: {len(parked)} file(s) look older than this install "
              f"-- set aside while the install step confirms which are gone")

    if not _reapply_install(user):
        n = _unpark_all(user)
        printError(f"  --clean: NOT DONE -- put {n} file(s) back as they were.")
        printInfo("    The upgrade itself is installed; only the clean-up was undone.")
        printInfo("    Fix the install step, then:  packagemanager update "
                  f"{user[2:] if user.startswith('p_') else user} --reinstall --clean --run")
        write_pkg_list(user, background=False)
        return 0

    still = [p for p in parked if os.path.lexists(p)]
    gone = [p for p in parked if not os.path.lexists(p)]
    # both kinds of parked copy go: for `still` the install wrote the
    # current one, for `gone` nothing replaced it -- that is the orphan
    remove_paths_as_user(user, [p + _PARK_SUFFIX for p in parked] + dirs)
    try:
        os.unlink(_park_ledger(user))
    except OSError:
        pass
    if still:
        printInfo(f"  --clean: {len(still)} of them are still installed by this "
                  f"version (unchanged, so the install left their old date) -- kept")
    if gone:
        printInfo(f"  --clean: removed {len(gone)} file(s) the new version no "
                  f"longer installs")
        for p in gone[:10]:
            printInfo("      " + p)
        if len(gone) > 10:
            printInfo("      ... and %d more" % (len(gone) - 10))
    else:
        printInfo("  --clean: nothing was an orphan after all")
    printInfo("  --clean: regenerating the file manifest...")
    write_pkg_list(user, background=False)
    return len(gone)


def _is_phased_script(text):
    """Does this install script hand its phases to the runner?

    The runner is what fetches, unpacks, resumes in the build directory and
    re-runs one phase -- so "phased" means "ends in pkgusr_run", not "defines
    some particular function".  Three spellings, because the header and the
    library name are each written by a different generation of the tools.
    """
    t = text or ""
    return bool(re.search(r"\bpkgusr_run\b", t)
                or re.search(r"PKGUSR_LIB|lfs-phases", t)
                or re.search(r"^###\s*phases:", t, re.M))


def _is_git_package(name):
    """A package whose install script builds from a git repo (is_git=1, or it
    clones/pulls) rather than a book tarball."""
    p = (_canonical_script_path(name)
         or os.path.join(pkgusr_home(name), f"install_{name}"))
    if not p or not os.path.isfile(p):
        return False
    try:
        t = open(p, encoding="utf-8", errors="replace").read(8000)
    except OSError:
        return False
    return bool(re.search(r'is_git="?1"?', t)
                or re.search(r'\bgit\s+(clone|pull|fetch)\b', t))


# A plan entry whose "script" is this is built by `lfs`, not by us: the LFS
# book owns it, and lfs already knows how to build one of its packages.
_LFS_STEP = ":lfs-book:"

_TOOLCHAIN_RISK = ("glibc", "binutils", "gcc", "libstdcpp", "ld", "linux-headers")


def _lfs_stale_list(include_current=False):
    """[(name, installed, book)] for packages the LFS book has newer.

    With include_current, the packages whose version did NOT move are listed
    too (installed == book).  After glibc changes, "up to date" and "built
    against the current system" stop being the same statement -- so a full
    rebuild in book order is a thing a person may legitimately ask for.

    Read from `lfs update --porcelain` -- one tab-separated fact per line.
    Parsing the human report instead would break the first time a word in it
    changed, and this tool has been bitten by exactly that before."""
    lfs_bin = shutil.which("lfs") or ("/usr/bin/lfs" if os.access(
        "/usr/bin/lfs", os.X_OK) else None)
    if not lfs_bin:
        return []
    try:
        _cmd = [lfs_bin, "update", "--porcelain"]
        if include_current:
            _cmd.append("--include-current")
        r = subprocess.run(_cmd, capture_output=True, text=True, timeout=600)
    except Exception:
        return []
    out = []
    for ln in (r.stdout or "").splitlines():
        parts = ln.split("\t")
        if len(parts) == 3 and parts[0]:
            out.append((parts[0], parts[1], parts[2]))
    return out


def _lfs_update_report(names):
    """Ask `lfs update` about the packages the BLFS book cannot answer for,
    and relay WHAT IT SAYS.

    Returns (kind, payload):
      ("current", None)  -- lfs said so, in those words
      ("lines", [...])   -- lfs's own report, verbatim
      ("failed", why)    -- no answer; the caller must say so, not assume

    The previous version returned [] both for "everything is current" and for
    "the call produced nothing", and the caller printed "all current with the
    LFS book" for both -- a clean bill of health manufactured out of silence,
    on a system with 30 stale packages.  Empty-as-pass, in the very code that
    was written to stop packages disappearing quietly.

    It is called with no package names: `lfs update` already covers every
    installed LFS package and labels what belongs to the other book, so this
    asks the same question the user would ask by hand, and shows the same
    answer.  Passing 77 names asked the same tool a longer question with more
    ways to go wrong."""
    lfs_bin = shutil.which("lfs") or ("/usr/bin/lfs" if os.access(
        "/usr/bin/lfs", os.X_OK) else None)
    if not lfs_bin:
        return ("failed", "lfs is not installed here")
    try:
        r = subprocess.run([lfs_bin, "update"],
                           capture_output=True, text=True, timeout=600)
    except Exception as e:
        return ("failed", str(e))
    out = (r.stdout or "").strip()
    if not out:
        tail = (r.stderr or "").strip().splitlines()
        why = tail[-1] if tail else f"no output (exit {r.returncode})"
        return ("failed", why)
    if "Everything checked is current" in out and "Out of date" not in out:
        return ("current", None)
    return ("lines", [ln for ln in out.splitlines() if ln.strip()])


def _report_no_book(no_book, consult_lfs, no_record=(), unjudged=(),
                    uptodate_n=None, total=None, named=()):
    """Account for every package the BLFS plan could not judge, and let the
    LFS book answer for them.

    Listing them only when the plan was non-empty made the commonest state
    (BLFS subset current, glibc stale) read as a clean bill of health -- and
    two silent `continue`s meant the numbers never had to add up.  They do
    now: checked = planned + current + these."""
    rest = sorted(set(no_book) | set(no_record) | set(unjudged))
    if uptodate_n is not None and total is not None:
        print()
        printInfo(f"Of {total} checked: {uptodate_n} current with the BLFS "
                  f"book, {len(rest)} it cannot judge.")
    if not rest:
        return
    if not (uptodate_n is not None and total is not None):
        print()
    if no_record:
        printInfo(f"  {len(no_record)} installed, but no recorded version "
                  f"here -- what the book carries is shown beside each:")
        for _nr in sorted(no_record)[:12]:
            printInfo("    " + _nr)
        if len(no_record) > 12:
            printInfo("    ... and %d more" % (len(no_record) - 12))
        printInfo("    the installed version, if the script still names it:"
                  "  packagemanager info <name>")
    if unjudged:
        printInfo(f"  {len(unjudged)} with no completed-install record here "
                  f"(the LFS build tracks these in its own manifests):")
        printInfo("    " + ", ".join(sorted(unjudged)[:12])
                  + (" ..." if len(unjudged) > 12 else ""))
        # SAY WHAT TO DO INSTEAD.  Asking to update a package this system has
        # never installed is a reasonable thing to try, and "cannot judge" is
        # a true answer to a question the user did not mean to ask.  If they
        # NAMED the packages, tell them the command that does what they want.
        _named = list(named or ())
        if _named:
            _want = [u for u in sorted(unjudged)
                     if any(u.lower() == n.lower() for n in _named)]
            if _want:
                printInfo("  These have no record here because they are NOT "
                          "INSTALLED.  To build them:")
                printInfo("    packagemanager install %s --run --recursive"
                          % " ".join(_want[:6]))
    if no_book:
        printInfo(f"  {len(no_book)} not in the BLFS book at all.")
    printInfo("  The LFS book answers for these:")
    if not consult_lfs:
        printInfo("    check them with:  lfs update")
        return
    kind, payload = _lfs_update_report(rest)
    if kind == "failed":
        printWarning(f"    could not ask lfs ({payload}) -- these are UNCHECKED.")
        printInfo("    run it yourself:  lfs update")
    elif kind == "current":
        printInfo("    all current with the LFS book.")
    else:
        for ln in payload:
            print("    " + ln)


def _systemctl_users(steps):
    """Planned packages whose install script runs systemctl.

    Generated scripts shim a missing systemctl into a visible skip (1.11.30),
    so a systemd book builds on a SysV system -- but "skipped" means the
    package's service was NOT enabled, and only the person can decide whether
    that matters for this package.  So: name them, once, rather than leaving
    the notices to scroll past mid-build."""
    if os.path.isdir("/usr/lib/systemd/system") or shutil.which("systemctl"):
        return []                       # this system HAS systemd: nothing to say
    out = []
    for _anchor, name, _iv, _bv, path in steps:
        cands = []
        if path and path != _LFS_STEP:
            cands.append(path)
        # the LFS book's script for this package, if one has been generated
        cands.append(os.path.join("/usr/src/lfs-pkgusr/scripts", name + ".sh"))
        cands.append(os.path.join(pkgusr_home(name), "install_" + name))
        for c in cands:
            try:
                with open(c, encoding="utf-8", errors="replace") as f:
                    body = f.read()
            except OSError:
                continue
            # the shim definition itself is not a use of systemctl
            uses = [ln for ln in body.splitlines()
                    if "systemctl" in ln
                    and "command -v systemctl" not in ln
                    and not ln.strip().startswith("#")]
            if uses:
                # the PATH, not just the name: the next thing anyone does with
                # this list is open the file and add the SysV equivalent
                out.append((name, len(uses), c))
                break
    return out


def _machine_avoids():
    """Everything this machine never builds, from avoid.stack.

    `avoid` entries were only consulted by `stack`, so `install` and
    `update` walked the book's dependency graph with nothing excluded.  The
    exclusions describe the MACHINE -- that is why they were moved into
    their own file in 1.14.224 -- so every plan should honour them.
    """
    out = set()
    d = STACK_DIR if "STACK_DIR" in globals() else "/etc/pkgusr/stacks"
    for f in sorted(glob.glob(os.path.join(d, "*.stack"))):
        try:
            for r in _parse_stack_file(f):
                if r["kind"] == "avoid":
                    out.add(r["target"])
        except (ValueError, OSError):
            continue
    return out


def _stack_targets(name):
    """The packages a stack builds -- book/git/tar entries, not checks."""
    path = name if os.path.sep in name else os.path.join(
        STACK_DIR if "STACK_DIR" in globals() else "/etc/pkgusr/stacks",
        name if name.endswith(".stack") else name + ".stack")
    if not os.path.isfile(path):
        printError("no such stack: %s (%s)" % (name, path))
        return None
    try:
        rows = _parse_stack_file(path)
    except ValueError as e:
        printError(str(e))
        return None
    # a stack on another book: refresh it once, and make sure the entries
    # read it even when this file is not the installed copy
    _sb = {r["target"]: r["opts"]["from-book"] for r in rows
           if r["kind"] == "book" and r["opts"].get("from-book")}
    if _sb:
        _stack_book_map().update({k.lower(): v for k, v in _sb.items()})
        _BOOK_FOR_PKG.clear()
        os.environ["PM_STACK_BOOKS"] = ",".join(
            "%s=%s" % kv for kv in sorted(_sb.items()))
        for _sel in sorted(set(_sb.values())):
            _book_path_for(_sel, refresh=True)
            printInfo("  %d package(s) of this stack read the %s book"
                      % (list(_sb.values()).count(_sel), _sel))
    return [r["target"] for r in rows
            if r["kind"] in ("book", "git", "tar")]


def cmd_update(args):
    # "UPDATE THE MEDIA CHAIN" WITHOUT TYPING EIGHTEEN NAMES.
    #
    # `stack media --run` builds what is MISSING and never updates what is
    # installed -- correct, and not what someone means by "update the media
    # stack".  The other end, `update webkitgtk`, is one package.  Between
    # them there was nothing but a list of names to type out.
    if getattr(args, "stack", None):
        _tg = _stack_targets(args.stack)
        if _tg is None:
            return 2
        if args.packages:
            printInfo("  --stack %s and named packages: using the named ones"
                      % args.stack)
        else:
            args.packages = _tg
            printInfo("  --stack %s: %d package(s) considered -- %s"
                      % (args.stack, len(_tg), ", ".join(_tg[:8])
                         + (" ..." if len(_tg) > 8 else "")))
            printInfo("    only those the book has moved past will appear in "
                      "the plan.")
            printInfo("    pick from them instead of taking all:  --select")
    # --local: update a single package from a custom/local install script
    # (e.g. a git-based package).
    if getattr(args, "local", None):
        name = args.packages[0] if args.packages else None
        if not name:
            printError("update --local needs a package name.")
            return
        path = os.path.abspath(args.local)
        install_local(name, path, args.run, args.yes, "update",
                      test=getattr(args, "test", False),
                      clean=getattr(args, "clean", False))
        return

    # git-repo packages (not from the book): update by re-running their own
    # git-based install script (git fetch + rebuild), bypassing book versions.
    if args.packages and all(_is_git_package(p) or book_version(p) is None
                             for p in args.packages) \
            and any(_is_git_package(p) for p in args.packages):
        for name in args.packages:
            script = _canonical_script_path(name) \
                or os.path.join(pkgusr_home(name), f"install_{name}")
            if not _is_git_package(name):
                printWarning(f"{name}: not a git package and not in the book -- "
                             f"skipping (check the name, or use --local).")
                continue
            # IS IT PHASED?  ASK THE RIGHT QUESTION.
            #
            # This looked for `unpack_pkg`, which is the RARE OVERRIDE a script
            # defines to replace the built-in unpack entirely.  A correct,
            # current script does not define it -- the runner's own unpack is
            # what clones git -- so every properly phased package was told its
            # script "isn't phased", with advice (`template --git`) that
            # overwrites the file and takes any hand-tuned build_pkg with it:
            #     meson setup build ... -D c_link_args=-licuuc
            # A phased script is one that ENDS IN THE RUNNER.  That is the
            # thing that makes fetch/rebuild work, and it is what to test.
            _body = open(script, errors="replace").read()
            if not _is_phased_script(_body):
                printWarning(f"{name}: this script does not end in the phase "
                             f"runner, so `update` cannot fetch and rebuild it "
                             f"cleanly.")
                printInfo("    a phased script ends with:")
                printInfo('      . "${PKGUSR_LIB:-lfs-phases}" && pkgusr_run "$@"')
                printInfo("    and puts its commands in build_pkg / install_pkg.")
                printInfo(f"    `packagemanager template {name} --git <url>` writes"
                          f" a fresh one -- to a NEW file first, then move your")
                printInfo("    build commands across: it does not keep them.")
            # SAY WHETHER THERE IS ANYTHING TO UPDATE TO.
            #
            # "git package -- updating from its repo" is true of a package
            # pinned to the newest tag, where the rebuild produces the same
            # commit it already has: the command works, does exactly what it
            # says, and changes nothing -- and there is no way to tell that
            # from the output.  The remote knows; ask it.
            _st = None if getattr(args, "no_git_check", False) \
                else _git_pkg_state(name)
            if _st:
                if _st["kind"].endswith("branch") and _st["remote"]:
                    if _st["local"][:12] == _st["remote"][:12]:
                        printInfo("  %s: %s is at %s, the same commit as here "
                                  "-- this rebuilds what is already installed"
                                  % (name, _st["ref"], _st["remote"][:8]))
                    else:
                        printInfo("  %s: %s moved %s -> %s%s -- this brings it in"
                                  % (name, _st["ref"], (_st["local"] or "?")[:8],
                                     _st["remote"][:8],
                                     (" (%d commit(s))" % _st["behind"])
                                     if _st["behind"] else ""))
                elif _st["kind"] == "tag":
                    if _st["newer_tags"]:
                        printInfo("  %s: pinned to tag %s; %s is out"
                                  % (name, _st["ref"], _st["newer_tags"][-1]))
                        printInfo("    a rebuild stays on %s.  To move it:"
                                  % _st["ref"])
                        printInfo("      packagemanager git-ref %s %s --run"
                                  % (name, _st["newer_tags"][-1]))
                    else:
                        printInfo("  %s: pinned to tag %s, which is the newest "
                                  "released -- this rebuilds the same commit"
                                  % (name, _st["ref"]))
            printInfo(f"{name}: git package -- updating from its repo.")
            install_local(name, script, args.run, args.yes, "update",
                          test=getattr(args, "test", False),
                          clean=getattr(args, "clean", False))
        return

    flag_sig = "".join([
        "r" if getattr(args, "recursive", False) else "",
        "R" if args.dependents else "",
        "e" if args.ignore_recommended else "", "o" if args.optional else "",
        "c" if getattr(args, "clean", False) else "",
        "i" if getattr(args, "reinstall", False) else ""])
    base = ",".join(sorted(args.packages)) if args.packages else "all"
    plan_key = base + (("#" + flag_sig) if flag_sig else "")
    kind_of = {}                                     # anchor -> required/recommended/...

    cached = use_stored_plan("update", plan_key, assume_yes=args.yes) if args.run else None
    no_book, no_record, unjudged, uptodate = [], [], [], []
    git_tracked = []
    _checked = 0

    if cached is not None:
        plan = [tuple(x) for x in cached]
    else:
        if args.packages and not getattr(args, "recursive", False):
            # DEFAULT: just the named packages, no dependency walk
            vers = book_versions_all()
            vlookup = {t: vers.get(t) for t in args.packages}
            names = list(args.packages)
        elif args.packages:
            vlookup = {}
            for target in args.packages:
                order, _missing = blfs_order_anchors(
                    target, args.ignore_recommended, args.optional)
                for anchor, nv, kind, parent in order:
                    vlookup.setdefault(anchor, nv)
                    if anchor not in kind_of:
                        if not parent:                   # the requested target
                            kind_of[anchor] = ("requested", target)
                        else:
                            kind_of[anchor] = (kind or "required", parent)
                if args.dependents:                  # super-recursive: also rebuild
                    for anchor, nv in book_rdeps(     # everything that depends on it
                            target, args.ignore_recommended, args.optional).items():
                        vlookup.setdefault(anchor, nv)
                        kind_of.setdefault(anchor, ("dependent-of", target))
            names = list(vlookup.keys())
        else:
            vlookup = book_versions_all()
            names = list_all_users()

        # a walk from a stack-book target carries that book's versions for
        # every dependency; the ones it does not own read their own book
        _stack_walk = getattr(args, "recursive", False) and any(
            _book_override(t) for t in (args.packages or []))
        _bk = _current_blfs_book()
        _checked = len(names)
        printInfo(f"Checking {len(names)} package(s) against the book"
                  + (f" ({_bk})" if _bk else "") + "...")
        named = set(args.packages) if args.packages else set()
        plan, not_installed = [], []
        # Two silent exits used to swallow most of a real system.  Every
        # package now lands in a NAMED bucket and the counts add up, because
        # "97 checked, nothing to do" while `lfs update glibc` says 2.42 ->
        # 2.43 is the plan lying about its own scope.
        no_record, unjudged = [], []
        for name in names:
            u = gather_user(name)
            anchor = u.meta.get("name") or name
            bv = vlookup.get(anchor)
            # EACH PACKAGE AGAINST ITS OWN BOOK: a stack's from-book (or
            # machine.conf's book=) -- the default map would "update" an
            # svn-built mpv back to the stable page.
            if _book_override(anchor):
                bv = book_version(anchor) or bv
            elif _stack_walk:
                bv = default_book_version(anchor) or bv
            if u.state != "installed":
                if name in named or anchor in named:
                    not_installed.append(name)
                else:
                    # NOT silent: a package built by lfs-helper has no
                    # install_last, so it reads as "not installed" here and
                    # simply disappeared from every update-all.
                    unjudged.append(name)
                continue
            if not bv:
                # not silently: an update-all that never mentions these reads
                # as "everything is covered", and the LFS-book packages are
                # exactly the ones that are not
                no_book.append(name)
                continue
            if not u.version:
                # An UNKNOWN installed version used to be folded into the
                # same test as the comparison, where it came out falsy --
                # and the package was filed as up to date.  Not knowing is
                # not the same as being current.
                #
                # BUT --reinstall IS NOT A QUESTION ABOUT VERSIONS.  It says
                # "build this again at the book's version", and the answer
                # does not depend on what is recorded: with the version
                # missing, `update curl --reinstall` reported "nothing to
                # update, 1 it cannot judge" and did nothing, 28 times in a
                # row, for packages whose records predate the tool.
                if getattr(args, "reinstall", False):
                    plan.append((anchor, name, "(reinstall)", bv))
                else:
                    # ...AND SAY WHAT THE BOOK HAS.  "no recorded version"
                    # answers half the question: the reader wants to know
                    # what they would get, and the plan already knows it.
                    no_record.append("%s (book: %s)" % (name, bv or "?"))
                continue
            # A GIT-TRACKED PACKAGE HAS NO VERSION TO COMPARE.
            #
            # gst-plugins-rs is a `git` stack entry following upstream, and
            # its name_version is `gst-plugins-rs-git`.  Against the book's
            # 1.28.6 that read as "older", so an update plan offered to
            # replace a cargo-built checkout with the book's page -- a
            # different build entirely, silently.  `-git` is not a version
            # and cannot be behind one.
            _is_git_tracked = (str(u.version or "").endswith("-git")
                               or (u.meta or {}).get("is_git") in ("1", 1))
            if _is_git_tracked:
                git_tracked.append((name, u.version, bv))
                continue
            outdated = not _same_version(bv, u.version)
            if outdated:
                plan.append((anchor, name, u.version, bv))
            elif getattr(args, "reinstall", False):
                plan.append((anchor, name, "(reinstall)", bv))
            else:
                uptodate.append((anchor, name, u.version, bv))

        # tell the user plainly about named packages that aren't installed
        for name in not_installed:
            if book_version(name) is None:
                printWarning(f"{name} is NOT in the book (check the name, e.g. "
                             f"'libjpeg-turbo' vs 'libjpeg') -- "
                             f"try: packagemanager search {name}")
            else:
                printWarning(f"{name} is NOT installed (no completed install "
                             f"found) -- use:  packagemanager install {name}")

        if git_tracked:
            # "LEFT ALONE" IS NOT AN ANSWER TO "IS IT OUT OF DATE?"
            #
            # This said `-git` cannot be behind a book version, which is true
            # and beside the point: a package that follows a BRANCH is behind
            # whenever the branch moves, and the remote can be asked in a
            # second.  A package pinned to a TAG is not behind at all -- the
            # question there is whether a newer tag exists, and taking it is a
            # decision, not an update.  Both are answered here rather than
            # left to the reader.
            print()
            printInfo("  %d package(s) follow GIT, not the book:"
                      % len(git_tracked))
            _moved, _tagged = [], []
            for _n, _iv, _bv in git_tracked:
                _st = _git_pkg_state(_n) if not getattr(args, "no_git_check",
                                                        False) else None
                if _st:
                    print(_git_pkg_line(_st))
                    if _st["kind"].endswith("branch") and _st["remote"] \
                            and _st["local"][:12] != _st["remote"][:12]:
                        _moved.append(_n)
                    if _st["newer_tags"]:
                        _tagged.append(_st)
                else:
                    printInfo("    %-22s tracked as %-20s (the book has %s)"
                              % (_n, _iv, _bv or "no page"))
            if _moved:
                printInfo("    behind their branch -- fetch, rebuild, install:")
                printInfo("      packagemanager update %s --run" % " ".join(_moved))
            for _st in _tagged:
                printInfo("    %s is pinned to %s, and %s is out:"
                          % (_st["name"], _st["ref"], _st["newer_tags"][-1]))
                printInfo("      packagemanager git-ref %s %s --run"
                          % (_st["name"], _st["newer_tags"][-1]))
            if not _moved and not _tagged:
                printInfo("    every one of them is where its ref says it"
                          " should be")
            printInfo("    the whole picture:  packagemanager git-status")
            printInfo("    (taking the BOOK's page instead would be a"
                      " different build:")
            printInfo("     `packagemanager update <pkg> --reinstall --run`.)")

        # named packages that are already current: offer to re-apply
        for anchor, name, iv, bv in uptodate:
            if name not in named and anchor not in named:
                continue                              # only prompt for named ones
            if getattr(args, "no_reinstall", False):
                printInfo(f"{name} is already up to date ({bv}); skipping "
                          f"(--no-reinstall).")
                continue
            # A DRY RUN ASKS NOTHING.  `update --stack media` prompted four
            # times -- once per already-current package -- before printing a
            # plan it was never going to carry out.  A preview that needs
            # answers is not a preview.
            if not getattr(args, "run", False):
                printInfo(f"  {name} is already current ({bv}) -- not in the "
                          f"plan.  To rebuild it anyway:")
                printInfo(f"    packagemanager update {name} --reinstall --run")
                continue
            if args.yes or ask_yes_no(f"{name} is already up to date ({bv}). "
                                      f"Re-apply the update anyway?"):
                plan.append((anchor, name, "(reinstall)", bv))

    if not plan:
        _bk = _current_blfs_book()
        printSuccess("Nothing to update from the BLFS book"
                     + (f" ({_bk})" if _bk else "")
                     + " -- every package it carries is current.")
        # consulted on --run too: with no BLFS work to do, the run has time,
        # and "check them with: lfs update" is a worse answer than the answer
        _report_no_book(no_book, consult_lfs=True,
                        named=getattr(args, "packages", None) or [],
                        no_record=no_record, unjudged=unjudged,
                        uptodate_n=len(uptodate),
                        total=_checked or None)
        clear_plan("update", plan_key)
        return

    def reason_str(anchor):
        kp = kind_of.get(anchor)
        if not kp:
            return ""
        kind, parent = kp
        if kind == "requested":
            return "requested"
        if kind == "dependent-of":
            return f"depends on {parent}"
        return f"{kind} by {parent}"

    if args.select:
        plan = _select_plan_rows(
            plan, lambda r: f"{r[1]:<24} {r[2]} -> {r[3]:<20} "
                            f"{reason_str(r[0])}")
        if not plan:
            printWarning("Nothing selected.")
            return

    save_plan("update", plan_key, plan)

    script_dir = args.outdir or os.path.join(TMP_DIR, "install_files")
    os.makedirs(script_dir, exist_ok=True)
    printHeader(f"Update plan ({len(plan)} package(s))")
    print()
    steps = []
    for anchor, name, iv, bv in plan:
        path = resolve_script(name, bv, script_dir, assume_yes=args.yes,
                              force_regen=getattr(args, "regenerate", False))
        if not path:
            continue
        steps.append((anchor, name, iv, bv, path))
        reason = reason_str(anchor)
        rc_col = f"  {colors.dim}({reason}){colors.normal}" if reason else ""
        print(f"  {name:<22} {iv}  ->  {colors.cyan}{bv}{colors.normal}{rc_col}")

    # loud warning if any package would build from an OLD-format script
    if not getattr(args, "regenerate", False):
        cur_v = _current_script_version()
        outdated = [name for _a, name, _i, _b, _p in steps
                    if _package_script_outdated(name, cur_v)]
        if outdated:
            bar = colors.red + "!" * 58 + colors.normal
            trunc = len(outdated) > 12
            print(f"\n{bar}")
            printWarning(f"!! {len(outdated)} package(s) still use an OLD-format "
                         f"install script:")
            printWarning("!!   " + ", ".join(outdated[:12]) + (" ..." if trunc else ""))
            if trunc:
                printWarning("!! Full list (space-separated, pipe-ready):")
                printWarning("!!   packagemanager script-status --fast -q")
            printWarning("!! A reinstall/update may not run your edits correctly "
                         "and could lose them.")
            printWarning("!! MIGRATE FIRST (merges your edits, backs up .bak) -- "
                         "these packages, or all at once:")
            if trunc:
                printWarning("!!   packagemanager migrate-scripts "
                             "$(packagemanager script-status --fast -q) --run")
            else:
                printWarning("!!   packagemanager migrate-scripts "
                             + " ".join(outdated) + " --run")
            printWarning("!! or add --regenerate here to rebuild scripts from the "
                         "book (discards edits).")
            print(f"{bar}")

    # ---- conflicts, LAST, where they are read ------------------------------
    # A version bump generates a fresh script; local edits to the installed
    # version's script never carry over on their own.  Collected here and said
    # at the END of the plan -- one block to work through -- and --run below
    # STOPS at the first one rather than silently discarding the edits.
    conflicts = []
    if not getattr(args, "regenerate", False):
        for anchor, name, iv, bv, path in steps:
            if _pending_edit_conflict(pkgusr_home(name), iv, bv):
                conflicts.append((name, iv, bv, path))
    if conflicts:
        print()
        printWarning(f"!! {len(conflicts)} package(s) carry LOCAL EDITS the "
                     f"update would leave behind:")
        for name, iv, bv, path in conflicts:
            home = pkgusr_home(name)
            printWarning(f"!!   {name}: install_{iv} differs from install_last")
            printInfo(f"        your edits : {os.path.join(home, 'install_' + iv)}")
            printInfo(f"        fresh {bv}: {path}")
            printInfo(f"        carry them : merge into "
                      f"{os.path.join(home, 'install_' + bv)} -- the update "
                      f"then uses that file")
        printWarning("!! --run stops at the first of these.  Merge the edits "
                     "(above), or add --regenerate to discard them all.")
    # ---- the LFS book covers what BLFS does not  --------------------------
    # BLFS is PREFERRED: anything it carries was planned above, from its own
    # script.  Everything else falls back to the LFS book, so one `update`
    # covers the whole system instead of planning two packages and printing a
    # command for the other twenty-nine.
    _blfs_planned = {n.lower() for _a, n, _i, _b, _p in steps}
    _lfs_steps = []
    if not args.packages:
        for _n, _have, _want in _lfs_stale_list(
                include_current=getattr(args, "reinstall", False)):
            if _n.lower() in _blfs_planned:
                continue                      # BLFS has it: preferred, done
            _lfs_steps.append((_n, _n, _have, _want, _LFS_STEP))
    if _lfs_steps:
        print()
        printInfo("From the LFS book (BLFS does not carry these):")
        for _a, _n, _iv, _bv, _p in _lfs_steps:
            _risk = "  (toolchain)" if _n.lower() in _TOOLCHAIN_RISK else ""
            if _iv == _bv:
                print(f"  {_n:<22} {_iv}  {colors.dim}(rebuild, same version)"
                      f"{colors.normal}{_risk}")
            else:
                print(f"  {_n:<22} {_iv}  ->  {colors.cyan}{_bv}"
                      f"{colors.normal}{_risk}")
        steps += _lfs_steps
        total = len(steps)

    # Rebuilding the toolchain on a running system is not the same act as
    # rebuilding `less`: get it wrong and there is no compiler left to fix it
    # with.  They are planned and shown, but running them has to be asked for.
    _risky = [n for _a, n, _i, _b, p in steps
              if p == _LFS_STEP and n.lower() in _TOOLCHAIN_RISK]
    if _risky:
        print()
        if args.run and not getattr(args, "toolchain", False):
            printWarning("!! toolchain packages in this plan: %s"
                         % ", ".join(_risky))
            printInfo("   Rebuilding those on the running system can leave it")
            printInfo("   without a working compiler.  SKIPPED unless asked:")
            printInfo("     packagemanager update --run --toolchain")
            steps = [s for s in steps if s[1] not in _risky]
            total = len(steps)
        elif not args.run:
            printInfo("Toolchain packages above (%s) need --toolchain with "
                      "--run." % ", ".join(_risky))

    # A systemd book on a SysV system: the scripts call systemctl, the shim
    # turns each call into a visible skip, and the build succeeds -- but the
    # service was not enabled.  Worth knowing BEFORE the build, not as
    # notices scrolling past during it.
    _sysd = _systemctl_users(steps)
    if _sysd:
        print()
        printWarning("%d package(s) in this plan run systemctl, which this "
                     "system does not have:" % len(_sysd))
        for _n, _c, _path in _sysd[:12]:
            printInfo("    %-22s %d line(s)  %s" % (_n, _c, _path))
        if len(_sysd) > 12:
            printInfo("    ... and %d more" % (len(_sysd) - 12))
        printInfo("  Those lines are SKIPPED (and say so), so the build")
        printInfo("  succeeds -- but the service is not enabled.  Edit the")
        printInfo("  file above to add the SysV equivalent; it is the file")
        printInfo("  the build runs, and an edited script is kept.")

    # The report below covers what the plan does NOT: listing a package as
    # "the LFS book answers for this" directly above the same package in the
    # plan printed every stale package twice.
    _planned_now = {n.lower() for _a, n, _i, _b, _p in steps}
    _report_no_book([n for n in no_book if n.lower() not in _planned_now],
                    named=getattr(args, "packages", None) or [],
                    consult_lfs=False,
                    no_record=[n for n in no_record
                               if n.lower() not in _planned_now],
                    unjudged=[n for n in unjudged
                              if n.lower() not in _planned_now])
    _conflict_names = {c[0] for c in conflicts}

    if not args.run:
        print()
        if args.select:
            printInfo(f"Dry run -- you narrowed this to {len(steps)} package(s). "
                      f"It's cached under key '{plan_key}'.\n"
                      f"    Run the SAME set with:  packagemanager update "
                      + " ".join(list(args.packages) +
                                 (["--reinstall"] if args.reinstall else []) +
                                 ["--run --yes"]) +
                      "\n    (don't re-add --select unless you want to re-pick).")
        else:
            exact = "packagemanager update " + " ".join(
                list(args.packages) + [f for f in (
                    "-f" if args.force else "", "-R" if args.dependents else "",
                    "--reinstall" if args.reinstall else "",
                    "--clean" if getattr(args, "clean", False) else "",
                    "-e" if args.ignore_recommended else "",
                    "--optional" if args.optional else "") if f] + ["--run"])
            _report_stale_requires([st[1] for st in steps],
                                   _verbose=getattr(args, "verbose", False))
            # WHERE THE WHOLE LIST IS.  Asking about one package tells you
            # nothing about the rest, and the command for "everything the
            # book has moved on from" is this one with no name after it.
            # WHAT WILL ACTUALLY CHANGE, in one line.  The requirement
            # report above lists a dozen packages and reads like a plan; it
            # is not one, and saying so beats hoping the header is noticed.
            printInfo("  this plan updates %d package(s): %s"
                      % (len(steps), ", ".join(st[1] for st in steps[:10])
                         + (" ..." if len(steps) > 10 else "")))
            printInfo("    nothing else is touched -- the requirements above"
                      " are a comparison, not a list of work.")
            if args.packages:
                printInfo("  other ways to choose:")
                printInfo("    packagemanager update                    #"
                          " everything the book has moved past")
                printInfo("    packagemanager update --stack media      #"
                          " just that stack's packages")
                printInfo("    packagemanager update --stack media --select"
                          " --run   # pick from them")
            printInfo(f"Dry run -- this exact command runs THIS plan ({len(steps)} "
                      f"package(s)):\n    {exact}")
            printInfo(f"(cached under key '{plan_key}', so --run reuses/resumes it).")
        if args.reinstall:
            printInfo("Note: --reinstall reuses each package's edited "
                      "install_<ver> script if present; add --regenerate to "
                      "rebuild the scripts from the book instead.")
        return

    print()
    if not args.yes and not ask_yes_no(f"Update {len(steps)} package(s) now?"):
        printWarning("Aborted.")
        return
    pm = find_pm_install()
    install_only = getattr(args, "install_only", False)
    env = {**os.environ, "PM_MODE": "install" if install_only else "update",
           "PM_YES": "1" if args.yes else "0"}
    if getattr(args, "test", False):
        env["PM_TEST"] = env["PKGUSR_TESTS"] = "1"
    if getattr(args, "reinstall", False):
        env["PM_REINSTALL"] = "1"
    remaining = list(plan)
    total = len(steps)
    errors = 0
    run_log = start_run_log("update", plan_key)
    for i, (anchor, name, iv, bv, path) in enumerate(steps, 1):
        if name in _conflict_names:
            save_plan("update", plan_key, remaining)   # resume-able
            clear_status()
            home = pkgusr_home(name)
            printError(f"stopping BEFORE {name}: install_{iv} carries local "
                       f"edits the fresh {bv} script would leave behind "
                       f"({i - 1}/{total} done).")
            printInfo(f"  your edits : {os.path.join(home, 'install_' + iv)}")
            printInfo(f"  fresh {bv}: {path}")
            printInfo(f"  Merge them into {os.path.join(home, 'install_' + bv)}"
                      f" -- the update then uses that file -- and re-run to "
                      f"resume; or re-run with --regenerate to discard the "
                      f"edits.")
            return
        set_status(f"[{i}/{total}] updating {name} {iv} -> {bv}"
                   + (f"  ({errors} error(s) so far)" if errors else ""))
        verb = "Installing" if install_only else "Updating"
        printHeader(f"({i}/{total}) {verb} {name}: {iv} -> {bv}")
        if path == _LFS_STEP:
            # The LFS book owns this package, and `lfs` already knows how to
            # build one of its packages -- fetching the tarball, generating
            # the script, handing over to lfs-helper.  Reimplementing that
            # here would be a second builder for the same book, which is the
            # whole disease this project keeps treating.
            _lfs_bin = shutil.which("lfs") or "/usr/bin/lfs"
            _cmd = [_lfs_bin, "install", "--reinstall", name]
            if args.yes:
                _cmd.append("--yes")
            printInfo("  via the LFS book:  %s" % " ".join(_cmd))
            try:
                _rc = subprocess.run(_cmd).returncode
            except Exception as e:
                printError(f"  could not run lfs: {e}")
                _rc = 1
            if _rc != 0:
                errors += 1
                printError(f"{name}: the LFS build failed (exit {_rc}); "
                           f"stopping ({i - 1}/{total} done).")
                save_plan("update", plan_key, remaining)
                clear_status()
                return
            remaining = [p for p in remaining if p[0] != anchor]
            save_plan("update", plan_key, remaining)
            continue
        cleaning = getattr(args, "clean", False)
        old_paths = _pkglist_paths(name) if cleaning else None
        t0 = time.time()
        penv = {**env, "PM_NO_REFRESH": "1"} if cleaning else env
        result = run_pm_install(name, path, penv)
        add_run_entry(run_log, name, "update", result.returncode == 0,
                      result.returncode, _pkg_log_dir(name))
        if result.returncode != 0:
            errors += 1
            save_plan("update", plan_key, remaining)   # resume-able
            clear_status()
            printError(f"update failed for {name} (exit {result.returncode}); "
                       f"stopping ({i - 1}/{total} done, {errors} error(s)).")
            printInfo(f"  logs: {_pkg_log_dir(name)}   "
                      f"(see all: packagemanager errors)")
            base = ("packagemanager update " + " ".join(list(args.packages)))
            printInfo("  The plan is saved. To resume after fixing the problem:\n"
                      f"    - if the BUILD was fine and only install failed "
                      f"(perms, a missing dir): retry just install (no recompile):\n"
                      f"        {base} --install-only --run\n"
                      f"      (or for one package:  packagemanager script install "
                      f"{name})\n"
                      f"    - to REBUILD from scratch: {base} --run "
                      f"(add --regenerate to rebuild the script from the book)")
            # Last, and the copy that survives -- see the install path above.
            _canon = os.path.join(pkgusr_home(name), os.path.basename(path))
            _edit = _canon if os.path.isfile(_canon) else path
            print()
            printInfo("  To change what it does, edit:")
            printError(f"    {_edit}")
            sys.exit(result.returncode)
        if getattr(args, "clean", False):
            _clean_after_install(name, old_paths, t0)
        _maybe_remove_old_sources(name, bv, getattr(args, "keep_sources", False))
        remaining = [p for p in remaining if p[0] != anchor]
        save_plan("update", plan_key, remaining)
    clear_status()
    clear_plan("update", plan_key)
    printSuccess(f"Done -- {total} package(s) updated"
                 + (f", {errors} error(s)." if errors else "."))
    # THE PATTERN HAS TO BE A REAL PATH.
    #
    # This built the hint by hand -- os.path.join(BASE_DIR, ...) -- and got it
    # wrong twice over: it printed "/usr/src/p_<pkg>/log", missing the pkgusr/
    # component that every package home actually has.  Someone following it
    # found nothing, twice: the directory does not exist, and until 1.14.71
    # the logs were not there either.  _pkg_log_dir is the function that knows.
    printInfo(f"  results: packagemanager errors     logs: "
              f"{_pkg_log_dir('<name>')}")
# =========================================================================== #
# command: remove                                                 [IMPLEMENTED]
# =========================================================================== #
#
# Default `remove <pkg>` UNINSTALLS the package's files (everything it put on
# the system, from pkg.lst) but KEEPS the package-user and its /usr/src/<pkg>
# home -- so reinstalling is easy and anything special you keep in that home is
# preserved.  The file removal runs AS THE PACKAGE USER (su -), so the kernel
# only lets it delete what that user is allowed to (its own files in the
# install-group dirs); it can never remove another package's or root's files by
# accident.  `--purge` additionally deletes the user, its group and the home.
#
#   (default)   uninstall files, keep user + /usr/src/<pkg>
#   --purge     also remove the user/group and /usr/src/<pkg>
#   --run       actually do it (default is a dry-run plan); --yes skips prompt
#
# Later helpers noted for the nimgnu_ collector-group layer (not yet built):
#   make a dir an install-group dir, fix install-group dir permissions,
#   add a dir to a nimgnu_* group.

# --------------------------------------------------------------------------- #
# dry-run plan cache
#
# A dry run stores what it computed (with a timestamp) so the matching --run can
# reuse it instead of recomputing -- e.g. re-scanning the filesystem for a
# package's files.  Before reusing a stored plan you are shown when it was made
# and asked to confirm.
# --------------------------------------------------------------------------- #

def _plans_dir():
    d = os.path.join(TMP_DIR, "plans")
    os.makedirs(d, exist_ok=True)
    return d


def _run_log_path():
    return os.path.join(TMP_DIR, "last_run.json")


def start_run_log(kind, key):
    """Begin recording a fresh install/update run (overwrites the previous one)."""
    os.makedirs(TMP_DIR, exist_ok=True)
    data = {"kind": kind, "key": key, "started": time.time(), "entries": []}
    try:
        with open(_run_log_path(), "w") as f:
            json.dump(data, f)
    except OSError:
        pass
    return data


def add_run_entry(log, pkg, action, ok, exit_code, log_dir):
    log["entries"].append({"pkg": pkg, "action": action, "ok": ok,
                           "exit": exit_code, "log_dir": log_dir,
                           "time": time.time()})
    try:
        with open(_run_log_path(), "w") as f:
            json.dump(log, f)
    except OSError:
        pass


def read_run_log():
    try:
        with open(_run_log_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def cmd_plan(args):
    """List or clear cached dry-run plans (install/update/remove/fix-install)."""
    d = _plans_dir()
    files = sorted(f for f in os.listdir(d) if f.endswith(".json"))
    if args.action == "clear":
        targets = [f for f in files if (not args.key or args.key in f)]
        for f in targets:
            try:
                os.remove(os.path.join(d, f))
            except OSError:
                pass
        printSuccess(f"cleared {len(targets)} plan(s).")
        return
    if not files:
        printInfo("No cached plans.")
        return
    printHeader("Cached plans")
    print()
    for f in files:
        try:
            data = json.load(open(os.path.join(d, f)))
            n = len(data.get("data") or [])
            when = _ago(data.get("time", 0))
            kind = data.get("kind", "?")
            key = data.get("key", "")
            print(f"  {kind:<12} {key:<24} {n:>4} item(s)   {when}   [{f}]")
        except (OSError, ValueError):
            print(f"  {f}  (unreadable)")
    printInfo("\nclear one:  packagemanager plan clear <file-or-key>\n"
              "clear all:  packagemanager plan clear")



# ---------------------------------------------------------------------------
# WHO WAS BUILT BEFORE WHAT.
#
# Every generated script records the page's own required/recommended/optional
# lists, and every package's pkg.lst is written when it finished installing.
# Those two facts together answer the question that cost this system its ALSA
# and its WebRTC: was anything a package can USE installed after that package
# was built?  Nothing else has to be inferred, guessed or remembered.
# ---------------------------------------------------------------------------

def _pkg_dirs():
    root = os.path.join(BASE_DIR, load_config().get("pkgusr_subdir", "pkgusr"))
    if not os.path.isdir(root):
        root = BASE_DIR
    out = {}
    for d in sorted(os.listdir(root)):
        full = os.path.join(root, d)
        if not os.path.isdir(full):
            continue
        if not os.path.isfile(os.path.join(full, "install_last")):
            continue
        out[re.sub(r"^" + re.escape(pkgusr_prefix()), "", d)] = full
    return out


def _built_when(home):
    """When this package last finished installing.

    pkg.lst is written after the install, so its mtime is the install time.
    install_last is the fallback: generated just before the run.
    """
    for f in ("pkg.lst", "install_last"):
        p = os.path.join(home, f)
        try:
            return os.path.getmtime(p), f
        except OSError:
            continue
    return None, ""


def _script_deps(home):
    """required/recommended/optional, as the page declared them."""
    out = {}
    try:
        body = open(os.path.join(home, "install_last"),
                    encoding="utf-8", errors="replace").read()
    except OSError:
        return out
    for kind in ("required", "recommended", "optional"):
        m = re.search(r"^%s=\((.*?)\)$" % kind, body, re.M | re.S)
        if not m:
            continue
        out[kind] = re.findall(r"'([^']*)'", m.group(1))
    return out


def _norm(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())


_DEP_IDX = {}


def _dep_index(installed):
    """title -> package, built from the packages themselves.

    A dep is written as the page's TITLE ('gst-plugins-base-1.28.1',
    'FreeType-2.14.1'); a package directory is the page's id
    ('gst10-plugins-base', 'freetype2').  Normalising the strings cannot
    bridge that, and 119 of them did not resolve -- which quietly broke the
    REBUILD ORDER, because a dependency edge that does not resolve is an edge
    that does not exist: gst10-plugins-bad sorted before gst10-plugins-base,
    and fontconfig before freetype2.
    
    Every script already records `name_version` -- the tarball base, which is
    the title -- so the mapping is in the data and does not have to be
    guessed.
    """
    key = tuple(sorted(installed))
    if _DEP_IDX.get("key") == key:
        return _DEP_IDX["idx"]
    idx = {}
    for name, home in installed.items():
        idx.setdefault(_norm(name), name)
        try:
            body = open(os.path.join(home, "install_last"),
                        encoding="utf-8", errors="replace").read(4096)
        except OSError:
            continue
        m = re.search(r"^name_version='([^']*)'", body, re.M)
        if not m:
            continue
        base = re.sub(r"-[0-9][0-9a-z.]*$", "", m.group(1))
        idx.setdefault(_norm(base), name)
    _DEP_IDX.update(key=key, idx=idx)
    return idx


def _resolve_dep(dep, installed):
    """A dep is 'Little-CMS-2.18'; a package dir is 'lcms2'.

    THE MAJOR VERSION IS PART OF THE NAME, sometimes.  gtk3 and gtk4 both
    record name_version 'GTK-<v>', so the base name 'GTK' matched whichever
    was indexed first -- and `GTK-4.20.3` resolved to **gtk3**.  webkitgtk
    requires both, so it listed gtk3 twice and gtk4 not at all; the same
    collision hides libsoup-3.x behind libsoup, sdl3 behind sdl, qt6 behind
    qt.

    So try base+major BEFORE base: `GTK-4.20.3` -> gtk4, `libsoup-3.6.6` ->
    libsoup3, and `Opus-1.6.1` -> opus1 does not exist, which falls through
    to opus as before.
    """
    idx = _dep_index(installed)
    base = re.sub(r"-[0-9][0-9a-z.]*$", "", dep)
    m = re.search(r"-([0-9]+)", dep[len(base):]) if len(dep) > len(base) else None
    major = m.group(1) if m else ""
    cands = []
    if major:
        cands += [base + major, base.replace("-", "") + major,
                  base.split("-")[0] + major]
    cands += [base, base.replace("-", ""), base.split("-")[0]]
    for cand in cands:
        n = _norm(cand)
        if n and n in idx:
            return idx[n]
    return None


# DOCS AND TESTS ARE NOT FEATURES.
#
# graphviz appeared against wayland, llvm, ruby, libinput, libexif and
# libical; docutils against glib2 and libdrm.  Rebuilding six packages to
# regenerate documentation nobody reads is not the point of this audit, and
# burying the real findings under it is how a report gets ignored.
_DOC_DEPS = {"graphviz", "docutils", "doxygen", "sphinx", "texlive", "asciidoc",
             "asciidoctor", "dejagnu", "valgrind", "gtk-doc", "xmlto", "ruby",
             "fop", "docbook-xsl", "docbook", "libxslt-docs", "dblatex"}
# ...and these are build-time conveniences, not linked features
_TOOL_DEPS = {"git", "cmake", "cython", "fcron", "meson", "ninja", "nasm",
              "yasm", "expect", "which", "mako", "setuptools", "wheel",
              "hatchling", "pytest", "gi-docgen", "gobject-introspection-docs",
              "unifdef", "gperf"}


# INSTALL DOES NOT REBUILD.  `packagemanager install <pkg> --run
# --regenerate` on an installed package answers "Nothing to do -- everything
# is installed and up to date" -- correctly, and 28 times in a row, so the
# whole rebuild pass did nothing and said so in a way that looked like
# success.  The verb that rebuilds at the same version is `update
# --reinstall`.
def _rebuild_cmd(name):
    return ["packagemanager", "update", name, "--reinstall", "--regenerate",
            "--run", "--yes"]


def _required_graph(installed, kinds=("required",)):
    """package -> the packages it depends on, from its own script."""
    g = {}
    for name, home in installed.items():
        deps, d = set(), _script_deps(home)
        for kind in kinds:
            for dep in d.get(kind, []):
                got = _resolve_dep(dep, installed)
                if got and got != name:
                    deps.add(got)
        g[name] = deps
    return g


def _depends_on(g, a, b, seen=None):
    """does a require b, directly or through anything?"""
    if seen is None:
        seen = set()
    if a in seen:
        return False
    seen.add(a)
    for d in g.get(a, ()):
        if d == b or _depends_on(g, d, b, seen):
            return True
    return False


# A TIMESTAMP IS EVIDENCE; A PROBE IS AN ANSWER.
#
# Two packages built in the same session cannot be ordered by pkg.lst
# mtimes, and that is exactly where the interesting cases are (ffmpeg and
# alsa-lib, zero days apart).  The stacks already carry `expect=` probes that
# read the built artifact -- run them.
def cmd_probe(args):
    import glob as _glob   # noqa: also used by the no-probes branch below
    stacks = sorted(_glob.glob("/etc/pkgusr/stacks/*.stack"))
    if not stacks:
        printError("no stack files in /etc/pkgusr/stacks")
        return 1
    n = ok = bad = 0
    for path in stacks:
        for e in _parse_stack_file(path):
            probe = e["opts"].get("expect")
            if not probe:
                continue
            if args.package and e["target"] not in args.package:
                continue
            n += 1
            r = subprocess.run(["/bin/bash", "-c", probe],
                               stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT)
            stack_name = os.path.basename(path).replace(".stack", "")
            if r.returncode == 0:
                ok += 1
                printSuccess("%-22s %s" % (e["target"], probe))
                continue
            bad += 1
            printError("%-22s %s" % (e["target"], probe))
            # A PROBE THAT FAILS BECAUSE THE PACKAGE IS NOT THERE IS NOT THE
            # SAME FINDING.  gst10-libav had never been built -- it was
            # missing from the stack until now -- and the report said "the
            # feature is NOT in the installed package", which sends the
            # reader looking for a build option.
            home = pkgusr_home(e["target"])
            installed = os.path.exists(os.path.join(home, "pkg.lst"))
            if not installed:
                printInfo("    that package is NOT INSTALLED here -- nothing"
                          " was built without the feature,")
                printInfo("    there is nothing built at all.  Build it:")
                printInfo("      packagemanager stack %s --only %s --run"
                          % (stack_name, e["target"]))
            else:
                printInfo("    the package is installed and the feature is"
                          " not in it.  Rebuild:")
                # not `stack --only`: that runs install, which no-ops on an
                # installed package
                printInfo("      %s" % " ".join(_rebuild_cmd(e["target"])))
            # ...and what the probe itself said, because a probe can be wrong
            # about a path as easily as a package can be wrong about a feature
            first = (r.stdout or b"").decode("utf-8", "replace").strip()
            if first:
                printInfo("    the check said: %s" % first.splitlines()[0][:120])
    if n == 0:
        printInfo("no expect= probes in the stacks"
                  + (" for %s" % ", ".join(args.package) if args.package else ""))
        # SAY WHY THERE ARE NONE.  A stack file you have edited is never
        # overwritten -- the new one lands beside it as .stack.new -- so an
        # installed tool can carry probes that no installed STACK has, and
        # "no probes" reads as "nothing to check" rather than "your stacks
        # predate them".
        waiting = []
        for newf in sorted(_glob.glob("/etc/pkgusr/stacks/*.stack.new")):
            try:
                if "expect=" in open(newf, encoding="utf-8",
                                     errors="replace").read():
                    waiting.append(newf)
            except OSError:
                continue
        if waiting:
            print("")
            printWarning("%d newer stack file(s) beside yours DO carry probes:"
                         % len(waiting))
            for newf in waiting:
                base = os.path.basename(newf).replace(".stack.new", "")
                printInfo("    %s" % newf)
                printInfo("      take it:  packagemanager stack %s --take-new"
                          % base)
            printInfo("  Your copy was edited, so make install left it alone"
                      " and put the new one beside it.")
        else:
            printInfo("  Probes live in the stack files as expect=\"...\"."
                      "  These stacks have none,")
            printInfo("  which is what an older stack looks like:"
                      " compare with the shipped one.")
        return 0
    print("")
    if bad:
        printWarning("%d of %d probe(s) failed -- see each line: a package that"
                     " is not installed and one" % (bad, n))
        printWarning("   built without a feature are different problems.")
        return 1
    printSuccess("all %d probe(s) pass: the features they check are present." % ok)
    return 0


def cmd_late_deps(args):
    installed = _pkg_dirs()
    if not installed:
        printError("no package users with an install_last under %s" % BASE_DIR)
        return 1
    kinds = [k.strip() for k in (args.kind or "recommended,optional").split(",")
             if k.strip()]
    # WHY DID IT DECIDE THAT?  The order is computed from edges, and an edge
    # that does not resolve is invisible -- so when a position looks wrong,
    # the useful thing is the graph it actually used for that package.
    if getattr(args, "why", False):
        for name in (args.package or sorted(installed)):
            if name not in installed:
                printWarning("%s is not installed here" % name)
                continue
            when, src = _built_when(installed[name])
            print("")
            printHeader(name)
            print("  built:  %s (%s)"
                  % (time.strftime("%Y-%m-%d %H:%M",
                                   time.localtime(when)) if when else "unknown", src))
            d = _script_deps(installed[name])
            for kind in ("required", "recommended", "optional"):
                for dep in d.get(kind, []):
                    got = _resolve_dep(dep, installed)
                    if got is None:
                        print("  %-12s %-28s -> no installed package of that name"
                              % (kind, dep))
                        continue
                    dw, _ = _built_when(installed[got])
                    if dw and when:
                        diff = dw - when
                        rel = ("built %+d day(s) relative to it" % (diff // 86400)
                               if abs(diff) >= 86400 else
                               "built %+d hour(s) relative to it" % (diff // 3600))
                    else:
                        rel = "no date"
                    print("  %-12s %-28s -> %s, %s" % (kind, dep, got, rel))
        return 0
    only = set(args.package or [])
    problems, unresolved, nodate = [], set(), []
    for name, home in installed.items():
        if only and name not in only:
            continue
        when, src = _built_when(home)
        if when is None:
            nodate.append(name)
            continue
        late = []
        for kind in kinds:
            for dep in _script_deps(home).get(kind, []):
                got = _resolve_dep(dep, installed)
                if got is None:
                    unresolved.add(dep)
                    continue
                if got == name:
                    continue
                dwhen, _ = _built_when(installed[got])
                if dwhen is None:
                    continue
                # SLACK THAT HIDES THE CASE IS TOO MUCH SLACK.
                #
                # A day was chosen because pkg.lst is rewritten by
                # reload-pkg-list and by --clean, so packages from one run
                # differ by minutes.  But `ffmpeg ... alsa-lib +0 day(s)` was
                # then filed as fine, and alsa-lib a few HOURS after ffmpeg
                # is the original bug exactly.  An hour covers the rewrite
                # noise; anything more is a gap.
                if dwhen - when > 3600:
                    late.append((kind, got, dep, dwhen - when))
        if late:
            problems.append((name, when, src, late))

    # THREE DIFFERENT ANSWERS, and the report was giving one.
    #
    #   ORDERABLE  the dependency does not need this package, so it can simply
    #              be built first -- a stack line moves and the problem is
    #              gone for the next machine.
    #   CIRCULAR   the dependency REQUIRES this package (cairo needs glib2,
    #              mesa needs libxcb).  No order exists.  The only fix is a
    #              second pass: build, build the dependency, rebuild.
    #   COSMETIC   documentation and build tools.  Nothing to gain.
    g = _required_graph(installed)
    # RECOMMENDED IS A DEPENDENCY TOO, for the purpose of asking whether an
    # order exists.  With `required` alone the report said
    #     in the stack: put mesa before libxcb
    # and mesa cannot precede libxcb -- it needs it.  BLFS lists that edge as
    # recommended, not required, and cairo needs glib2 the same way.  Advice
    # that cannot be taken is worse than no advice.
    g_order = _required_graph(installed, ("required", "recommended"))
    orderable, circular, cosmetic = [], [], []
    for name, when, src, late in problems:
        o, c, d = [], [], []
        for item in late:
            dep_pkg = item[1]
            if dep_pkg in _DOC_DEPS or dep_pkg in _TOOL_DEPS:
                d.append(item)
            elif _depends_on(g_order, dep_pkg, name):
                c.append(item)
            else:
                o.append(item)
        if o:
            orderable.append((name, when, src, o))
        if c:
            circular.append((name, when, src, c))
        if d:
            cosmetic.append((name, when, src, d))

    def _show(rows, header, note):
        if not rows:
            return
        print("")
        printHeader(header)
        printInfo("  " + note)
        for name, when, src, late in sorted(rows, key=lambda r: -len(r[3])):
            print("")
            printWarning("%s  (built %s)"
                         % (name, time.strftime("%Y-%m-%d", time.localtime(when))))
            for kind, got, _dep, gap in late:
                when_s = ("%d day(s)" % (gap // 86400) if gap >= 86400
                          else "%d hour(s)" % (gap // 3600))
                print("    %-12s %-22s installed %s later%s"
                      % (kind, got, when_s,
                         "  <- same session: only a probe can settle it"
                         if gap < 21600 else ""))
            # SAY WHAT TO CHANGE, not just what is wrong.  The orderable ones
            # are a stack edit; without the line the reader has to work out
            # which file and which position.
            if rows is orderable:
                print("    in the stack:  put %s before %s"
                      % (", ".join(sorted({g for _k, g, _d, _x in late})), name))

    if not problems:
        printSuccess("no package was built before something it can use.")
    _show(orderable, "built too early -- and an order exists",
          "move these dependencies earlier in the stack, then rebuild these once.")
    _show(circular, "built too early -- no order exists",
          "the dependency requires this package, so it cannot go first."
          "  A second pass is the only fix.")
    if args.include_docs:
        _show(cosmetic, "documentation and build tools only",
              "rebuilding gains you documentation, not features.")
    elif cosmetic:
        print("")
        printInfo("%d package(s) differ only in documentation or build tools"
                  " (--include-docs to see them)" % len(cosmetic))

    # THE REBUILD ORDER IS NOT THE REPORT ORDER.  Rebuilding a library after
    # the thing that links it means doing it twice.
    todo = {r[0] for r in orderable} | {r[0] for r in circular}
    if args.include_docs:
        todo |= {r[0] for r in cosmetic}
    if todo:
        # ORDER BY EVERY EDGE THAT DECIDES A FEATURE, not just the required
        # ones: mesa RECOMMENDS libxcb, so libxcb has to be rebuilt first or
        # mesa is rebuilt against the old one.  Cycles are expected here
        # (cairo and glib2 recommend each other) and are broken below.
        # ORDER THE CLUSTERS, NOT THE NODES.
        #
        # Picking one node out of a cycle and then going back to the ready
        # scan strands the rest of the cluster at the end: freetype2 and
        # harfbuzz (which recommend/require each other) came out LAST, after
        # fontconfig and cairo -- both of which require freetype2.  So the
        # cycle has to be treated as one unit.
        #
        # Tarjan gives the strongly connected components; the components form
        # a DAG by construction, so they sort cleanly.  Inside a component
        # there is no right answer, and the same rule as before applies:
        # least dependent, most depended on.
        nodes = set(todo)
        # THE OPTIONAL EDGE IS THE WHOLE POINT OF THIS PASS.
        #
        # The order graph was required+recommended, so mpg123 was rebuilt
        # BEFORE pulseaudio -- and mpg123's missing feature IS pulseaudio.
        # Ordering a rebuild by the edges that do not decide features, while
        # ignoring the ones that do, cannot be right.
        #
        # Optional edges make the graph much more cyclic; that is honest
        # rather than inconvenient, and SCCs handle it.  Inside a component
        # the STRONG edges (required, recommended) still decide, because
        # those are the ones that break a build rather than a feature.
        g_all = _required_graph(installed,
                                ("required", "recommended", "optional"))
        adj = {n: (g_all.get(n, set()) & nodes) for n in nodes}
        strong = {n: (g_order.get(n, set()) & nodes) for n in nodes}
        index, low, on_stack, stack, sccs, counter = {}, {}, set(), [], [], [0]

        def _strong(v):
            # iterative: a 400-package graph would recurse past the limit
            work = [(v, iter(sorted(adj[v])))]
            index[v] = low[v] = counter[0]; counter[0] += 1
            stack.append(v); on_stack.add(v)
            while work:
                node, it = work[-1]
                advanced = False
                for w in it:
                    if w not in index:
                        index[w] = low[w] = counter[0]; counter[0] += 1
                        stack.append(w); on_stack.add(w)
                        work.append((w, iter(sorted(adj[w]))))
                        advanced = True
                        break
                    if w in on_stack:
                        low[node] = min(low[node], index[w])
                if advanced:
                    continue
                work.pop()
                if work:
                    low[work[-1][0]] = min(low[work[-1][0]], low[node])
                if low[node] == index[node]:
                    comp = []
                    while True:
                        w = stack.pop(); on_stack.discard(w); comp.append(w)
                        if w == node:
                            break
                    sccs.append(comp)

        for n in sorted(nodes):
            if n not in index:
                _strong(n)

        # Tarjan emits each component only after everything it depends on,
        # so this is already dependency order.
        comp_of = {n: i for i, c in enumerate(sccs) for n in c}
        ordered, cycles = [], []

        def _inside(c):
            cs = set(c)
            return sorted(c, key=lambda n: (len(strong[n] & cs),
                                            len(adj[n] & cs),
                                            -sum(1 for m in cs if n in strong[m]),
                                            -sum(1 for m in cs if n in adj[m]),
                                            n))

        for comp in sccs:
            if len(comp) > 1:
                cycles.extend(_inside(comp))
                ordered.extend(_inside(comp))
            else:
                ordered.extend(comp)

        print("")
        printHeader("rebuild, in this order (%d)" % len(ordered))
        printInfo("  dependencies first, so nothing is rebuilt twice.")
        for n in ordered:
            print("    %s" % " ".join(_rebuild_cmd(n)))
        if cycles:
            print("")
            printInfo("  %d of these are in dependency cycles, where no order"
                      " is completely right:" % len(cycles))
            printInfo("    " + ", ".join(cycles))
            printInfo("  each was placed by fewest unmet dependencies, then by"
                      " how many wait for it.")
            printInfo("  If a feature is still missing afterwards, run"
                      " late-deps again: a cycle")
            printInfo("  can need two passes, and the second one is short.")
        if args.rebuild:
            print("")
            if not args.run:
                printInfo("that is the plan; add --run to do it.")
                return 1
            for i, n in enumerate(ordered, 1):
                printHeader("rebuild %d/%d: %s" % (i, len(ordered), n))
                rc = subprocess.run(_rebuild_cmd(n)).returncode
                if rc != 0:
                    printError("%s failed (exit %d) -- stopping here, with"
                               " %d left." % (n, rc, len(ordered) - i))
                    printInfo("  fix it, then run late-deps --rebuild --run again:"
                              " what succeeded is recorded and will not repeat.")
                    return 1
            printSuccess("rebuilt %d package(s)." % len(ordered))
            return 0
    if unresolved and args.verbose:
        print("")
        printInfo("could not match to an installed package (so not checked): %s"
                  % ", ".join(sorted(unresolved)))
    elif unresolved:
        print("")
        printInfo("%d dependency name(s) match no INSTALLED package"
                  " (--verbose lists them)." % len(unresolved))
        printInfo("  Mostly that means they are not installed, which is"
                  " nothing to fix -- a package")
        printInfo("  that is not there cannot have been built after anything."
                  "  A name you know IS")
        printInfo("  installed appearing there is worth reporting: it is an"
                  " edge this cannot see.")
    if nodate:
        printInfo("%d package(s) have no pkg.lst and no install_last date"
                  % len(nodate))
    return 1 if problems else 0

def cmd_errors(args):
    """Show which packages failed in the LAST install/update run, with their log
    locations.  With --all, show every package's result."""
    log = read_run_log()
    if not log:
        printInfo("No install/update run recorded yet.")
        return
    entries = log.get("entries", [])
    fails = [e for e in entries if not e["ok"]]
    oks = [e for e in entries if e["ok"]]
    printHeader(f"Last run: {log.get('kind')} {log.get('key', '')}")
    print(f"\n  {_ago(log.get('started', 0))} -- "
          f"{len(oks)} ok, {colors.red}{len(fails)} failed{colors.normal}, "
          f"{len(entries)} total\n")
    show = entries if getattr(args, "all", False) else fails
    if not show:
        printSuccess("No errors in the last run.")
        return
    for e in show:
        mark = (f"{colors.green}ok{colors.normal}" if e["ok"]
                else f"{colors.red}FAILED (exit {e['exit']}){colors.normal}")
        print(f"  {e['pkg']:<26} {e['action']:<8} {mark}")
        print(f"      log: {e['log_dir']}")
    if fails:
        newest = max(fails, key=lambda e: e["time"])
        printInfo(f"\n  tip: view the newest failing log with:\n"
                  f"    ls -t {newest['log_dir']} | head -1   # then less that file")


def set_status(msg):
    """Show a persistent one-line status at the bottom (progress across many
    packages).  No-op when stdout isn't a terminal so it can't corrupt logs."""
    if sys.stdout.isatty():
        sys.stdout.write("\r\033[K" + msg[:120])
        sys.stdout.flush()


def clear_status():
    if sys.stdout.isatty():
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()


def _versioned_script_in(home):
    """The editable install_<name>-<version> in a package user's home.

    That is the file a person is told to edit, and the one the copy that
    actually runs is made from -- so a failure has to be able to name it.
    """
    # THE ONE THAT WAS LAST INSTALLED, NOT THE FIRST IN THE ALPHABET.
    #
    # A home keeps every version's script: p_mesa has install_Mesa-25.3.5
    # and install_Mesa-26.1.7.  sorted() returned 25.3.5, so `script install
    # mesa` ran the OLD version's install over a 26.1.7 build ("9" also sorts
    # after "10").  install_last names the version last staged; take that
    # file.  Without it, the newest by modification time.
    try:
        cands = [f for f in os.listdir(home)
                 if f.startswith("install_") and not f.endswith((".edited", ".bak"))
                 and re.search(r"-\d[\w.]*$", f)]
    except OSError:
        return None
    if not cands:
        return None
    try:
        m = re.search(r"^name_version=['\"]([^'\"]+)['\"]",
                      open(os.path.join(home, "install_last"),
                           encoding="utf-8", errors="replace").read(), re.M)
        if m and ("install_" + m.group(1)) in cands:
            return os.path.join(home, "install_" + m.group(1))
    except OSError:
        pass
    return max((os.path.join(home, f) for f in cands), key=os.path.getmtime)


def _unpacked_source_dir(home):
    """Where the package unpacked, when there is exactly one candidate."""
    src = os.path.join(home, "src")
    try:
        dirs = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]
    except OSError:
        return None
    return os.path.join(src, dirs[0]) if len(dirs) == 1 else None


def _pkg_log_dir(user):
    return os.path.join(pkgusr_home(user), "log")


def _maybe_remove_old_sources(user, keep_name_version, keep_sources=False):
    """After a successful (re)install, remove OLD unpacked source dirs and stale
    downloaded archives in the package user's home, keeping the current version.
    Removes automatically; pass keep_sources=True to skip."""
    if keep_sources:
        return
    home = pkgusr_home(user)
    keep = keep_name_version
    victims = []
    try:
        for fn in os.listdir(home):
            p = os.path.join(home, fn)
            if fn.startswith(".") or fn.startswith("install_") or fn == "log":
                continue
            if fn == "pkg.lst" or fn == "pkg.lst.new":
                continue
            if fn == keep:                              # current source dir
                continue
            is_archive = fn.endswith((".tar", ".tgz", ".tar.gz", ".tar.bz2",
                                      ".tar.xz", ".zip"))
            if (os.path.isdir(p) or is_archive) and keep.split("-")[0].lower() \
                    in fn.lower():
                if fn.startswith(keep):                 # current version's archive
                    continue
                victims.append(p)
    except OSError:
        return
    if not victims:
        return
    for p in victims:
        try:
            if os.path.isdir(p):
                shutil.rmtree(p)
            else:
                os.remove(p)
        except OSError as e:
            printWarning(f"    could not remove {p}: {e}")
    printInfo(f"  removed {len(victims)} old source item(s) for {user} "
              f"(keeping {keep}).")


def _plan_path(kind, key):
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", key)
    return os.path.join(_plans_dir(), f"{kind}__{safe}.json")


def save_plan(kind, key, data):
    try:
        with open(_plan_path(kind, key), "w") as f:
            json.dump({"plan_version": PLAN_VERSION, "time": time.time(),
                       "kind": kind, "key": key, "data": data}, f)
    except OSError:
        pass


def load_plan(kind, key):
    try:
        with open(_plan_path(kind, key)) as f:
            plan = json.load(f)
        if plan.get("plan_version") != PLAN_VERSION:  # structure changed -> ignore
            return None
        return plan
    except (OSError, ValueError):
        return None


def clear_plan(kind, key):
    try:
        os.remove(_plan_path(kind, key))
    except OSError:
        pass


def _ago(t):
    s = max(0, int(time.time() - t))
    if s < 90:
        return f"{s}s ago"
    if s < 5400:
        return f"{s // 60}m ago"
    if s < 172800:
        return f"{s // 3600}h ago"
    return f"{s // 86400}d ago"


def use_stored_plan(kind, key, assume_yes=False):
    """Return the stored plan's data if one exists and the user confirms using
    it (given its age), else None."""
    plan = load_plan(kind, key)
    if not plan:
        return None
    n = len(plan.get("data") or [])
    when = _ago(plan.get("time", 0))
    if assume_yes:
        printInfo(f"Using stored dry-run from {when} ({n} item(s)).")
        return plan["data"]
    if ask_yes_no(f"Found a dry-run from {when} ({n} item(s)). Use it "
                  f"(skip re-scanning)?"):
        return plan["data"]
    return None


def find_forall():
    return os.environ.get("FORALL_BIN", "forall_direntries_from").split()


def owned_entries(name):
    """All filesystem entries owned by user OR group `name`, scanned as root via
    forall_direntries_from.  None if the tool isn't available.  Used for the
    install-group and nimgnu-group scans."""
    try:
        r = subprocess.run(find_forall() + [name], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return [ln for ln in r.stdout.splitlines() if ln.strip()]


def pkglist_entries(pkg_list):
    try:
        with open(pkg_list, encoding="utf-8", errors="replace") as f:
            return [ln.strip() for ln in f if ln.strip()]
    except OSError:
        return []


def scan_owned_as_user(user):
    """Files/dirs owned by `user`, found by running forall_direntries_from AS
    that user (su -), so the search only descends where the user can go instead
    of walking the whole filesystem as root.  Returns a list, or None if forall
    is unavailable."""
    forall = " ".join(shlex.quote(x) for x in find_forall())
    inner = f"{forall} {shlex.quote(user)}"
    cmd = ["su", "-", user, "-c", inner] if _can_su(user) else ["sh", "-c", inner]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return [ln for ln in r.stdout.splitlines() if ln.strip()]


def remove_paths_as_user(user, paths, as_user=True):
    """Delete `paths`: files/symlinks first, then now-empty directories deepest-
    first, streaming a live progress line.  By default runs AS the package user
    (su -) so the kernel enforces what may be removed; with as_user=False it runs
    as the current (root) process -- the thorough fallback for files the user
    itself can't reach.  Returns the number of entries removed."""
    paths = [p for p in paths if p]
    if not paths:
        return 0
    listfile = os.path.join(_plans_dir(),
                            re.sub(r"[^A-Za-z0-9_.-]+", "_", user) + ".rmlist")
    with open(listfile, "w") as f:
        f.write("\n".join(paths) + "\n")
    os.chmod(listfile, 0o644)
    lf = shlex.quote(listfile)
    inner = (
        f'while IFS= read -r p; do '
        f'if [ -L "$p" ] || {{ [ -f "$p" ] && [ ! -d "$p" ]; }}; then '
        f'rm -f -- "$p" 2>/dev/null && echo "$p"; fi; done < {lf}; '
        f"awk '{{print length\"\\t\"$0}}' {lf} | sort -rn | cut -f2- | "
        f'while IFS= read -r p; do [ -d "$p" ] && rmdir -- "$p" 2>/dev/null && echo "$p"; done'
    )
    if as_user and _can_su(user):
        cmd = ["su", "-", user, "-c", inner]
    else:
        cmd = ["sh", "-c", inner]
    count = 0
    tty = sys.stdout.isatty()
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             text=True, bufsize=1)
        for line in p.stdout:
            e = line.strip()
            if not e:
                continue
            count += 1
            if tty and (count % 5 == 0 or count == 1):
                sys.stdout.write(f"\r  removed {count}... {os.path.basename(e)[:40]:<40}")
                sys.stdout.flush()
        p.wait()
    finally:
        if tty:
            sys.stdout.write("\r" + " " * 70 + "\r")
            sys.stdout.flush()
        try:
            os.remove(listfile)
        except OSError:
            pass
    return count


def user_supplementary_groups(name):
    if grp is None:
        return []
    return sorted(g.gr_name for g in grp.getgrall() if name in g.gr_mem)


_STATE = {"verbose": False}


def _run(cmd, show_output=False):
    """Run a command, always echoing the command line so the user sees the
    system change being made.  With --verbose (or show_output=True) the command's
    own output is shown too; otherwise it's captured and surfaced only on error."""
    print(f"  {colors.blue}$ "
          f"{' '.join(shlex.quote(c) for c in cmd)}{colors.normal}")
    try:
        if _STATE["verbose"] or show_output:
            r = subprocess.run(cmd)
        else:
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                printError(f"  {' '.join(cmd)} -> {r.stderr.strip() or r.returncode}")
    except FileNotFoundError:
        # a missing helper is an ordinary problem to report, not a stack trace
        printError(f"  {cmd[0]}: command not found")
        return False
    except PermissionError as e:
        printError(f"  {cmd[0]}: {e}")
        return False
    return r.returncode == 0


def remove_one(name, args):
    u = gather_user(name)
    home = pkgusr_home(name)
    has_home = os.path.isdir(home)
    if not u.has_user and not has_home:
        printWarning(f"{name}: nothing to remove (no user, no home).")
        return

    # safety: for --purge, never remove a user whose home isn't under /usr/src
    if args.purge and u.has_user:
        # `u.has_user` was computed for the ACCOUNT; this looked the ANCHOR up
        # in passwd, so `packagemanager remove cargo-c --purge` died with
        #     KeyError: getpwnam(): name not found: 'cargo-c'
        # A missing account is a normal answer here, not an exception.
        try:
            pw_dir = pwd.getpwnam(pkgusr_name(name)).pw_dir if pwd else ""
        except KeyError:
            pw_dir = ""
        if not pw_dir.startswith(BASE_DIR.rstrip("/") + "/"):
            printError(f"{name}: user home {pw_dir} is not under {BASE_DIR}; "
                       f"refusing to purge (not a package-user).")
            return

    groups = user_supplementary_groups(name)

    def header():
        printHeader(f"{'Purge' if args.purge else 'Remove'} {name}")
        print()
        tag = "   (will be removed)" if args.purge \
            else "   (kept -- use --purge to remove)"
        if has_home:
            print(f"  home directory  : {home}{tag}")
        if u.has_user:
            print(f"  user/group      : {name} (uid {u.uid}, gid {u.gid}){tag}")
        if groups:
            print(f"  member of       : {', '.join(groups)}")

    def do_scan():
        if getattr(args, "root", False):
            printInfo(f"Scanning the whole filesystem for files owned by {name}, "
                      f"as root (thorough; may take a while)...")
            return owned_entries(name)
        printInfo(f"Searching for files owned by {name}, as {name} "
                  f"(su - {name}; may take a moment)...")
        return scan_owned_as_user(name)

    # DRY RUN: search and store the result for a fast --run later
    if not args.run:
        entries = do_scan()
        if entries is None:
            printError("forall_direntries_from not found; cannot search.")
            return
        save_plan("remove", name, entries)
        header()
        print(f"  installed files : {len(entries)} (owned by {name})")
        printInfo("\nDry run -- re-run with --run (it will offer to reuse this "
                  "search instead of scanning again).")
        return

    # RUN
    header()
    what = f"purge {name} (all its files + user + home)" if args.purge \
        else f"uninstall all files owned by {name} (keep user + home)"
    if not args.yes and not ask_yes_no(f"\nReally {what}?"):
        printWarning("Aborted.")
        return

    # reuse a stored dry-run if the user confirms; otherwise search now
    entries = use_stored_plan("remove", name, assume_yes=args.yes)
    if entries is None:
        entries = do_scan() or []
    total = remove_paths_as_user(name, entries,
                                 as_user=not getattr(args, "root", False))
    clear_plan("remove", name)
    printInfo(f"  uninstalled {total} files owned by {name}")

    if args.purge:
        # THE ACCOUNT, NOT THE ANCHOR -- AND CHECK IT WORKED.
        #
        # `remove --purge mako` ran `userdel mako`.  There is no such user;
        # the account is p_mako, which stayed in /etc/passwd while the tool
        # printed "mako purged."  The files and the home were gone, so the
        # system was left with an account owning nothing and a report saying
        # otherwise.
        _acct = pkgusr_name(name)
        if u.has_user:
            if not _run(["userdel", _acct]):     # _run returns True on success
                printError(f"  userdel {_acct} did not succeed -- the account "
                           f"is still there")
                printInfo(f"    check with:  grep {_acct} /etc/passwd")
            if grp is not None:
                try:
                    grp.getgrnam(_acct)
                    _run(["groupdel", _acct])
                except KeyError:
                    pass
        if has_home and os.path.isdir(home):
            try:
                shutil.rmtree(home)
            except OSError as e:
                printError(f"  rmtree {home}: {e}")
        _left = []
        if pwd is not None:
            try:
                pwd.getpwnam(_acct)
                _left.append("the account " + _acct)
            except KeyError:
                pass
        if os.path.isdir(home):
            _left.append(home)
        if _left:
            printWarning(f"{name}: files removed, but {', '.join(_left)} "
                         f"remain -- NOT fully purged")
        else:
            printSuccess(f"{name} purged.")
    else:
        for fname in ("pkg.lst", "pkg.lst.new"):     # manifest now meaningless
            try:
                os.remove(os.path.join(home, fname))
            except OSError:
                pass
        printSuccess(f"{name} uninstalled (user kept" +
                     (f", {home} kept)." if has_home else ")."))


def cmd_remove(args):
    for name in args.packages:
        remove_one(name, args)
