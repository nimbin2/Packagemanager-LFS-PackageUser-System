_SETUP_HELP = """\
Bootstrap the tooling on a freshly booted system.

LFS ships no download tool, so a new system cannot fetch even the sources for
its own next package.  And `lfs` and `blfs` need `requests` and
`beautifulsoup4` to read the books, so without them the tools cannot run on the
system they just built.

    packagemanager setup --sources     what it needs downloaded
    packagemanager setup --run         install it

The tarballs must be on disk BEFORE the reboot, while the host still has a
network -- `lfs build-system get-sources` asks this command for the list.
"""

# What a freshly booted system needs before it can fetch anything itself.
#
# wget comes from the BLFS BOOK: the book already knows its URL and keeps it
# current, and a second list of download links is a second thing to go stale.
_SETUP_BLFS_PACKAGES = ["wget"]

# The Python modules `lfs` and `blfs` need to parse the books.
#
# WHEELS, not source tarballs, and not from the book.  A modern sdist needs its
# build backend -- beautifulsoup4 wants hatchling, requests wants setuptools --
# and with no package index reachable pip cannot fetch one:
#     BackendUnavailable: Cannot import 'hatchling.build'
# A wheel is already built, so pip only unpacks it.  All of these are pure
# Python, so the "any" wheel works on every architecture.
#
# Dependencies first: setup installs with --no-deps, so pip will not pull them.
_SETUP_WHEELS = [
    "https://files.pythonhosted.org/packages/py3/u/urllib3/urllib3-2.2.3-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/c/charset_normalizer/charset_normalizer-3.4.0-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/i/idna/idna-3.10-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/c/certifi/certifi-2024.8.30-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/s/soupsieve/soupsieve-2.6-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/r/requests/requests-2.32.3-py3-none-any.whl",
    "https://files.pythonhosted.org/packages/py3/b/beautifulsoup4/beautifulsoup4-4.12.3-py3-none-any.whl",
]


def setup_sources():
    """Every URL this command needs, resolved once."""
    import subprocess
    urls = []
    for pkg in _SETUP_BLFS_PACKAGES:
        try:
            out = subprocess.run(["blfs", "sources", pkg],
                                 capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.SubprocessError):
            printWarning("could not run `blfs sources %s` -- is blfs installed?"
                      % pkg)
            continue
        got = [l.strip() for l in (out.stdout or "").splitlines()
               if l.strip().startswith(("http://", "https://", "ftp://"))]
        if not got:
            printWarning("the BLFS book gave no download for '%s' "
                      "(try: blfs fetch)" % pkg)
            continue
        urls += got
    return urls + _SETUP_WHEELS


# Where the tarballs and wheels are, on the booted system.
#
# Book 3.1's /sources, kept: `lfs build-system get-sources` put them there
# while the host still had a network, and that is the last moment there was
# one.  Overridable, because a tree can be mounted anywhere.
def setup_sources_dir():
    return os.environ.get("LFS_SOURCES_DIR") or "/sources"


def _wheel_dist(url):
    """(distribution, version, filename) from a wheel URL.

    PEP 427 fixes the filename: {dist}-{version}-{python}-{abi}-{platform}.whl,
    so the first two fields are exactly what pip records in site-packages as
    <dist>-<version>.dist-info.  That is what makes the check below an
    identity, not a guess.
    """
    fn = url.rsplit("/", 1)[-1]
    parts = fn[:-4].split("-") if fn.endswith(".whl") else fn.split("-")
    if len(parts) < 2:
        return fn, "", fn
    return parts[0], parts[1], fn


def _wheel_installed(site, dist, version):
    return bool(site) and os.path.isdir(
        os.path.join(site, "%s-%s.dist-info" % (dist, version)))


def _have_ca_bundle():
    return any(os.path.isfile(c) and os.path.getsize(c) > 0 for c in _CA_BUNDLES)


def _make_ca_installed():
    return bool(shutil.which("make-ca")) or os.path.isfile("/usr/sbin/make-ca")


def _bootstrap_state():
    """What is already true, so bootstrap can be run twice and do nothing twice.

    Five stages, in the order they unblock each other.  Each is a question this
    tool already knew how to answer on its own; what was missing was the
    SEQUENCE -- a freshly booted system where every check says something
    different and nothing says what to do first.
    """
    site = _pip_site_dir()
    wheels = []
    for url in _SETUP_WHEELS:
        dist, ver, fn = _wheel_dist(url)
        wheels.append((dist, ver, fn, url, _wheel_installed(site, dist, ver)))
    return {
        "site": site,
        "wget": shutil.which("wget"),
        "wheels": wheels,
        "book": _blfs_book_available(),
        "make_ca": _make_ca_installed(),
        "ca": _have_ca_bundle(),
        "unverified": _wgetrc_is_weakened(),
    }


def _wgetrc_is_weakened():
    """Is certificate checking still turned off in /etc/wgetrc?"""
    try:
        return _WGETRC_MARK in open("/etc/wgetrc").read()
    except OSError:
        return False


def _setup_install_wget(yes):
    """Install wget through the ordinary BLFS path.

    Invoked as a command rather than called as a function: `packagemanager
    install wget --run` is a build plan, a script, a package user and a
    manifest, and there is no version of "just the wget part" of that which is
    not a second implementation of it.
    """
    return _install_via_self("wget", yes)


def _install_via_self(pkg, yes, recursive=False, required_only=False, ignore=None,
                      ignore_prereqs=False):
    cmd = [sys.executable, os.path.abspath(__file__), "install", pkg, "--run"]
    if recursive:
        cmd.append("--recursive")
    if ignore_prereqs:
        # a stack is a long unattended run: a decision to push past a missing
        # tool has to reach the install it delegates to
        cmd.append("--ignore-prereqs")
    if required_only:
        cmd.append("--ignore-recommended")
    if ignore:
        # ONE list, already joined by the caller.  A second block here
        # re-joined the STRING -- ",".join("texlive,...") is one comma per
        # LETTER -- and the command line grew a second --ignore reading
        # "t,e,x,l,i,v,e,...".
        cmd += ["--ignore", ignore]
    if yes:
        cmd.append("--yes")
    printInfo("  $ " + " ".join(cmd[2:]))
    try:
        return subprocess.run(cmd).returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        printError("could not install %s: %s" % (pkg, e))
        return False


# The stages, in the order they unblock each other.  Kept as data so the
# report, the work and the tests all read the same list.
_BOOTSTRAP_STAGES = [
    # The modules come first: looking a package up in the book needs them, and
    # installing the download tool IS a book lookup.
    ("wheels",  "Python modules for reading the books",
                "`blfs` and `packagemanager` cannot parse a book"),
    ("wget",    "a download tool",
                "nothing can be fetched at all"),
    ("book",    "the BLFS book on disk",
                "every package lookup fails the same way: not found"),
    ("make_ca", "make-ca, for certificates",
                "downloads stay unverified"),
    ("ca",      "a CA certificate bundle",
                "make-ca is installed but has generated nothing"),
]


def cmd_setup(args):
    if args.sources:
        for u in setup_sources():
            print(u)
        return

    st = _bootstrap_state()
    srcdir = getattr(args, "sources_dir", None) or setup_sources_dir()
    force = getattr(args, "force", False)
    yes = getattr(args, "yes", False)
    todo_wget = not st["wget"] or force
    todo_wheels = [w for w in st["wheels"] if force or not w[4]]
    n_wheels = len(st["wheels"]) - len(todo_wheels)

    def mark(done):
        return "  ok  " if done else "  --  "

    printHeader("packagemanager bootstrap")
    print()
    print("  A freshly booted LFS system has no download tool, no Python")
    print("  modules to read a book with, no BLFS book and no certificates.")
    print("  These are the five things between here and a working `blfs`:")
    print()
    print("%s1. book-parsing modules     %d of %d installed"
          % (mark(not todo_wheels), n_wheels, len(st["wheels"])))
    print("%s2. a download tool          %s" % (mark(st["wget"]),
          st["wget"] or "wget is not installed"))
    print("%s3. the BLFS book            %s" % (mark(st["book"]),
          "found" if st["book"] else "no book on disk"))
    print("%s4. make-ca                  %s" % (mark(st["make_ca"]),
          "installed" if st["make_ca"] else "not installed"))
    print("%s5. CA certificates          %s" % (mark(st["ca"]),
          "present" if st["ca"] else "no bundle generated yet"))
    print()
    print("  site-packages : %s" % (st["site"] or "NOT FOUND -- is Python installed?"))
    print("  sources       : %s" % srcdir)
    if st["unverified"]:
        print()
        printWarning("  Certificate checking is OFF in /etc/wgetrc so that")
        printWarning("  make-ca can be fetched at all.  It is turned back on")
        printWarning("  automatically once stage 5 is done.")

    if not st["site"]:
        printError("\nNo system site-packages directory: nothing can be installed.")
        sys.exit(1)

    # Stages 1 and 2 need no network -- only the files get-sources already put
    # on disk.  Stages 3-5 need a working download, which is exactly what 1 and
    # 2 buy you, so they run straight after in the same command.
    if not todo_wget and not todo_wheels:
        print()
        printSuccess("Stages 1 and 2 are done -- `blfs` and `packagemanager` can read a book.")
        if not args.run:
            _bootstrap_next_steps(st)
            printInfo("\nDry run -- to do these, re-run with --run.")
            return
        failed = _bootstrap_finish(st, yes)
        _bootstrap_report(failed)
        return

    if not args.run:
        print()
        _bootstrap_next_steps(st)
        printInfo("\nDry run -- to apply all of this, re-run with --run.")
        return

    # The wheels are already on disk and pip must not reach for an index: this
    # system has no CA certificates yet, so anything that tries is a hang, not
    # an error.
    missing = [fn for _d, _v, fn, _u, _h in todo_wheels
               if not os.path.isfile(os.path.join(srcdir, fn))]
    if missing:
        printError("\nThese wheels are not in %s:" % srcdir)
        for fn in missing:
            print("    %s" % fn)
        printWarning("They had to be downloaded before the reboot:")
        printWarning("    lfs build-system get-sources --run   (on the host)")
        sys.exit(1)

    failed = []

    # MODULES FIRST, THEN THE DOWNLOAD TOOL.
    #
    # Installing wget means looking it up in the BLFS book, and reading the
    # book needs requests and beautifulsoup4.  With the tool installed first,
    # the very first run on a fresh system could not parse the book it was
    # holding and said the package did not exist:
    #
    #     $ install wget --run
    #     wget: not in the BLFS book.
    #     searching the book for wget  Nothing similar found either.
    #
    # ...and it only ever succeeded on a SECOND run, once stage 2 had put the
    # parsers in place -- which looked like flakiness rather than an order.
    # The wheels need neither the book nor a network, so they come first and
    # nothing is lost.
    if todo_wheels:
        printHeader("1. book-parsing modules")
        grp = collector_prefix() + _pip_owner_of_python()
        # IN ORDER, with --no-deps: pip cannot reach an index to resolve
        # anything, so the order in _SETUP_WHEELS is the dependency order and
        # each module must already have what it imports.
        for dist, ver, fn, url, _have in todo_wheels:
            if not pip_install_module(dist, st["site"], grp,
                                      find_links=srcdir, no_deps=True,
                                      target=os.path.join(srcdir, fn)):
                failed.append(dist)

    if todo_wget:
        printHeader("2. a download tool")
        if failed:
            printWarning("The book parsers did not install, so the book cannot")
            printWarning("be read and the download tool cannot be looked up.")
            printWarning("Fix those first; this stage would fail for that reason")
            printWarning("rather than for one of its own.")
        elif not _setup_install_wget(yes):
            failed.append("wget")
        else:
            # A system with no certificates cannot verify anything it fetches.
            # This is the same call the tool makes on every invocation; doing it
            # here means the very next download works.
            ensure_wget_workaround()

    print()
    if failed:
        # Stop here: everything after this point needs what just failed.
        _bootstrap_report(failed)
    printSuccess("Stages 1 and 2 done.")
    failed = _bootstrap_finish(_bootstrap_state(), yes)
    _bootstrap_report(failed)


def _bootstrap_report(failed):
    print()
    if failed:
        printError("bootstrap stopped with %d failure(s): %s"
                   % (len(failed), ", ".join(failed)))
        printInfo("Fix them and run it again -- it skips what is already done.")
        sys.exit(1)
    st = _bootstrap_state()
    if st["book"] and st["make_ca"] and st["ca"]:
        printSuccess("Bootstrap complete -- all five stages done.")
        # THE STARTUP HELPERS BELONG TO THE BOOTSTRAP.  BLFS packages drop
        # /etc/profile.d snippets that call pathprepend, which LFS does not
        # provide -- rust's snippet failed on every package-user login.
        # lfs-helper writes them; this is the command people run on a fresh
        # system, so it asks for them here.
        try:
            _pr = subprocess.run(["lfs-helper", "install-profile"],
                                 capture_output=True, text=True)
            for _l in (_pr.stdout or "").splitlines():
                if _l.strip():
                    printInfo("  " + _l.strip())
        except (OSError, subprocess.SubprocessError):
            printWarning("  could not run `lfs-helper install-profile`; BLFS"
                         " profile.d snippets may fail with"
                         " 'pathprepend: command not found'")
        printInfo("Try it:  blfs order <pkg>   /   packagemanager install <pkg>")
    else:
        printSuccess("Nothing left that this command can do.")


def _bootstrap_finish(st, yes):
    """Do stages 3, 4 and 5 -- the ones that need a working download.

    These used to be PRINTED, on the reasoning that each has to be seen to work
    before the next is worth trying.  That was a poor trade: `bootstrap --run`
    is a person saying "get this system ready", and answering with three
    commands to type is refusing the request while looking like an answer.
    Each stage still reports what it did, and a failure still stops the ones
    that depend on it -- which is the part that actually mattered.
    """
    failed = []

    # 3. the book.  Only reachable now: fetching it needs the download tool
    # that stage 2 just installed.
    if not st["book"]:
        printHeader("3. the BLFS book")
        blfs = _find_blfs_cmd()
        if not blfs:
            printError("  blfs is not installed, so the book cannot be fetched.")
            failed.append("the BLFS book")
        else:
            printInfo("  $ blfs fetch")
            try:
                rc = subprocess.run(blfs + ["fetch"]).returncode
            except (OSError, subprocess.SubprocessError) as e:
                printError("  could not run blfs: %s" % e)
                rc = 1
            if rc != 0 or not _blfs_book_available():
                printError("  no book was fetched -- this needs a network.")
                printInfo("  Or copy one in:  blfs import /path/to/BLFS-BOOK-...html")
                failed.append("the BLFS book")

    # 4. make-ca, through the ordinary install path so BLFS resolves what it
    # needs.  Without a book there is nothing to look it up in, so this is
    # skipped rather than attempted and blamed on itself.
    if not st["make_ca"]:
        printHeader("4. make-ca")
        if "the BLFS book" in failed:
            printWarning("  Skipped: there is no book to look make-ca up in.")
            failed.append("make-ca")
        else:
            printInfo("  This fetches over an UNVERIFIED connection -- that is")
            printInfo("  what the /etc/wgetrc marker is for, and the last time")
            printInfo("  it happens.")
            if not _install_via_self("make-ca", yes, recursive=True):
                failed.append("make-ca")

    # 5. the bundle.  `make-ca -g` alone reports "No update required!" and
    # writes nothing, because its copy of certdata.txt looks current right
    # after installing -- so the install looks fine while the system still has
    # no certificates.
    # THE TRIGGER MUST MATCH WHAT COUNTS AS DONE.
    #
    # This ran only when there was NO bundle at all, while 1.11.19 made the
    # finishing condition "a bundle AND no empty store".  So on a tree with the
    # GnuTLS bundle written and /etc/ssl/certs empty, stage 5 was skipped
    # entirely and then the check below reported the empty store as a failure
    # -- correctly, and without ever having tried to fix it.  Reported twice,
    # attempted never.
    if not _have_ca_bundle() or _empty_cert_stores():
        printHeader("5. the certificate bundle")
        if "make-ca" in failed:
            printWarning("  Skipped: make-ca is not installed.")
            failed.append("certificates")
        else:
            if not _run_make_ca():
                failed.append("certificates")

    # Turn verification back on only when there is something that can actually
    # verify.  make-ca writes several stores and EXITS 0 having failed some of
    # them, so "a bundle exists" is not the same as "verification works".
    if _have_ca_bundle():
        empty = _empty_cert_stores()
        if empty:
            printWarning("")
            printWarning("  Some certificate stores were NOT written, even after")
            printWarning("  granting and generating again:")
            for d, why in empty:
                printWarning("    %-28s %s" % (d, why))
            printWarning("  A tool that reads one of those still cannot verify")
            printWarning("  anything.  OpenSSL reads /etc/ssl/certs by default,")
            printWarning("  so this matters to wget itself.")
            printWarning("  Grant it by hand and generate once more:")
            printWarning("      lfs-helper grant-dir %s %s --run"
                         % (_OPENSSL_CERT_DIR, pkgusr_name("make-ca")))
            printWarning("      /usr/sbin/make-ca -g --force")
            if "certificates" not in failed:
                failed.append("certificates")
        else:
            restore_wget_verification()
    return failed


# OpenSSL's default CApath, and the file make-ca writes beside it.  These are
# what `wget` itself consults, so an empty one means verification fails even
# though _have_ca_bundle found a GnuTLS bundle elsewhere and said yes.
_OPENSSL_CERT_DIR = "/etc/ssl/certs"


def _empty_cert_stores():
    """Stores that exist but hold nothing, with why -- best guess."""
    out = []
    d = _OPENSSL_CERT_DIR
    if os.path.isdir(d):
        try:
            n = len([f for f in os.listdir(d)
                     if f.endswith((".pem", ".crt", ".0"))])
        except OSError:
            n = 0
        if n == 0:
            why = "empty"
            try:
                owner = pwd.getpwuid(os.stat(d).st_uid).pw_name
                if owner != "root":
                    why = "empty -- owned by %s" % owner
            except (KeyError, OSError):
                pass
            out.append((d, why))
    return out


def _run_make_ca(retry=True):
    """Generate the certificate stores, granting access if that is what stops it.

    make-ca writes into several directories owned by other packages --
    /etc/ssl/certs belongs to p_openssl -- and it EXITS 0 having failed some of
    them:

        p11-kit: couldn't create file: /etc/ssl/certs/...pem: Unknown error 13
        Failed!!!
        ...
        Extracting GNUTLS server auth certificates to: ...Done!

    A zero exit and one bundle written is what made bootstrap report success
    with an empty OpenSSL trust store.  So: read the output, grant what the
    errors name, and run it again.
    """
    mk = shutil.which("make-ca") or "/usr/sbin/make-ca"
    printInfo("  $ %s -g --force" % mk)
    try:
        r = subprocess.run([mk, "-g", "--force"], capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError) as e:
        printError("  could not run make-ca: %s" % e)
        return False
    out = (r.stdout or "") + (r.returncode and (r.stderr or "") or (r.stderr or ""))
    sys.stdout.write(r.stdout or "")
    sys.stderr.write(r.stderr or "")

    if r.returncode == 0 and not _empty_cert_stores():
        return _have_ca_bundle()

    if not retry:
        if not _have_ca_bundle():
            printError("  no certificate bundle was generated.")
        return False

    # Which directories did it fail on?  Written to a file so the one parser
    # both this and an install failure go through can read it.
    tmp = os.path.join(TMP_DIR, "make-ca.log")
    try:
        os.makedirs(TMP_DIR, exist_ok=True)
        with open(tmp, "w") as f:
            f.write(out)
    except OSError:
        return False
    account = pkgusr_name("make-ca")
    if not _user_exists(account):
        return _have_ca_bundle()
    granted = auto_grant_from_log(account, tmp)
    if not granted:
        printWarning("  make-ca could not write every store, and nothing in its")
        printWarning("  output names a directory to grant.  Check by hand:")
        printWarning("      ls -ald %s" % _OPENSSL_CERT_DIR)
        return False
    printInfo("  granted; generating again ...")
    return _run_make_ca(retry=False)


def _find_blfs_cmd():
    if shutil.which("blfs"):
        return ["blfs"]
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "blfs")
    if os.path.isfile(here):
        return [sys.executable, here]
    return None


def _bootstrap_next_steps(st):
