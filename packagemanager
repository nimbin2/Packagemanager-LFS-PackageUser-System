              f"  packagemanager install {name} --local {path} --run\n"
              f"  (or:  packagemanager add-user {name}; "
              f"lfs-helper pm-install {name} {path})")




# =========================================================================== #
# command: env                                                    [IMPLEMENTED]
# =========================================================================== #
#
# The book asks for a handful of exported variables (TEXLIVE_PREFIX,
# XORG_CONFIG, ...).  Exporting them in a shell does not help: builds run as
# a package user through `su -`, which drops the environment.  They live in
# one file instead, and lfs-helper passes it to every phase.

BUILD_ENV_FILE = os.environ.get("LFS_BUILD_ENV", "/etc/pkgusr/build.env")


def _read_build_env():
    out = {}
    try:
        with open(BUILD_ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def _write_build_env(vals):
    os.makedirs(os.path.dirname(BUILD_ENV_FILE), exist_ok=True)
    with open(BUILD_ENV_FILE, "w") as f:
        f.write("# Build-time variables the BLFS book expects to be exported.\n")
        f.write("# Written by `packagemanager env`; read by every build.\n")
        for k in sorted(vals):
            f.write("%s=%s\n" % (k, vals[k]))


# Values the book states plainly but that the generator cannot lift safely:
# XORG_CONFIG is a quoted, multi-line flag list built from XORG_PREFIX, and a
# half-captured fragment would be worse than asking.  Offered as a SUGGESTION
# at the prompt -- the user presses Enter or types their own.
_ENV_SUGGESTIONS = {
    "XORG_PREFIX": "/usr",
    "KF6_PREFIX": "/usr",
    "QT6PREFIX": "/opt/qt6",
    "TEXLIVE_PREFIX": "/opt/texlive/2025",
    "XORG_CONFIG": "--prefix=/usr --sysconfdir=/etc "
                   "--localstatedir=/var --disable-static",
}


def _env_wanted_by_scripts():
    """Which variables do the generated scripts ask for, and does the book
    answer them itself?  Returns {name: suggested_value_or_empty}."""
    wanted, stale, asked_by = {}, set(), {}
    dirs = [os.path.join(TMP_DIR, "install_files")] if TMP_DIR else []
    dirs += [os.path.join(pkgusr_root(), d, "")
             for d in ()]            # package homes are scanned below
    for d in dirs:
        if not d or not os.path.isdir(d):
            continue
        for fn in os.listdir(d):
            try:
                body = open(os.path.join(d, fn), encoding="utf-8",
                            errors="replace").read()
            except OSError:
                continue
            # A SCRIPT FROM AN OLDER GENERATOR ASKS OLDER QUESTIONS.
            # These files are whatever the last run produced; after the guard
            # was narrowed (1.12.56) the stale ones still listed EUID,
            # DOCNAME and the rest, so the fix looked like it had done
            # nothing.  Only scripts from the CURRENT generator are consulted.
            gen = _script_gen_version(os.path.join(d, fn))
            cur = _blfs_gen_version() or TOOL_VERSION
            if gen and cur and gen != cur:
                stale.add(fn)
                continue
            for n in _ENV_GUARD_RE.findall(body):
                wanted.setdefault(n, "")
                asked_by.setdefault(n, set()).add(fn.replace("install_", ""))
            # the book's own answer, if the generator found one
            for n, v in re.findall(r'^\t([A-Z][A-Z0-9_]{2,})="([^"]*)"\s+# set by',
                                   body, re.M):
                wanted[n] = v
    _env_wanted_by_scripts.asked_by = asked_by
    if stale and not wanted:
        # EVERY script was stale, so this returned nothing and `env --ask`
        # had nothing to ask about -- which is how XORG_PREFIX went unset
        # while XORG_CONFIG was being set from the very same book page.
        printWarning("all %d cached script(s) are from an older blfs, so"
                     " nothing here can say which variables your packages"
                     " need." % len(stale))
        printWarning("  They are regenerated on the next install; the common"
                     " ones are:")
        for n in sorted(_ENV_SUGGESTIONS):
            printWarning("    packagemanager env --set %s=%s"
                         % (n, _ENV_SUGGESTIONS[n]))
    elif stale:
        printWarning("ignored %d script(s) from an older blfs -- they ask"
                     " questions the current one no longer asks; they are"
                     " regenerated on the next install" % len(stale))
    return wanted


# The book's Xorg page sets these TOGETHER:
#     export XORG_PREFIX="/usr"
#     export XORG_CONFIG="--prefix=$XORG_PREFIX --sysconfdir=/etc ..."
# so someone who sets XORG_CONFIG has read that page and means both.  Setting
# only one leaves the other packages to fail later, one at a time -- which is
# what happened: XORG_CONFIG was set, and seventeen packages later libevdev
# stopped on XORG_PREFIX.
_ENV_COMPANIONS = {
    "XORG_CONFIG": ["XORG_PREFIX"],
    "XORG_PREFIX": ["XORG_CONFIG"],
}


def _warn_env_companions(vals):
    for name in sorted(vals):
        for other in _ENV_COMPANIONS.get(name, ()):
            if other in vals:
                continue
            printWarning("%s is set but %s is not, and the book's page sets"
                         " both." % (name, other))
            printWarning("    packagemanager env --set %s=%s"
                         % (other, _ENV_SUGGESTIONS.get(other, "...")))


def cmd_env(args):
    vals = _read_build_env()
    if args.set:
        for pair in args.set:
            if "=" not in pair:
                printError("not NAME=VALUE: %s" % pair)
                sys.exit(1)
            k, v = pair.split("=", 1)
            vals[k.strip()] = v.strip()
        _write_build_env(vals)
        printSuccess("wrote %s" % BUILD_ENV_FILE)
        _warn_env_companions(vals)

    wanted = _env_wanted_by_scripts()
    if args.ask:
        for name in sorted(wanted):
            if name in vals:
                continue
            suggested = wanted[name] or _ENV_SUGGESTIONS.get(name, "")
            prompt = "  %s" % name
            if suggested:
                prompt += " [%s]" % suggested
            who = sorted(getattr(_env_wanted_by_scripts, "asked_by", {}).get(name, ()))
            printWarning("%s is needed by: %s" % (name, ", ".join(who) or "a generated script"))
            if who:
                printInfo("    the book's page for that package explains it:"
                          "  blfs debug %s" % re.sub(r"-[0-9].*$", "", who[0]))
            if not suggested:
                printInfo("    press Enter to skip -- the build stops at that"
                          " package rather than using an empty value")
            try:
                got = input(prompt + ": ").strip()
            except EOFError:
                got = ""
            vals[name] = got or suggested
            if not vals[name]:
                del vals[name]
        _write_build_env(vals)
        printSuccess("wrote %s" % BUILD_ENV_FILE)

    if args.refresh:
        # STALE SCRIPTS HIDE THE QUESTIONS.  They are regenerated per
        # install anyway, so deleting them costs nothing and lets the next
        # `env` (or the next build) see the current generator's guards.
        removed = 0
        d = os.path.join(TMP_DIR, "install_files") if TMP_DIR else None
        cur = _blfs_gen_version() or TOOL_VERSION
        if d and os.path.isdir(d):
            for fn in os.listdir(d):
                fp = os.path.join(d, fn)
                gen = _script_gen_version(fp)
                if gen and cur and gen != cur:
                    try:
                        os.unlink(fp)
                        removed += 1
                    except OSError:
                        pass
        printSuccess("removed %d stale script(s); they regenerate on demand"
                     % removed)
        wanted = _env_wanted_by_scripts()

    printHeader("build environment  (%s)" % BUILD_ENV_FILE)
    if not vals and not wanted:
        print("  nothing set, and no generated script asks for anything")
    for k in sorted(set(vals) | set(wanted)):
        state = vals.get(k)
        if state:
            print("  %-20s = %s" % (k, state))
        else:
            _sugg = wanted.get(k) or _ENV_SUGGESTIONS.get(k, "")
            _who = sorted(getattr(_env_wanted_by_scripts, "asked_by", {}).get(k, ()))
            print("  %-20s   NOT SET  (%s%s)"
                  % (k,
                     "wanted by " + ", ".join(_who[:2]) if _who else "a script needs it",
                     "; the book says %s" % _sugg if _sugg else ""))
    if any(k not in vals for k in wanted):
        printInfo("\n  set them with:  packagemanager env --ask")
        printInfo("  or one at a time:  packagemanager env --set NAME=VALUE")
    elif not vals:
        # An empty list is not a promise.  A variable only becomes visible
        # once the package's script has been generated, which happens during
        # the run -- so say what will happen rather than implying there is
        # nothing to do.
        printInfo("\n  A variable becomes visible when its package's script is")
        printInfo("  generated, which happens during the build.  The build warns")
        printInfo("  before that package starts, and stops rather than passing an")
        printInfo("  empty value.  Set one now if you already know it:")
        printInfo("      packagemanager env --set XORG_CONFIG='--prefix=/usr "
                  "--sysconfdir=/etc --localstatedir=/var --disable-static'")


# =========================================================================== #
# command: stack                                                  [IMPLEMENTED]
# =========================================================================== #
#
# One command, one environment.  A stack file is the PLAN -- an ordered list
# of targets that together make a working environment (sway + a webkit
# browser, say) -- and `packagemanager stack <name> --run` replays it through
# the exact machinery a full fresh build proved: book targets go through the
# ordinary install planner (BLFS resolves the dependency chains, installed
# packages are skipped), git targets are built from an auto-generated local
# template, and check/cfg targets are root scripts shipped beside the stack.
# It stops at the first failure and skips what is done, so re-running after a
# fix continues instead of starting over.
#
# File format, one entry per line:
#     book   <target> [key=value ...]      a BLFS book package (deps resolved)
#     git    <name> url=<repo> [ref=<ref>] [prog=<installed-program>]
#     tar    <name> url=<tarball-url> pkg=<filename> [prog=|have=] [build=|install=]
#     check  <name>                        root script <stackdir>/<name>.sh;
#                                          a non-zero exit STOPS the stack
#     cfg    <name>                        root script <stackdir>/<name>.sh
# '#' comments and blank lines are ignored.  Entries run top to bottom.
#
# Stack files are looked for in: the path as given, /etc/pkgusr/stacks/,
# and stacks/ beside this tool.

def _find_stack_file(name):
    cands = [name]
    if not name.endswith(".stack"):
        cands.append(name + ".stack")
    out = []
    for c in cands:
        out.append(c)
        out.append(os.path.join("/etc/pkgusr/stacks", c))
        out.append(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "stacks", c))
    for c in out:
        if os.path.isfile(c):
            return os.path.abspath(c)
    return None


def _parse_stack_file(path):
    """-> list of {kind, target, opts{}} in file order.  Raises ValueError
    with a line number on anything malformed -- a plan half-understood is
    worse than one refused."""
    import shlex
    entries = []
    kinds = ("book", "git", "tar", "check", "cfg", "avoid")
    # A LINE MAY CONTINUE.
    #
    # Every entry had to be one line, so sway.stack's are 300 characters wide
    # and nobody can read the build= command in them.  A trailing backslash
    # joins, as it does everywhere else in a shell-shaped file; the line
    # NUMBER reported for an error stays the one the entry started on.
    _joined, _buf, _start = [], "", 0
    with open(path) as f:
        for n, raw in enumerate(f, 1):
            _s = raw.rstrip("\n")
            if _buf:
                _s = _buf + " " + _s.strip()
            else:
                _start = n
            if _s.rstrip().endswith("\\"):
                _buf = _s.rstrip()[:-1].rstrip()
                continue
            _buf = ""
            _joined.append((_start, _s))
    if _buf:
        raise ValueError("%s:%d: line ends with a backslash and nothing follows"
                         % (path, _start))
    for n, raw in _joined:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            # shlex, not split(): build= commands carry spaces, so values are
            # quoted -- build="meson setup build; ninja -C build"
            try:
                parts = shlex.split(line, comments=True)
            except ValueError as e:
                raise ValueError("%s:%d: %s" % (path, n, e))
            if not parts:
                continue
            kind = parts[0]
            if kind not in kinds:
                raise ValueError("%s:%d: unknown entry kind %r (one of %s)"
                                 % (path, n, kind, "/".join(kinds)))
            if len(parts) < 2:
                raise ValueError("%s:%d: %r needs a target" % (path, n, kind))
            target = parts[1]
            opts = {}
            for kv in parts[2:]:
                if "=" not in kv:
                    raise ValueError("%s:%d: option %r is not key=value"
                                     % (path, n, kv))
                k, v = kv.split("=", 1)
                opts[k] = v
            if kind == "avoid":
                # a package this stack must never build, however it is
                # reached -- texlive and LibreOffice arrive as RECOMMENDED
                # dependencies of harfbuzz, three layers down, and a desktop
                # does not want either
                entries.append({"kind": "avoid", "target": target, "opts": opts})
                continue
            if kind == "git" and "url" not in opts:
                raise ValueError("%s:%d: a git entry needs url=" % (path, n))
            if kind == "tar" and ("url" not in opts or "pkg" not in opts):
                raise ValueError("%s:%d: a tar entry needs url= and pkg=" % (path, n))
            entries.append({"kind": kind, "target": target, "opts": opts})
    if not entries:
        raise ValueError("%s: the stack file has no entries" % path)
    return entries


def _stack_git_script(entry, script_dir):
    """Generate the local install script for a git OR tar entry, in the
    template's shape, with the family's build convention: make all && make
    PREFIX=/usr install.  Overridable per entry with build= / install=
    (';'-separated)."""
    name = entry["target"]
    opts = entry["opts"]
    is_git = "1" if entry["kind"] == "git" else ""
    build_cmds = opts.get("build", "make all").replace(";", "\n")
    install_cmds = opts.get("install", "make PREFIX=/usr install").replace(";", "\n")
    # `prog=` is the BINARY this entry installs; it is not always the entry's
    # own name.  Defaulting it to the name made verify check libsrtp for a
    # program called `libsrtp`, and report "missing: program libsrtp" for
    # every library and data package in the stack -- twelve of them.
    prog = opts.get("prog", "")
    text = _TEMPLATE.format(name=name, version=opts.get("version", "git"),
                            name_version="%s-%s" % (name, opts.get("version", "git")),
                            link=opts["url"], pkg=opts.get("pkg", ""),
                            is_git=is_git,
                            collector=collector_prefix().rstrip("_"))
    # pin the ref and the doneness signal into the generated header
    text = text.replace('git_ref=""', 'git_ref="%s"' % opts.get("ref", ""), 1)
    text = text.replace('installed_program=""', 'installed_program="%s"' % prog, 1)
    # ...and `have=` is the entry's OWN statement of what proves it installed
    # -- the stack already uses it to skip an entry that is done.  It is the
    # right validation target for a package with no binary: a .pc file, a
    # header directory, a font directory.
    _have = opts.get("have", "")
    if _have:
        text = text.replace('installed_directory=""',
                            'installed_directory="%s"' % _have, 1)
    # the template ships with placeholder build/install bodies; put the
    # family's convention in
    text = _set_phase_body(text, "build_pkg", build_cmds)
    text = _set_phase_body(text, "install_pkg", install_cmds)
    os.makedirs(script_dir, exist_ok=True)
    path = os.path.join(script_dir, "install_%s" % name)
    with open(path, "w") as f:
        f.write(text)
    os.chmod(path, 0o755)
    return path, (prog or name)


def _stack_root_script(entry, stack_dir):
    return os.path.join(stack_dir, entry["target"] + ".sh")


def _stack_state_file(stack_path):
    d = os.path.join(os.environ.get("LFS_PKGUSR_DIR", "/usr/src/lfs-pkgusr"),
                     "progress", "stacks")
    base = os.path.basename(stack_path)
    if base.endswith(".stack"):
        base = base[:-6]
    return os.path.join(d, base + ".done")


def _stack_done_set(stack_path):
    try:
        return set(l.strip() for l in open(_stack_state_file(stack_path))
                   if l.strip())
    except OSError:
        return set()


def _stack_mark_done(stack_path, key):
    f = _stack_state_file(stack_path)
    try:
        os.makedirs(os.path.dirname(f), exist_ok=True)
        with open(f, "a") as fh:
            fh.write(key + "\n")
    except OSError as e:
        printWarning("could not record stack progress (%s) -- the next run "
                     "re-judges this entry" % e)


def _check_stack_refs(rows):
    """Ask every git remote whether the ref this stack pins still exists.

    Two entries in one stack had rotted: usrsctp ref=1.0.0 (the tags are
    0.9.3.0, 0.9.4.0, 0.9.5.0) and foot ref=1.24.1 (1.24.0 exists, 1.24.1
    never did).  Each cost a clone, a build attempt and a round trip to find
    out.  A pinned ref is data that rots, and only the remote can check it --
    so check them all at once, before anything is built.
    """
    git = shutil.which("git")
    if not git:
        printError("git is not installed -- cannot check any ref.")
        return 1
    bad = unreachable = 0
    # (unreachable is counted for no-ref entries too, so the summary cannot
    #  claim an all-clear over a remote nobody asked)
    for r in rows:
        if r.get("kind") != "git":
            continue
        url = (r["opts"].get("url") or "").strip()
        ref = (r["opts"].get("ref") or "").strip()
        target = r.get("target")
        if not url:
            continue
        if not ref:
            # AN ENTRY WITH NO REF STILL HAS A URL.
            #
            # Four entries tracked their default branch and were passed over
            # untouched, so the check said "every pinned ref exists" without
            # having contacted them at all.  A repository that has been
            # renamed, made private or moved fails identically to a bad ref --
            # at clone time, after everything before it has built.  Ask.
            try:
                out = subprocess.run([git, "ls-remote", "--heads", url],
                                     capture_output=True, text=True, timeout=120)
            except (OSError, subprocess.SubprocessError):
                out = None
            if out is None or out.returncode != 0:
                printWarning("  %-22s no ref=, and %s could not be reached"
                             % (target, url))
                unreachable += 1
            elif not out.stdout.strip():
                bad += 1
                printError("  %-22s no ref=, and the remote has NO branches"
                           % target)
                printInfo("        %s -- moved, renamed or empty?" % url)
            else:
                printSuccess("  %-22s no ref= (default branch, reachable)"
                             % target)
            continue
        if re.fullmatch(r"[0-9a-f]{7,40}", ref):
            printInfo("  %-22s %s (a commit id -- not checked)" % (target, ref))
            continue
        try:
            out = subprocess.run([git, "ls-remote", "--tags", "--heads", url],
                                 capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.SubprocessError) as e:
            printWarning("  %-22s could not reach %s (%s)" % (target, url, e))
            unreachable += 1
            continue
        if out.returncode != 0:
            printWarning("  %-22s could not reach %s" % (target, url))
            unreachable += 1
            continue
        names = {l.rsplit("/", 1)[-1] for l in out.stdout.splitlines()}
        names = {n[:-3] if n.endswith("^{}") else n for n in names}
        if ref in names:
            printSuccess("  %-22s %s" % (target, ref))
            continue
        bad += 1
        printError("  %-22s %s DOES NOT EXIST" % (target, ref))
        # SORT TAGS AS VERSIONS, NOT AS STRINGS.
        #
        # foot's real tags include 1.28.0, and a reverse string sort offered
        # "1.9.2, 1.9.1, 1.9.0, 1.9, 1.8.2" -- because "9" > "2" one character
        # at a time.  A suggestion that names an ancient release as the newest
        # is worse than no suggestion: it invites a downgrade.
        def _vkey(n):
            base = n[1:] if n[:1] == "v" else n
            parts = re.split(r"[.\-_]", base)
            out = []
            for x in parts:
                out.append((0, int(x), "") if x.isdigit() else (1, 0, x))
            return out
        near = sorted((n for n in names if n[:1].isdigit() or n[:1] == "v"),
                      key=_vkey, reverse=True)[:5]
        if near:
            printInfo("        remote has: " + ", ".join(near))
    if bad:
        print()
        printError("%d entr%s a ref the remote does not have."
                   % (bad, "y pins" if bad == 1 else "ies pin"))
        printInfo("  Fix ref= in the stack file before building.")
    else:
        print()
        # "every pinned ref exists" while five remotes were unreachable is a
        # false all-clear: the ones that could not be asked are exactly the
        # ones that might be wrong.
        if unreachable:
            printSuccess("every ref that COULD be checked exists.")
        else:
            printSuccess("every pinned ref exists.")
    if unreachable:
        printWarning("  %d remote(s) could not be reached -- those refs are unverified."
                     % unreachable)
    return 1 if bad else 0


def cmd_stack(args):
    path = _find_stack_file(args.name)
    if not path:
        printError("no stack file for %r (looked in ., /etc/pkgusr/stacks, "
                   "stacks/ beside this tool)" % args.name)
        sys.exit(1)
    try:
        entries = _parse_stack_file(path)
        # --yes REACHES THE SCRIPTS THIS RUNS.  A cfg step calls `lfs-helper
        # pm-install`, which asks "Press enter to continue" unless PM_YES is
        # set -- so an unattended stack run stopped at a prompt nobody was
        # there to answer.
        if getattr(args, "yes", False):
            os.environ["PM_YES"] = "1"
            os.environ["LFS_ASSUME_YES"] = "1"
        # A NEWER VERSION OF THIS FILE IS SITTING BESIDE IT.
        #
        # `make install` leaves the shipped copy as <stack>.new when the
        # user's own differs (1.14.58/1.14.98), and running the stack said
        # nothing about it: "3 entries" while the .new had six, twice in a
        # row, with no hint that a merge was owed.  The moment to mention it
        # is the moment someone runs the file.
        _new = path + ".new"
        if os.path.isfile(_new):
            try:
                _n_entries = len(_parse_stack_file(_new))
            except (OSError, ValueError):
                _n_entries = None
            if (getattr(args, "take_new", False) and _n_entries is not None
                    and _n_entries < len(entries) and not args.force):
                # A .new WITH FEWER ENTRIES IS A DOWNGRADE.
                #
                # The chroot refresh writes <stack>.new from the HOST's copy
                # when the chroot's differs (1.14.105).  If the host is the
                # stale one -- it often is, since `make install` keeps a file
                # it thinks the user edited -- then --take-new would replace
                # a 6-entry stack with a 3-entry one, and the next refresh
                # would offer it again.  Refuse the shrink; --force overrides.
                printError("that .new file has FEWER entries (%d) than this one"
                           " (%d) -- not taking it." % (_n_entries, len(entries)))
                printInfo("  It is probably the host's older copy, brought in by"
                          " the chroot refresh.")
                printInfo("  Update the host first:")
                printInfo("    cp /etc/pkgusr/stacks/%s{.new,}   # on the HOST"
                          % os.path.basename(path))
                printInfo("  ...or take it anyway with --take-new --force.")
                sys.exit(1)
            if getattr(args, "take_new", False):
                # TAKE IT, rather than describe it again.  Three runs in a
                # row ended with the user reading a note and doing nothing:
                # the note was right and the work it asked for was mine to
                # do.  Theirs is kept as .bak, so nothing is lost.
                _bak = path + ".bak"
                try:
                    shutil.copy2(path, _bak)
                    shutil.copy2(_new, path)
                    os.remove(_new)
                except OSError as e:
                    printError("could not take the new stack file: %s" % e)
                    sys.exit(1)
                printSuccess("took the shipped stack file; yours is %s" % _bak)
                entries = _parse_stack_file(path)
                printInfo("  %d entries now." % len(entries))
                print()
                _new = None
        if _new and os.path.isfile(_new):
            printWarning("a newer version of this stack ships beside it:")
            printWarning("    %s%s" % (_new,
                         "" if _n_entries is None else
                         "   (%d entries, this file has %d)"
                         % (_n_entries, len(entries))))
            printInfo("  diff %s %s" % (path, _new))
            printInfo("  ...and take what you want; this run uses YOUR file.")
            print()
        if getattr(args, "check_refs", False):
            printHeader("Checking pinned git refs")
            sys.exit(_check_stack_refs(entries))
    except ValueError as e:
        printError(str(e))
        sys.exit(1)
    stack_dir = os.path.dirname(path)
    script_dir = os.path.join(TMP_DIR, "stack_files")

    avoid = [e["target"] for e in entries if e["kind"] == "avoid"]
    entries = [e for e in entries if e["kind"] != "avoid"]
    if getattr(args, "no_git", False):
        # git and tar entries are the extras -- cloned tools, fonts.  Skipping
        # them finishes the book part of the desktop first, and matters while
        # git itself is not built yet ("git: command not found").
        _n = len(entries)
        _skipped_git = [e for e in entries if e["kind"] in ("git", "tar")]
        entries = [e for e in entries if e["kind"] not in ("git", "tar")]
        if not getattr(args, "status", False):
            printInfo("  --no-git: skipping %d cloned/tarball entries\n"
                      % (_n - len(entries)))
            # SOME CLONED ENTRIES ARE DEPENDENCIES, NOT EXTRAS.
            #
            # libnice and friends (1.13.69) are git entries that book
            # packages LINK: gst-plugins-bad compiles webrtcbin only if
            # libnice is present.  Skipping them with --no-git builds those
            # packages without WebRTC and says nothing -- and finding out
            # later costs a webkitgtk rebuild.
            _webrtc = [e["target"] for e in _skipped_git
                       if e["target"] in ("libnice", "libsrtp", "usrsctp",
                                          "webrtc-audio-processing")]
            if _webrtc:
                printWarning("  NOTE: %s are skipped, and gst-plugins-bad / "
                             "webkitgtk link them." % ", ".join(_webrtc))
                printWarning("  Built without them there is no WebRTC (no "
                             "camera or screen sharing in the browser),")
                printWarning("  and adding them later means recompiling both. "
                             " Drop --no-git to include them.")
    if not getattr(args, "status", False):
        printHeader("stack: %s  (%d entries)" % (os.path.basename(path), len(entries)))
        if avoid:
            # AVOID WAS ONLY A MESSAGE.  It printed "never built by this
            # stack" and then passed nothing to the installer, so the
            # packages were built anyway.  It is the stack's exclusion list
            # now, handed to every entry's resolve.
            print("  never built by this stack: %s\n" % ", ".join(avoid))
        print("  file: %s\n" % path)

    import shutil as _sh

    def _git_installed(e):
        """prog= on PATH, or have= (a file that only exists once it is
        installed -- the signal for libraries, which put nothing on PATH)."""
        have = e["opts"].get("have")
        if have and os.path.exists(have):
            return True
        prog = e["opts"].get("prog", e["target"])
        return bool(prog and prog != "-" and _sh.which(prog))

    # Entries that finished in an earlier run are recorded and SKIPPED, so a
    # resume does not re-plan a 200-package dependency tree for a stage that
    # is already done.  --force ignores the cache.  Recorded per stack file
    # under $LFS_PKGUSR_DIR/progress/stacks/.
    # RUN ONE ENTRY, OR A FEW.
    #
    # A stack is a list, and after the first pass the only thing anyone wants
    # is to redo ONE line of it -- a config step that failed, a package to
    # rebuild.  --force re-ran all 56.  --only names entries (repeatable, or
    # comma-separated); it implies --force for those and skips the rest.
    donekeys = set() if args.force else _stack_done_set(path)
    # RUN JUST ONE PART, AND REALLY RUN IT.
    #
    # A stack is long and its entries fail one at a time; re-running the
    # whole thing to retry `cfg mytools` is a poor answer, and --force
    # re-runs everything.  --only names entries: they are exempt from the
    # cache (so a "done" one is rebuilt) and everything else is skipped.
    # (--only was declared long ago and never implemented -- the help
    #  promised "repeatable or comma-separated"; both work now.)
    _only = {x.strip()
             for spec in (getattr(args, "only", None) or [])
             for x in str(spec).split(",") if x.strip()}
    if _only:
        _known = {e["target"] for e in entries}
        _unknown = sorted(_only - _known)
        if _unknown:
            printError("not in this stack: %s" % ", ".join(_unknown))
            printInfo("  entries: %s" % ", ".join(sorted(_known)))
            # ...BUT IT MAY BE IN THE FILE WAITING BESIDE THIS ONE.
            #
            # The user asked for `--only mytools` against a stack whose
            # newer copy has exactly that entry.  "not in this stack" was
            # true and useless: the answer was one flag away and the message
            # did not say so.
            _nf = path + ".new"
            if os.path.isfile(_nf):
                try:
                    _nnames = {x["target"] for x in _parse_stack_file(_nf)}
                except (OSError, ValueError):
                    _nnames = set()
                _there = sorted(set(_unknown) & _nnames)
                if _there:
                    print()
                    printWarning("%s IS in the newer file beside this one:"
                                 % ", ".join(_there))
                    printInfo("    %s" % _nf)
                    printInfo("  Take it and run the same command:")
                    printInfo("    packagemanager stack %s --take-new %s"
                              % (args.name, " ".join(
                                  "--only " + x for x in sorted(_only))))
            sys.exit(1)
        donekeys = {k for k in donekeys
                    if k.split(" ", 1)[-1] not in _only}

    # ...and SKIP the rest.  Exempting the named entries from the cache is
    # only half of it: without this the other 55 were still planned and run.
    if _only:
        entries = [e for e in entries if e["target"] in _only]
        printInfo("running only: %s" % ", ".join(e["target"] for e in entries))
        print()
    rows = []
    for e in entries:
        e["_key"] = "%s %s" % (e["kind"], e["target"])
        # (entries are already filtered to --only above; the old `only`
        #  variable was removed with the duplicate implementation, and this
        #  reference outlived it -- NameError on every stack run.)
        if e["_key"] in donekeys:
            rows.append((e, "done (stack cache)"))
            if not getattr(args, "status", False):
                print("  %-6s %-28s %s" % (e["kind"], e["target"], "done (stack cache)"))
            continue
        if e["kind"] in ("git", "tar"):
            state = "installed" if _git_installed(e) else "to build"
        elif e["kind"] in ("check", "cfg"):
            sp = _stack_root_script(e, stack_dir)
            state = "script" if os.path.isfile(sp) else "MISSING SCRIPT"
        else:
            # ASK THE BOOK.  A dry run that says "book" without looking is a
            # plan half-judged: sway and wlroots sat in a stack as book
            # entries, and BLFS carries neither -- the first --run would have
            # discovered it one llvm build too late.
            # book_version cannot tell "anchor absent" from "no book on
            # disk", so probe availability ONCE with an anchor every BLFS
            # has; without a book, every entry is honestly unjudged.
            if not hasattr(cmd_stack, "_book_ok"):
                try:
                    cmd_stack._book_ok = book_version("dbus") is not None \
                        or book_version("DBus") is not None
                except Exception:
                    cmd_stack._book_ok = False
            if not cmd_stack._book_ok:
                state = "book (no book on disk -- unjudged)"
            else:
                try:
                    bv = book_version(e["target"])
                    state = ("book %s" % bv) if bv else "NOT IN BOOK"
                except Exception:
                    state = "book (lookup failed -- unjudged)"
            # A book entry carrying url= FALLS BACK to git where the book
            # does not know it -- one stack file serves a system whose book
            # flavour has the package and one whose book does not.
            if state == "NOT IN BOOK" and "url" in e["opts"]:
                e["kind"] = "git"
                state = ("installed" if _git_installed(e)
                         else "not in book -> git fallback")
        rows.append((e, state))
        if not getattr(args, "status", False):
            print("  %-6s %-28s %s" % (e["kind"], e["target"], state))

    notinbook = [e["target"] for e, st in rows if st == "NOT IN BOOK"]
    if notinbook:
        printWarning("\nnot in the book: " + ", ".join(notinbook)
                     + "\n  fix the entry (rename to the book's anchor, or make it"
                     "\n  a git entry with build=/install= commands)")
        if args.run:
            printError("refusing to run a plan with unknown targets.")
            sys.exit(1)

    missing = [e["target"] for e, st in rows if st == "MISSING SCRIPT"]
    if missing:
        printError("\nmissing root script(s) beside the stack: "
                   + ", ".join("%s.sh" % m for m in missing))
        sys.exit(1)
    if getattr(args, "status", False):
        # WHERE ARE WE IN THE TREE?
        #
        # Entry counts answered the wrong question: "1 of 39" says nothing
        # about the hundreds of packages those entries pull in.  Resolve each
        # book entry's dependency order and report the PACKAGES -- installed,
        # remaining, and what comes next -- using install_tag, the same
        # judgement `search` and the install plan use, so all three agree.
        seen, pkgs, skipped_by_avoid = set(), [], set()
        for e, _st in rows:
            if e["kind"] != "book":
                continue
            try:
                # THE SAME GRAPH THE BUILD WILL USE.  Asking without the
                # entry's deps= showed 272 packages for a plan that builds
                # 99 -- a status that does not match the run is worse than
                # no status.
                order, _missing = blfs_order_anchors(
                    e["target"],
                    no_recommended=(e["opts"].get("deps") == "required"))
            except SystemExit:
                continue
            for anchor, nv, _kind, _parent in order:
                # THE STATUS MUST NOT COUNT WHAT THE RUN WILL SKIP.  The avoid
                # list reaches the installer (1.12.78) and never reached this
                # display, so it reported 273 packages for a run that skips
                # qt6, okular, LibreOffice, CUPS and the rest by name.
                if any(anchor.lower() == a.lower() for a in avoid):
                    skipped_by_avoid.add(anchor)
                    continue
                if anchor not in seen:
                    seen.add(anchor)
                    pkgs.append((anchor, nv))
        done_pkgs = [(a, v) for a, v in pkgs if "not installed" not in install_tag(a, v)]
        todo = [(a, v) for a, v in pkgs if (a, v) not in set(done_pkgs)]
        done_n = sum(1 for _, st in rows if st == "done (stack cache)")
        printHeader("stack %s" % args.name)
        print("  entries : %d of %d done" % (done_n, len(rows)))
        if pkgs:
            print("  packages: %d of %d installed" % (len(done_pkgs), len(pkgs)))
        if skipped_by_avoid:
            print("  avoided : %d named in the stack (%s%s)"
                  % (len(skipped_by_avoid),
                     ", ".join(sorted(skipped_by_avoid)[:5]),
                     " ..." if len(skipped_by_avoid) > 5 else ""))
        nxt_entry = next((e["target"] for e, st in rows if st != "done (stack cache)"), None)
        print("  next    : %s" % (nxt_entry or "nothing left to do"))
        if todo:
            print("  building next: " + ", ".join(a for a, _ in todo[:6])
                  + (" ..." if len(todo) > 6 else ""))
        if getattr(args, "full", False):
            print()
            for a, v in pkgs:
                tag = install_tag(a, v)
                print("  %-30s %-26s %s" % (a, v, tag))
        else:
            print("  (full tree: --status --full)")
        print("  state   : %s" % _stack_state_file(path))
        return

    if not args.run:
        printInfo("\nDry run -- nothing was built.  Replay the plan with:\n"
                  "  packagemanager stack %s --run" % args.name)
        return

    print()
    done = 0
    for e, state in rows:
        kind, target = e["kind"], e["target"]
        if state == "done (stack cache)":
            done += 1
            continue
        printHeader("stack (%d/%d): %s %s" % (done + 1, len(rows), kind, target))
        # A BOOK ENTRY CAN BECOME A CLONE.  elogind is `book ... url=...`,
        # and its kind only turns into "git" when the judging finds it absent
        # from the book -- after the early --no-git filter has run.  So the
        # decision is taken here too, where the kind is final.
        if getattr(args, "no_git", False) and kind in ("git", "tar"):
            printInfo("  %s: skipped (--no-git)" % target)
            continue
        if kind == "book":
            # NEVER drop a whole CLASS of dependencies.
            #
            # `required-only=1` (--ignore-recommended) was an attempt to keep
            # texlive and LibreOffice out of a sway build.  It removed far
            # more: texlive's OWN dependencies -- Cairo, libpaper, the PATH
            # page -- are all "recommended", so texlive was left with none,
            # scheduled first, and built against a freetype that did not
            # exist yet.  A recommendation is still a dependency; the book
            # knows why it is there.  If a package is unwanted, NAME IT.
            # deps=required -- the book's REQUIRED graph only.
            #
            # A first attempt at this (1.12.47) went badly and was reverted:
            # texlive's own dependencies are all recommended, so dropping the
            # class left it with none and it was scheduled FIRST.  That was an
            # ORDERING bug, fixed since (1.12.69 is a real topological sort),
            # not an argument against choosing the graph you want.  The
            # recommendations worth keeping are named as entries of their own,
            # which is what a stack file is for.
            if not _install_via_self(target, args.yes, recursive=True,
                                     required_only=(e["opts"].get("deps") == "required"),
                                     ignore=",".join(
                                         [x for x in [e["opts"].get("ignore")] if x]
                                         + avoid) or None,
                                     ignore_prereqs=getattr(args, "ignore_prereqs",
                                                            False)):
                printError("stack stopped at %r (%d of %d done).  Fix it and "
                           "re-run -- finished entries are skipped."
                           % (target, done, len(rows)))
                sys.exit(1)
        elif kind in ("git", "tar"):
            if _git_installed(e) and not args.force:
                printSuccess("  %s: already installed (--force rebuilds)"
                             % target)
            else:
                spath, _ = _stack_git_script(e, script_dir)
                # THE SAME CHECKS AS A BOOK PACKAGE.
                #
                # A git entry never goes through the planner, so nothing had
                # looked at what its commands need: elogind's clone died on
                # `git: command not found` after the account was made, the
                # source directory created and the phase started.  The check
                # is a dictionary lookup; run it here too.
                # A GIT ENTRY CAN NAME ITS DEPENDENCIES.
                #
                # sway is built from git, so nothing in the book orders
                # anything before it, and it stopped on
                #     ERROR: Dependency "json-c" not found
                # json-c IS a BLFS package (JSON-C-0.18); it was simply never
                # built, because a git entry had no way to say it needed one.
                # `needs=` closes that: the named packages are installed --
                # through the same door as everything else -- before the entry
                # runs.
                for _need in [x.strip() for x in
                              (e["opts"].get("needs") or "").replace(",", " ").split()
                              if x.strip()]:
                    if gather_user(_need).state == "installed":
                        continue
                    printInfo("  %s needs %s -- installing it first"
                              % (target, _need))
                    if not _install_via_self(_need, args.yes, recursive=True):
                        printError("stack stopped at %s %r: could not install"
                                   " %s (%d of %d done)."
                                   % (kind, target, _need, done, len(rows)))
                        sys.exit(1)
                # MACHINE.CONF REACHES A GIT ENTRY TOO.
                #
                # apply_machine_opts was called only from resolve_script, the
                # BOOK path.  So the box could tell someone to put
                #     [webrtc-audio-processing]
                #     cpp_args = -include cstdint
                # in machine.conf for a git stack entry, and nothing would
                # read it -- the advice was correct and inert.  A script is a
                # script; the options belong to the package, not to where its
                # commands came from.
                apply_machine_opts(target, spath)
                _MISSING_TOOLS.clear()
                _check_script_prereqs(target, spath)
                if _MISSING_TOOLS and not getattr(args, "ignore_prereqs", False):
                    # BUILD IT, DO NOT JUST NAME IT.
                    #
                    # Stopping with "packagemanager install git --run
                    # --recursive" asks the person to type what the stack is
                    # for.  A plan does this itself (1.14.14: a missing
                    # provider joins the plan and it is rebuilt); a git entry
                    # is not a plan, so it stopped instead.  If the book has
                    # the tool, install it and carry on -- that is what an
                    # unattended run is.
                    _fixable = sorted({_provider_of(t) for t in _MISSING_TOOLS
                                       if _provider_of(t)})
                    _stuck = sorted(t for t in _MISSING_TOOLS
                                    if not _provider_of(t))
                    for _prov in _fixable:
                        printInfo("  %s needs %s -- installing it first"
                                  % (target, _prov))
                        if not _install_via_self(_prov, args.yes, recursive=True):
                            printError("stack stopped at %s %r: could not"
                                       " install %s (%d of %d done)."
                                       % (kind, target, _prov, done, len(rows)))
                            sys.exit(1)
                    if _stuck:
                        _report_missing_tools()
                        printError("stack stopped at %s %r: it needs %s, which"
                                   " no BLFS page provides (%d of %d done)."
                                   % (kind, target, ", ".join(_stuck),
                                      done, len(rows)))
                        printInfo("  Those come from LFS -- check they were"
                                  " built and are on PATH.")
                        printInfo("  To start regardless:  --ignore-prereqs")
                        sys.exit(1)
                install_local(target, spath, True, args.yes, "install")
        else:   # check / cfg -- a root script through the one runner
            sp = _stack_root_script(e, stack_dir)
            rc = subprocess.run(["lfs-helper", "run-script", "--user", "root",
                                 "--as-root", "--script", sp,
                                 "--phase", "all", "--name", ""]).returncode
            if rc != 0:
                printError("stack stopped at %s %r (exit %d, %d of %d done)."
                           % (kind, target, rc, done, len(rows)))
                sys.exit(1)
        # DO NOT RECORD A GIT ENTRY THAT IS NOT THERE.
        #
        # The cache makes an entry disappear from every later run, so a false
        # "done" is permanent.  A git/tar entry declares what proves it
        # installed (prog=/have=); if that is still absent after a build the
        # tools said succeeded, say so and leave the entry unrecorded rather
        # than hiding it forever.
        if e["kind"] in ("git", "tar") and not _git_installed(e):
            printWarning("%s finished, but %s is still missing -- NOT recording"
                         " it as done, so the next run tries again."
                         % (target, e["opts"].get("have")
                            or e["opts"].get("prog") or target))
        else:
            _stack_mark_done(path, e["_key"])
        done += 1
    printSuccess("\nstack %s: all %d entries done." % (args.name, done))


