# /usr/src holds one directory (== home) per package-user.  Overridable so the
# tool can be exercised against a fixture tree in testing.
# Where package users live.  Config wins over the built-in default, so a
# system built with a different layout keeps it; the environment still wins
# over both, for tests and one-off runs.
def _base_dir_default():
    """The BASE the account roots hang under -- /usr/src, not /usr/src/pkgusr.

    ONE KEY, TWO MEANINGS.  `lfs` writes `pkgusr_home` as the FULL package-user
    root (its LAYOUT_DEFAULTS say /usr/src/pkgusr); this read the same key as
    the base and then appended PKGUSR_SUBDIR itself, so a tree configured by
    lfs got both:

        logs: /usr/src/pkgusr/pkgusr/p_wget/log

    Taking the parent when the value already ends in the subdirectory makes the
    two readings agree without either tool having to change what it writes --
    and a base that does NOT end in it is still taken literally, which is what
    a hand-written config means.
    """
    # CONFIG_PATH is defined further down, so read the path the same way it
    # does rather than depending on definition order.
    path = os.environ.get("PKGUSR_CONFIG") or "/etc/pkgusr/packagemanager.conf"
    sub = os.environ.get("PKGUSR_SUBDIR", "pkgusr")
    try:
        with open(path) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "pkgusr_home" and v.strip():
                    v = v.strip().rstrip("/")
                    if sub and os.path.basename(v) == sub:
                        return os.path.dirname(v) or "/"
                    return v
    except OSError:
        pass
    return "/usr/src"


BASE_DIR = os.environ.get("PKGUSR_BASE") or _base_dir_default()


def appuser_home():
    """Where application users live -- separate from package users, because
    they are accounts a person uses rather than build trees.

    DEFAULT /home, NOT the package base.  This returned BASE_DIR, so every
    application user's home, shared directory and XDG profile link were
    built under /usr/src -- `mkdir -p /usr/src/u_claude/Shared`, and a
    ~/Shared/Claude link pointing into the package tree.  A build tree is
    not a home.  Configurable as before (`appuser_home` in the config), but
    the default is now the one that is right.
    """
    return load_config().get("appuser_home") or APPUSER_HOME_DEFAULT


# ONE SUBDIRECTORY FOR ALL OF THEM.  The user's layout, recorded on the
# machine as appuser_home=/home/shared_user -- and ignored: the account was
# moved to a hard-coded "/home/<user>", so /home filled up with u_* beside
# the real logins.  The default is that subdirectory; the config key still
# overrides it.
APPUSER_HOME_DEFAULT = "/home/shared_user"


# /home/Shared (1.14.315).  1.14.312 put a hub of LINKS in
# /home/shared_user/Shared and argued against /home: a directory there that
# is not a home looks like one.  Once the hub holds the DATA, that argument
# turns round: the shared directories are the one thing in /home/shared_user
# that is not private to an account, and taking them out is what lets every
# account home be 0700.
SHARED_HUB_DEFAULT = "/home/Shared"


def shared_hub():
    """Where every shared directory lives (1.14.312; the data itself since
    1.14.315 -- see SHARED_HUB_DEFAULT).

    It was ~/Shared of the main user.  Two things were wrong with that:

      * ONE PERSON'S HOME IS NOT A SYSTEM PATH.  A program of your own, a
        script, a launcher, an app account -- anything that wants "the
        shared dirs" had to know whose home to look in.  A fixed path is the
        same answer for every account.
      * The SHARED_* variables were enumerated from $HOME/Shared by EVERY
        login -- and in an app account $HOME/Shared is its own data
        directory, so u_claude got SHARED_<FILENAME> for each file in it.

    Default /home/Shared: the real directories, one per account
    (/home/Shared/Claude, 2770 u_claude:u_claude).  Each account's ~/Shared
    and the main user's ~/Shared are links into it, so nothing you type
    changes.  `shared_hub=` in packagemanager.conf moves it.
    """
    return (load_config().get("shared_hub") or "").rstrip("/") \
        or SHARED_HUB_DEFAULT


def _app_home(u):
    """An application user's home: what passwd says, or where they go.

    passwd FIRST, because an account whose home has already been moved
    (usermod -d) must not have its shared directory rebuilt somewhere else
    -- which is exactly what happened: the homes were moved to /home and the
    next `cfg app-users` run recreated Shared under /usr/src.
    """
    return _home_of(u) or os.path.join(appuser_home(), u)
