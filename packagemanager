def _book_in_use(tool):
    """Which book each tool would use -- the thing you actually want to know
    when a package cannot be found."""
    if tool == "blfs":
        rc, out, _e = run_blfs(["books"])
        if rc != 0:
            return "(blfs not available)"
        for ln in out.splitlines():
            if "[" in ln and "]" in ln:
                return ln.split("[", 1)[1].split("]", 1)[0]
        return "(none cached -- blfs fetch, or blfs import <file>)"
    # Read the config directly.  Parsing `lfs config` needed a mounted LFS
    # tree, which does not exist inside the chroot -- so the book the system
    # was built from showed as "(unknown)" on the very system it built.
    cfg = _shared_lfs_config()
    ver = cfg.get("build_book") or cfg.get("default")
    if not ver:
        return "(no book configured)"
    for cand in (os.environ.get("LFS_STORE"), "/usr/share/lfs"):
        if not cand:
            continue
        p = os.path.join(cand, "books", f"LFS-BOOK-{ver}-NOCHUNKS.html")
        if os.path.isfile(p):
            return os.path.basename(p)
    return f"{ver}  (not cached here)"


def _accounts_with_prefix(prefix):
    """Package-user accounts currently using this prefix.

    Used to refuse a prefix change that would orphan a built tree: the
    accounts are not renamed by changing the setting.
    """
    if pwd is None:
        return []
    pfx = (prefix.rstrip("_") + "_") if prefix else ""
    out = []
    for entry in pwd.getpwall():
        if not pfx or entry.pw_name.startswith(pfx):
            if entry.pw_dir.startswith(BASE_DIR.rstrip("/") + "/"):
                out.append(entry.pw_name)
    return out


def _config_sources():
    """Every prefix and directory, with the reason it has that value.

    The user could not find where these live -- fairly: prefixes come from
    /usr/share/lfs/config.json (authoritative), then
    /etc/pkgusr/packagemanager.conf, then the environment, then a default;
    and the DIRECTORIES were environment-only, documented nowhere.
    """
    shared = _shared_lfs_config() or {}
    conf = {}
    try:
        import configparser
        cp = configparser.ConfigParser()
        with open(CONFIG_PATH) as f:
            cp.read_string("[c]\n" + f.read())
        conf = dict(cp["c"])
    except Exception:
        conf = {}

    def src(key, env, value):
        if os.environ.get(env):
            return "the environment ($%s)" % env
        if key in shared:
            return "the lfs config (%s)" % _lfs_config_path()
        if key in conf:
            return "packagemanager.conf"
        return "the built-in default"

    rows = [
        ("package-user prefix", pkgusr_prefix(),
         src("pkgusr_prefix", "LFS_PKGUSR_PREFIX", None)),
        ("config-user prefix", cfguser_prefix(),
         src("cfguser_prefix", "LFS_CFGUSR_PREFIX", None)),
        ("collector prefix", collector_prefix(),
         src("collector_prefix", "LFS_COLLECTOR_PREFIX", None)),
        ("shared-user prefix", user_prefix(),
         src("user_prefix", "LFS_USER_PREFIX", None)),
        ("base directory", BASE_DIR,
         "the environment ($PKGUSR_BASE)" if os.environ.get("PKGUSR_BASE")
         else "the built-in default"),
        ("package homes", os.path.join(BASE_DIR, PKGUSR_SUBDIR) if PKGUSR_SUBDIR
         else BASE_DIR,
         src("pkgusr_subdir", "PKGUSR_SUBDIR", None)),
        ("config-user homes", os.path.join(BASE_DIR, CFGUSR_SUBDIR) if CFGUSR_SUBDIR
         else BASE_DIR,
         src("cfguser_subdir", "CFGUSR_SUBDIR", None)),
    ]
    return rows


def _lfs_config_path():
    """The lfs config actually in use -- not the default path.

    The report named /usr/share/lfs/config.json whatever it had read, which
    is wrong wherever LFS_STORE points somewhere else.
    """
    for cand in (os.environ.get("LFS_STORE"), "/usr/share/lfs",
                 os.path.expanduser("~/.local/share/lfs")):
        if cand and os.path.isfile(os.path.join(cand, "config.json")):
            return os.path.join(cand, "config.json")
    return "/usr/share/lfs/config.json"


_LFS_CONFIG_HINT = "/usr/share/lfs/config.json"


def cmd_config(args):
    # --show: the whole picture, no questions.  `config` on its own asks for
    # the main user before it prints anything, which is not what somebody
    # checking their prefixes wants.
    if getattr(args, "show", False):
        printHeader("Prefixes and directories")
        print()
        for label, value, source in _config_sources():
            print("  %-20s %-28s %s" % (label, value or "(none)", source))
        print()
        # Say what the keys ARE.  This told people to export variables, which
        # was the only way until 1.13.69 -- and then kept telling them so,
        # which is why the report looked unchanged after the keys were added.
        printInfo("  every value below can be set in either file; the lfs "
                  "config wins for the")
        printInfo("  prefixes, and the environment wins over both.")
        print()
        printInfo("    %s" % _lfs_config_path())
        printInfo('      "pkgusr_prefix": "p"      "cfguser_prefix": "cfg"')
        printInfo('      "collector_prefix": "nimgnu"')
        printInfo('      "pkgusr_subdir": "pkgusr"  "cfguser_subdir": "cfg"')
        print()
        printInfo("    %s" % CONFIG_PATH)
        printInfo("      pkgusr_home=/usr/src/pkgusr      (the base; the "
                  "subdir is taken off)")
        printInfo("      pkgusr_subdir=pkgusr             cfguser_subdir=cfg")
        printInfo("      user_prefix=u                    main_user=<login>")
        printWarning("  a prefix is chosen BEFORE the first account exists; "
                     "changing it on a built")
        printWarning("  tree makes every tool look for accounts that are not "
                     "there.")
        return
    return _cmd_config_interactive(args)


def _cmd_config_interactive(args):
    cfg = load_config()
    changed = False
    # THE PACKAGE-USER PREFIX HAD NO FLAG AT ALL.
    #
    # It could only be changed by editing config.json by hand -- and it is
    # the one prefix that renames every account the system has.  So: a flag,
    # and a refusal when accounts already exist under the current one.
    for _flag, _key in (("pkgusr_prefix", "pkgusr_prefix"),
                        ("cfguser_prefix", "cfguser_prefix")):
        _new = getattr(args, _flag, None)
        if _new is None:
            continue
        _new = _new.rstrip("_")
        _old = cfg.get(_key, _DEFAULT_CONFIG.get(_key, ""))
        if _new == _old:
            printInfo("  %s is already %r" % (_key, _new or ""))
            continue
        _have = _accounts_with_prefix(_old)
        if _have and not getattr(args, "force", False):
            printError("%d account(s) already use the '%s_' prefix: %s%s"
                       % (len(_have), _old, ", ".join(sorted(_have)[:4]),
                          " ..." if len(_have) > 4 else ""))
            printWarning("  Changing it now does NOT rename them.  Every tool "
                         "would look for accounts")
            printWarning("  named %r and find nothing: the packages would read "
                         "as not installed," % (_new + "_" if _new else "<none>"))
            printWarning("  their manifests would orphan, and a rebuild would "
                         "make a second set.")
            printWarning("  This belongs on a tree with no package users yet.")
            printInfo("  If you are certain (a fresh tree, or you will rename "
                      "the accounts yourself):")
            printInfo("    packagemanager config --%s %s --force"
                      % (_flag.replace("_", "-"), _new or "''"))
            return
        cfg[_key] = _new
        changed = True
        printWarning("  %s -> %r%s" % (_key, _new or "(no prefix)",
                                       "  [--force]" if _have else ""))
        # ...and put it where it will actually be read
        _save_shared_key(_key, _new)

    # THE DIRECTORIES NEED FLAGS TOO.
    #
    # They became configurable in 1.13.52/53 and could still only be changed
    # by editing a file.  Same guard as the prefixes: moving the layout does
    # not move the homes, so it belongs on a tree that has none yet.
    for _flag, _key in (("base_dir", "pkgusr_home"),
                        ("pkgusr_subdir", "pkgusr_subdir"),
                        ("cfguser_subdir", "cfguser_subdir")):
        _new = getattr(args, _flag, None)
        if _new is None:
            continue
        _new = _new.rstrip("/")
        _homes = [h for h in (os.path.join(BASE_DIR, PKGUSR_SUBDIR),
                              os.path.join(BASE_DIR, CFGUSR_SUBDIR))
                  if os.path.isdir(h) and os.listdir(h)]
        if _homes and not getattr(args, "force", False):
            printError("account homes already exist under the current layout:")
            for _h in _homes:
                printError("    %s  (%d entries)" % (_h, len(os.listdir(_h))))
            printWarning("  Changing the layout does NOT move them.  Every "
                         "tool would look in the new")
            printWarning("  place and find nothing.  This belongs on a tree "
                         "with no accounts yet.")
            printInfo("  If you are certain (or you will move the homes "
                      "yourself):")
            printInfo("    packagemanager config --%s %s --force"
                      % (_flag.replace("_", "-"), _new or "''"))
            return
        cfg[_key] = _new
        changed = True
        printWarning("  %s -> %r" % (_key, _new or "(none)"))
        _save_shared_key(_key, _new)

    if args.collector_prefix:
        cfg["collector_prefix"] = args.collector_prefix.rstrip("_")
        changed = True
    if args.user_prefix:
        cfg["user_prefix"] = args.user_prefix.rstrip("_")
        changed = True
    if getattr(args, "editor", None):
        cfg["editor"] = args.editor
        changed = True
    if getattr(args, "difftool", None):
        cfg["difftool"] = args.difftool
        changed = True
    if args.main_user:
