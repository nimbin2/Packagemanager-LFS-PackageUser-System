# /usr/src holds one directory (== home) per package-user.  Overridable so the
# tool can be exercised against a fixture tree in testing.
# Where package users live.  Config wins over the built-in default, so a
# system built with a different layout keeps it; the environment still wins
# over both, for tests and one-off runs.
def _base_dir_default():
    """The BASE the account roots hang under -- /usr/src, not /usr/src/pkgusr.

    ONE KEY, TWO MEANINGS.  `lfs` writes `pkgusr_home` as the FULL package-user
    root (its LAYOUT_DEFAULTS say /usr/src/pkgusr); this read the same key as
    the base and then appended PKGUSR_SUBDIR itself, so a tree configured by
    lfs got both:

        logs: /usr/src/pkgusr/pkgusr/p_wget/log

    Taking the parent when the value already ends in the subdirectory makes the
    two readings agree without either tool having to change what it writes --
    and a base that does NOT end in it is still taken literally, which is what
    a hand-written config means.
    """
    # CONFIG_PATH is defined further down, so read the path the same way it
    # does rather than depending on definition order.
    path = os.environ.get("PKGUSR_CONFIG") or "/etc/pkgusr/packagemanager.conf"
    sub = os.environ.get("PKGUSR_SUBDIR", "pkgusr")
    try:
        with open(path) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "pkgusr_home" and v.strip():
                    v = v.strip().rstrip("/")
                    if sub and os.path.basename(v) == sub:
                        return os.path.dirname(v) or "/"
                    return v
    except OSError:
        pass
    return "/usr/src"


BASE_DIR = os.environ.get("PKGUSR_BASE") or _base_dir_default()


