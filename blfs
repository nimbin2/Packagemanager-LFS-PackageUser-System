SITE = os.environ.get("BLFS_SITE", "https://www.linuxfromscratch.org")

def _default_selector():
    """The flavour follows the SYSTEM, not a constant.

    A hardcoded stable-systemd default handed a SysV system the systemd
    book: elogind read NOT IN BOOK (it only exists in the SysV edition) and
    every generated script leaned systemd.  A set default (blfs set-default)
    always wins; this only decides what happens when nobody chose."""
    if os.path.isdir("/run/systemd/system"):
        return "stable-systemd"
    return "stable-sysv"

DEFAULT_SELECTOR = _default_selector()
VALID_INITS = ("systemd", "sysv")

