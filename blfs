             f"{args.selector}")


def cmd_search(args):
    book = get_book(args)
    needle = args.name.lower().replace(" ", "-")
    hits = []
    for anchor, data in sorted(book.packages.items()):
        if needle in (anchor + " " + data["title"]).lower():
            hits.append((anchor, data["title"], data["is_module"]))
    if not hits:
