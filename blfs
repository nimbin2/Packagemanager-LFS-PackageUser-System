# What makes a difference an INIT difference rather than version churn.
_INIT_WORDS_RE = re.compile(
    r"\b(systemd|systemctl|sysv|bootscript|init\.d|rc\.d|tmpfiles|sysusers|"
    r"unit[-_ ]?dir|--(en|dis)able-systemd|service)\b", re.I)


def cmd_diff_init(args):
    """Show where a SysV book and a systemd book disagree.

    The generated scripts come from ONE book.  Using the systemd book on a
    SysV system is workable -- a missing systemctl becomes a visible skip --
    right up to a page whose CONFIGURE line differs, and then it is not:

        BlueZ: configure: error: systemd system unit directory is required

    because the sysv page passes --disable-systemd and the systemd page has
    no reason to.  Per-package machine.conf entries paper over that one page
    at a time, and only after each has failed.  This says which pages differ
    BEFORE any of them are built -- and for one package, exactly how.
    """
    import difflib
    other = args.other
    if not os.path.isfile(other):
        url, local, _is_svn, _v = resolve_book(other)
        if not os.path.isfile(local):
            ensure_book(other)
        other = local
    here = get_book(args)
    # the same loader the rest of the tool uses: cached if the cache is
    # current, indexed once otherwise
    there = get_book(argparse.Namespace(book_file=other, book=None))
    # NAME BOTH SIDES, AND REFUSE TO COMPARE ONE WITH ITSELF.
    #
    # `blfs diff-init 12.4` reported "0 of 947 shared pages differ", which
    # was true and useless: the default selector (stable-sysv) has no book,
    # so it fell back to the newest cached one -- 12.4, the very book being
    # compared against.  A comparison that silently compares a thing with
    # itself is worse than an error.
    print("comparing:\n  A  %s\n  B  %s\n" % (here.path, there.path))
    if os.path.realpath(here.path) == os.path.realpath(there.path):
        sys.stderr.write("those are the same file -- nothing to compare.\n")
        sys.stderr.write("  Name the book to compare AGAINST, and make sure a\n")
        sys.stderr.write("  different one is in use here:\n")
        sys.stderr.write("    blfs --book-file <this book> diff-init <other>\n")
        sys.exit(1)
    names = args.packages or sorted(set(here.packages) & set(there.packages))
    # ONLY THE PAGES THIS MACHINE WILL EVER BUILD.
    #
    # 47 of 929 shared pages differ in their init handling, and most of them
    # are for software this system does not have and never will (GNOME, samba,
    # qemu, postgresql...).  The useful question is not "what differs" but
    # "what differs AND is on my machine", and the answer is on disk: a
    # package with an account has been built or is about to be.
    if getattr(args, "installed", False):
        root = os.environ.get("LFS_PKGUSR_ROOT", "/usr/src/pkgusr")
        pfx = os.environ.get("LFS_PKGUSR_PREFIX", "p_")
        try:
            have = {d[len(pfx):] for d in os.listdir(root) if d.startswith(pfx)}
        except OSError:
            have = set()
        if not have:
            sys.stderr.write("no package users under %s -- --installed has "
                             "nothing to filter by.\n" % root)
            sys.exit(1)
        names = [n for n in names if n.lower() in {h.lower() for h in have}]
    shown = 0
    for anchor in names:
        a = here.get(resolve_anchor(here, anchor_from_input(anchor)))
        try:
            b = there.get(resolve_anchor(there, anchor_from_input(anchor)))
        except SystemExit:
            b = None
        if not a or not b:
            continue
        ka = "\n".join([a.get("build_cmds") or "", a.get("install_root_cmds") or ""])
        kb = "\n".join([b.get("build_cmds") or "", b.get("install_root_cmds") or ""])
        if ka.strip() == kb.strip():
            continue
        # ACROSS VERSIONS, ALMOST EVERYTHING DIFFERS.
        #
        # There is no 13.0 sysv book (BLFS stopped after 12.4), so the only
        # comparison available is 12.4-sysv against 13.0-systemd -- where most
        # pages differ for version reasons that have nothing to do with init.
        # Default to the differences that MENTION init, which is what the
        # question is; --all for the rest.
        if not getattr(args, "all", False):
            # A COMMENTED LINE IS NOT A COMMAND -- HERE TOO (1.14.23 again).
            #
            # Of eight pages this reported for a real system, four were
            # nothing: gcc, libxml2 and rust differed only in NOTE prose that
            # happens to say "systemd journal", "systemctl stop httpd.service"
            # or a book URL containing "13.0-systemd".  Judge the difference
            # on lines that RUN.
            _live = lambda t: [l for l in t.splitlines()
                               if l.strip() and not l.strip().startswith("#")]
            _delta = "\n".join(l for l in difflib.ndiff(_live(kb), _live(ka))
                               if l[:1] in "+-")
            if not _INIT_WORDS_RE.search(_delta):
                continue
        shown += 1
        if args.packages:
            print("=== %s ===" % anchor)
            for line in difflib.unified_diff(
                    kb.splitlines(), ka.splitlines(),
                    fromfile="%s (%s)" % (anchor, os.path.basename(other)),
                    tofile="%s (%s)" % (anchor, os.path.basename(here.path)),
                    lineterm=""):
                print(line)
            print()
        else:
            print("  %-28s commands differ" % anchor)
    if not args.packages:
        _what = "differ" if getattr(args, "all", False) \
            else "differ in their init handling"
        print("\n%d of %d shared pages %s." % (shown, len(names), _what))
        if not getattr(args, "all", False):
            print("(--all compares everything, including version churn)")
        print("For one of them:  blfs diff-init %s <package>" % args.other)
    return 0


def cmd_books(args):
    if getattr(args, "rebuild_cache", False):
        book = get_book(args, rebuild=True)
        print(f"Re-indexed {book.path}: {len(book.packages)} packages cached.")
        return
    cfg = load_config()
    default = cfg.get("default", DEFAULT_SELECTOR)
    print(f"Store:   {store_dir()}")
    print(f"Default: {default}\n")

    print("Cached books:")
    found = False
    for f in sorted(os.listdir(books_dir())):
        if f.endswith(".meta") or f.endswith(".part"):
            continue
        found = True
        meta = _load_meta(os.path.join(books_dir(), f))
        sel = meta.get("selector", "?")
        ver = meta.get("version", "?")
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(meta.get("fetched", 0)))
        mark = " (default)" if sel == default else ""
        print(f"  {sel:<18} version {ver:<8} fetched {when}{mark}  [{f}]")
    if not found:
        print("  (none yet)")

    # --brief is the wrapper's contract: the Default line and the cached
    # list, NOTHING live.  packagemanager reads the book name through this,
    # and the auto-discovery below is for a person at a terminal -- routed
    # through the wrapper it made every `packagemanager update` probe the
    # site, twice, and print the probes' notes.
    if getattr(args, "brief", False):
        return

    def _print_available(books, note):
        print(note)
        for sel, rec in sorted(books.items()):
            mark = " (default)" if sel == default else ""
            print(f"  {sel:<22} version {rec['version']:<8} [{rec['init']}]{mark}")
        print(f"\nPick one with:  blfs set-default <selector>")

    # Discovery is automatic: with a connection, the list is live; without
    # one, the cached list from the last discovery is shown and SAYS it is
    # cached.  --discover is kept as the explicit refresh (it reports the
    # failure loudly instead of falling back).
    if args.discover:
        try:
            _print_available(discover_all(),
                             "\nAvailable books (from the downloads index):")
        except Exception as e:
            print(f"  could not read {downloads_index_url()} ({e})")
            return
    else:
        try:
            _print_available(discover_all(),
                             "\nAvailable books (from the downloads index):")
        except Exception:
            avail = load_available()
            if avail:
                _print_available(avail, "\nAvailable books (offline -- cached "
                                        "from the last discovery):")
            else:
                print("\n(offline, and no cached discovery yet -- re-run with "
                      "a connection to list what the site offers)")


def cmd_set_default(args):
    cfg = load_config()
    cfg["default"] = args.selector
    save_config(cfg)
    print(f"Default book set to: {args.selector}")
    # A default that is not cached is a decision waiting to be silently
    # overridden: every lookup would fall back to the closest cached book.
    # That happened -- set-default 13.0-systemd, and update read 12.4 with
    # the note swallowed.  So the book is cached NOW, while the person who
    # made the choice is looking.
    try:
        ensure_book(args.selector)
