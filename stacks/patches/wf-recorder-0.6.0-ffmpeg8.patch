+/* FFmpeg 7.1 (libavcodec 61.13.100) replaced AVCodec.pix_fmts, .sample_fmts
+ * and .ch_layouts with avcodec_get_supported_config(); FFmpeg 8 removed the
+ * fields.  These read the list either way. */
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+static const AVPixelFormat *wfr_pix_fmts(const AVCodec *c)
+{
+    const void *p = nullptr;
+    avcodec_get_supported_config(nullptr, c, AV_CODEC_CONFIG_PIX_FORMAT, 0, &p, nullptr);
+    return (const AVPixelFormat *)p;
+}
+static const AVSampleFormat *wfr_sample_fmts(const AVCodec *c)
+{
+    const void *p = nullptr;
+    avcodec_get_supported_config(nullptr, c, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, &p, nullptr);
+    return (const AVSampleFormat *)p;
+}
+#if HAVE_CH_LAYOUT
+static const AVChannelLayout *wfr_ch_layouts(const AVCodec *c)
+{
+    const void *p = nullptr;
+    avcodec_get_supported_config(nullptr, c, AV_CODEC_CONFIG_CHANNEL_LAYOUT, 0, &p, nullptr);
+    return (const AVChannelLayout *)p;
+}
+#endif
+#else
+static const AVPixelFormat *wfr_pix_fmts(const AVCodec *c) { return c->pix_fmts; }
+static const AVSampleFormat *wfr_sample_fmts(const AVCodec *c) { return c->sample_fmts; }
+#if HAVE_CH_LAYOUT
+static const AVChannelLayout *wfr_ch_layouts(const AVCodec *c) { return c->ch_layouts; }
+#endif
+#endif
