def strip_package_name_full(name):
    return re.sub("\(.*","",name).strip()

def extractPackageNameFull():
    global soup
    # Find the div element with class "sect1" followed by h1 with class "sect1"
    div_element = None
    if is_module:
        div_element = soup.select_one('h2.sect2')
    else:
        div_element = soup.select_one('h1.sect1')

    if div_element:
        # Extract and return the content within the div
        content = div_element.get_text().strip()
        return strip_package_name_full(content)
    else:
        print(f"extractPackageNameFull: nothing found")
        return ""


def extractPackageName():
    global soup
    name_link = None
    if is_module:
        name_link = soup.select_one("h2.sect2 > a")
    else:
        name_link = soup.select_one("h1.sect1 > a")
    name = name_link['name']
    parts = name.split("-")
    if len(parts) > 1 and parts[-1].replace(".","").isdigit():
        return "-".join(parts[:-1])
    else:
        return name

def extractPackageNameVersion(package_string):
    version_pattern = r'-(\d+(\.\d+)+)$'
    match = re.search(version_pattern, package_string)

    if match:
        package_name_without_version = package_string[:match.start()]
        package_version = match.group(1)
        return package_name_without_version, package_version
    else:
        return package_string, None

def extract_package_link():
    global soup
    # Find the div element with class "package"
    package_div = soup.find(class_="package")

    if package_div:
        # Find all <a class="ulink"> elements within the div
        ulink_elements = package_div.select('div.itemizedlist a.ulink')

        if ulink_elements:
            for ulink_element in ulink_elements:
                href = ulink_element.get("href")
                if href and href.startswith("https"):
                    return href

            # If no HTTPS link is found, return the first one
            first_href = ulink_elements[0].get("href")
            return first_href

    print(f"extract_package_link: nothing found")
    return ""

def extract_package_md5():
    global soup
    # Find the div element with class "package"
    package_div = soup.find(class_="package")

    if package_div:
        itemizedlists = package_div.find_all("div", class_="itemizedlist")
        md5_sum = ""

        for itemizedlist in itemizedlists:
            md5_p = itemizedlist.find("p", string=re.compile(r'\sDownload MD5 sum:\s*', re.IGNORECASE))
            if md5_p:
                # Extract the text after "*Download MD5 sum:*" and remove any line breaks or leading/trailing spaces
                md5_sum = md5_p.get_text()
                md5_sum = re.sub(r'Download MD5 sum:', '', md5_sum, flags=re.IGNORECASE).strip().replace('\n', ' ')

                # Break after finding the first matching element
                break

        return md5_sum
    else:
        print(f"extract_package_md5: nothing found")
        return None

def extract_additional_downloads():
    global soup
    # Find the div element with class "package"
    package_div = soup.find(class_="package")

    if package_div:
        content = []
        h3_additional_downloads = package_div.find("h3", string=re.compile(r'\s*Additional Downloads\s*'))
        h3_dependencies = package_div.find("h3", string=re.compile(r'\s* Dependencies\s*'))


        #if h3_additional_downloads and h3_dependencies:
        if h3_additional_downloads:
            ulink_elements = []
            content = []

            # Iterate through siblings of h3_additional_downloads until h3_dependencies is found
            current_element = h3_additional_downloads.find_next_sibling()
            while current_element and current_element != h3_dependencies:
                # Find all <a> elements with class "ulink" within current_element
                ulinks = current_element.find_all("a", class_="ulink")
                for ulink in ulinks:
                    link = ulink.get("href")
                    if link:
                        content.append(link)
                current_element = current_element.find_next_sibling()

            return content
        else:
            print(f"extract_additional_downloads: nothing found")
            return []
    else:
        print(f"extract_additional_downloads: nothing found")
        return []



def extract_package_info():
    global soup
    # Find the element with class "package"
    package_element = soup.find(class_="package")

    if package_element:
        # Find all p elements between "sect2" and the h3 element with content "Package Information"
        sect2_element = None
        if is_module:
            sect2_element = package_element.find(class_="sect3")
        else:
            sect2_element = package_element.find(class_="sect2")

        if sect2_element:
            package_info = []
            p_content = ""
            break_div = "h3"
            if is_module:
                break_div = "h4"

            for element in sect2_element.next_siblings:
                if element.name == break_div and "Package Information" in element.text:
                    break
                if element.name == "p":
                    p_content = p_content + '\\n\\n' + ' '.join(line.strip() for line in element.text.strip().splitlines())

            package_info.append(p_content.replace('"', '\\"'))
            # Return the extracted package information as a single string
            extracted_info = '\n'.join(package_info).lstrip("\\n")
            return extracted_info
        else:
            print(f"extract_package_info: nothing found")
    else:
        print(f"extract_package_info: nothing found")
        return ""

