def extract_package_installed_content():
    global soup
    # Find all div.seg within div.sect1 > div.content > div.seglistitem
    seglistitems = None
    if is_module:
        seglistitems = soup.select('div.content div.seglistitem')
    else:
        seglistitems = soup.select('div.sect1 > div.content div.seglistitem')

    content_dict = {}

    for seglistitem in seglistitems:
        segs = seglistitem.find_all("div", class_="seg")

        for seg in segs:
            segtitle = seg.find("strong", class_="segtitle")
            segbody = seg.find("span", class_="segbody")

            if segtitle and segbody:
                segtitle_text = segtitle.get_text().strip().lower().replace(" ", "_").replace(":","")
                segbody_text = ' '.join(segbody.get_text().split())  # Remove multiple spaces and newlines

                content_dict[segtitle_text] = segbody_text.replace(" and "," ")

    return content_dict

def extract_package_commands(class_names):
    global soup
    # Find the div element with class "installation"
    #command_div = soup.find(class_=class_names)
    command_div = soup.select(class_names + " >*")

    if command_div:
        contents = []

        # Iterate through the elements within div.installation
        for element in command_div:
            if element.name == "h2":
                d_content = "\n\n\n#### " + ''.join(line.strip() for line in element.get_text().splitlines()).replace('\n', '') + "\n"
                contents.append(d_content)
            elif element.name == "h3":
                d_content = "\n\n### " + ''.join(line.strip() for line in element.get_text().splitlines()).replace('\n', '')
                contents.append(d_content)
            elif element.name == "h4":
                d_content = "\n\n## " + ''.join(line.strip() for line in element.get_text().splitlines()).replace('\n', '')
                contents.append(d_content)
            elif element.name == "p":
                # If it's a <p> element, add its text content with "# " prefix
                p_content = ' '.join(line.strip() for line in element.get_text().splitlines()).replace('\n', ' ')
                p_content = "\n\n# " + p_content.strip() + "\n"
                contents.append(p_content)
            elif element.name == "pre":
                kbd_command = element.find("kbd", class_="command")
                if kbd_command:
                    # If it's a <pre><kbd class="command"> element, add its text content
                    contents.append(kbd_command.get_text().strip())
            elif element.name == "div":
                element_classes = element.get("class", [])
                if isinstance(element, Tag) and "admon" in element.get("class", []):
                    element_classes.remove("admon")
                    contents.append("\n#### " + ''.join([element.upper() for element in element_classes]) + " ####")
                    for element_admon in element:
                        if element_admon.name == "p":
                            lines = []
                            # Iterate through the contents of the p element
                            for item in element_admon.contents:
                                if isinstance(item, str):
                                    # If it's a text node (not a child element), strip leading and trailing whitespace
                                    line = re.sub(r'\s+', ' ', item.strip())
                                    if line:
                                        lines.append(line)
                                elif item.name:  # If it's a child element (has a name)
                                    # Add the content of the child element without leading/trailing whitespace
                                    child_text = item.get_text().strip()
                                    child_text  = re.sub(r'\s+', ' ', child_text)
                                    if child_text:
                                        lines.append(child_text)

                            # Join the lines into a single string, replacing line breaks with spaces
                            content_str = ' '.join(lines)
                            contents.append("## " + content_str.replace(" , ", ", "))
                            contents.append("")
                    


        if contents:
            joined_contents = '\n'.join(contents)
            return joined_contents
        else:
            print(f"extract_package_commands({class_names}): nothing found")
            return ""
    else:
        print(f"extract_package_commands({class_names}): nothing found")
        return ""

def extract_classnames_between_package_and_installation():
    global soup
    # Find the div element with class "sect1"
    sect1_div = soup.find("div", class_="sect1")

    if sect1_div:
        installation_div = sect1_div.find("div", class_="package")
        configuration_div = sect1_div.find("div", class_="installation")

        if installation_div and configuration_div:
            # Find all siblings of div.installation that are on the same level
            elements_between = []

            for sibling in installation_div.next_siblings:
                if sibling == configuration_div:
                    break

                if sibling.name:
                    elements_between.append(sibling["class"])

            if elements_between:
                classnames = [classname for element_classes in elements_between for classname in element_classes]
                return classnames

def format_array_to_bash_array(input_array):
