def installCycle(package_name):
    global package_reinstall

    url = ""

    # Check if the URL is not a webpage (doesn't start with "https://" or "http://")
    if not package_name.startswith(("https://", "http://")):
        url = getPackageUrl(package_name, True)

    # get global soup
    getPkgSoup(url)

    if not package_reinstall:
        dependencies = getDependencies(url, False, False)
        installed, missing, version_mismatch = installCheck(package_name, dependencies, False)
    else:
        dependencies = getDependencies(url, False, True)
        installed, missing, version_mismatch = installCheck(package_name, dependencies, True)

    installMissing(missing)
    print(install_command)

