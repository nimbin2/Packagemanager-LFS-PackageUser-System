    install_check_run  = install_check_run + 1

    printHeader("Install")
    # get dependencies
    package_name = getNameFromDependencyFile(package_name_version)
    name, version = extractPackageNameVersion(package_name_version)
    if not package_name:
        package_name = name
    add_missing = None
    if checkPackage(package_name, version) == "True" and not ignore_check:
        printLine()
        printError(f"{package_name} is already installed")
        if install_check_run == 1:
            if askYesNoQuestion(f"do you want to go on anyways?"):
                add_missing = package_name_version
            else:
                exit(1)
    printLine()
    # check dependencies
    installed, missing, version_mismatch = checkInstalledDependencies(dependencies, ignore_check)
    if add_missing:
        installed.append(add_missing)
    printHeader("Dependencie summary:")
    printSuccess(f"Installed: {installed}")
    printError(f"Missing: {missing}")
    printWarning(f"Version mismatch: {version_mismatch}")

    return installed, missing, version_mismatch

