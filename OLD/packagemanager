def strip_package_name_full(name):
    return re.sub("\(.*","",name).strip()

def extract_package_name(soup):
    global is_module
    name_link = None
    if is_module:
        name_link = soup.select_one("h2.sect2 > a")
    else:
        name_link = soup.select_one("h1.sect1 > a")
