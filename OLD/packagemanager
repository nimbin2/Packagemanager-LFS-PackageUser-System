def findFilesOrFoldersWithBrokenGidOrUid():
    def print_find(file):
        print(file)

    def findFilesWithInvalidIds(root_dir, ignored_paths):
        invalid_files = []

        for foldername, subfolders, filenames in os.walk(root_dir):
            ignore_flag = False
            for ignored_path in ignored_paths:
                if foldername.startswith(ignored_path):
                    ignore_flag = True
                    break
            if ignore_flag:
                continue

            for filename in filenames:
                file_path = os.path.join(foldername, filename)

                try:
                    file_stat = os.lstat(file_path)  # Use os.lstat() instead of os.stat() for symlinks
                    uid = file_stat.st_uid
                    gid = file_stat.st_gid

                    try:
                        pwd.getpwuid(uid)
                        grp.getgrgid(gid)
                    except (KeyError, OverflowError):
                        invalid_files.append(file_path)
                        print_find(file_path)

                except (FileNotFoundError, PermissionError):
                    invalid_files.append(file_path)
                    print_find(file_path)

        return invalid_files

    root_directory = '/'
    ignored_paths = [ '/mnt', '/proc']
    invalid_files = findFilesWithInvalidIds(root_directory, ignored_paths)

    print()
    print(invalid_files)

    # Write invalid files to a file in /tmp directory
    output_file_path = '/tmp/invalid_files.txt'
    with open(output_file_path, 'w') as output_file:
        for file_path in invalid_files:
            output_file.write(file_path + '\n')

    # Inform user about the output file
    print(f'\nInvalid files list written to: {output_file_path}\n')
    return invalid_files


