        content = div_element.get_text().strip()
        return strip_package_name_full(content)
    else:
        print(f"extract_package_name_version: nothing found")
        return ""

def extractPackageNameVersion(package_string):
    version_pattern = r'-(\d+(\.\d+)+)$'
    match = re.search(version_pattern, package_string)

    if match:
        package_name_without_version = package_string[:match.start()]
        package_version = match.group(1)
        return package_name_without_version, package_version
    else:
        return package_string, None

def sortDependencies(dependencies):
    global get_not_installable
    ## SORT
    # Create a defaultdict to store dependencies as sets
    dependency_sets = defaultdict(set)
    # Convert the dependencies dictionary to sets
    for package, deps in dependencies.items():
        for dep, _ in deps:
            dependency_sets[package].add(dep)
    # Perform topological sorting
    sorted_packages = []
    visited = set()

    def topologicalSort(package):
        visited.add(package)
        for dep in dependency_sets[package]:
            if dep not in visited:
                topologicalSort(dep)
        sorted_packages.append(package)

    for package in dependencies.keys():
        if package not in visited:
            topologicalSort(package)

    # Create a new dictionary with sorted packages
    sorted_dependencies = {}
    for pkg in sorted_packages:
        try:
            sorted_dependencies[pkg] = dependencies[pkg]
        except KeyError:
            # If dependencies[pkg] does not exist, add pkg to get_not_installable
            get_not_installable.append(pkg)
    return sorted_dependencies


def checkInstalledDependencies(dependencies, ignore_check):
    global get_not_installable
    installed = []
    missing = []
    version_mismatch = []

    ### CHECK
    for key in dependencies:
        package_name = getNameFromDependencyFile(key)
        name, version = extractPackageNameVersion(key)
        check = checkPackage(package_name, version)
        if ignore_check:
            missing.append(key)
        elif check == "True":
            installed.append(key)
        elif check == "False":
            missing.append(key)
        elif check == "Undefined":
            get_not_installable.append(key)
        else:
            version_mismatch.append(f"{key} == {check}")

    return installed, missing, version_mismatch

