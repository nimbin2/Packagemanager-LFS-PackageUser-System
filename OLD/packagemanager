def checkPackageVersion(package_name_version):
    package_name, package_version = extractPackageNameVersion(package_name_version)
    file_path = f"/usr/src/{package_name}/install_{package_name}"
    with open(file_path, 'r') as file:
        for line in file:
            line = line.strip()
            if line.startswith("name_version="):
                name_version = line.split("=")[1].replace('"',"")
                name, version = extractPackageNameVersion(name_version)
                return version


def checkPackage(package_name, version):
    if not package_name:
        return "Undefined"

    installed_version = None
    printHeader(f"Checking {package_name} {version}")

    print(f"Checking '{package_name}'")
    package_name = package_name.lower()

    check = "True"
    try:
        user_result = os.system(f"id {package_name} >/dev/null 2>&1")

        if user_result == 0:
            printSuccess("User "+package_name+" exists.")
        else:
            printWarning("User "+package_name+" does not exist.")
            check = False
    except Exception as e:
        print(f"Error checking user: {e}")
        check = "False"

    # Check dir
    directory = f"/usr/src/{package_name}"
    if os.path.exists(directory):
        printSuccess("Directory "+directory+" exists.")
    else:
        printWarning("Directory "+directory+" does not exist.")
        check = "False"

    # Check pkg.list file -> installed...
    file_path = f"{directory}/pkg.lst"
    if os.path.exists(file_path) and os.path.getsize(file_path) > 0:
        printSuccess("File "+file_path+" exists")
    else:
        printWarning("File "+file_path+" does not exist or is empty.")
        check = "False"

    # Check version
    file_install = f"{directory}/install_{package_name}"
    if os.path.exists(file_install) and os.path.getsize(file_install) > 0:
        printSuccess("File "+file_install+" exists")
        version_is = checkPackageVersion(package_name)
        if not version_is == version and version is not None:
            printWarning(f"Version mismatch: {version}")
            check = version
        else:
            printSuccess(f"Version match: {version}")
    else:
        printWarning("File "+file_install+" does not exist or is empty.")

    printLine()
    if check == "True":
        printSuccess("All checks passed.")
    elif check == "False":
        printError("Some checks failed.")
    else:
        printError("Version mismatch.")

    return check

def getPackageUrl(pkg_name, quiet):
    # Execute the blfs_parse_find_package script with -q and store its output in the 'url' variable
    url = ""
    try:
        if quiet:
            blfs_output = subprocess.check_output(["blfs_parse_find_package", "-q", pkg_name], universal_newlines=True, stderr=subprocess.STDOUT).strip()
        else:
            blfs_output = subprocess.check_output(["blfs_parse_find_package", pkg_name], universal_newlines=True, stderr=subprocess.STDOUT).strip()
        url = blfs_output
    except subprocess.CalledProcessError as e:
        if e.output:
            url = e.output.strip()
        else:
            print(f"Error executing blfs_parse_find_package: {e}")
            sys.exit(1)

    if "not found" in url or not quiet:
        printHeader(f"Search {pkg_name}")
        print(url)

        if "not found" in url:
            sys.exit(0)
    return url

def fetchDependencies(url, quiet, once, tab):
    global is_module
    if not url:
        return

    tab_space = " " * tab
    tab += 1
    global get_dependencies
    global get_not_installable
    global ignore_list

    basename = os.path.basename(url.replace(".html", ""))

    if basename.startswith("xorg7#"):
        printError("\n#################")
        printError(f"cannot fetch {basename}")
        get_not_installable.append(basename)
        return

    if not quiet:
        print("\n#################")
        print(f"{tab_space}FETCHING: ", basename)
        print()
    soup = None
    deps = []
    # Send a GET request to the URL
    response = requests.get(url)

    # Check if the request was successful (status code 200)
    if response.status_code == 200:
        is_module = False

        # Check if pkg is a module
        parsed_url = urlsplit(url)
        fragment = parsed_url.fragment

        # Remove URL encoding from the fragment
        if fragment:
            is_module = unquote(fragment)

        # Parse the HTML content of the webpage
        soup = BeautifulSoup(response.text, "html.parser")
        if is_module:
            soup = soup.select_one(f'div.sect2 h2.sect2 a[name="{is_module}"]').find_parent('div', class_='sect2')
    else:
        print(f"Failed to retrieve the webpage. Status code: {response.status_code}")

    # Extract name
    pkg_name_version = extract_package_name_full(soup).replace(" ", "-")

    # Find the div element with class "package"

    pg_name, version = extractPackageNameVersion(pkg_name_version)
    pkg_name = extract_package_name(soup)

    package_div = soup.find(class_="package")
    with open(file_install_links, 'a') as file:
        file.write(f'{pkg_name}\t{pkg_name_version}\t{url}\n')

    #if once:
    #    sys.exit(0)
    #    return
    
    #get_dependencies[pkg_name_version] = deps
    get_dependencies[pkg_name_version] = []
    loop_pkg = pkg_name_version

    if checkPackage(pkg_name, version) == "True":
        printSuccess(f"{pkg_name} is installed")
        return

    
    if package_div:
        # Find all <a class="xref"> elements within <p class="required"> under the package_div

        # Extract and join the titles of all found xref elements with a comma
        def getP(required_xref_elements):
            for xref in required_xref_elements:
                title_full = strip_package_name_full(xref.get("title"))
                title_full = title_full.replace(" ", "-")
                if title_full:
                    href = xref.get("href")
                    # if not a local page
                    if href.startswith("https://"):
                        missing.append([title_full, href])
                    else:
                        url_new = urljoin(url, href)
                        deps.append([title_full, url_new])
                        check_title = False
                        check_ignore = False
                        for subarray in get_dependencies:
                            if title_full in get_dependencies and not loop_pkg == subarray:
                                check_title = True
                        for ignore in ignore_list:
                            if ignore.lower() in title_full.lower():
                                printError(f"\n\n{printHeader('IGNORE')}\n\n{title_full}\n\n")
                                check_ignore = True
                        if not once and not check_title and not check_ignore and not ignore_deps:
                            fetchDependencies(url_new, quiet, False, tab)

        getP(package_div.select('p.required a.xref'))
        if not ignore_recommended:
            getP(package_div.select('p.recommended a.xref'))

    get_dependencies[pkg_name_version] = deps

def getDependencies(url, quiet, once):
    global get_dependencies
    global get_not_installable


    if not url.startswith(("https://", "http://")):
        url = getPackageUrl(url, True)

    if not quiet:
        printHeader("Dependencies")
        print()

    fetchDependencies(url, quiet, False, 0)

    dependencies_sorted = sortDependencies(get_dependencies)

    if not quiet:
        printHeader(f"{package_name} dependencies")
        print("DEPENDENCIES: ", dependencies_sorted)
        print("NOT INSTALLABLE: ", get_not_installable)

    return dependencies_sorted

def getUrlFromDependencyFile(pkg_name):
    with open(file_install_links, "r", encoding="utf8") as file:
        reader = csv.reader(file, delimiter="\t")
        for row in reader:
            (name, name_version, url) = row
            if name_version == pkg_name:
                return url

def getNameFromDependencyFile(pkg_name_version):
    with open(file_install_links, "r", encoding="utf8") as file:
        reader = csv.reader(file, delimiter="\t")
        for row in reader:
            (name, name_version, url) = row
            if name_version == pkg_name_version:
                return name

